    protected override void OnInitialized()
    {
        ReadQueryParameters();
    }

    protected override void OnParametersSet()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (!string.IsNullOrEmpty(query))
            {
                if (query.Contains("view=worksheet", StringComparison.OrdinalIgnoreCase))
                {
                    ActiveView = ViewMode.Worksheet;
                }
                if (query.Contains("solution=true", StringComparison.OrdinalIgnoreCase))
                {
                    ShowSolution = true;
                }
                if (query.Contains("embed=true", StringComparison.OrdinalIgnoreCase) || query.Contains("embedded=true", StringComparison.OrdinalIgnoreCase))
                {
                    IsEmbed = true;
                }
            }

            if (!string.IsNullOrEmpty(QueryCircuit))
            {
                var c = QueryCircuit.ToLowerInvariant();
                if (c.Contains("truth") || c.Contains("exercise") || c.Contains("schaltnetz") || c.Contains("aufgabe1"))
                {
                    SelectedCircuit = CircuitType.TruthTableCircuit;
                }
                else if (c.Contains("mux") || c.Contains("multiplexer"))
                {
                    SelectedCircuit = CircuitType.Multiplexer;
                }
                else if (c.Contains("demux") || c.Contains("demultiplexer"))
                {
                    SelectedCircuit = CircuitType.Demultiplexer;
                }
                else if (c.Contains("seven") || c.Contains("segment") || c.Contains("bcd"))
                {
                    SelectedCircuit = CircuitType.SevenSegment;
                }
                else if (c.Contains("counter") || c.Contains("zaehler") || c.Contains("sync"))
                {
                    SelectedCircuit = CircuitType.Counter;
                }
                else if (c.Contains("gate"))
                {
                    SelectedCircuit = CircuitType.Gates;
                }
                else if (c.Contains("half"))
                {
                    SelectedCircuit = CircuitType.HalfAdder;
                }
                else if (c.Contains("full"))
                {
                    SelectedCircuit = CircuitType.FullAdder;
                }
                else if (c.Contains("latch"))
                {
                    SelectedCircuit = CircuitType.DLatch;
                }
            }
        }
        catch { }
    }

    private void SetView(ViewMode mode) => ActiveView = mode;
    private void SetCircuit(CircuitType circuit) => SelectedCircuit = circuit;
    private void ToggleSolution() => ShowSolution = !ShowSolution;
    private async Task TriggerPrint() => await JSRuntime.InvokeVoidAsync("window.print");

    // 3-Bit Counter Logic (GDI09 Aufgabe 1)
    private bool CounterSequential = true;
    private int CounterValue = 0;
    private bool CounterManualE0 = false;
    private bool CounterManualE1 = false;
    private bool CounterManualE2 = false;
    private bool CounterClockPulse = false;
    private bool CounterAutoPlay = false;
    private System.Threading.Timer? CounterTimer;

    private int CounterDecimal => CounterSequential ? CounterValue : ((CounterManualE0 ? 1 : 0) | (CounterManualE1 ? 2 : 0) | (CounterManualE2 ? 4 : 0));
    private bool ActiveE0 => CounterSequential ? (CounterValue & 1) != 0 : CounterManualE0;
    private bool ActiveE1 => CounterSequential ? (CounterValue & 2) != 0 : CounterManualE1;
    private bool ActiveE2 => CounterSequential ? (CounterValue & 4) != 0 : CounterManualE2;

    private bool CounterA0 => !ActiveE0;
    private bool CounterA1 => ActiveE1 ^ ActiveE0;
    private bool CounterAnd => ActiveE1 && ActiveE0;
    private bool CounterA2 => ActiveE2 ^ CounterAnd;
    private int NextCounterValue => (CounterA0 ? 1 : 0) | ((CounterA1 ? 1 : 0) << 1) | ((CounterA2 ? 1 : 0) << 2);

    private string GetCounterWireColor(bool active) => active ? "#2563eb" : "#cbd5e1";
    private string GetCounterWireWidth(bool active) => active ? "3.5" : "2";

    private void StepCounterClock()
    {
        CounterClockPulse = true;
        CounterValue = (CounterValue + 1) % 8;
        InvokeAsync(StateHasChanged);
        Task.Delay(180).ContinueWith(_ =>
        {
            CounterClockPulse = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private void ToggleCounterAutoPlay()
    {
        if (CounterAutoPlay)
        {
            StopCounterAutoPlay();
        }
        else
        {
            CounterAutoPlay = true;
            CounterTimer = new System.Threading.Timer(_ =>
            {
                StepCounterClock();
            }, null, 0, 1000);
        }
    }

    private void StopCounterAutoPlay()
    {
        CounterAutoPlay = false;
        CounterTimer?.Dispose();
        CounterTimer = null;
    }

    private void ResetCounter()
    {
        CounterValue = 0;
        CounterManualE0 = false;
        CounterManualE1 = false;
        CounterManualE2 = false;
    }

    private void SetCounterValue(int val)
    {
        CounterValue = Math.Clamp(val, 0, 7);
        CounterManualE0 = (val & 1) != 0;
        CounterManualE1 = (val & 2) != 0;
        CounterManualE2 = (val & 4) != 0;
    }

    private void ToggleD()
    {
        InputD = !InputD;
        if (ClockSignal) LatchQ = InputD;
    }

    private void ToggleClock()
    {
        ClockSignal = !ClockSignal;
        if (ClockSignal) LatchQ = InputD;
    }

    public void Dispose()
    {
        StopCounterAutoPlay();
    }
