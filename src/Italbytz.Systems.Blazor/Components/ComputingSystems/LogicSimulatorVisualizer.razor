                </div>
            </div>

        </div>
    }

</article>

@code {
    public enum ViewMode { Simulator, Worksheet }
    private enum CircuitType { TruthTableCircuit, Multiplexer, Demultiplexer, SevenSegment, Counter, Gates, HalfAdder, FullAdder, DLatch }

    [Parameter] public string? View { get; set; }
    [Parameter] public bool? SolutionParam { get; set; }
    [Parameter] public bool? Embed { get; set; }

    [SupplyParameterFromQuery(Name = "circuit")] public string? QueryCircuit { get; set; }

    private ViewMode ActiveView = ViewMode.Simulator;
    private CircuitType SelectedCircuit = CircuitType.Multiplexer;
    private bool ShowSolution = false;
    private bool IsEmbed = false;

    // Truth Table Circuit state (GDI04 Aufgabe 1)
    private bool CircuitX0 = false;
    private bool CircuitX1 = false;
    private bool CircuitX2 = false;

    private bool CircuitNotX0 => !CircuitX0;
    private bool CircuitAnd1 => CircuitX2 && CircuitNotX0;
    private bool CircuitAnd2 => CircuitAnd1 && CircuitX0;
    private bool CircuitAnd3 => CircuitX1 && CircuitNotX0;
    private bool CircuitOr1 => CircuitAnd3 || CircuitX0;
    private bool CircuitY => CircuitAnd2 || CircuitOr1;

    // Multiplexer state
    private bool MuxS1 = false;
    private bool MuxS0 = false;
    private bool MuxE0 = true;
    private bool MuxE1 = false;
    private bool MuxE2 = false;
    private bool MuxE3 = false;

    private int SelectedChannel => ((MuxS1 ? 1 : 0) << 1) | (MuxS0 ? 1 : 0);

    private bool GetChannelValue(int ch) => ch switch
    {
        0 => MuxE0,
        1 => MuxE1,
        2 => MuxE2,
        3 => MuxE3,
        _ => false
    };

    private bool MuxOutput => GetChannelValue(SelectedChannel);

    private static string ToSubscript(int number) => number switch
    {
        0 => "₀",
        1 => "₁",
        2 => "₂",
        3 => "₃",
        4 => "₄",
        5 => "₅",
        6 => "₆",
        7 => "₇",
        8 => "₈",
        9 => "₉",
        _ => number.ToString()
    };

    // Demultiplexer state (GDI 07 Aufgabe 1)
    private bool DemuxS2 = false; // MSB
    private bool DemuxS1 = false; // LSB
    private bool DemuxE = true;

    private int DemuxAddress => ((DemuxS2 ? 1 : 0) << 1) | (DemuxS1 ? 1 : 0);
    private bool DemuxA0 => DemuxE && !DemuxS1 && !DemuxS2;
    private bool DemuxA1 => DemuxE && DemuxS1 && !DemuxS2;
    private bool DemuxA2 => DemuxE && !DemuxS1 && DemuxS2;
    private bool DemuxA3 => DemuxE && DemuxS1 && DemuxS2;
    private bool DemuxActiveOutput => DemuxE;

    // 7-Segment Decoder state (GDI 07 Aufgabe 2)
    private bool SegX4 = false; // MSB (8)
    private bool SegX3 = false; // (4)
    private bool SegX2 = false; // (2)
    private bool SegX1 = false; // LSB (1)

    private int SegDigitValue => ((SegX4 ? 1 : 0) << 3) | ((SegX3 ? 1 : 0) << 2) | ((SegX2 ? 1 : 0) << 1) | (SegX1 ? 1 : 0);

    private static readonly bool[,] SevenSegTable = new bool[16, 7]
    {
        // s0,   s1,    s2,    s3,    s4,    s5,    s6
        { true,  true,  false, true,  true,  true,  true  }, // 0
        { false, false, false, true,  false, true,  false }, // 1
        { true,  false, true,  true,  true,  false, true  }, // 2
        { true,  false, true,  true,  false, true,  true  }, // 3
        { false, true,  true,  true,  false, true,  false }, // 4
        { true,  true,  true,  false, false, true,  true  }, // 5
        { true,  true,  true,  false, true,  true,  true  }, // 6
        { true,  false, false, true,  false, true,  false }, // 7
        { true,  true,  true,  true,  true,  true,  true  }, // 8
        { true,  true,  true,  true,  false, true,  true  }, // 9
        { false, false, false, false, false, false, false }, // 10
        { false, false, false, false, false, false, false }, // 11
        { false, false, false, false, false, false, false }, // 12
        { false, false, false, false, false, false, false }, // 13
        { false, false, false, false, false, false, false }, // 14
        { false, false, false, false, false, false, false }, // 15
    };

    private bool GetSegment(int seg) => (SegDigitValue >= 0 && SegDigitValue < 10) ? SevenSegTable[SegDigitValue, seg] : false;

    private void SetDigit(int d)
    {
        SegX4 = (d & 8) != 0;
        SegX3 = (d & 4) != 0;
        SegX2 = (d & 2) != 0;
        SegX1 = (d & 1) != 0;
    }

    private string GetActiveSegmentList()
    {
        if (SegDigitValue >= 10) return "Keine (Don't Care)";
        var active = new List<string>();
        for (int i = 0; i <= 6; i++)
        {
            if (GetSegment(i)) active.Add($"s{ToSubscript(i)}");
        }
        return active.Count > 0 ? string.Join(", ", active) : "Keine";
    }

    private int GetActiveSegmentCount()
    {
        if (SegDigitValue >= 10) return 0;
        int count = 0;
        for (int i = 0; i <= 6; i++)
        {
            if (GetSegment(i)) count++;
        }
        return count;
    }

    private string GetSegmentBitString()
    {
        if (SegDigitValue >= 10) return "-------";
        var sb = new System.Text.StringBuilder();
        for (int i = 6; i >= 0; i--)
        {
            sb.Append(SevenSegTable[SegDigitValue, i] ? "1" : "0");
        }
        return sb.ToString();
    }

    // Basic Gates state
    private bool InputA = false;
    private bool InputB = false;
    private bool InputCin = false;
    private bool InputD = false;
    private bool ClockSignal = false;
    private bool LatchQ = false;

    private bool GateAnd => InputA && InputB;
    private bool GateOr => InputA || InputB;
    private bool GateNotA => !InputA;
    private bool GateNand => !(InputA && InputB);
    private bool GateNor => !(InputA || InputB);
    private bool GateXor => InputA ^ InputB;

    private bool HalfAdderSum => InputA ^ InputB;
    private bool HalfAdderCarry => InputA && InputB;

    private bool FullAdderSum => InputA ^ InputB ^ InputCin;
    private bool FullAdderCout => (InputA && InputB) || (InputCin && (InputA ^ InputB));

