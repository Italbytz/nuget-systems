@namespace Italbytz.Systems.Blazor.Components.ComputingSystems
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="logic-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Grundlagen der Informatik &bull; Schaltnetze &amp; Schaltwerke</p>
            <h2>Logikgatter- &amp; Schaltungssimulator (Logic Circuit Simulator)</h2>
            <p class="feature-intro">
                Interaktive Simulation elementarer Logikgatter, kombinatorischer Schaltnetze (Halb-/Volladdierer, 4-zu-1 Multiplexer) 
                und sequentieller Speicherglieder (D-Latch) mit Signalfluss und Wertetabellen.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Simulator &amp; Gatter-Schaltungen
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Circuit Selector Tabs -->
        <div class="circuit-tabs no-print">
            <button class="circuit-tab @(SelectedCircuit == CircuitType.Multiplexer ? "active" : "")" @onclick="() => SetCircuit(CircuitType.Multiplexer)">
                🔀 4-zu-1 Multiplexer
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.Gates ? "active" : "")" @onclick="() => SetCircuit(CircuitType.Gates)">
                Elementare Gatter
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.HalfAdder ? "active" : "")" @onclick="() => SetCircuit(CircuitType.HalfAdder)">
                Halbaddierer
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.FullAdder ? "active" : "")" @onclick="() => SetCircuit(CircuitType.FullAdder)">
                Volladdierer (1-Bit)
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.DLatch ? "active" : "")" @onclick="() => SetCircuit(CircuitType.DLatch)">
                D-Latch (Speicher)
            </button>
        </div>

        @if (SelectedCircuit == CircuitType.Multiplexer)
        {
            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge badge-mux">4-zu-1 Multiplexer</div>
                    <div class="narrator-title">
                        Steuereingänge: <span class="mono bold purple">S₁=@(MuxS1 ? "1" : "0"), S₀=@(MuxS0 ? "1" : "0")</span> &rarr;
                        Kanal gewählt: <strong class="blue mono"><em>e</em><sub>@SelectedChannel</sub></strong> &bull;
                        Ausgang: <strong class="@(MuxOutput ? "emerald" : "red") mono">a = @(MuxOutput ? "1" : "0")</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    Die Steuersignale <em>S</em><sub>1</sub>, <em>S</em><sub>0</sub> dekodieren die Binärzahl @SelectedChannel und schalten ausschließlich den Eingang <em>e</em><sub>@SelectedChannel</sub> (Wert @(GetChannelValue(SelectedChannel) ? "1" : "0")) über das zugehörige AND-Gatter und das abschließende OR-Gatter auf den Ausgang <em>a</em> durch.
                </p>
                <div class="logic-metrics-strip">
                    <span>Funktion: <strong class="mono">a = e₀·¬S₁·¬S₀ ∨ e₁·¬S₁·S₀ ∨ e₂·S₁·¬S₀ ∨ e₃·S₁·S₀</strong></span>
                    <span>Aktiver Pfad: <strong class="mono emerald">Kanal <em>e</em><sub>@SelectedChannel</sub> (@(GetChannelValue(SelectedChannel) ? "HIGH" : "LOW"))</strong></span>
                </div>
            </div>

            <!-- Main Display: Interactive Schematic & Table -->
            <div class="main-display-grid">

                <!-- Left: Interactive Schematic SVG -->
                <div class="circuit-card">
                    <div class="circuit-card-header">
                        <h3>Schaltplan (Klick auf Signale toggelt Pegel)</h3>
                    </div>

                    <!-- Input Controls Toolbar -->
                    <div class="mux-toolbar">
                        <div class="mux-group">
                            <span class="toolbar-label">Steuerung (<em>S</em>):</span>
                            <button class="toggle-btn @(MuxS1 ? "high" : "low")" @onclick="() => MuxS1 = !MuxS1">
                                S₁: <strong>@(MuxS1 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxS0 ? "high" : "low")" @onclick="() => MuxS0 = !MuxS0">
                                S₀: <strong>@(MuxS0 ? "1" : "0")</strong>
                            </button>
                        </div>

                        <div class="mux-group">
                            <span class="toolbar-label">Daten (<em>e</em>):</span>
                            <button class="toggle-btn @(MuxE0 ? "high" : "low")" @onclick="() => MuxE0 = !MuxE0">
                                e₀: <strong>@(MuxE0 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxE1 ? "high" : "low")" @onclick="() => MuxE1 = !MuxE1">
                                e₁: <strong>@(MuxE1 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxE2 ? "high" : "low")" @onclick="() => MuxE2 = !MuxE2">
                                e₂: <strong>@(MuxE2 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxE3 ? "high" : "low")" @onclick="() => MuxE3 = !MuxE3">
                                e₃: <strong>@(MuxE3 ? "1" : "0")</strong>
                            </button>
                        </div>
                    </div>

                    <div class="svg-container">
                        <svg viewBox="0 0 680 360" class="circuit-svg" xmlns="http://www.w3.org/2000/svg">
                            @{
                                bool ctrlS1 = MuxS1;
                                bool ctrlS1_not = !MuxS1;
                                bool ctrlS0 = MuxS0;
                                bool ctrlS0_not = !MuxS0;
                            }

                            <!-- =================================================== -->
                            <!-- Control Inputs & NOT Gates at the top               -->
                            <!-- =================================================== -->
                            <!-- S1 Direct Bus -->
                            <text x="115" y="14" class="pin-label purple mono bold" text-anchor="middle">S₁</text>
                            <line x1="115" y1="20" x2="115" y2="340" class="wire @(ctrlS1 ? "wire-high" : "wire-low")" />

                            <!-- S1 Tap to NOT Gate 1 -->
                            <circle cx="115" cy="38" r="3.5" class="wire-dot @(ctrlS1 ? "dot-high" : "dot-low")" />
                            <line x1="115" y1="38" x2="135" y2="38" class="wire @(ctrlS1 ? "wire-high" : "wire-low")" />

                            <!-- NOT Gate 1 for S1 -->
                            <rect x="135" y="24" width="24" height="28" rx="3" class="gate-box @(ctrlS1_not ? "gate-selected" : "")" />
                            <text x="147" y="38" class="gate-box-text" font-size="12">1</text>
                            <circle cx="163" cy="38" r="3.5" class="inversion-bubble @(ctrlS1_not ? "bubble-high" : "bubble-low")" />

                            <!-- S1 Inverted Bus (¬S1) -->
                            <line x1="166.5" y1="38" x2="170" y2="38" class="wire @(ctrlS1_not ? "wire-high" : "wire-low")" />
                            <line x1="170" y1="20" x2="170" y2="340" class="wire @(ctrlS1_not ? "wire-high" : "wire-low")" />
                            <text x="170" y="14" class="pin-label purple mono bold" text-anchor="middle">¬S₁</text>

                            <!-- S0 Direct Bus -->
                            <text x="225" y="14" class="pin-label purple mono bold" text-anchor="middle">S₀</text>
                            <line x1="225" y1="20" x2="225" y2="340" class="wire @(ctrlS0 ? "wire-high" : "wire-low")" />

                            <!-- S0 Tap to NOT Gate 2 -->
                            <circle cx="225" cy="38" r="3.5" class="wire-dot @(ctrlS0 ? "dot-high" : "dot-low")" />
                            <line x1="225" y1="38" x2="245" y2="38" class="wire @(ctrlS0 ? "wire-high" : "wire-low")" />

                            <!-- NOT Gate 2 for S0 -->
                            <rect x="245" y="24" width="24" height="28" rx="3" class="gate-box @(ctrlS0_not ? "gate-selected" : "")" />
                            <text x="257" y="38" class="gate-box-text" font-size="12">1</text>
                            <circle cx="273" cy="38" r="3.5" class="inversion-bubble @(ctrlS0_not ? "bubble-high" : "bubble-low")" />

                            <!-- S0 Inverted Bus (¬S0) -->
                            <line x1="276.5" y1="38" x2="280" y2="38" class="wire @(ctrlS0_not ? "wire-high" : "wire-low")" />
                            <line x1="280" y1="20" x2="280" y2="340" class="wire @(ctrlS0_not ? "wire-high" : "wire-low")" />
                            <text x="280" y="14" class="pin-label purple mono bold" text-anchor="middle">¬S₀</text>

                            <!-- =================================================== -->
                            <!-- 4 AND Gates & Inputs                                -->
                            <!-- =================================================== -->
                            @{
                                int[] yCenters = new int[] { 80, 150, 220, 290 };
                                int[] orPinY = new int[] { 150, 173, 197, 220 };
                            }

                            @for (int i = 0; i < 4; i++)
                            {
                                int idx = i;
                                int yCenter = yCenters[idx];
                                int pinDataY = yCenter - 12;
                                int pinS1Y = yCenter;
                                int pinS0Y = yCenter + 12;

                                bool isSelected = idx == SelectedChannel;
                                bool dataVal = GetChannelValue(idx);
                                bool outVal = isSelected && dataVal;

                                int s1TapX = (idx < 2) ? 170 : 115;
                                bool s1Val = (idx < 2) ? ctrlS1_not : ctrlS1;

                                int s0TapX = (idx % 2 == 0) ? 280 : 225;
                                bool s0Val = (idx % 2 == 0) ? ctrlS0_not : ctrlS0;

                                <!-- Data line e[i] -->
                                @((MarkupString)$"<text x=\"28\" y=\"{pinDataY}\" text-anchor=\"end\" class=\"pin-label mono bold {(dataVal ? "emerald" : "")}\">e{ToSubscript(idx)}</text>")
                                <line x1="35" y1="@pinDataY" x2="340" y2="@pinDataY" class="wire @(dataVal ? "wire-high" : "wire-low")" />

                                <!-- S1 tap line -->
                                <circle cx="@s1TapX" cy="@pinS1Y" r="3.5" class="wire-dot @(s1Val ? "dot-high" : "dot-low")" />
                                <line x1="@s1TapX" y1="@pinS1Y" x2="340" y2="@pinS1Y" class="wire @(s1Val ? "wire-high" : "wire-low")" />

                                <!-- S0 tap line -->
                                <circle cx="@s0TapX" cy="@pinS0Y" r="3.5" class="wire-dot @(s0Val ? "dot-high" : "dot-low")" />
                                <line x1="@s0TapX" y1="@pinS0Y" x2="340" y2="@pinS0Y" class="wire @(s0Val ? "wire-high" : "wire-low")" />

                                <!-- AND Gate Box -->
                                <rect x="340" y="@(yCenter - 20)" width="55" height="40" rx="4" class="gate-box @(isSelected ? "gate-selected" : "")" />
                                @((MarkupString)$"<text x=\"367\" y=\"{yCenter}\" class=\"gate-box-text\">&amp;</text>")

                                <!-- Output to OR gate -->
                                <path d="M 395 @yCenter C 440 @yCenter, 440 @orPinY[idx], 480 @orPinY[idx]" class="wire @(outVal ? "wire-high" : "wire-low")" />
                            }

                            <!-- =================================================== -->
                            <!-- OR Gate & Output                                    -->
                            <!-- =================================================== -->
                            <rect x="480" y="135" width="65" height="100" rx="6" class="gate-box @(MuxOutput ? "gate-selected" : "")" />
                            <text x="512" y="185" class="gate-box-text" font-size="16">≥1</text>

                            <!-- Output line a -->
                            <line x1="545" y1="185" x2="610" y2="185" class="wire @(MuxOutput ? "wire-high" : "wire-low")" stroke-width="3.5" />
                            <text x="620" y="185" class="pin-label mono bold @(MuxOutput ? "emerald" : "red")">a = @(MuxOutput ? "1" : "0")</text>
                        </svg>
                    </div>
                </div>

                <!-- Right: Truth Table -->
                <div class="table-card">
                    <div class="table-card-header">
                        <h3>Wahrheitstafel (Ausschnitt)</h3>
                    </div>

                    <div class="table-responsive">
                        <table class="interactive-truth-table">
                            <thead>
                                <tr>
                                    <th><em>S</em><sub>1</sub></th>
                                    <th><em>S</em><sub>0</sub></th>
                                    <th><em>e</em><sub>0</sub></th>
                                    <th><em>e</em><sub>1</sub></th>
                                    <th><em>e</em><sub>2</sub></th>
                                    <th><em>e</em><sub>3</sub></th>
                                    <th class="th-out">Ausgang <em>a</em></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int s1 = 0; s1 <= 1; s1++)
                                {
                                    for (int s0 = 0; s0 <= 1; s0++)
                                    {
                                        int ch = (s1 << 1) | s0;
                                        bool isCurrentRow = (MuxS1 ? 1 : 0) == s1 && (MuxS0 ? 1 : 0) == s0;

                                        <tr class="@(isCurrentRow ? "table-row-active" : "")">
                                            <td class="mono bold purple">@s1</td>
                                            <td class="mono bold purple">@s0</td>
                                            <td class="mono">@(ch == 0 ? "e₀" : "–")</td>
                                            <td class="mono">@(ch == 1 ? "e₁" : "–")</td>
                                            <td class="mono">@(ch == 2 ? "e₂" : "–")</td>
                                            <td class="mono">@(ch == 3 ? "e₃" : "–")</td>
                                            <td class="mono bold @(isCurrentRow ? (MuxOutput ? "emerald" : "red") : "")">
                                                <strong><em>e</em><sub>@ch</sub></strong>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="circuit-summary-box">
                        <div class="summary-item">
                            <span>Ausgewählter Eingang:</span>
                            <strong class="mono blue"><em>e</em><sub>@SelectedChannel</sub> (@(GetChannelValue(SelectedChannel) ? "1" : "0"))</strong>
                        </div>
                        <div class="summary-item">
                            <span>Ausgangspegel <em>a</em>:</span>
                            <strong class="mono @(MuxOutput ? "emerald" : "red")">@(MuxOutput ? "1 (HIGH)" : "0 (LOW)")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }
        else if (SelectedCircuit == CircuitType.Gates)
        {
            <!-- Basic Gates Grid -->
            <div class="gates-grid">
                <div class="inputs-bar">
                    <span class="bar-label">Eingangssignale:</span>
                    <button class="toggle-btn @(InputA ? "high" : "low")" @onclick="() => InputA = !InputA">
                        Eingang A: <strong>@(InputA ? "1" : "0")</strong>
                    </button>
                    <button class="toggle-btn @(InputB ? "high" : "low")" @onclick="() => InputB = !InputB">
                        Eingang B: <strong>@(InputB ? "1" : "0")</strong>
                    </button>
                </div>

                <div class="gates-showcase">
                    <div class="gate-card">
                        <div class="gate-name">AND (Konjunktion)</div>
                        <div class="gate-formula mono">Y = A ∧ B</div>
                        <div class="gate-output-pill @(GateAnd ? "high" : "low")">
                            Ausgang Y = <strong>@(GateAnd ? "1" : "0")</strong>
                        </div>
                    </div>
                    <div class="gate-card">
                        <div class="gate-name">OR (Disjunktion)</div>
                        <div class="gate-formula mono">Y = A ∨ B</div>
                        <div class="gate-output-pill @(GateOr ? "high" : "low")">
                            Ausgang Y = <strong>@(GateOr ? "1" : "0")</strong>
                        </div>
                    </div>
                    <div class="gate-card">
                        <div class="gate-name">NOT (Invertierung)</div>
                        <div class="gate-formula mono">Y = ¬A</div>
                        <div class="gate-output-pill @(GateNotA ? "high" : "low")">
                            Ausgang Y = <strong>@(GateNotA ? "1" : "0")</strong>
                        </div>
                    </div>
                    <div class="gate-card">
                        <div class="gate-name">NAND (Sheffer)</div>
                        <div class="gate-formula mono">Y = ¬(A ∧ B)</div>
                        <div class="gate-output-pill @(GateNand ? "high" : "low")">
                            Ausgang Y = <strong>@(GateNand ? "1" : "0")</strong>
                        </div>
                    </div>
                    <div class="gate-card">
                        <div class="gate-name">NOR (Peirce)</div>
                        <div class="gate-formula mono">Y = ¬(A ∨ B)</div>
                        <div class="gate-output-pill @(GateNor ? "high" : "low")">
                            Ausgang Y = <strong>@(GateNor ? "1" : "0")</strong>
                        </div>
                    </div>
                    <div class="gate-card">
                        <div class="gate-name">XOR (Antivalenz)</div>
                        <div class="gate-formula mono">Y = A ⊕ B</div>
                        <div class="gate-output-pill @(GateXor ? "high" : "low")">
                            Ausgang Y = <strong>@(GateXor ? "1" : "0")</strong>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (SelectedCircuit == CircuitType.HalfAdder)
        {
            <div class="gates-grid">
                <div class="inputs-bar">
                    <span class="bar-label">Eingangssignale:</span>
                    <button class="toggle-btn @(InputA ? "high" : "low")" @onclick="() => InputA = !InputA">A: @(InputA ? "1" : "0")</button>
                    <button class="toggle-btn @(InputB ? "high" : "low")" @onclick="() => InputB = !InputB">B: @(InputB ? "1" : "0")</button>
                </div>
                <div class="circuit-summary-box">
                    <div class="summary-item"><span>Summe S (A ⊕ B):</span><strong class="mono emerald">@(HalfAdderSum ? "1" : "0")</strong></div>
                    <div class="summary-item"><span>Übertrag C (A ∧ B):</span><strong class="mono blue">@(HalfAdderCarry ? "1" : "0")</strong></div>
                </div>
            </div>
        }
        else if (SelectedCircuit == CircuitType.FullAdder)
        {
            <div class="gates-grid">
                <div class="inputs-bar">
                    <span class="bar-label">Eingangssignale:</span>
                    <button class="toggle-btn @(InputA ? "high" : "low")" @onclick="() => InputA = !InputA">A: @(InputA ? "1" : "0")</button>
                    <button class="toggle-btn @(InputB ? "high" : "low")" @onclick="() => InputB = !InputB">B: @(InputB ? "1" : "0")</button>
                    <button class="toggle-btn @(InputCin ? "high" : "low")" @onclick="() => InputCin = !InputCin">C_in: @(InputCin ? "1" : "0")</button>
                </div>
                <div class="circuit-summary-box">
                    <div class="summary-item"><span>Summe S:</span><strong class="mono emerald">@(FullAdderSum ? "1" : "0")</strong></div>
                    <div class="summary-item"><span>Übertrag C_out:</span><strong class="mono blue">@(FullAdderCout ? "1" : "0")</strong></div>
                </div>
            </div>
        }
        else if (SelectedCircuit == CircuitType.DLatch)
        {
            <div class="gates-grid">
                <div class="inputs-bar">
                    <span class="bar-label">Signale:</span>
                    <button class="toggle-btn @(InputD ? "high" : "low")" @onclick="ToggleD">D: @(InputD ? "1" : "0")</button>
                    <button class="toggle-btn @(ClockSignal ? "high" : "low")" @onclick="ToggleClock">Clock (Takt): @(ClockSignal ? "1" : "0")</button>
                </div>
                <div class="circuit-summary-box">
                    <div class="summary-item"><span>Gespeicherter Zustand Q:</span><strong class="mono emerald">@(LatchQ ? "1" : "0")</strong></div>
                    <div class="summary-item"><span>Invertiert ¬Q:</span><strong class="mono red">@(!LatchQ ? "1" : "0")</strong></div>
                </div>
            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- WORKSHEET VIEW (1:1 EXAM REPLICA)                                         -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">

            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-block">
                    <span class="exam-sub">Grundlagen der Informatik &bull; Schaltnetze</span>
                    <h1 class="exam-main-title">Übungs- und Klausuraufgabe: Logikgatter &amp; Schaltungen</h1>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Seite drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Fields -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 8 P.</div>
                </div>
            </div>

            <!-- Intro text matching TILogicCircuit.tex -->
            <div class="task-prompt-box">
                <p class="task-text">
                    Betrachten Sie folgende kombinatorische Schaltung mit zwei Steuereingängen <em>S</em><sub>1</sub>, <em>S</em><sub>0</sub>, 
                    vier Dateneingängen <em>e</em><sub>0</sub>, <em>e</em><sub>1</sub>, <em>e</em><sub>2</sub>, <em>e</em><sub>3</sub> und einem Ausgang <em>a</em>:
                </p>
            </div>

            <!-- Schematic Box -->
            <div class="ws-diagram-center">
                <svg viewBox="0 0 680 360" class="ws-svg-exam" xmlns="http://www.w3.org/2000/svg">
                    <!-- S1 line and NOT gate -->
                    <text x="115" y="14" class="ws-svg-txt font-bold" text-anchor="middle">S₁</text>
                    <line x1="115" y1="20" x2="115" y2="340" stroke="#000" stroke-width="1.5" />
                    <circle cx="115" cy="38" r="3" fill="#000" />
                    <line x1="115" y1="38" x2="135" y2="38" stroke="#000" stroke-width="1.5" />
                    <rect x="135" y="24" width="24" height="28" fill="#fff" stroke="#000" stroke-width="1.5" />
                    <text x="147" y="38" text-anchor="middle" dominant-baseline="central" class="ws-svg-txt" font-size="12">1</text>
                    <circle cx="163" cy="38" r="3.5" fill="#fff" stroke="#000" stroke-width="1.5" />
                    <line x1="166.5" y1="38" x2="170" y2="38" stroke="#000" stroke-width="1.5" />
                    <line x1="170" y1="20" x2="170" y2="340" stroke="#000" stroke-width="1.5" />
                    <text x="170" y="14" class="ws-svg-txt font-bold" text-anchor="middle">¬S₁</text>

                    <!-- S0 line and NOT gate -->
                    <text x="225" y="14" class="ws-svg-txt font-bold" text-anchor="middle">S₀</text>
                    <line x1="225" y1="20" x2="225" y2="340" stroke="#000" stroke-width="1.5" />
                    <circle cx="225" cy="38" r="3" fill="#000" />
                    <line x1="225" y1="38" x2="245" y2="38" stroke="#000" stroke-width="1.5" />
                    <rect x="245" y="24" width="24" height="28" fill="#fff" stroke="#000" stroke-width="1.5" />
                    <text x="257" y="38" text-anchor="middle" dominant-baseline="central" class="ws-svg-txt" font-size="12">1</text>
                    <circle cx="273" cy="38" r="3.5" fill="#fff" stroke="#000" stroke-width="1.5" />
                    <line x1="276.5" y1="38" x2="280" y2="38" stroke="#000" stroke-width="1.5" />
                    <line x1="280" y1="20" x2="280" y2="340" stroke="#000" stroke-width="1.5" />
                    <text x="280" y="14" class="ws-svg-txt font-bold" text-anchor="middle">¬S₀</text>

                    @{
                        int[] wsYCenters = new int[] { 80, 150, 220, 290 };
                        int[] wsOrPinY = new int[] { 150, 173, 197, 220 };
                    }

                    @for (int i = 0; i < 4; i++)
                    {
                        int idx = i;
                        int yCenter = wsYCenters[idx];
                        int pinDataY = yCenter - 12;
                        int pinS1Y = yCenter;
                        int pinS0Y = yCenter + 12;

                        int s1TapX = (idx < 2) ? 170 : 115;
                        int s0TapX = (idx % 2 == 0) ? 280 : 225;

                        <!-- Data line e[i] -->
                        @((MarkupString)$"<text x=\"28\" y=\"{pinDataY}\" text-anchor=\"end\" dominant-baseline=\"central\" class=\"ws-svg-txt font-bold\">e{ToSubscript(idx)}</text>")
                        <line x1="35" y1="@pinDataY" x2="340" y2="@pinDataY" stroke="#000" stroke-width="1.5" />

                        <!-- S1 tap line -->
                        <circle cx="@s1TapX" cy="@pinS1Y" r="3" fill="#000" />
                        <line x1="@s1TapX" y1="@pinS1Y" x2="340" y2="@pinS1Y" stroke="#000" stroke-width="1.5" />

                        <!-- S0 tap line -->
                        <circle cx="@s0TapX" cy="@pinS0Y" r="3" fill="#000" />
                        <line x1="@s0TapX" y1="@pinS0Y" x2="340" y2="@pinS0Y" stroke="#000" stroke-width="1.5" />

                        <!-- AND Gate Box -->
                        <rect x="340" y="@(yCenter - 20)" width="55" height="40" rx="4" fill="#fff" stroke="#000" stroke-width="1.5" />
                        @((MarkupString)$"<text x=\"367\" y=\"{yCenter}\" text-anchor=\"middle\" dominant-baseline=\"central\" class=\"ws-svg-txt font-bold\">&amp;</text>")

                        <!-- Output to OR gate -->
                        <path d="M 395 @yCenter C 440 @yCenter, 440 @wsOrPinY[idx], 480 @wsOrPinY[idx]" stroke="#000" stroke-width="1.5" fill="none" />
                    }

                    <!-- OR Gate -->
                    <rect x="480" y="135" width="65" height="100" rx="6" fill="#fff" stroke="#000" stroke-width="1.5" />
                    <text x="512" y="185" text-anchor="middle" dominant-baseline="central" class="ws-svg-txt font-bold" font-size="16">≥1</text>

                    <!-- Output line a -->
                    <line x1="545" y1="185" x2="615" y2="185" stroke="#000" stroke-width="2" />
                    <text x="625" y="185" dominant-baseline="central" class="ws-svg-txt font-bold">a</text>
                </svg>
            </div>

            <!-- Teilaufgabe 1 -->
            <div class="task-section">
                <div class="task-sub-title">
                    <span>Teilaufgabe 1 (2 Punkte)</span>
                </div>
                <p class="task-text">
                    Formulieren Sie die Schaltung als boolesche Funktion <em>a</em> = <em>f</em>(<em>S</em><sub>1</sub>, <em>S</em><sub>0</sub>, <em>e</em><sub>0</sub>, <em>e</em><sub>1</sub>, <em>e</em><sub>2</sub>, <em>e</em><sub>3</sub>):
                </p>

                @if (ShowSolution)
                {
                    <div class="ws-solution-box">
                        <div class="sol-formula-line mono bold emerald">
                            <em>a</em> = <em>e</em><sub>0</sub>·<span style="text-decoration: overline"><em>S</em><sub>1</sub></span>·<span style="text-decoration: overline"><em>S</em><sub>0</sub></span> &or; <em>e</em><sub>1</sub>·<span style="text-decoration: overline"><em>S</em><sub>1</sub></span>·<em>S</em><sub>0</sub> &or; <em>e</em><sub>2</sub>·<em>S</em><sub>1</sub>·<span style="text-decoration: overline"><em>S</em><sub>0</sub></span> &or; <em>e</em><sub>3</sub>·<em>S</em><sub>1</sub>·<em>S</em><sub>0</sub>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ws-formula-blank">
                        <span class="mono bold">a = </span>
                        <div class="blank-line-long"></div>
                    </div>
                }
            </div>

            <!-- Teilaufgabe 2 -->
            <div class="task-section">
                <div class="task-sub-title">
                    <span>Teilaufgabe 2 (4 Punkte)</span>
                </div>
                <p class="task-text">
                    Ermitteln Sie einen Teil der Wertetabelle, indem Sie die fehlenden Ausgangswerte <em>a</em> eintragen:
                </p>

                <div class="ws-table-container">
                    <table class="ws-matrix-table">
                        <thead>
                            <tr>
                                <th><em>S</em><sub>1</sub></th>
                                <th><em>S</em><sub>0</sub></th>
                                <th><em>e</em><sub>0</sub></th>
                                <th><em>e</em><sub>1</sub></th>
                                <th><em>e</em><sub>2</sub></th>
                                <th><em>e</em><sub>3</sub></th>
                                <th class="ws-th-highlight"><em>a</em></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in ExamTableRows)
                            {
                                <tr>
                                    <td class="mono">@row.S1</td>
                                    <td class="mono">@row.S0</td>
                                    <td class="mono">@row.E0</td>
                                    <td class="mono">@row.E1</td>
                                    <td class="mono">@row.E2</td>
                                    <td class="mono">@row.E3</td>
                                    <td class="mono bold @(ShowSolution ? (row.ExpectedA == 1 ? "ws-val-one" : "ws-val-zero") : "ws-blank-slot")">
                                        @(ShowSolution ? row.ExpectedA.ToString() : "")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Teilaufgabe 3 -->
            <div class="task-section">
                <div class="task-sub-title">
                    <span>Teilaufgabe 3 (2 Punkte)</span>
                </div>
                <p class="task-text">
                    Wie heißt diese Schaltung?
                </p>

                @if (ShowSolution)
                {
                    <div class="ws-solution-box">
                        <p class="sol-para mono bold emerald">
                            Multiplexer (4-zu-1 Multiplexer / MUX)
                        </p>
                    </div>
                }
                else
                {
                    <div class="ws-formula-blank">
                        <span class="mono">Antwort: </span>
                        <div class="blank-line-long"></div>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="exam-footer">
                <div class="exam-footer-note">
                    Hinweis: Ein Multiplexer schaltet genau ein Datensignal aus mehreren Eingängen auf einen einzigen Ausgang durch, gesteuert durch die Adressleitungen.
                </div>
            </div>

        </div>
    }

</article>

@code {
    public enum ViewMode { Simulator, Worksheet }
    private enum CircuitType { Multiplexer, Gates, HalfAdder, FullAdder, DLatch }

    [Parameter] public string? View { get; set; }
    [Parameter] public bool? SolutionParam { get; set; }
    [Parameter] public bool? Embed { get; set; }

    [SupplyParameterFromQuery(Name = "circuit")] public string? QueryCircuit { get; set; }

    private ViewMode ActiveView = ViewMode.Simulator;
    private CircuitType SelectedCircuit = CircuitType.Multiplexer;
    private bool ShowSolution = false;
    private bool IsEmbed = false;

    // Multiplexer state
    private bool MuxS1 = false;
    private bool MuxS0 = false;
    private bool MuxE0 = true;
    private bool MuxE1 = false;
    private bool MuxE2 = false;
    private bool MuxE3 = false;

    private int SelectedChannel => ((MuxS1 ? 1 : 0) << 1) | (MuxS0 ? 1 : 0);

    private bool GetChannelValue(int ch) => ch switch
    {
        0 => MuxE0,
        1 => MuxE1,
        2 => MuxE2,
        3 => MuxE3,
        _ => false
    };

    private bool MuxOutput => GetChannelValue(SelectedChannel);

    private static string ToSubscript(int number) => number switch
    {
        0 => "₀",
        1 => "₁",
        2 => "₂",
        3 => "₃",
        4 => "₄",
        5 => "₅",
        6 => "₆",
        7 => "₇",
        8 => "₈",
        9 => "₉",
        _ => number.ToString()
    };

    // Basic Gates state
    private bool InputA = false;
    private bool InputB = false;
    private bool InputCin = false;
    private bool InputD = false;
    private bool ClockSignal = false;
    private bool LatchQ = false;

    private bool GateAnd => InputA && InputB;
    private bool GateOr => InputA || InputB;
    private bool GateNotA => !InputA;
    private bool GateNand => !(InputA && InputB);
    private bool GateNor => !(InputA || InputB);
    private bool GateXor => InputA ^ InputB;

    private bool HalfAdderSum => InputA ^ InputB;
    private bool HalfAdderCarry => InputA && InputB;

    private bool FullAdderSum => InputA ^ InputB ^ InputCin;
    private bool FullAdderCout => (InputA && InputB) || (InputCin && (InputA ^ InputB));

    public class ExamRow
    {
        public int S1 { get; set; }
        public int S0 { get; set; }
        public int E0 { get; set; }
        public int E1 { get; set; }
        public int E2 { get; set; }
        public int E3 { get; set; }
        public int ExpectedA { get; set; }
    }

    private List<ExamRow> ExamTableRows = new()
    {
        new ExamRow { S1 = 0, S0 = 0, E0 = 0, E1 = 0, E2 = 0, E3 = 0, ExpectedA = 0 },
        new ExamRow { S1 = 0, S0 = 0, E0 = 1, E1 = 0, E2 = 0, E3 = 0, ExpectedA = 1 },
        new ExamRow { S1 = 0, S0 = 1, E0 = 0, E1 = 0, E2 = 0, E3 = 0, ExpectedA = 0 },
        new ExamRow { S1 = 0, S0 = 1, E0 = 0, E1 = 1, E2 = 0, E3 = 0, ExpectedA = 1 },
        new ExamRow { S1 = 1, S0 = 0, E0 = 0, E1 = 0, E2 = 0, E3 = 0, ExpectedA = 0 },
        new ExamRow { S1 = 1, S0 = 0, E0 = 0, E1 = 0, E2 = 1, E3 = 0, ExpectedA = 1 },
        new ExamRow { S1 = 1, S0 = 1, E0 = 0, E1 = 0, E2 = 0, E3 = 0, ExpectedA = 0 },
        new ExamRow { S1 = 1, S0 = 1, E0 = 0, E1 = 0, E2 = 0, E3 = 1, ExpectedA = 1 },
    };

    protected override void OnInitialized()
    {
        ReadQueryParameters();
    }

    protected override void OnParametersSet()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (!string.IsNullOrEmpty(query))
            {
                if (query.Contains("view=worksheet", StringComparison.OrdinalIgnoreCase))
                {
                    ActiveView = ViewMode.Worksheet;
                }
                if (query.Contains("solution=true", StringComparison.OrdinalIgnoreCase))
                {
                    ShowSolution = true;
                }
                if (query.Contains("embed=true", StringComparison.OrdinalIgnoreCase) || query.Contains("embedded=true", StringComparison.OrdinalIgnoreCase))
                {
                    IsEmbed = true;
                }
            }

            if (!string.IsNullOrEmpty(QueryCircuit))
            {
                var c = QueryCircuit.ToLowerInvariant();
                if (c.Contains("mux") || c.Contains("multiplexer"))
                {
                    SelectedCircuit = CircuitType.Multiplexer;
                }
                else if (c.Contains("gate"))
                {
                    SelectedCircuit = CircuitType.Gates;
                }
                else if (c.Contains("half"))
                {
                    SelectedCircuit = CircuitType.HalfAdder;
                }
                else if (c.Contains("full"))
                {
                    SelectedCircuit = CircuitType.FullAdder;
                }
                else if (c.Contains("latch"))
                {
                    SelectedCircuit = CircuitType.DLatch;
                }
            }
        }
        catch { }
    }

    private void SetView(ViewMode mode) => ActiveView = mode;
    private void SetCircuit(CircuitType circuit) => SelectedCircuit = circuit;
    private void ToggleSolution() => ShowSolution = !ShowSolution;
    private async Task TriggerPrint() => await JSRuntime.InvokeVoidAsync("window.print");

    private void ToggleD()
    {
        InputD = !InputD;
        if (ClockSignal) LatchQ = InputD;
    }

    private void ToggleClock()
    {
        ClockSignal = !ClockSignal;
        if (ClockSignal) LatchQ = InputD;
    }
}
