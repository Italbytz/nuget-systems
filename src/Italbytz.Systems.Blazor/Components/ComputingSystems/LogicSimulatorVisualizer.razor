@namespace Italbytz.Systems.Blazor.Components.ComputingSystems
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="logic-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Grundlagen der Informatik &bull; Schaltnetze &amp; Schaltwerke</p>
            <h2>Logikgatter- &amp; Schaltungssimulator (Logic Circuit Simulator)</h2>
            <p class="feature-intro">
                Interaktive Simulation elementarer Logikgatter, kombinatorischer Schaltnetze (Halb-/Volladdierer, 4-zu-1 Multiplexer) 
                und sequentieller Speicherglieder (D-Latch) mit Signalfluss und Wertetabellen.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Simulator &amp; Gatter-Schaltungen
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht)
            </button>
            <a class="view-btn pdf-link-btn" href="pdf/LogicCircuit_5.pdf" target="_blank" download="LogicCircuit_5.pdf" title="5 Aufgaben zu Standardschaltnetzen (MUX, DEMUX, PLA, Zähler) als druckreifes LaTeX-PDF herunterladen">
                📄 5 Schaltungen (PDF)
            </a>
            <a class="view-btn pdf-link-btn" href="pdf/TruthTable_20.pdf" target="_blank" download="TruthTable_20.pdf" title="20 Wahrheitstabellen-Übungsaufgaben als druckreifes LaTeX-PDF herunterladen">
                📄 20 Wahrheitstabellen (PDF)
            </a>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Circuit Selector Tabs -->
        <div class="circuit-tabs no-print">
            <button class="circuit-tab @(SelectedCircuit == CircuitType.TruthTableCircuit ? "active" : "")" @onclick="() => SetCircuit(CircuitType.TruthTableCircuit)">
                📋 Schaltnetz-Analyse (Aufgabe 1)
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.Multiplexer ? "active" : "")" @onclick="() => SetCircuit(CircuitType.Multiplexer)">
                🔀 4-zu-1 Multiplexer
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.Demultiplexer ? "active" : "")" @onclick="() => SetCircuit(CircuitType.Demultiplexer)">
                🔄 1-zu-4 Demultiplexer
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.SevenSegment ? "active" : "")" @onclick="() => SetCircuit(CircuitType.SevenSegment)">
                🔢 7-Segment-Decoder
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.Counter ? "active" : "")" @onclick="() => SetCircuit(CircuitType.Counter)">
                ⏱️ 3-Bit-Synchronzähler
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.Gates ? "active" : "")" @onclick="() => SetCircuit(CircuitType.Gates)">
                Elementare Gatter
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.HalfAdder ? "active" : "")" @onclick="() => SetCircuit(CircuitType.HalfAdder)">
                Halbaddierer
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.FullAdder ? "active" : "")" @onclick="() => SetCircuit(CircuitType.FullAdder)">
                Volladdierer (1-Bit)
            </button>
            <button class="circuit-tab @(SelectedCircuit == CircuitType.DLatch ? "active" : "")" @onclick="() => SetCircuit(CircuitType.DLatch)">
                D-Latch (Speicher)
            </button>
        </div>

        @if (SelectedCircuit == CircuitType.TruthTableCircuit)
        {
            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge badge-mux">Schaltnetz-Analyse &bull; Aufgabe 1</div>
                    <div class="narrator-title">
                        Eingänge: <span class="mono bold purple">x₀=@(CircuitX0 ? "1" : "0"), x₁=@(CircuitX1 ? "1" : "0"), x₂=@(CircuitX2 ? "1" : "0")</span> &rarr;
                        Ausgang: <strong class="@(CircuitY ? "emerald" : "red") mono">y = @(CircuitY ? "1" : "0")</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    Dieses Schaltnetz analysiert drei Eingangsvariablen. Auffällig: Der obere Pfad bildet (<em>x</em><sub>2</sub> ∧ ¬<em>x</em><sub>0</sub>) ∧ <em>x</em><sub>0</sub> = 0 (Gesetz des Widerspruchs: ¬<em>x</em><sub>0</sub> ∧ <em>x</em><sub>0</sub> = 0). Der Ausgang wird somit allein durch den unteren Pfad bestimmt: <em>y</em> = 0 ∨ ((<em>x</em><sub>1</sub> ∧ ¬<em>x</em><sub>0</sub>) ∨ <em>x</em><sub>0</sub>) = <em>x</em><sub>1</sub> ∨ <em>x</em><sub>0</sub>. Die Eingangsvariable <em>x</em><sub>2</sub> ist für das Gesamtergebnis redundant.
                </p>
                <div class="logic-metrics-strip">
                    <span>Vollständige Funktion: <strong class="mono">y = ((x₂ ∧ ¬x₀) ∧ x₀) ∨ ((x₁ ∧ ¬x₀) ∨ x₀)</strong></span>
                    <span>Vereinfacht: <strong class="mono blue">y = x₁ ∨ x₀</strong></span>
                    <span>Ausgangspegel: <strong class="mono @(CircuitY ? "emerald" : "red")">y = @(CircuitY ? "1 (HIGH)" : "0 (LOW)")</strong></span>
                </div>
            </div>

            <!-- Main Display: Interactive Schematic & Table -->
            <div class="main-display-grid">

                <!-- Left: Interactive Schematic SVG -->
                <div class="circuit-card">
                    <div class="circuit-card-header">
                        <h3>Schaltplan (Klick auf Eingänge toggelt Pegel)</h3>
                    </div>

                    <!-- Input Controls Toolbar -->
                    <div class="mux-toolbar">
                        <div class="mux-group">
                            <span class="toolbar-label">Eingänge:</span>
                            <button class="toggle-btn @(CircuitX0 ? "high" : "low")" @onclick="() => CircuitX0 = !CircuitX0">
                                x₀: <strong>@(CircuitX0 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(CircuitX1 ? "high" : "low")" @onclick="() => CircuitX1 = !CircuitX1">
                                x₁: <strong>@(CircuitX1 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(CircuitX2 ? "high" : "low")" @onclick="() => CircuitX2 = !CircuitX2">
                                x₂: <strong>@(CircuitX2 ? "1" : "0")</strong>
                            </button>
                        </div>
                    </div>

                    <div class="svg-container">
                        <svg viewBox="20 115 625 285" class="circuit-svg" xmlns="http://www.w3.org/2000/svg">
                            <!-- Input x2 -->
                            <g class="clickable-pin" @onclick="() => CircuitX2 = !CircuitX2" style="cursor: pointer;">
                                <rect x="69" y="125" width="30" height="30" rx="3" class="gate-box @(CircuitX2 ? "gate-selected" : "")" />
                                <circle cx="84" cy="140" r="9" class="wire-dot @(CircuitX2 ? "dot-high" : "dot-low")" />
                                <text text-anchor="end" x="55" y="146" class="pin-label mono bold" font-size="20">x₂</text>
                            </g>
                            <!-- Wire x2 to AND1 -->
                            <line x1="100" y1="140" x2="280" y2="140" class="wire @(CircuitX2 ? "wire-high" : "wire-low")" />

                            <!-- Input x0 -->
                            <g class="clickable-pin" @onclick="() => CircuitX0 = !CircuitX0" style="cursor: pointer;">
                                <rect x="69" y="225" width="30" height="30" rx="3" class="gate-box @(CircuitX0 ? "gate-selected" : "")" />
                                <circle cx="84" cy="240" r="9" class="wire-dot @(CircuitX0 ? "dot-high" : "dot-low")" />
                                <text text-anchor="end" x="55" y="246" class="pin-label mono bold" font-size="20">x₀</text>
                            </g>
                            <!-- Wire x0 to junction 140,240 -->
                            <line x1="100" y1="240" x2="140" y2="240" class="wire @(CircuitX0 ? "wire-high" : "wire-low")" />
                            <circle cx="140" cy="240" r="4" class="wire-dot @(CircuitX0 ? "dot-high" : "dot-low")" />

                            <!-- x0 branches up to AND2 (bottom input at 380,200) and down to OR1 (bottom input at 380,380) -->
                            <line x1="140" y1="240" x2="140" y2="200" class="wire @(CircuitX0 ? "wire-high" : "wire-low")" />
                            <line x1="140" y1="200" x2="380" y2="200" class="wire @(CircuitX0 ? "wire-high" : "wire-low")" />
                            <line x1="140" y1="240" x2="140" y2="380" class="wire @(CircuitX0 ? "wire-high" : "wire-low")" />
                            <line x1="140" y1="380" x2="380" y2="380" class="wire @(CircuitX0 ? "wire-high" : "wire-low")" />

                            <!-- x0 into NOT Gate -->
                            <line x1="140" y1="240" x2="181" y2="240" class="wire @(CircuitX0 ? "wire-high" : "wire-low")" />
                            <rect x="181" y="226" width="24" height="28" rx="2" class="gate-box @(CircuitNotX0 ? "gate-selected" : "")" />
                            <text x="193" y="240" class="gate-box-text" font-size="14">1</text>
                            <circle cx="210" cy="240" r="4.5" class="inversion-bubble @(CircuitNotX0 ? "bubble-high" : "bubble-low")" />

                            <!-- NOT output to junction 240,240 -->
                            <line x1="214.5" y1="240" x2="240" y2="240" class="wire @(CircuitNotX0 ? "wire-high" : "wire-low")" />
                            <circle cx="240" cy="240" r="4" class="wire-dot @(CircuitNotX0 ? "dot-high" : "dot-low")" />

                            <!-- NOT output branches up to AND1 (bottom input at 280,180) and down to AND3 (bottom input at 280,360) -->
                            <line x1="240" y1="240" x2="240" y2="180" class="wire @(CircuitNotX0 ? "wire-high" : "wire-low")" />
                            <line x1="240" y1="180" x2="280" y2="180" class="wire @(CircuitNotX0 ? "wire-high" : "wire-low")" />
                            <line x1="240" y1="240" x2="240" y2="360" class="wire @(CircuitNotX0 ? "wire-high" : "wire-low")" />
                            <line x1="240" y1="360" x2="280" y2="360" class="wire @(CircuitNotX0 ? "wire-high" : "wire-low")" />

                            <!-- Input x1 -->
                            <g class="clickable-pin" @onclick="() => CircuitX1 = !CircuitX1" style="cursor: pointer;">
                                <rect x="69" y="305" width="30" height="30" rx="3" class="gate-box @(CircuitX1 ? "gate-selected" : "")" />
                                <circle cx="84" cy="320" r="9" class="wire-dot @(CircuitX1 ? "dot-high" : "dot-low")" />
                                <text text-anchor="end" x="55" y="326" class="pin-label mono bold" font-size="20">x₁</text>
                            </g>
                            <!-- Wire x1 to AND3 -->
                            <line x1="100" y1="320" x2="280" y2="320" class="wire @(CircuitX1 ? "wire-high" : "wire-low")" />

                            <!-- Gate 1: AND (&) [x2 ∧ ¬x0] -->
                            <rect x="281" y="130" width="58" height="60" rx="3" class="gate-box @(CircuitAnd1 ? "gate-selected" : "")" />
                            <text text-anchor="middle" x="310" y="160" class="gate-box-text" font-size="22">&amp;</text>
                            <line x1="339" y1="160" x2="380" y2="160" class="wire @(CircuitAnd1 ? "wire-high" : "wire-low")" />

                            <!-- Gate 2: AND (&) [(x2 ∧ ¬x0) ∧ x0] -->
                            <rect x="381" y="150" width="58" height="60" rx="3" class="gate-box @(CircuitAnd2 ? "gate-selected" : "")" />
                            <text text-anchor="middle" x="410" y="180" class="gate-box-text" font-size="22">&amp;</text>
                            <path d="M 439,180 L 460,180 L 460,240 L 480,240" class="wire @(CircuitAnd2 ? "wire-high" : "wire-low")" fill="none" />

                            <!-- Gate 3: AND (&) [x1 ∧ ¬x0] -->
                            <rect x="281" y="310" width="58" height="60" rx="3" class="gate-box @(CircuitAnd3 ? "gate-selected" : "")" />
                            <text text-anchor="middle" x="310" y="340" class="gate-box-text" font-size="22">&amp;</text>
                            <line x1="339" y1="340" x2="380" y2="340" class="wire @(CircuitAnd3 ? "wire-high" : "wire-low")" />

                            <!-- Gate 4: OR (≥1) [(x1 ∧ ¬x0) ∨ x0] -->
                            <rect x="381" y="330" width="58" height="60" rx="3" class="gate-box @(CircuitOr1 ? "gate-selected" : "")" />
                            <text text-anchor="middle" x="410" y="360" class="gate-box-text" font-size="20">≥1</text>
                            <path d="M 439,360 L 460,360 L 460,280 L 480,280" class="wire @(CircuitOr1 ? "wire-high" : "wire-low")" fill="none" />

                            <!-- Gate 5: OR (≥1) [Output y] -->
                            <rect x="481" y="230" width="58" height="60" rx="3" class="gate-box @(CircuitY ? "gate-selected" : "")" />
                            <text text-anchor="middle" x="510" y="260" class="gate-box-text" font-size="20">≥1</text>
                            <line x1="539" y1="260" x2="582" y2="260" class="wire @(CircuitY ? "wire-high" : "wire-low")" />

                            <!-- Output pin y -->
                            <circle cx="596" cy="260" r="14" class="inversion-bubble @(CircuitY ? "bubble-high" : "bubble-low")" />
                            <circle cx="596" cy="260" r="8" class="wire-dot @(CircuitY ? "dot-high" : "dot-low")" />
                            <text text-anchor="start" x="618" y="265" class="pin-label mono bold @(CircuitY ? "emerald" : "red")" font-size="22">y</text>
                        </svg>
                    </div>
                </div>

                <!-- Right: Truth Table Card -->
                <div class="table-card">
                    <div class="table-card-header">
                        <h3>Wahrheitstafel (8 Zeilen)</h3>
                    </div>

                    <div class="table-responsive">
                        <table class="interactive-truth-table">
                            <thead>
                                <tr>
                                    <th><em>x</em>₀</th>
                                    <th><em>x</em>₁</th>
                                    <th><em>x</em>₂</th>
                                    <th>Oben (∧)</th>
                                    <th>Unten (∨)</th>
                                    <th class="th-out">Ausgang <em>y</em></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int r = 0; r < 8; r++)
                                {
                                    int rowX0 = (r >> 2) & 1;
                                    int rowX1 = (r >> 1) & 1;
                                    int rowX2 = r & 1;
                                    bool isCurrentRow = (CircuitX0 ? 1 : 0) == rowX0 && (CircuitX1 ? 1 : 0) == rowX1 && (CircuitX2 ? 1 : 0) == rowX2;
                                    int rowOben = 0; // (x2 & !x0 & x0) == 0
                                    int rowUnten = (rowX1 == 1 || rowX0 == 1) ? 1 : 0;
                                    int rowY = (rowX1 == 1 || rowX0 == 1) ? 1 : 0;

                                    <tr class="@(isCurrentRow ? "table-row-active" : "")">
                                        <td class="mono bold purple">@rowX0</td>
                                        <td class="mono bold purple">@rowX1</td>
                                        <td class="mono bold purple">@rowX2</td>
                                        <td class="mono">@rowOben</td>
                                        <td class="mono">@rowUnten</td>
                                        <td class="mono bold @(isCurrentRow ? (rowY == 1 ? "emerald" : "red") : "")">
                                            @rowY
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="circuit-summary-box">
                        <div class="summary-item">
                            <span>Ausgangsvektor <em>y</em>:</span>
                            <strong class="mono blue">(0, 0, 1, 1, 1, 1, 1, 1)</strong>
                        </div>
                        <div class="summary-item">
                            <span>Aktueller Zustand:</span>
                            <strong class="mono @(CircuitY ? "emerald" : "red")">y = @(CircuitY ? "1 (HIGH)" : "0 (LOW)")</strong>
                        </div>
                        <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed #cbd5e1; text-align: center;">
                            <a href="../normal-forms/?values=0,0,1,1,1,1,1,1" target="_blank" style="display: block; text-decoration: none; padding: 0.5rem 0.75rem; background: #8b5cf6; color: white; border-radius: 0.375rem; font-weight: 600; font-size: 0.85rem; transition: background 0.15s ease;">
                                🚀 Weiter zu Aufgabe 2: Normalformen &amp; KV-Diagramme
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        }
        else if (SelectedCircuit == CircuitType.Multiplexer)
        {
            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge badge-mux">4-zu-1 Multiplexer</div>
                    <div class="narrator-title">
                        Steuereingänge: <span class="mono bold purple">S₁=@(MuxS1 ? "1" : "0"), S₀=@(MuxS0 ? "1" : "0")</span> &rarr;
                        Kanal gewählt: <strong class="blue mono"><em>e</em><sub>@SelectedChannel</sub></strong> &bull;
                        Ausgang: <strong class="@(MuxOutput ? "emerald" : "red") mono">a = @(MuxOutput ? "1" : "0")</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    Die Steuersignale <em>S</em><sub>1</sub>, <em>S</em><sub>0</sub> dekodieren die Binärzahl @SelectedChannel und schalten ausschließlich den Eingang <em>e</em><sub>@SelectedChannel</sub> (Wert @(GetChannelValue(SelectedChannel) ? "1" : "0")) über das zugehörige AND-Gatter und das abschließende OR-Gatter auf den Ausgang <em>a</em> durch.
                </p>
                <div class="logic-metrics-strip">
                    <span>Funktion: <strong class="mono">a = e₀·¬S₁·¬S₀ ∨ e₁·¬S₁·S₀ ∨ e₂·S₁·¬S₀ ∨ e₃·S₁·S₀</strong></span>
                    <span>Aktiver Pfad: <strong class="mono emerald">Kanal <em>e</em><sub>@SelectedChannel</sub> (@(GetChannelValue(SelectedChannel) ? "HIGH" : "LOW"))</strong></span>
                </div>
            </div>

            <!-- Main Display: Interactive Schematic & Table -->
            <div class="main-display-grid">

                <!-- Left: Interactive Schematic SVG -->
                <div class="circuit-card">
                    <div class="circuit-card-header">
                        <h3>Schaltplan (Klick auf Signale toggelt Pegel)</h3>
                    </div>

                    <!-- Input Controls Toolbar -->
                    <div class="mux-toolbar">
                        <div class="mux-group">
                            <span class="toolbar-label">Steuerung (<em>S</em>):</span>
                            <button class="toggle-btn @(MuxS1 ? "high" : "low")" @onclick="() => MuxS1 = !MuxS1">
                                S₁: <strong>@(MuxS1 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxS0 ? "high" : "low")" @onclick="() => MuxS0 = !MuxS0">
                                S₀: <strong>@(MuxS0 ? "1" : "0")</strong>
                            </button>
                        </div>

                        <div class="mux-group">
                            <span class="toolbar-label">Daten (<em>e</em>):</span>
                            <button class="toggle-btn @(MuxE0 ? "high" : "low")" @onclick="() => MuxE0 = !MuxE0">
                                e₀: <strong>@(MuxE0 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxE1 ? "high" : "low")" @onclick="() => MuxE1 = !MuxE1">
                                e₁: <strong>@(MuxE1 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxE2 ? "high" : "low")" @onclick="() => MuxE2 = !MuxE2">
                                e₂: <strong>@(MuxE2 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(MuxE3 ? "high" : "low")" @onclick="() => MuxE3 = !MuxE3">
                                e₃: <strong>@(MuxE3 ? "1" : "0")</strong>
                            </button>
                        </div>
                    </div>

                    <div class="svg-container">
                        <svg viewBox="0 0 680 360" class="circuit-svg" xmlns="http://www.w3.org/2000/svg">
                            @{
                                bool ctrlS1 = MuxS1;
                                bool ctrlS1_not = !MuxS1;
                                bool ctrlS0 = MuxS0;
                                bool ctrlS0_not = !MuxS0;
                            }

                            <!-- =================================================== -->
                            <!-- Control Inputs & NOT Gates at the top               -->
                            <!-- =================================================== -->
                            <!-- S1 Direct Bus -->
                            <text x="115" y="14" class="pin-label purple mono bold" text-anchor="middle">S₁</text>
                            <line x1="115" y1="20" x2="115" y2="340" class="wire @(ctrlS1 ? "wire-high" : "wire-low")" />

                            <!-- S1 Tap to NOT Gate 1 -->
                            <circle cx="115" cy="38" r="3.5" class="wire-dot @(ctrlS1 ? "dot-high" : "dot-low")" />
                            <line x1="115" y1="38" x2="135" y2="38" class="wire @(ctrlS1 ? "wire-high" : "wire-low")" />

                            <!-- NOT Gate 1 for S1 -->
                            <rect x="135" y="24" width="24" height="28" rx="3" class="gate-box @(ctrlS1_not ? "gate-selected" : "")" />
                            <text x="147" y="38" class="gate-box-text" font-size="12">1</text>
                            <circle cx="163" cy="38" r="3.5" class="inversion-bubble @(ctrlS1_not ? "bubble-high" : "bubble-low")" />

                            <!-- S1 Inverted Bus (¬S1) -->
                            <line x1="166.5" y1="38" x2="170" y2="38" class="wire @(ctrlS1_not ? "wire-high" : "wire-low")" />
                            <line x1="170" y1="20" x2="170" y2="340" class="wire @(ctrlS1_not ? "wire-high" : "wire-low")" />
                            <text x="170" y="14" class="pin-label purple mono bold" text-anchor="middle">¬S₁</text>

                            <!-- S0 Direct Bus -->
                            <text x="225" y="14" class="pin-label purple mono bold" text-anchor="middle">S₀</text>
                            <line x1="225" y1="20" x2="225" y2="340" class="wire @(ctrlS0 ? "wire-high" : "wire-low")" />

                            <!-- S0 Tap to NOT Gate 2 -->
                            <circle cx="225" cy="38" r="3.5" class="wire-dot @(ctrlS0 ? "dot-high" : "dot-low")" />
                            <line x1="225" y1="38" x2="245" y2="38" class="wire @(ctrlS0 ? "wire-high" : "wire-low")" />

                            <!-- NOT Gate 2 for S0 -->
                            <rect x="245" y="24" width="24" height="28" rx="3" class="gate-box @(ctrlS0_not ? "gate-selected" : "")" />
                            <text x="257" y="38" class="gate-box-text" font-size="12">1</text>
                            <circle cx="273" cy="38" r="3.5" class="inversion-bubble @(ctrlS0_not ? "bubble-high" : "bubble-low")" />

                            <!-- S0 Inverted Bus (¬S0) -->
                            <line x1="276.5" y1="38" x2="280" y2="38" class="wire @(ctrlS0_not ? "wire-high" : "wire-low")" />
                            <line x1="280" y1="20" x2="280" y2="340" class="wire @(ctrlS0_not ? "wire-high" : "wire-low")" />
                            <text x="280" y="14" class="pin-label purple mono bold" text-anchor="middle">¬S₀</text>

                            <!-- =================================================== -->
                            <!-- 4 AND Gates & Inputs                                -->
                            <!-- =================================================== -->
                            @{
                                int[] yCenters = new int[] { 80, 150, 220, 290 };
                                int[] orPinY = new int[] { 150, 173, 197, 220 };
                            }

                            @for (int i = 0; i < 4; i++)
                            {
                                int idx = i;
                                int yCenter = yCenters[idx];
                                int pinDataY = yCenter - 12;
                                int pinS1Y = yCenter;
                                int pinS0Y = yCenter + 12;

                                bool isSelected = idx == SelectedChannel;
                                bool dataVal = GetChannelValue(idx);
                                bool outVal = isSelected && dataVal;

                                int s1TapX = (idx < 2) ? 170 : 115;
                                bool s1Val = (idx < 2) ? ctrlS1_not : ctrlS1;

                                int s0TapX = (idx % 2 == 0) ? 280 : 225;
                                bool s0Val = (idx % 2 == 0) ? ctrlS0_not : ctrlS0;

                                <!-- Data line e[i] -->
                                @((MarkupString)$"<text x=\"28\" y=\"{pinDataY}\" text-anchor=\"end\" class=\"pin-label mono bold {(dataVal ? "emerald" : "")}\">e{ToSubscript(idx)}</text>")
                                <line x1="35" y1="@pinDataY" x2="340" y2="@pinDataY" class="wire @(dataVal ? "wire-high" : "wire-low")" />

                                <!-- S1 tap line -->
                                <circle cx="@s1TapX" cy="@pinS1Y" r="3.5" class="wire-dot @(s1Val ? "dot-high" : "dot-low")" />
                                <line x1="@s1TapX" y1="@pinS1Y" x2="340" y2="@pinS1Y" class="wire @(s1Val ? "wire-high" : "wire-low")" />

                                <!-- S0 tap line -->
                                <circle cx="@s0TapX" cy="@pinS0Y" r="3.5" class="wire-dot @(s0Val ? "dot-high" : "dot-low")" />
                                <line x1="@s0TapX" y1="@pinS0Y" x2="340" y2="@pinS0Y" class="wire @(s0Val ? "wire-high" : "wire-low")" />

                                <!-- AND Gate Box -->
                                <rect x="340" y="@(yCenter - 20)" width="55" height="40" rx="4" class="gate-box @(isSelected ? "gate-selected" : "")" />
                                @((MarkupString)$"<text x=\"367\" y=\"{yCenter}\" class=\"gate-box-text\">&amp;</text>")

                                <!-- Output to OR gate -->
                                <path d="M 395 @yCenter C 440 @yCenter, 440 @orPinY[idx], 480 @orPinY[idx]" class="wire @(outVal ? "wire-high" : "wire-low")" />
                            }

                            <!-- =================================================== -->
                            <!-- OR Gate & Output                                    -->
                            <!-- =================================================== -->
                            <rect x="480" y="135" width="65" height="100" rx="6" class="gate-box @(MuxOutput ? "gate-selected" : "")" />
                            <text x="512" y="185" class="gate-box-text" font-size="16">≥1</text>

                            <!-- Output line a -->
                            <line x1="545" y1="185" x2="610" y2="185" class="wire @(MuxOutput ? "wire-high" : "wire-low")" stroke-width="3.5" />
                            <text x="620" y="185" class="pin-label mono bold @(MuxOutput ? "emerald" : "red")">a = @(MuxOutput ? "1" : "0")</text>
                        </svg>
                    </div>
                </div>

                <!-- Right: Truth Table -->
                <div class="table-card">
                    <div class="table-card-header">
                        <h3>Wahrheitstafel (Ausschnitt)</h3>
                    </div>

                    <div class="table-responsive">
                        <table class="interactive-truth-table">
                            <thead>
                                <tr>
                                    <th><em>S</em><sub>1</sub></th>
                                    <th><em>S</em><sub>0</sub></th>
                                    <th><em>e</em><sub>0</sub></th>
                                    <th><em>e</em><sub>1</sub></th>
                                    <th><em>e</em><sub>2</sub></th>
                                    <th><em>e</em><sub>3</sub></th>
                                    <th class="th-out">Ausgang <em>a</em></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int s1 = 0; s1 <= 1; s1++)
                                {
                                    for (int s0 = 0; s0 <= 1; s0++)
                                    {
                                        int ch = (s1 << 1) | s0;
                                        bool isCurrentRow = (MuxS1 ? 1 : 0) == s1 && (MuxS0 ? 1 : 0) == s0;

                                        <tr class="@(isCurrentRow ? "table-row-active" : "")">
                                            <td class="mono bold purple">@s1</td>
                                            <td class="mono bold purple">@s0</td>
                                            <td class="mono">@(ch == 0 ? "e₀" : "–")</td>
                                            <td class="mono">@(ch == 1 ? "e₁" : "–")</td>
                                            <td class="mono">@(ch == 2 ? "e₂" : "–")</td>
                                            <td class="mono">@(ch == 3 ? "e₃" : "–")</td>
                                            <td class="mono bold @(isCurrentRow ? (MuxOutput ? "emerald" : "red") : "")">
                                                <strong><em>e</em><sub>@ch</sub></strong>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="circuit-summary-box">
                        <div class="summary-item">
                            <span>Ausgewählter Eingang:</span>
                            <strong class="mono blue"><em>e</em><sub>@SelectedChannel</sub> (@(GetChannelValue(SelectedChannel) ? "1" : "0"))</strong>
                        </div>
                        <div class="summary-item">
                            <span>Ausgangspegel <em>a</em>:</span>
                            <strong class="mono @(MuxOutput ? "emerald" : "red")">@(MuxOutput ? "1 (HIGH)" : "0 (LOW)")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }
        else if (SelectedCircuit == CircuitType.Demultiplexer)
        {
            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge badge-demux">1-zu-4 Demultiplexer</div>
                    <div class="narrator-title">
                        Steuereingänge: <span class="mono bold purple">S₂=@(DemuxS2 ? "1" : "0"), S₁=@(DemuxS1 ? "1" : "0")</span> (Kanal @DemuxAddress) &bull;
                        Dateneingang: <strong class="@(DemuxE ? "emerald" : "red") mono">e = @(DemuxE ? "1" : "0")</strong> &rarr;
                        Aktiver Ausgang: <strong class="blue mono">a<sub>@DemuxAddress</sub> = @(DemuxActiveOutput ? "1" : "0")</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    Ein Demultiplexer leitet das Datensignal <em>e</em> gesteuert durch die Adressbits <em>S</em>₂, <em>S</em>₁ exklusiv auf den ausgewählten Ausgang <em>a</em><sub>@DemuxAddress</sub> weiter. Alle unadressierten Ausgänge verbleiben auf 0 (LOW).
                </p>
                <div class="logic-metrics-strip">
                    <span>Funktionen: <strong class="mono">a₀ = e·¬S₂·¬S₁ &bull; a₁ = e·¬S₂·S₁ &bull; a₂ = e·S₂·¬S₁ &bull; a₃ = e·S₂·S₁</strong></span>
                    <span>Aktiver Pfad: <strong class="mono emerald">Ausgang <em>a</em><sub>@DemuxAddress</sub> (@(DemuxActiveOutput ? "HIGH" : "LOW"))</strong></span>
                </div>
            </div>

            <!-- Main Display: Interactive Schematic & Table -->
            <div class="main-display-grid">

                <!-- Left: Interactive Schematic SVG -->
                <div class="circuit-card">
                    <div class="circuit-card-header">
                        <h3>Schaltplan (Klick auf Signale toggelt Pegel)</h3>
                    </div>

                    <!-- Input Controls Toolbar -->
                    <div class="mux-toolbar">
                        <div class="mux-group">
                            <span class="toolbar-label">Steuerung (<em>S</em>):</span>
                            <button class="toggle-btn @(DemuxS2 ? "high" : "low")" @onclick="() => DemuxS2 = !DemuxS2">
                                S₂ (MSB): <strong>@(DemuxS2 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(DemuxS1 ? "high" : "low")" @onclick="() => DemuxS1 = !DemuxS1">
                                S₁ (LSB): <strong>@(DemuxS1 ? "1" : "0")</strong>
                            </button>
                        </div>

                        <div class="mux-group">
                            <span class="toolbar-label">Dateneingang:</span>
                            <button class="toggle-btn @(DemuxE ? "high" : "low")" @onclick="() => DemuxE = !DemuxE">
                                e: <strong>@(DemuxE ? "1" : "0")</strong>
                            </button>
                        </div>
                    </div>

                    <div class="svg-container">
                        <svg viewBox="0 0 660 380" class="circuit-svg" xmlns="http://www.w3.org/2000/svg">
                            @{
                                bool s1 = DemuxS1;
                                bool not_s1 = !DemuxS1;
                                bool s2 = DemuxS2;
                                bool not_s2 = !DemuxS2;
                                bool e = DemuxE;
                            }

                            <!-- S1 Inputs & Bus (x=90, x=150) -->
                            <g class="clickable-pin" @onclick="() => DemuxS1 = !DemuxS1" style="cursor: pointer;">
                                <rect x="75" y="6" width="30" height="24" rx="3" class="gate-box @(s1 ? "gate-selected" : "")" />
                                <text x="90" y="22" class="pin-label purple mono bold" text-anchor="middle" font-size="14">S₁</text>
                            </g>
                            <line x1="90" y1="30" x2="90" y2="360" class="wire @(s1 ? "wire-high" : "wire-low")" />

                            <!-- S1 NOT Gate -->
                            <circle cx="90" cy="45" r="3.5" class="wire-dot @(s1 ? "dot-high" : "dot-low")" />
                            <line x1="90" y1="45" x2="110" y2="45" class="wire @(s1 ? "wire-high" : "wire-low")" />
                            <rect x="110" y="32" width="22" height="26" rx="3" class="gate-box @(not_s1 ? "gate-selected" : "")" />
                            <text x="121" y="46" class="gate-box-text" font-size="11">1</text>
                            <circle cx="136" cy="45" r="3.5" class="inversion-bubble @(not_s1 ? "bubble-high" : "bubble-low")" />
                            <line x1="139.5" y1="45" x2="150" y2="45" class="wire @(not_s1 ? "wire-high" : "wire-low")" />
                            <line x1="150" y1="30" x2="150" y2="360" class="wire @(not_s1 ? "wire-high" : "wire-low")" />
                            <text x="150" y="22" class="pin-label purple mono bold" text-anchor="middle" font-size="12">¬S₁</text>

                            <!-- S2 Inputs & Bus (x=200, x=260) -->
                            <g class="clickable-pin" @onclick="() => DemuxS2 = !DemuxS2" style="cursor: pointer;">
                                <rect x="185" y="6" width="30" height="24" rx="3" class="gate-box @(s2 ? "gate-selected" : "")" />
                                <text x="200" y="22" class="pin-label purple mono bold" text-anchor="middle" font-size="14">S₂</text>
                            </g>
                            <line x1="200" y1="30" x2="200" y2="360" class="wire @(s2 ? "wire-high" : "wire-low")" />

                            <!-- S2 NOT Gate -->
                            <circle cx="200" cy="45" r="3.5" class="wire-dot @(s2 ? "dot-high" : "dot-low")" />
                            <line x1="200" y1="45" x2="220" y2="45" class="wire @(s2 ? "wire-high" : "wire-low")" />
                            <rect x="220" y="32" width="22" height="26" rx="3" class="gate-box @(not_s2 ? "gate-selected" : "")" />
                            <text x="231" y="46" class="gate-box-text" font-size="11">1</text>
                            <circle cx="246" cy="45" r="3.5" class="inversion-bubble @(not_s2 ? "bubble-high" : "bubble-low")" />
                            <line x1="249.5" y1="45" x2="260" y2="45" class="wire @(not_s2 ? "wire-high" : "wire-low")" />
                            <line x1="260" y1="30" x2="260" y2="360" class="wire @(not_s2 ? "wire-high" : "wire-low")" />
                            <text x="260" y="22" class="pin-label purple mono bold" text-anchor="middle" font-size="12">¬S₂</text>

                            <!-- e Data Bus (x=300) -->
                            <g class="clickable-pin" @onclick="() => DemuxE = !DemuxE" style="cursor: pointer;">
                                <rect x="285" y="6" width="30" height="24" rx="3" class="gate-box @(e ? "gate-selected" : "")" />
                                <text x="300" y="22" class="pin-label emerald mono bold" text-anchor="middle" font-size="14">e</text>
                            </g>
                            <line x1="300" y1="30" x2="300" y2="360" class="wire @(e ? "wire-high" : "wire-low")" stroke-width="2.5" />

                            <!-- 4 AND Gates (y=90, 160, 230, 300) -->
                            @{
                                int[] demuxY = new int[] { 90, 160, 230, 300 };
                                bool[] demuxOuts = new bool[] { DemuxA0, DemuxA1, DemuxA2, DemuxA3 };
                            }

                            @for (int i = 0; i < 4; i++)
                            {
                                int idx = i;
                                int yCenter = demuxY[idx];
                                bool isAddr = idx == DemuxAddress;
                                bool outVal = demuxOuts[idx];

                                int pinS1Y = yCenter - 10;
                                int pinS2Y = yCenter;
                                int pinEY = yCenter + 10;

                                int s1X = (idx % 2 == 1) ? 90 : 150;
                                bool s1BitVal = (idx % 2 == 1) ? s1 : not_s1;

                                int s2X = (idx >= 2) ? 200 : 260;
                                bool s2BitVal = (idx >= 2) ? s2 : not_s2;

                                <!-- Tap lines to AND gate -->
                                <circle cx="@s1X" cy="@pinS1Y" r="3.5" class="wire-dot @(s1BitVal ? "dot-high" : "dot-low")" />
                                <line x1="@s1X" y1="@pinS1Y" x2="360" y2="@pinS1Y" class="wire @(s1BitVal ? "wire-high" : "wire-low")" />

                                <circle cx="@s2X" cy="@pinS2Y" r="3.5" class="wire-dot @(s2BitVal ? "dot-high" : "dot-low")" />
                                <line x1="@s2X" y1="@pinS2Y" x2="360" y2="@pinS2Y" class="wire @(s2BitVal ? "wire-high" : "wire-low")" />

                                <circle cx="300" cy="@pinEY" r="3.5" class="wire-dot @(e ? "dot-high" : "dot-low")" />
                                <line x1="300" y1="@pinEY" x2="360" y2="@pinEY" class="wire @(e ? "wire-high" : "wire-low")" />

                                <!-- AND Gate Box -->
                                <rect x="360" y="@(yCenter - 20)" width="55" height="40" rx="4" class="gate-box @(isAddr ? "gate-selected" : "")" />
                                @((MarkupString)$"<text x=\"387\" y=\"{yCenter}\" class=\"gate-box-text\">&amp;</text>")

                                <!-- Output Wire & Indicator -->
                                <line x1="415" y1="@yCenter" x2="510" y2="@yCenter" class="wire @(outVal ? "wire-high" : "wire-low")" stroke-width="3" />
                                <circle cx="525" cy="@yCenter" r="10" class="wire-dot @(outVal ? "dot-high" : "dot-low")" />
                                <g>
                                    <text x="545" y="@(yCenter + 5)" class="pin-label mono bold @(outVal ? "emerald" : "red")" font-size="16">a@ToSubscript(idx) = @(outVal ? "1" : "0")</text>
                                </g>
                            }
                        </svg>
                    </div>
                </div>

                <!-- Right: Truth Table -->
                <div class="table-card">
                    <div class="table-card-header">
                        <h3>Wahrheitstabelle (GDI 07 Aufgabe 1c)</h3>
                    </div>

                    <div class="table-responsive">
                        <table class="interactive-truth-table">
                            <thead>
                                <tr>
                                    <th><em>e</em></th>
                                    <th><em>S</em>₂</th>
                                    <th><em>S</em>₁</th>
                                    <th class="th-out"><em>a</em>₀</th>
                                    <th class="th-out"><em>a</em>₁</th>
                                    <th class="th-out"><em>a</em>₂</th>
                                    <th class="th-out"><em>a</em>₃</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int r = 0; r < 8; r++)
                                {
                                    int rowE = (r >> 2) & 1;
                                    int rowS2 = (r >> 1) & 1;
                                    int rowS1 = r & 1;
                                    int rowAddr = (rowS2 << 1) | rowS1;

                                    bool isCurrentRow = (DemuxE ? 1 : 0) == rowE && (DemuxS2 ? 1 : 0) == rowS2 && (DemuxS1 ? 1 : 0) == rowS1;
                                    <tr class="@(isCurrentRow ? "table-row-active" : "")">
                                        <td class="mono bold @(rowE == 1 ? "emerald" : "")">@rowE</td>
                                        <td class="mono bold purple">@rowS2</td>
                                        <td class="mono bold purple">@rowS1</td>
                                        <td class="mono @(rowE == 1 && rowAddr == 0 ? "bold emerald" : "")">@(rowE == 1 && rowAddr == 0 ? "1" : "0")</td>
                                        <td class="mono @(rowE == 1 && rowAddr == 1 ? "bold emerald" : "")">@(rowE == 1 && rowAddr == 1 ? "1" : "0")</td>
                                        <td class="mono @(rowE == 1 && rowAddr == 2 ? "bold emerald" : "")">@(rowE == 1 && rowAddr == 2 ? "1" : "0")</td>
                                        <td class="mono @(rowE == 1 && rowAddr == 3 ? "bold emerald" : "")">@(rowE == 1 && rowAddr == 3 ? "1" : "0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="circuit-summary-box">
                        <div class="summary-item">
                            <span>Ausgewählte Adresse:</span>
                            <strong class="mono purple">S₂S₁ = @(DemuxS2 ? "1" : "0")@(DemuxS1 ? "1" : "0") (Kanal @DemuxAddress)</strong>
                        </div>
                        <div class="summary-item">
                            <span>Aktiver Ausgang:</span>
                            <strong class="mono @(DemuxActiveOutput ? "emerald" : "red")">a<sub>@DemuxAddress</sub> = @(DemuxActiveOutput ? "1" : "0")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }
        else if (SelectedCircuit == CircuitType.SevenSegment)
        {
            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge badge-seg">BCD 7-Segment-Decoder</div>
                    <div class="narrator-title">
                        Binäreingänge: <span class="mono bold purple">x₄=@(SegX4 ? "1" : "0"), x₃=@(SegX3 ? "1" : "0"), x₂=@(SegX2 ? "1" : "0"), x₁=@(SegX1 ? "1" : "0")</span> &rarr;
                        Dezimalziffer: <strong class="blue mono">@(SegDigitValue < 10 ? SegDigitValue.ToString() : $"{SegDigitValue} (Don't Care)")</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    Die 4 Eingangssignale <em>x</em>₄ (Wertigkeit 8) bis <em>x</em>₁ (Wertigkeit 1) bilden eine BCD-codierte Ziffer (0 bis 9). Die Ansteuerungslogik aktiviert genau die Ausgangssignale <em>s</em>₀ bis <em>s</em>₆, deren Segmente aufleuchten müssen.
                </p>
                <div class="logic-metrics-strip">
                    <span>Segmente aktiv: <strong class="mono emerald">@(GetActiveSegmentList())</strong></span>
                    <span>Segmentanzahl: <strong class="mono">@GetActiveSegmentCount() von 7</strong></span>
                </div>
            </div>

            <!-- Main Display: Interactive Schematic & Table -->
            <div class="main-display-grid">

                <!-- Left: 7-Segment Display SVG & Buttons -->
                <div class="circuit-card">
                    <div class="circuit-card-header">
                        <h3>7-Segment-Anzeige (GDI 07 Aufgabe 2)</h3>
                    </div>

                    <!-- Input Controls Toolbar -->
                    <div class="mux-toolbar">
                        <div class="mux-group">
                            <span class="toolbar-label">BCD-Eingänge:</span>
                            <button class="toggle-btn @(SegX4 ? "high" : "low")" @onclick="() => SegX4 = !SegX4">
                                x₄ (8): <strong>@(SegX4 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(SegX3 ? "high" : "low")" @onclick="() => SegX3 = !SegX3">
                                x₃ (4): <strong>@(SegX3 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(SegX2 ? "high" : "low")" @onclick="() => SegX2 = !SegX2">
                                x₂ (2): <strong>@(SegX2 ? "1" : "0")</strong>
                            </button>
                            <button class="toggle-btn @(SegX1 ? "high" : "low")" @onclick="() => SegX1 = !SegX1">
                                x₁ (1): <strong>@(SegX1 ? "1" : "0")</strong>
                            </button>
                        </div>
                    </div>

                    <!-- Quick Digit Picker -->
                    <div style="padding: 0.5rem 1rem;">
                        <span style="font-size: 0.8rem; font-weight: 600; color: #64748b;">Schnellwahl Ziffer:</span>
                        <div class="digit-btn-grid">
                            @for (int d = 0; d <= 9; d++)
                            {
                                int digit = d;
                                <button class="digit-btn @(SegDigitValue == digit ? "active" : "")" @onclick="() => SetDigit(digit)">
                                    @digit
                                </button>
                            }
                        </div>
                    </div>

                    <div class="seven-seg-box">
                        <svg viewBox="0 0 340 380" class="seven-seg-svg" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <marker id="arrowhead" markerWidth="6" markerHeight="6" refX="4" refY="3" orient="auto">
                                    <polygon points="0 0, 6 3, 0 6" fill="#94a3b8" />
                                </marker>
                            </defs>

                            <!-- s0: Top horizontal -->
                            <polygon points="110,60 125,45 215,45 230,60 215,75 125,75" class="@(GetSegment(0) ? "seg-lit" : "seg-dim")" />
                            <line x1="170" y1="20" x2="170" y2="42" class="seg-arrow" />
                            <text x="170" y="14" class="seg-label-txt" text-anchor="middle">s₀=@(GetSegment(0) ? "1" : "0")</text>

                            <!-- s1: Upper-left vertical -->
                            <polygon points="105,65 120,80 120,150 105,165 90,150 90,80" class="@(GetSegment(1) ? "seg-lit" : "seg-dim")" />
                            <line x1="35" y1="115" x2="88" y2="115" class="seg-arrow" />
                            <text x="30" y="119" class="seg-label-txt" text-anchor="end">s₁=@(GetSegment(1) ? "1" : "0")</text>

                            <!-- s3: Upper-right vertical -->
                            <polygon points="235,65 250,80 250,150 235,165 220,150 220,80" class="@(GetSegment(3) ? "seg-lit" : "seg-dim")" />
                            <line x1="305" y1="115" x2="252" y2="115" class="seg-arrow" />
                            <text x="310" y="119" class="seg-label-txt" text-anchor="start">s₃=@(GetSegment(3) ? "1" : "0")</text>

                            <!-- s2: Center horizontal -->
                            <polygon points="110,170 125,155 215,155 230,170 215,185 125,185" class="@(GetSegment(2) ? "seg-lit" : "seg-dim")" />
                            <line x1="170" y1="205" x2="170" y2="187" class="seg-arrow" />
                            <text x="170" y="222" class="seg-label-txt" text-anchor="middle">s₂=@(GetSegment(2) ? "1" : "0")</text>

                            <!-- s4: Lower-left vertical -->
                            <polygon points="105,175 120,190 120,260 105,275 90,260 90,190" class="@(GetSegment(4) ? "seg-lit" : "seg-dim")" />
                            <line x1="35" y1="225" x2="88" y2="225" class="seg-arrow" />
                            <text x="30" y="229" class="seg-label-txt" text-anchor="end">s₄=@(GetSegment(4) ? "1" : "0")</text>

                            <!-- s5: Lower-right vertical -->
                            <polygon points="235,175 250,190 250,260 235,275 220,260 220,190" class="@(GetSegment(5) ? "seg-lit" : "seg-dim")" />
                            <line x1="305" y1="225" x2="252" y2="225" class="seg-arrow" />
                            <text x="310" y="229" class="seg-label-txt" text-anchor="start">s₅=@(GetSegment(5) ? "1" : "0")</text>

                            <!-- s6: Bottom horizontal -->
                            <polygon points="110,280 125,265 215,265 230,280 215,295 125,295" class="@(GetSegment(6) ? "seg-lit" : "seg-dim")" />
                            <line x1="170" y1="330" x2="170" y2="297" class="seg-arrow" />
                            <text x="170" y="348" class="seg-label-txt" text-anchor="middle">s₆=@(GetSegment(6) ? "1" : "0")</text>
                        </svg>
                    </div>
                </div>

                <!-- Right: Truth Table -->
                <div class="table-card">
                    <div class="table-card-header">
                        <h3>Wahrheitstabelle (TISevenSegment)</h3>
                    </div>

                    <div class="table-responsive">
                        <table class="interactive-truth-table">
                            <thead>
                                <tr>
                                    <th><em>x</em>₄</th>
                                    <th><em>x</em>₃</th>
                                    <th><em>x</em>₂</th>
                                    <th><em>x</em>₁</th>
                                    <th class="th-out"><em>s</em>₆</th>
                                    <th class="th-out"><em>s</em>₅</th>
                                    <th class="th-out"><em>s</em>₄</th>
                                    <th class="th-out"><em>s</em>₃</th>
                                    <th class="th-out"><em>s</em>₂</th>
                                    <th class="th-out"><em>s</em>₁</th>
                                    <th class="th-out"><em>s</em>₀</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int r = 0; r < 16; r++)
                                {
                                    int rowVal = r;
                                    int rx4 = (r >> 3) & 1;
                                    int rx3 = (r >> 2) & 1;
                                    int rx2 = (r >> 1) & 1;
                                    int rx1 = r & 1;

                                    bool isCurrent = SegDigitValue == rowVal;
                                    <tr class="@(isCurrent ? "table-row-active" : "")">
                                        <td class="mono bold purple">@rx4</td>
                                        <td class="mono bold purple">@rx3</td>
                                        <td class="mono bold purple">@rx2</td>
                                        <td class="mono bold purple">@rx1</td>
                                        @if (rowVal < 10)
                                        {
                                            <td class="mono @(SevenSegTable[rowVal, 6] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 6] ? "1" : "0")</td>
                                            <td class="mono @(SevenSegTable[rowVal, 5] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 5] ? "1" : "0")</td>
                                            <td class="mono @(SevenSegTable[rowVal, 4] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 4] ? "1" : "0")</td>
                                            <td class="mono @(SevenSegTable[rowVal, 3] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 3] ? "1" : "0")</td>
                                            <td class="mono @(SevenSegTable[rowVal, 2] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 2] ? "1" : "0")</td>
                                            <td class="mono @(SevenSegTable[rowVal, 1] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 1] ? "1" : "0")</td>
                                            <td class="mono @(SevenSegTable[rowVal, 0] ? "bold emerald" : "")">@(SevenSegTable[rowVal, 0] ? "1" : "0")</td>
                                        }
                                        else
                                        {
                                            <td class="mono muted" colspan="7" style="text-align: center;">-- (Don't Care) --</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="circuit-summary-box">
                        <div class="summary-item">
                            <span>Dezimalziffer:</span>
                            <strong class="mono blue">@(SegDigitValue < 10 ? SegDigitValue.ToString() : $"{SegDigitValue} (Don't Care)")</strong>
                        </div>
                        <div class="summary-item">
                            <span>Segmente (s₆..s₀):</span>
                            <strong class="mono emerald">@GetSegmentBitString()</strong>
                        </div>
                    </div>
                </div>

            </div>
        }
        else if (SelectedCircuit == CircuitType.Counter)
        {
            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge" style="background:#4338ca; color:#ffffff;">3-Bit-Synchronzähler</div>
                    <div class="narrator-title">
                        Modus: <span class="mono bold purple">@(CounterSequential ? "Sequentiell (D-Flip-Flops mit Takt)" : "Kombinatorische Logik (e → a)")</span> &bull;
                        Aktueller Zählerstand: <strong class="blue mono">@CounterDecimal (@(ActiveE2 ? "1" : "0")@(ActiveE1 ? "1" : "0")@(ActiveE0 ? "1" : "0")₂)</strong> &rarr;
                        Nächster Zustand: <strong class="emerald mono">@NextCounterValue (@(CounterA2 ? "1" : "0")@(CounterA1 ? "1" : "0")@(CounterA0 ? "1" : "0")₂)</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    Ein synchroner 3-Bit-Vorwärtszähler schaltet mit jedem Taktsignal um genau eins weiter (<em>n</em> + 1 mod 8). Die Flip-Flops speichern den aktuellen Zustand <em>e</em>₂, <em>e</em>₁, <em>e</em>₀. Das kombinatorische Schaltnetz erzeugt aus dem aktuellen Zustand die Ansteuerungen <em>a</em>₂, <em>a</em>₁, <em>a</em>₀ für den Folgezustand.
                </p>
                <div class="logic-metrics-strip">
                    <span>Gleichungen: <strong class="mono">a₀ = ¬e₀ &bull; a₁ = e₁ ⊕ e₀ &bull; a₂ = e₂ ⊕ (e₁ · e₀)</strong></span>
                    <span>Takt-Zyklus: <strong class="mono blue">0 &rarr; 1 &rarr; 2 &rarr; 3 &rarr; 4 &rarr; 5 &rarr; 6 &rarr; 7 &rarr; 0</strong></span>
                </div>
            </div>

            <!-- Main Display Grid -->
            <div class="main-display-grid">

                <!-- Left: Interactive Schematic SVG -->
                <div class="circuit-card">
                    <div class="circuit-card-header">
                        <h3>Schaltplan (@(CounterSequential ? "Synchrones Schaltwerk mit gemeinsamen Takt" : "Kombinatorisches Schaltnetz"))</h3>
                        <div class="view-switch-btns">
                            <button class="mode-btn @(CounterSequential ? "active" : "")" @onclick="() => CounterSequential = true">
                                ⏱️ Sequentiell (mit Takt)
                            </button>
                            <button class="mode-btn @(!CounterSequential ? "active" : "")" @onclick="() => CounterSequential = false">
                                🔌 Nur Kombinatorik (e)
                            </button>
                        </div>
                    </div>

                    <!-- Toolbar -->
                    <div class="mux-toolbar">
                        @if (CounterSequential)
                        {
                            <div class="mux-group">
                                <span class="toolbar-label">Taktsteuerung:</span>
                                <button class="btn-clock @(CounterClockPulse ? "pulsing" : "")" @onclick="StepCounterClock" title="Einen Taktimpuls auslösen">
                                    ⏱️ Takt (Clock)
                                </button>
                                <button class="btn-autoplay @(CounterAutoPlay ? "active-playing" : "")" @onclick="ToggleCounterAutoPlay">
                                    @(CounterAutoPlay ? "⏸️ Pause" : "▶️ Auto-Takt")
                                </button>
                                <button class="btn-reset" @onclick="ResetCounter" title="Auf 0 zurücksetzen">
                                    ↺ Reset (000)
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="mux-group">
                                <span class="toolbar-label">Eingänge (e):</span>
                                <button class="toggle-btn @(CounterManualE2 ? "high" : "low")" @onclick="() => CounterManualE2 = !CounterManualE2">
                                    e₂ (MSB): <strong>@(CounterManualE2 ? "1" : "0")</strong>
                                </button>
                                <button class="toggle-btn @(CounterManualE1 ? "high" : "low")" @onclick="() => CounterManualE1 = !CounterManualE1">
                                    e₁: <strong>@(CounterManualE1 ? "1" : "0")</strong>
                                </button>
                                <button class="toggle-btn @(CounterManualE0 ? "high" : "low")" @onclick="() => CounterManualE0 = !CounterManualE0">
                                    e₀ (LSB): <strong>@(CounterManualE0 ? "1" : "0")</strong>
                                </button>
                            </div>
                        }

                        <div class="mux-group">
                            <span class="toolbar-label">Direktwahl:</span>
                            <div class="digit-selector">
                                @for (int i = 0; i < 8; i++)
                                {
                                    var digit = i;
                                    <button class="digit-btn @(CounterDecimal == digit ? "active" : "")" @onclick="() => SetCounterValue(digit)">
                                        @digit
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- SVG Circuit Canvas -->
                    <div class="svg-container">
                        <svg class="logic-svg" viewBox="0 0 680 440" preserveAspectRatio="xMidYMid meet">
                            <!-- Clock Rail (Sequential mode only) -->
                            @if (CounterSequential)
                            {
                                <g class="clock-rail">
                                    <!-- Clock Source Box -->
                                    <rect x="25" y="40" width="70" height="36" rx="4" fill="@(CounterClockPulse ? "#ede9fe" : "#f8fafc")" stroke="@(CounterClockPulse ? "#7c3aed" : "#64748b")" stroke-width="2" />
                                    <path d="M 38 62 L 48 62 L 48 48 L 58 48 L 58 62 L 68 62 L 68 48 L 78 48 L 78 62 L 85 62" fill="none" stroke="@(CounterClockPulse ? "#7c3aed" : "#475569")" stroke-width="2" />
                                    <text x="60" y="32" font-size="12" font-weight="700" text-anchor="middle" fill="#64748b">CLOCK</text>

                                    <!-- Clock Wires down to FF0, FF1, FF2 -->
                                    <path d="M 95 58 L 130 58 L 130 360 L 160 360" fill="none" stroke="@(CounterClockPulse ? "#7c3aed" : "#94a3b8")" stroke-width="@(CounterClockPulse ? "3.5" : "2")" />
                                    <path d="M 130 160 L 160 160" fill="none" stroke="@(CounterClockPulse ? "#7c3aed" : "#94a3b8")" stroke-width="@(CounterClockPulse ? "3.5" : "2")" />
                                    <path d="M 130 260 L 160 260" fill="none" stroke="@(CounterClockPulse ? "#7c3aed" : "#94a3b8")" stroke-width="@(CounterClockPulse ? "3.5" : "2")" />
                                    <circle cx="130" cy="160" r="3.5" fill="@(CounterClockPulse ? "#7c3aed" : "#94a3b8")" />
                                    <circle cx="130" cy="260" r="3.5" fill="@(CounterClockPulse ? "#7c3aed" : "#94a3b8")" />
                                </g>

                                <!-- 3 D-Flip-Flops -->
                                <!-- FF0 (LSB) -->
                                <g class="ff-box">
                                    <rect x="160" y="115" width="60" height="65" rx="5" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" />
                                    <text x="190" y="105" font-size="12" font-weight="700" text-anchor="middle" fill="#0f172a">FF₀</text>
                                    <text x="168" y="142" font-size="13" font-weight="600" fill="#475569">D</text>
                                    <path d="M 160 167 L 168 160 L 160 153 Z" fill="none" stroke="#475569" stroke-width="1.8" />
                                    <text x="210" y="142" font-size="13" font-weight="700" text-anchor="end" fill="@(ActiveE0 ? "#2563eb" : "#475569")">Q</text>
                                </g>

                                <!-- FF1 -->
                                <g class="ff-box">
                                    <rect x="160" y="215" width="60" height="65" rx="5" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" />
                                    <text x="190" y="205" font-size="12" font-weight="700" text-anchor="middle" fill="#0f172a">FF₁</text>
                                    <text x="168" y="242" font-size="13" font-weight="600" fill="#475569">D</text>
                                    <path d="M 160 267 L 168 260 L 160 253 Z" fill="none" stroke="#475569" stroke-width="1.8" />
                                    <text x="210" y="242" font-size="13" font-weight="700" text-anchor="end" fill="@(ActiveE1 ? "#2563eb" : "#475569")">Q</text>
                                </g>

                                <!-- FF2 (MSB) -->
                                <g class="ff-box">
                                    <rect x="160" y="315" width="60" height="65" rx="5" fill="#ffffff" stroke="#1e293b" stroke-width="2.5" />
                                    <text x="190" y="305" font-size="12" font-weight="700" text-anchor="middle" fill="#0f172a">FF₂</text>
                                    <text x="168" y="342" font-size="13" font-weight="600" fill="#475569">D</text>
                                    <path d="M 160 367 L 168 360 L 160 353 Z" fill="none" stroke="#475569" stroke-width="1.8" />
                                    <text x="210" y="342" font-size="13" font-weight="700" text-anchor="end" fill="@(ActiveE2 ? "#2563eb" : "#475569")">Q</text>
                                </g>
                            }
                            else
                            {
                                <!-- Input Switches (Combinational Mode) -->
                                <g class="input-switches">
                                    <!-- e0 -->
                                    <rect x="140" y="122" width="40" height="32" rx="4" fill="@(ActiveE0 ? "#2563eb" : "#f1f5f9")" stroke="@(ActiveE0 ? "#1d4ed8" : "#94a3b8")" stroke-width="2" style="cursor:pointer;" @onclick="() => CounterManualE0 = !CounterManualE0" />
                                    <text x="160" y="143" font-size="13" font-weight="700" text-anchor="middle" fill="@(ActiveE0 ? "#ffffff" : "#334155")" style="cursor:pointer;" @onclick="() => CounterManualE0 = !CounterManualE0">e₀: @(ActiveE0 ? "1" : "0")</text>

                                    <!-- e1 -->
                                    <rect x="140" y="222" width="40" height="32" rx="4" fill="@(ActiveE1 ? "#2563eb" : "#f1f5f9")" stroke="@(ActiveE1 ? "#1d4ed8" : "#94a3b8")" stroke-width="2" style="cursor:pointer;" @onclick="() => CounterManualE1 = !CounterManualE1" />
                                    <text x="160" y="243" font-size="13" font-weight="700" text-anchor="middle" fill="@(ActiveE1 ? "#ffffff" : "#334155")" style="cursor:pointer;" @onclick="() => CounterManualE1 = !CounterManualE1">e₁: @(ActiveE1 ? "1" : "0")</text>

                                    <!-- e2 -->
                                    <rect x="140" y="322" width="40" height="32" rx="4" fill="@(ActiveE2 ? "#2563eb" : "#f1f5f9")" stroke="@(ActiveE2 ? "#1d4ed8" : "#94a3b8")" stroke-width="2" style="cursor:pointer;" @onclick="() => CounterManualE2 = !CounterManualE2" />
                                    <text x="160" y="343" font-size="13" font-weight="700" text-anchor="middle" fill="@(ActiveE2 ? "#ffffff" : "#334155")" style="cursor:pointer;" @onclick="() => CounterManualE2 = !CounterManualE2">e₂: @(ActiveE2 ? "1" : "0")</text>
                                </g>
                            }

                            <!-- Wire Net for e0, e1, e2 -->
                            <!-- e0 wires -->
                            <path d="M @(CounterSequential ? 220 : 180) 138 L 260 138 L 320 138" fill="none" stroke="@GetCounterWireColor(ActiveE0)" stroke-width="@GetCounterWireWidth(ActiveE0)" />
                            <path d="M 260 138 L 260 225 L 400 225" fill="none" stroke="@GetCounterWireColor(ActiveE0)" stroke-width="@GetCounterWireWidth(ActiveE0)" />
                            <path d="M 260 225 L 260 295 L 320 295" fill="none" stroke="@GetCounterWireColor(ActiveE0)" stroke-width="@GetCounterWireWidth(ActiveE0)" />
                            <circle cx="260" cy="138" r="4" fill="@GetCounterWireColor(ActiveE0)" />
                            <circle cx="260" cy="225" r="4" fill="@GetCounterWireColor(ActiveE0)" />

                            <!-- e1 wires -->
                            <path d="M @(CounterSequential ? 220 : 180) 238 L 280 238 L 400 238" fill="none" stroke="@GetCounterWireColor(ActiveE1)" stroke-width="@GetCounterWireWidth(ActiveE1)" />
                            <path d="M 280 238 L 280 315 L 320 315" fill="none" stroke="@GetCounterWireColor(ActiveE1)" stroke-width="@GetCounterWireWidth(ActiveE1)" />
                            <circle cx="280" cy="238" r="4" fill="@GetCounterWireColor(ActiveE1)" />

                            <!-- e2 wires -->
                            <path d="M @(CounterSequential ? 220 : 180) 338 L 300 338 L 300 375 L 420 375" fill="none" stroke="@GetCounterWireColor(ActiveE2)" stroke-width="@GetCounterWireWidth(ActiveE2)" />

                            <!-- GATE 1: Inverter (NOT) for a0 -->
                            <g class="gate-not">
                                <rect x="320" y="118" width="40" height="40" rx="4" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
                                <text x="340" y="143" font-size="18" font-weight="700" text-anchor="middle" fill="#0f172a">1</text>
                                <circle cx="366" cy="138" r="5" fill="#ffffff" stroke="#0f172a" stroke-width="2" />
                            </g>
                            <!-- a0 wire -->
                            <path d="M 372 138 L 530 138" fill="none" stroke="@GetCounterWireColor(CounterA0)" stroke-width="@GetCounterWireWidth(CounterA0)" />

                            <!-- GATE 2: XOR for a1 -->
                            <g class="gate-xor1">
                                <rect x="400" y="210" width="55" height="55" rx="4" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
                                <text x="427" y="244" font-size="18" font-weight="700" text-anchor="middle" fill="#0f172a">=1</text>
                            </g>
                            <!-- a1 wire -->
                            <path d="M 455 238 L 530 238" fill="none" stroke="@GetCounterWireColor(CounterA1)" stroke-width="@GetCounterWireWidth(CounterA1)" />

                            <!-- GATE 3: AND for (e1 · e0) -->
                            <g class="gate-and">
                                <rect x="320" y="285" width="50" height="50" rx="4" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
                                <text x="345" y="317" font-size="20" font-weight="700" text-anchor="middle" fill="#0f172a">&amp;</text>
                            </g>
                            <!-- AND output wire to XOR -->
                            <path d="M 370 310 L 395 310 L 395 345 L 420 345" fill="none" stroke="@GetCounterWireColor(CounterAnd)" stroke-width="@GetCounterWireWidth(CounterAnd)" />

                            <!-- GATE 4: XOR for a2 -->
                            <g class="gate-xor2">
                                <rect x="420" y="335" width="55" height="55" rx="4" fill="#ffffff" stroke="#0f172a" stroke-width="2.5" />
                                <text x="447" y="370" font-size="18" font-weight="700" text-anchor="middle" fill="#0f172a">=1</text>
                            </g>
                            <!-- a2 wire -->
                            <path d="M 475 362 L 530 362" fill="none" stroke="@GetCounterWireColor(CounterA2)" stroke-width="@GetCounterWireWidth(CounterA2)" />

                            <!-- Output Indicators / Pins a0, a1, a2 -->
                            <!-- a0 -->
                            <circle cx="545" cy="138" r="14" fill="@(CounterA0 ? "#dcfce7" : "#f1f5f9")" stroke="@(CounterA0 ? "#15803d" : "#64748b")" stroke-width="2.5" />
                            <text x="545" y="143" font-size="13" font-weight="700" text-anchor="middle" fill="@(CounterA0 ? "#15803d" : "#64748b")">@(CounterA0 ? "1" : "0")</text>
                            <text x="568" y="143" font-size="14" font-weight="700" fill="#0f172a">a₀</text>

                            <!-- a1 -->
                            <circle cx="545" cy="238" r="14" fill="@(CounterA1 ? "#dcfce7" : "#f1f5f9")" stroke="@(CounterA1 ? "#15803d" : "#64748b")" stroke-width="2.5" />
                            <text x="545" y="243" font-size="13" font-weight="700" text-anchor="middle" fill="@(CounterA1 ? "#15803d" : "#64748b")">@(CounterA1 ? "1" : "0")</text>
                            <text x="568" y="243" font-size="14" font-weight="700" fill="#0f172a">a₁</text>

                            <!-- a2 -->
                            <circle cx="545" cy="362" r="14" fill="@(CounterA2 ? "#dcfce7" : "#f1f5f9")" stroke="@(CounterA2 ? "#15803d" : "#64748b")" stroke-width="2.5" />
                            <text x="545" y="367" font-size="13" font-weight="700" text-anchor="middle" fill="@(CounterA2 ? "#15803d" : "#64748b")">@(CounterA2 ? "1" : "0")</text>
                            <text x="568" y="367" font-size="14" font-weight="700" fill="#0f172a">a₂</text>

                            <!-- Sequential Feedback Loops from a0, a1, a2 back to D0, D1, D2 -->
                            @if (CounterSequential)
                            {
                                <!-- Loop 0: a0 to D0 (y=138 -> y=85 -> x=110 -> y=138) -->
                                <path d="M 545 124 L 545 85 L 110 85 L 110 138 L 160 138" fill="none" stroke="@GetCounterWireColor(CounterA0)" stroke-width="2" stroke-dasharray="4 3" />

                                <!-- Loop 1: a1 to D1 (y=238 -> y=190 -> x=118 -> y=238) -->
                                <path d="M 545 224 L 545 190 L 118 190 L 118 238 L 160 238" fill="none" stroke="@GetCounterWireColor(CounterA1)" stroke-width="2" stroke-dasharray="4 3" />

                                <!-- Loop 2: a2 to D2 (y=362 -> y=415 -> x=114 -> y=338) -->
                                <path d="M 545 376 L 545 415 L 114 415 L 114 338 L 160 338" fill="none" stroke="@GetCounterWireColor(CounterA2)" stroke-width="2" stroke-dasharray="4 3" />
                            }
                        </svg>
                    </div>
                </div>

                <!-- Right: Truth Table Card -->
                <div class="truth-table-card">
                    <div class="table-card-header">
                        <h3>Wertetabelle (8 Zustände)</h3>
                        <span class="table-badge">Zustandsfolge</span>
                    </div>
                    <div class="table-responsive">
                        <table class="logic-table">
                            <thead>
                                <tr>
                                    <th colspan="3" class="th-group-gray">Alter Zustand (e)</th>
                                    <th colspan="3" class="th-group-accent">Neuer Zustand (a)</th>
                                    <th>Übergang</th>
                                </tr>
                                <tr>
                                    <th>e₂</th>
                                    <th>e₁</th>
                                    <th>e₀</th>
                                    <th>a₂</th>
                                    <th>a₁</th>
                                    <th>a₀</th>
                                    <th>Dezimal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int row = 0; row < 8; row++)
                                {
                                    var r = row;
                                    var re2 = (r & 4) != 0;
                                    var re1 = (r & 2) != 0;
                                    var re0 = (r & 1) != 0;
                                    var ra0 = !re0;
                                    var ra1 = re1 ^ re0;
                                    var ra2 = re2 ^ (re1 && re0);
                                    var nextDec = (r + 1) % 8;
                                    var isCurRow = (CounterDecimal == r);

                                    <tr class="@(isCurRow ? "highlight-row" : "")" style="cursor:pointer;" @onclick="() => SetCounterValue(r)">
                                        <td class="@(re2 ? "td-active-one" : "td-zero")">@(re2 ? "1" : "0")</td>
                                        <td class="@(re1 ? "td-active-one" : "td-zero")">@(re1 ? "1" : "0")</td>
                                        <td class="@(re0 ? "td-active-one" : "td-zero")">@(re0 ? "1" : "0")</td>
                                        <td class="@(ra2 ? "td-active-out" : "td-zero")">@(ra2 ? "1" : "0")</td>
                                        <td class="@(ra1 ? "td-active-out" : "td-zero")">@(ra1 ? "1" : "0")</td>
                                        <td class="@(ra0 ? "td-active-out" : "td-zero")">@(ra0 ? "1" : "0")</td>
                                        <td class="td-status-active">
                                            @if (isCurRow)
                                            {
                                                <strong class="emerald">@r &rarr; @nextDec ◀</strong>
                                            }
                                            else
                                            {
                                                <span>@r &rarr; @nextDec</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary Box -->
                    <div class="circuit-summary-box">
                        <div class="summary-item">
                            <span>Status:</span>
                            <strong class="mono blue">@(CounterSequential ? "Taktgesteuert" : "Manuell")</strong>
                        </div>
                        <div class="summary-item">
                            <span>Zähler:</span>
                            <strong class="mono purple">@CounterDecimal (Zustand S@CounterDecimal)</strong>
                        </div>
                        <div class="summary-item">
                            <span>Nächster Takt:</span>
                            <strong class="mono emerald">&rarr; @NextCounterValue (S@NextCounterValue)</strong>
                        </div>
                    </div>
                </div>

            </div>
        }
        else if (SelectedCircuit == CircuitType.Gates)
        {
            <!-- Basic Gates Grid -->
            <div class="gates-grid">
                <div class="inputs-bar">
                    <span class="bar-label">Eingangssignale:</span>
                    <button class="toggle-btn @(InputA ? "high" : "low")" @onclick="() => InputA = !InputA">
