@namespace Italbytz.Systems.Blazor.Components.ComputingSystems

<div class="napier-card">
    <div class="napier-header">
        <div>
            <h3 class="napier-title">Napiersche Rechenstäbe (Napier's Bones)</h3>
            <p class="napier-subtitle">
                Historisches Multiplikationsverfahren (John Napier, 1617) nach dem Prinzip der Gelosia-Multiplikation.
            </p>
        </div>
    </div>

    <!-- Controls -->
    <div class="napier-controls">
        <div class="control-group">
            <label class="control-label">Zu multiplizierende Zahl (Faktor 1):</label>
            <div class="input-with-buttons">
                <input type="number" min="1" max="999999" @bind="NumberInput" @bind:after="UpdateRods" class="napier-input" />
                <button class="preset-btn" @onclick="() => SetPreset(1423)">Bsp: 1423</button>
                <button class="preset-btn" @onclick="() => SetPreset(739)">Bsp: 739</button>
                <button class="preset-btn" @onclick="() => SetPreset(5824)">Bsp: 5824</button>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">Multiplikator (Faktor 2): <strong>@Multiplier</strong></label>
            <div class="multiplier-bar">
                @for (int m = 1; m <= 9; m++)
                {
                    var currentM = m;
                    <button class="multiplier-btn @(Multiplier == currentM ? "active" : "")" @onclick="() => SetMultiplier(currentM)">
                        × @currentM
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Interactive Rods Board -->
    <div class="rods-board-container">
        <div class="rods-board">
            <!-- Index Rod on Left -->
            <div class="rod index-rod">
                <div class="rod-cap">×</div>
                @for (int r = 1; r <= 9; r++)
                {
                    var row = r;
                    <div class="rod-cell index-cell @(Multiplier == row ? "active-row" : "")" @onclick="() => SetMultiplier(row)">
                        <strong>@row</strong>
                    </div>
                }
            </div>

            <!-- Value Rods -->
            @for (int i = 0; i < RodDigits.Count; i++)
            {
                var digit = RodDigits[i];
                <div class="rod value-rod">
                    <div class="rod-cap">@digit</div>
                    @for (int r = 1; r <= 9; r++)
                    {
                        var row = r;
                        var prod = digit * row;
                        var tens = prod / 10;
                        var units = prod % 10;
                        <div class="rod-cell value-cell @(Multiplier == row ? "active-row" : "")">
                            <svg viewBox="0 0 40 40" class="diagonal-box">
                                <line x1="0" y1="40" x2="40" y2="0" stroke="#cbd5e1" stroke-width="1.5" />
                                <text x="8" y="15" class="cell-tens">@tens</text>
                                <text x="28" y="32" class="cell-units">@units</text>
                            </svg>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Calculation Breakdown -->
    <div class="result-breakdown">
        <div class="breakdown-heading">
            <h4>Ergebnisermittlung für @CurrentNumber × @Multiplier:</h4>
        </div>
        <div class="steps-flow">
            <div class="flow-item">
                <span class="step-label">Diagonale Additionen (von rechts nach links):</span>
                <div class="diagonal-sum-list">
                    @for (int k = DiagonalSteps.Count - 1; k >= 0; k--)
                    {
                        var step = DiagonalSteps[k];
                        <span class="diagonal-step-badge">
                            @step.Expression = <strong>@step.Digit</strong> @(step.Carry > 0 ? $"(Übertrag: {step.Carry})" : "")
                        </span>
                    }
                </div>
            </div>
            <div class="total-result-box">
                <span>Endergebnis:</span>
                <strong class="total-number">@CurrentNumber × @Multiplier = @(CurrentNumber * Multiplier)</strong>
            </div>
        </div>
    </div>
</div>

