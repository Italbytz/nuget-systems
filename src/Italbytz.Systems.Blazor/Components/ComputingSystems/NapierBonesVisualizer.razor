@code {
    private int NumberInput = 1423;
    private int CurrentNumber = 1423;
    private int Multiplier = 5;
    private List<int> RodDigits = new() { 1, 4, 2, 3 };

    private record DiagonalStep(string Expression, int Digit, int Carry);
    private List<DiagonalStep> DiagonalSteps = new();

    protected override void OnInitialized()
    {
        UpdateRods();
    }

    private void SetPreset(int number)
    {
        NumberInput = number;
        UpdateRods();
    }

    private void SetMultiplier(int m)
    {
        Multiplier = m;
        CalculateSteps();
    }

    private void UpdateRods()
    {
        if (NumberInput < 1) NumberInput = 1;
        CurrentNumber = NumberInput;
        RodDigits = CurrentNumber.ToString().Select(c => c - '0').ToList();
        CalculateSteps();
    }

    private void CalculateSteps()
    {
        DiagonalSteps.Clear();
        // Calculate products for each rod at current multiplier
        var products = RodDigits.Select(d => d * Multiplier).ToList();
        
        // Sum along diagonals from right (units) to left
        int carry = 0;
        for (int i = products.Count - 1; i >= 0; i--)
        {
            int units = products[i] % 10;
            int sum = units + carry;
            
            int nextTens = (i > 0) ? (products[i - 1] / 10) : 0;
            string expr = (carry > 0) ? $"{units} + Übertrag {carry}" : $"{units}";
            if (i < products.Count - 1)
            {
                int prevTens = products[i] / 10;
                // combined diagonal expression
            }
            
            // Standard Gelosia diagonal calculation
            // Position k has units of digit i and tens of digit i+1
        }

        // Rigorous Gelosia diagonal summation:
        int numDigits = RodDigits.Count;
        int currentCarry = 0;
        
        // Diagonal 0: units of last digit
        int rightmost = products[^1] % 10;
        int d0Sum = rightmost;
        int out0 = d0Sum % 10;
        currentCarry = d0Sum / 10;
        DiagonalSteps.Add(new DiagonalStep($"Einer: {rightmost}", out0, currentCarry));

        // Intermediate diagonals
        for (int i = numDigits - 1; i >= 1; i--)
        {
            int tensRight = products[i] / 10;
            int unitsLeft = products[i - 1] % 10;
            int diagSum = tensRight + unitsLeft + currentCarry;
            int outDigit = diagSum % 10;
            string expr = $"{tensRight} + {unitsLeft}" + (currentCarry > 0 ? $" + {currentCarry}" : "");
            currentCarry = diagSum / 10;
            DiagonalSteps.Add(new DiagonalStep(expr, outDigit, currentCarry));
        }

        // Leftmost diagonal (tens of first digit)
        int leftmostTens = products[0] / 10;
        int lastSum = leftmostTens + currentCarry;
        if (lastSum > 0 || numDigits == 1)
        {
            string expr = $"{leftmostTens}" + (currentCarry > 0 ? $" + {currentCarry}" : "");
            DiagonalSteps.Add(new DiagonalStep(expr, lastSum, 0));
        }
    }
}
