                <!-- x1 -->
                <text x="15" y="84" class="pin-label">x₁</text>
                <text x="15" y="95" class="pin-val">@(IsWorksheet ? "" : (mx1 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="80" x2="100" y2="80" class="wire @GetWireClass(mx1)" />
                <circle cx="60" cy="80" r="3" class="wire-dot @GetDotClass(mx1)" />
                <path fill="none" d="M 60 80 L 60 140 L 100 140" class="wire @GetWireClass(mx1)" />

