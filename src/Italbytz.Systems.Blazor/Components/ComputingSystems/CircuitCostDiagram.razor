                <text x="125" y="92" class="gate-box-text">≥1</text>
                <path fill="none" d="M 150 92 L 175 92 L 175 60 L 220 60" class="wire @GetWireClass(mwa)" />

                <!-- Gb (AND 1, Stufe 1) -->
                <rect x="100" y="130" width="50" height="44" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="125" y="152" class="gate-box-text">@("&")</text>
                <path fill="none" d="M 150 152 L 290 152 L 290 118 L 340 118" class="wire @GetWireClass(mwb)" />

