                <circle cx="65" cy="155" r="3" class="wire-dot @GetDotClass(mx1)" />
                <line fill="none" x1="65" y1="155" x2="130" y2="155" class="wire @GetWireClass(mx1)" />

                <!-- x0 -->
                <text x="12" y="119" class="pin-label">x₀</text>
                <text x="12" y="130" class="pin-val">@(IsWorksheet ? "" : (mx0 ? "1" : "0"))</text>
                <line fill="none" x1="28" y1="115" x2="85" y2="115" class="wire @GetWireClass(mx0)" />
                <line fill="none" x1="85" y1="115" x2="85" y2="175" class="wire @GetWireClass(mx0)" />
                <circle cx="85" cy="115" r="3" class="wire-dot @GetDotClass(mx0)" />
                <line fill="none" x1="85" y1="115" x2="130" y2="115" class="wire @GetWireClass(mx0)" />
                <circle cx="85" cy="175" r="3" class="wire-dot @GetDotClass(mx0)" />
                <line fill="none" x1="85" y1="175" x2="130" y2="175" class="wire @GetWireClass(mx0)" />

                <!-- G1 (AND 1: x2 ∧ x1) -->
                <rect x="130" y="25" width="50" height="44" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="155" y="47" class="gate-box-text">@("&")</text>
                <path fill="none" d="M 180 47 L 215 47 L 215 92 L 270 92" class="wire @GetWireClass(mw1)" />

                <!-- G2 (AND 2: x2 ∧ x0) -->
                <rect x="130" y="85" width="50" height="44" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="155" y="107" class="gate-box-text">@("&")</text>
                <line fill="none" x1="180" y1="107" x2="270" y2="107" class="wire @GetWireClass(mw2)" />

                <!-- G3 (AND 3: x1 ∧ x0) -->
                <rect x="130" y="145" width="50" height="44" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="155" y="167" class="gate-box-text">@("&")</text>
                <path fill="none" d="M 180 167 L 215 167 L 215 122 L 270 122" class="wire @GetWireClass(mw3)" />

                <!-- G4 (OR Fan-In 3) -->
                <rect x="270" y="82" width="50" height="50" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="295" y="107" class="gate-box-text">≥1</text>
                <!-- Ausgang y -->
                <line fill="none" x1="320" y1="107" x2="365" y2="107" class="wire @GetWireClass(mwy)" />
                <text x="375" y="111" class="pin-label">y</text>
                <text x="375" y="123" class="pin-val">@(IsWorksheet ? "" : (mwy ? "=1" : "=0"))</text>
            </svg>
        }
        else
        {
