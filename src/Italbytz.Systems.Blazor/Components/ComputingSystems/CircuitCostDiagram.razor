            bool mx0 = InputValues != null && InputValues.Length > 0 && InputValues[0];
            bool mwa = mx1 || mx0;
            bool mwb = mx1 && mx0;
            bool mwc = mx2 && mwa;
            bool mwyd = mwc || mwb;

