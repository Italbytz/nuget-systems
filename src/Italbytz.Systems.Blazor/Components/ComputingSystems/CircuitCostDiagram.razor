                <line fill="none" x1="185" y1="10" x2="185" y2="185" class="stage-divider" />
                <text x="245" y="14" class="stage-label-text">Stufe 2</text>
                <line fill="none" x1="305" y1="10" x2="305" y2="185" class="stage-divider" />
                <text x="365" y="14" class="stage-label-text">Stufe 3</text>

                <!-- Eingänge & Leitungen -->
                <!-- x0 -->
                <text x="15" y="39" class="pin-label">x₀</text>
                <text x="15" y="50" class="pin-val">@(IsWorksheet ? "" : (in0 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="35" x2="95" y2="35" class="wire @GetWireClass(in0)" />

                <!-- x1 -->
                <text x="15" y="67" class="pin-label">x₁</text>
                <text x="15" y="78" class="pin-val">@(IsWorksheet ? "" : (in1 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="63" x2="95" y2="63" class="wire @GetWireClass(in1)" />

                <!-- x2 -->
                <text x="15" y="117" class="pin-label">x₂</text>
                <text x="15" y="128" class="pin-val">@(IsWorksheet ? "" : (in2 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="113" x2="220" y2="113" class="wire @GetWireClass(in2)" />

                <!-- x3 -->
                <text x="15" y="167" class="pin-label">x₃</text>
                <text x="15" y="178" class="pin-val">@(IsWorksheet ? "" : (in3 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="163" x2="340" y2="163" class="wire @GetWireClass(in3)" />

                <!-- Gatter 1 (Stufe 1, XOR) -->
                <rect x="95" y="25" width="50" height="48" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="120" y="49" class="gate-box-text">=1</text>
                <text x="120" y="63" class="gate-sub-text">XOR 1</text>
                <!-- Leitung w1 -->
                <path fill="none" d="M 145 49 L 170 49 L 170 85 L 220 85" class="wire @GetWireClass(w1)" />

                <!-- Gatter 2 (Stufe 2, XOR) -->
                <rect x="220" y="75" width="50" height="48" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="245" y="99" class="gate-box-text">=1</text>
                <text x="245" y="113" class="gate-sub-text">XOR 2</text>
                <!-- Leitung w2 -->
                <path fill="none" d="M 270 99 L 290 99 L 290 135 L 340 135" class="wire @GetWireClass(w2)" />

                <!-- Gatter 3 (Stufe 3, XOR) -->
                <rect x="340" y="125" width="50" height="48" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="365" y="149" class="gate-box-text">=1</text>
                <text x="365" y="163" class="gate-sub-text">XOR 3</text>
                <!-- Ausgang y -->
                <line fill="none" x1="390" y1="149" x2="430" y2="149" class="wire @GetWireClass(w3)" />
                <text x="438" y="153" class="pin-label">y</text>
                <text x="438" y="165" class="pin-val">@(IsWorksheet ? "" : (w3 ? "=1" : "=0"))</text>
            </svg>
        }
        else
        {
            bool in0 = InputValues != null && InputValues.Length > 0 && InputValues[0];
            bool in1 = InputValues != null && InputValues.Length > 1 && InputValues[1];
            bool in2 = InputValues != null && InputValues.Length > 2 && InputValues[2];
            bool in3 = InputValues != null && InputValues.Length > 3 && InputValues[3];
            bool wa = in0 ^ in1;
            bool wb = in2 ^ in3;
            bool wc = wa ^ wb;

            <svg viewBox="0 0 380 200" class="circuit-svg" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <style>
                        .wire { fill: none; stroke-width: 2.2px; stroke-linecap: round; stroke-linejoin: round; }
                        .wire-high { stroke: #2563eb; }
                        .wire-low { stroke: #94a3b8; }
                        .wire-neutral { stroke: #334155; }
                        .gate-box { fill: #ffffff; stroke: #1e293b; stroke-width: 1.8px; }
