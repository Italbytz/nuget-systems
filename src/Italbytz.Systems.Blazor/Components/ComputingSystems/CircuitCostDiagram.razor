                        .stage-label-text { fill: #64748b; font-size: 10px; font-weight: 700; text-anchor: middle; letter-spacing: 0.05em; text-transform: uppercase; }
                        .inversion-bubble { fill: #ffffff; stroke: #1e293b; stroke-width: 1.5px; }
                        .wire-dot.dot-high { fill: #2563eb; }
                        .wire-dot.dot-low { fill: #94a3b8; }
                    </style>
                </defs>
                <!-- Stufen-Markierungen -->
                <text x="155" y="14" class="stage-label-text">Stufe 1</text>
                <line fill="none" x1="240" y1="10" x2="240" y2="205" class="stage-divider" />
                <text x="295" y="14" class="stage-label-text">Stufe 2</text>

                <!-- Eingänge & Verteilerschienen (Bus) -->
                <!-- x2 -->
                <text x="12" y="39" class="pin-label">x₂</text>
                <text x="12" y="50" class="pin-val">@(IsWorksheet ? "" : (mx2 ? "1" : "0"))</text>
                <line fill="none" x1="28" y1="35" x2="45" y2="35" class="wire @GetWireClass(mx2)" />
                <line fill="none" x1="45" y1="35" x2="45" y2="95" class="wire @GetWireClass(mx2)" />
                <circle cx="45" cy="35" r="3" class="wire-dot @GetDotClass(mx2)" />
                <line fill="none" x1="45" y1="35" x2="130" y2="35" class="wire @GetWireClass(mx2)" />
                <circle cx="45" cy="95" r="3" class="wire-dot @GetDotClass(mx2)" />
                <line fill="none" x1="45" y1="95" x2="130" y2="95" class="wire @GetWireClass(mx2)" />

                <!-- x1 -->
                <text x="12" y="69" class="pin-label">x₁</text>
                <text x="12" y="80" class="pin-val">@(IsWorksheet ? "" : (mx1 ? "1" : "0"))</text>
                <line fill="none" x1="28" y1="65" x2="65" y2="65" class="wire @GetWireClass(mx1)" />
                <line fill="none" x1="65" y1="55" x2="65" y2="155" class="wire @GetWireClass(mx1)" />
