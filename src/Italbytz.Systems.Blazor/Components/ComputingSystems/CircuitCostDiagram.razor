                <defs>
                    <style>
                        .wire { fill: none; stroke-width: 2.2px; stroke-linecap: round; stroke-linejoin: round; }
                        .wire-high { stroke: #2563eb; }
                        .wire-low { stroke: #94a3b8; }
                        .wire-neutral { stroke: #334155; }
                        .gate-box { fill: #ffffff; stroke: #1e293b; stroke-width: 1.8px; }
                        .gate-box-text { fill: #0f172a; font-size: 15px; font-weight: 700; text-anchor: middle; dominant-baseline: central; font-family: ui-monospace, monospace; }
                        .gate-sub-text { fill: #64748b; font-size: 10px; font-weight: 600; text-anchor: middle; dominant-baseline: central; }
                        .pin-label { fill: #1e293b; font-size: 13px; font-weight: 700; font-family: system-ui, sans-serif; font-style: italic; }
                        .pin-val { fill: #64748b; font-size: 10px; font-weight: 600; font-family: ui-monospace, monospace; }
                        .stage-divider { stroke: #cbd5e1; stroke-width: 1.2px; stroke-dasharray: 4, 4; fill: none; }
                        .stage-label-text { fill: #64748b; font-size: 10px; font-weight: 700; text-anchor: middle; letter-spacing: 0.05em; text-transform: uppercase; }
                        .inversion-bubble { fill: #ffffff; stroke: #1e293b; stroke-width: 1.5px; }
                        .wire-dot.dot-high { fill: #2563eb; }
                        .wire-dot.dot-low { fill: #94a3b8; }
                    </style>
                </defs>
                <!-- Stufen-Markierungen -->
                <text x="120" y="14" class="stage-label-text">Stufe 1</text>
                <line fill="none" x1="195" y1="10" x2="195" y2="185" class="stage-divider" />
                <text x="260" y="14" class="stage-label-text">Stufe 2</text>

                <!-- Eingänge & Leitungen -->
                <!-- a1, b1 -->
                <text x="15" y="39" class="pin-label">a₁</text>
                <text x="15" y="50" class="pin-val">@(IsWorksheet ? "" : (ca1 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="35" x2="95" y2="35" class="wire @GetWireClass(ca1)" />

                <text x="15" y="67" class="pin-label">b₁</text>
                <text x="15" y="78" class="pin-val">@(IsWorksheet ? "" : (cb1 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="63" x2="95" y2="63" class="wire @GetWireClass(cb1)" />

                <!-- a0, b0 -->
                <text x="15" y="139" class="pin-label">a₀</text>
                <text x="15" y="150" class="pin-val">@(IsWorksheet ? "" : (ca0 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="135" x2="95" y2="135" class="wire @GetWireClass(ca0)" />

                <text x="15" y="167" class="pin-label">b₀</text>
                <text x="15" y="178" class="pin-val">@(IsWorksheet ? "" : (cb0 ? "1" : "0"))</text>
                <line fill="none" x1="30" y1="163" x2="95" y2="163" class="wire @GetWireClass(cb0)" />

                <!-- G1 (XNOR 1: a1 == b1) -->
                <rect x="95" y="25" width="50" height="48" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="120" y="49" class="gate-box-text">=1</text>
                <circle cx="148.5" cy="49" r="3.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />
                <path fill="none" d="M 152 49 L 175 49 L 175 85 L 235 85" class="wire @GetWireClass(cw1)" />

                <!-- G2 (XNOR 0: a0 == b0) -->
                <rect x="95" y="125" width="50" height="48" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="120" y="149" class="gate-box-text">=1</text>
                <circle cx="148.5" cy="149" r="3.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />
                <path fill="none" d="M 152 149 L 175 149 L 175 113 L 235 113" class="wire @GetWireClass(cw2)" />

                <!-- G3 (AND: w1 ∧ w2) -->
                <rect x="235" y="75" width="50" height="48" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="260" y="99" class="gate-box-text">@("&")</text>
                <!-- Ausgang y -->
                <line fill="none" x1="285" y1="99" x2="340" y2="99" class="wire @GetWireClass(cwy)" />
                <text x="350" y="103" class="pin-label">y</text>
                <text x="350" y="115" class="pin-val">@(IsWorksheet ? "" : (cwy ? "=1" : "=0"))</text>
            </svg>
        }
        else
        {
            bool ca1 = InputValues != null && InputValues.Length > 1 && InputValues[1];
            bool ca0 = InputValues != null && InputValues.Length > 0 && InputValues[0];
            bool cb1 = InputValues != null && InputValues.Length > 3 && InputValues[3];
            bool cb0 = InputValues != null && InputValues.Length > 2 && InputValues[2];
            bool cm0 = !ca1 && !ca0 && !cb1 && !cb0;
            bool cm5 = !ca1 && ca0 && !cb1 && cb0;
            bool cm10 = ca1 && !ca0 && cb1 && !cb0;
            bool cm15 = ca1 && ca0 && cb1 && cb0;
            bool cwyd = cm0 || cm5 || cm10 || cm15;

            <svg viewBox="0 0 460 250" class="circuit-svg" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <style>
                        .wire { fill: none; stroke-width: 2.2px; stroke-linecap: round; stroke-linejoin: round; }
                        .wire-high { stroke: #2563eb; }
                        .wire-low { stroke: #94a3b8; }
                        .wire-neutral { stroke: #334155; }
                        .gate-box { fill: #ffffff; stroke: #1e293b; stroke-width: 1.8px; }
                        .gate-box-text { fill: #0f172a; font-size: 15px; font-weight: 700; text-anchor: middle; dominant-baseline: central; font-family: ui-monospace, monospace; }
                        .gate-sub-text { fill: #64748b; font-size: 10px; font-weight: 600; text-anchor: middle; dominant-baseline: central; }
                        .pin-label { fill: #1e293b; font-size: 13px; font-weight: 700; font-family: system-ui, sans-serif; font-style: italic; }
                        .pin-val { fill: #64748b; font-size: 10px; font-weight: 600; font-family: ui-monospace, monospace; }
                        .stage-divider { stroke: #cbd5e1; stroke-width: 1.2px; stroke-dasharray: 4, 4; fill: none; }
                        .stage-label-text { fill: #64748b; font-size: 10px; font-weight: 700; text-anchor: middle; letter-spacing: 0.05em; text-transform: uppercase; }
                        .inversion-bubble { fill: #ffffff; stroke: #1e293b; stroke-width: 1.5px; }
                        .wire-dot.dot-high { fill: #2563eb; }
                        .wire-dot.dot-low { fill: #94a3b8; }
                    </style>
                </defs>
                <!-- Stufen-Markierungen -->
                <text x="165" y="14" class="stage-label-text">Stufe 1</text>
                <line fill="none" x1="260" y1="10" x2="260" y2="235" class="stage-divider" />
                <text x="330" y="14" class="stage-label-text">Stufe 2</text>

                <!-- Eingangs-Bus links -->
                <!-- a1 -->
                <text x="8" y="29" class="pin-label">a₁</text>
                <line fill="none" x1="26" y1="25" x2="40" y2="25" class="wire @GetWireClass(ca1)" />
                <line fill="none" x1="40" y1="25" x2="40" y2="200" class="wire @GetWireClass(ca1)" />
                <circle cx="40" cy="25" r="2.5" class="wire-dot @GetDotClass(ca1)" />

                <!-- a0 -->
                <text x="8" y="54" class="pin-label">a₀</text>
                <line fill="none" x1="26" y1="50" x2="55" y2="50" class="wire @GetWireClass(ca0)" />
                <line fill="none" x1="55" y1="50" x2="55" y2="208" class="wire @GetWireClass(ca0)" />
                <circle cx="55" cy="50" r="2.5" class="wire-dot @GetDotClass(ca0)" />

                <!-- b1 -->
                <text x="8" y="79" class="pin-label">b₁</text>
                <line fill="none" x1="26" y1="75" x2="70" y2="75" class="wire @GetWireClass(cb1)" />
                <line fill="none" x1="70" y1="75" x2="70" y2="216" class="wire @GetWireClass(cb1)" />
                <circle cx="70" cy="75" r="2.5" class="wire-dot @GetDotClass(cb1)" />

                <!-- b0 -->
                <text x="8" y="104" class="pin-label">b₀</text>
                <line fill="none" x1="26" y1="100" x2="85" y2="100" class="wire @GetWireClass(cb0)" />
                <line fill="none" x1="85" y1="100" x2="85" y2="224" class="wire @GetWireClass(cb0)" />
                <circle cx="85" cy="100" r="2.5" class="wire-dot @GetDotClass(cb0)" />

                <!-- ================= M0: ¬a₁ ∧ ¬a₀ ∧ ¬b₁ ∧ ¬b₀ ================= -->
                <!-- Bus Taps zu M0 (y=26, 32, 38, 44) -->
                <circle cx="40" cy="26" r="2.5" class="wire-dot @GetDotClass(ca1)" />
                <line fill="none" x1="40" y1="26" x2="132" y2="26" class="wire @GetWireClass(ca1)" />
                <circle cx="135" cy="26" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <circle cx="55" cy="32" r="2.5" class="wire-dot @GetDotClass(ca0)" />
                <line fill="none" x1="55" y1="32" x2="132" y2="32" class="wire @GetWireClass(ca0)" />
                <circle cx="135" cy="32" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <circle cx="70" cy="38" r="2.5" class="wire-dot @GetDotClass(cb1)" />
                <line fill="none" x1="70" y1="38" x2="132" y2="38" class="wire @GetWireClass(cb1)" />
                <circle cx="135" cy="38" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <circle cx="85" cy="44" r="2.5" class="wire-dot @GetDotClass(cb0)" />
                <line fill="none" x1="85" y1="44" x2="132" y2="44" class="wire @GetWireClass(cb0)" />
                <circle cx="135" cy="44" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <rect x="138" y="20" width="52" height="36" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="164" y="38" class="gate-box-text">@("&")</text>
                <text x="105" y="16" class="gate-sub-text">m₀</text>
                <path fill="none" d="M 190 38 L 240 38 L 240 87 L 290 87" class="wire @GetWireClass(cm0)" />

                <!-- ================= M5: ¬a₁ ∧ a₀ ∧ ¬b₁ ∧ b₀ ================= -->
                <circle cx="40" cy="80" r="2.5" class="wire-dot @GetDotClass(ca1)" />
                <line fill="none" x1="40" y1="80" x2="132" y2="80" class="wire @GetWireClass(ca1)" />
                <circle cx="135" cy="80" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <circle cx="55" cy="86" r="2.5" class="wire-dot @GetDotClass(ca0)" />
                <line fill="none" x1="55" y1="86" x2="138" y2="86" class="wire @GetWireClass(ca0)" />

                <circle cx="70" cy="92" r="2.5" class="wire-dot @GetDotClass(cb1)" />
                <line fill="none" x1="70" y1="92" x2="132" y2="92" class="wire @GetWireClass(cb1)" />
                <circle cx="135" cy="92" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <circle cx="85" cy="98" r="2.5" class="wire-dot @GetDotClass(cb0)" />
                <line fill="none" x1="85" y1="98" x2="138" y2="98" class="wire @GetWireClass(cb0)" />

                <rect x="138" y="74" width="52" height="36" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="164" y="92" class="gate-box-text">@("&")</text>
                <text x="105" y="70" class="gate-sub-text">m₅</text>
                <path fill="none" d="M 190 92 L 225 92 L 225 103 L 290 103" class="wire @GetWireClass(cm5)" />

                <!-- ================= M10: a₁ ∧ ¬a₀ ∧ b₁ ∧ ¬b₀ ================= -->
                <circle cx="40" cy="134" r="2.5" class="wire-dot @GetDotClass(ca1)" />
                <line fill="none" x1="40" y1="134" x2="138" y2="134" class="wire @GetWireClass(ca1)" />

                <circle cx="55" cy="140" r="2.5" class="wire-dot @GetDotClass(ca0)" />
                <line fill="none" x1="55" y1="140" x2="132" y2="140" class="wire @GetWireClass(ca0)" />
                <circle cx="135" cy="140" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <circle cx="70" cy="146" r="2.5" class="wire-dot @GetDotClass(cb1)" />
                <line fill="none" x1="70" y1="146" x2="138" y2="146" class="wire @GetWireClass(cb1)" />

                <circle cx="85" cy="152" r="2.5" class="wire-dot @GetDotClass(cb0)" />
                <line fill="none" x1="85" y1="152" x2="132" y2="152" class="wire @GetWireClass(cb0)" />
                <circle cx="135" cy="152" r="2.5" fill="#ffffff" stroke="#1e293b" class="inversion-bubble" />

                <rect x="138" y="128" width="52" height="36" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="164" y="146" class="gate-box-text">@("&")</text>
                <text x="105" y="124" class="gate-sub-text">m₁₀</text>
                <path fill="none" d="M 190 146 L 225 146 L 225 137 L 290 137" class="wire @GetWireClass(cm10)" />

                <!-- ================= M15: a₁ ∧ a₀ ∧ b₁ ∧ b₀ ================= -->
                <circle cx="40" cy="188" r="2.5" class="wire-dot @GetDotClass(ca1)" />
                <line fill="none" x1="40" y1="188" x2="138" y2="188" class="wire @GetWireClass(ca1)" />

                <circle cx="55" cy="194" r="2.5" class="wire-dot @GetDotClass(ca0)" />
                <line fill="none" x1="55" y1="194" x2="138" y2="194" class="wire @GetWireClass(ca0)" />

                <circle cx="70" cy="200" r="2.5" class="wire-dot @GetDotClass(cb1)" />
                <line fill="none" x1="70" y1="200" x2="138" y2="200" class="wire @GetWireClass(cb1)" />

                <circle cx="85" cy="206" r="2.5" class="wire-dot @GetDotClass(cb0)" />
                <line fill="none" x1="85" y1="206" x2="138" y2="206" class="wire @GetWireClass(cb0)" />

                <rect x="138" y="182" width="52" height="36" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="164" y="200" class="gate-box-text">@("&")</text>
                <text x="105" y="178" class="gate-sub-text">m₁₅</text>
                <path fill="none" d="M 190 200 L 240 200 L 240 153 L 290 153" class="wire @GetWireClass(cm15)" />

                <!-- ================= OR-4 Gatter ================= -->
                <rect x="290" y="75" width="52" height="90" rx="4" fill="#ffffff" stroke="#1e293b" class="gate-box" />
                <text x="316" y="120" class="gate-box-text">≥1</text>
                <!-- Ausgang y -->
                <line fill="none" x1="342" y1="120" x2="400" y2="120" class="wire @GetWireClass(cwyd)" />
                <text x="410" y="124" class="pin-label">y</text>
                <text x="410" y="136" class="pin-val">@(IsWorksheet ? "" : (cwyd ? "=1" : "=0"))</text>
            </svg>
        }
    }
</div>

@code {
    [Parameter] public int ModelId { get; set; } = 0;
    [Parameter] public string Variant { get; set; } = "A";
    [Parameter] public bool[]? InputValues { get; set; }
    [Parameter] public bool IsWorksheet { get; set; } = false;

    private string GetWireClass(bool val) => IsWorksheet ? "wire-neutral" : (val ? "wire-high" : "wire-low");
    private string GetDotClass(bool val) => IsWorksheet ? "" : (val ? "dot-high" : "dot-low");
}
