@namespace Italbytz.Systems.Blazor.Components.ComputingSystems
@inject IJSRuntime JSRuntime

<article class="demo-card wide-card">
    <div class="card-heading">
        <p class="feature-kicker">Rechnerarchitektur & Binärarithmetik</p>
        <h2>8-Bit-Binäraddition mit Übertrag</h2>
    </div>

    <!-- View Switcher -->
    <div class="view-switch no-print">
        <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                @onclick="() => ActiveView = ViewMode.Simulator">
            🚀 Interaktiver Simulator (Step-by-Step)
        </button>
        <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                @onclick="() => ActiveView = ViewMode.Worksheet">
            🖨️ Klausur-Arbeitsblatt (Druckansicht)
        </button>
    </div>

    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Input & Randomizer -->
        <div class="input-grid two-up no-print">
            <label>
                <span>Summand A (0 – 255)</span>
                <input type="number" min="0" max="255" value="@AdditionLeft" @onchange="HandleLeftChanged" />
            </label>
            <label>
                <span>Summand B (0 – 255)</span>
                <input type="number" min="0" max="255" value="@AdditionRight" @onchange="HandleRightChanged" />
            </label>
        </div>

        <!-- Step-by-Step Player Controls -->
        <div class="player-toolbar no-print">
            <div class="player-controls">
                <button class="player-btn" title="Neue Zufallsaufgabe" @onclick="RandomizeInputs">
                    🎲 Zufallswerte
                </button>
                <button class="player-btn" title="Zum Start" disabled="@(CurrentStep == 0)" @onclick="ResetPlayer">
                    ⏮ Start
                </button>
                <button class="player-btn" title="Vorheriger Schritt" disabled="@(CurrentStep == 0)" @onclick="PreviousStep">
                    ◀ Zurück
                </button>
                <button class="player-btn primary" title="Nächster Schritt" disabled="@(CurrentStep >= TotalSteps)" @onclick="NextStep">
                    ▶ Nächster Schritt
                </button>
                <button class="player-btn" title="Gesamtlösung anzeigen" disabled="@(CurrentStep >= TotalSteps)" @onclick="CompleteSolution">
                    ⏭ Ende
                </button>
            </div>
            <div class="player-progress">
                @if (CurrentStep == 0)
                {
                    <span>Bereit: Bit 0 (2⁰) als Nächstes</span>
                }
                else if (CurrentStep <= 8)
                {
                    <span>Schritt @CurrentStep von @TotalSteps (Bit @(CurrentStep - 1): 2<sup>@(CurrentStep - 1)</sup> = @(1 << (CurrentStep - 1)))</span>
                }
                else
                {
                    <span>Abgeschlossen: Alle Bits berechnet</span>
                }
            </div>
        </div>

        <!-- Visual Addition Matrix -->
        <div class="addition-matrix">
            <table class="matrix-table">
                <thead>
                    <tr>
                        <th class="matrix-label">Stellenwert</th>
                        <th class="matrix-cell header-cell">2⁸ (256)</th>
                        @for (var b = 7; b >= 0; b--)
                        {
                            <th class="matrix-cell header-cell @(IsActiveBit(b) ? "active-col" : "")">
                                2<sup>@b</sup> (@(1 << b))
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <!-- Summand A -->
                    <tr>
                        <td class="matrix-label">Summand A (@AdditionLeftByte)</td>
                        <td class="matrix-cell dimmed">0</td>
                        @for (var b = 7; b >= 0; b--)
                        {
                            var bit = GetBit(AdditionLeftByte, b);
                            <td class="matrix-cell @(IsActiveBit(b) ? "active-col" : "")">@bit</td>
                        }
                    </tr>
                    <!-- Summand B -->
                    <tr>
                        <td class="matrix-label">+ Summand B (@AdditionRightByte)</td>
                        <td class="matrix-cell dimmed">0</td>
                        @for (var b = 7; b >= 0; b--)
                        {
                            var bit = GetBit(AdditionRightByte, b);
                            <td class="matrix-cell @(IsActiveBit(b) ? "active-col" : "")">@bit</td>
                        }
                    </tr>
                    <!-- Carry Bits -->
                    <tr>
                        <td class="matrix-label">Übertrag (Carry)</td>
                        <td class="matrix-cell carry-cell @(CurrentStep >= 8 && CarryOutBits[7] == 1 ? "active-col" : (CurrentStep < 8 ? "dimmed" : ""))">
                            @(CurrentStep >= 8 ? CarryOutBits[7] : "")
                        </td>
                        @for (var b = 7; b >= 0; b--)
                        {
                            var showCarry = b == 0 ? (CurrentStep >= 0) : (CurrentStep >= b);
                            var carryVal = b == 0 ? 0 : CarryOutBits[b - 1];
                            <td class="matrix-cell carry-cell @(IsActiveBit(b) ? "active-col" : (!showCarry ? "dimmed" : ""))">
                                @(showCarry && (carryVal == 1 || b == 0) ? carryVal.ToString() : (showCarry ? "0" : ""))
                            </td>
                        }
                    </tr>
                    <!-- Divider line -->
                    <tr class="matrix-divider">
                        <td colspan="10"><hr /></td>
                    </tr>
                    <!-- Sum Result -->
                    <tr>
                        <td class="matrix-label"><strong>= Summe (@VisibleSumDec)</strong></td>
                        <td class="matrix-cell sum-cell @(CurrentStep >= 8 && CarryOutBits[7] == 1 ? "active-col" : (CurrentStep < 8 ? "dimmed" : ""))">
                            @(CurrentStep >= 8 ? ((Solution.Sum >> 8) & 1).ToString() : "")
                        </td>
                        @for (var b = 7; b >= 0; b--)
                        {
                            var isCalculated = CurrentStep > b;
                            var sumBit = (Solution.Sum >> b) & 1;
                            <td class="matrix-cell sum-cell @(IsActiveBit(b) ? "active-col" : (!isCalculated ? "dimmed" : ""))">
                                @(isCalculated ? sumBit.ToString() : (IsActiveBit(b) ? "?" : "·"))
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Step Narrative Explanation -->
        @if (CurrentStep > 0 && CurrentStep <= 8)
        {
            var bitIndex = CurrentStep - 1;
            var aBit = GetBit(AdditionLeftByte, bitIndex);
            var bBit = GetBit(AdditionRightByte, bitIndex);
            var cIn = bitIndex == 0 ? 0 : CarryOutBits[bitIndex - 1];
            var part = aBit + bBit + cIn;
            var resBit = part & 1;
            var cOut = (part >> 1) & 1;

            <div class="narrative-card">
                <h4>Erklärung zu Schritt @CurrentStep (Bit @bitIndex, 2<sup>@bitIndex</sup> = @(1 << bitIndex)):</h4>
                <p>
                    Rechnung an Stelle @bitIndex:
                    <strong>Bit A (@aBit) + Bit B (@bBit) + Übertrag_in (@cIn) = @part</strong>
                    &rArr; <strong>Ergebnisbit = @resBit</strong>, neuer <strong>Übertrag (Carry Out) = @cOut</strong>.
                </p>
            </div>
        }
        else if (CurrentStep > 8)
        {
            <div class="narrative-card">
                <h4>Berechnung vollständig!</h4>
                <p>
                    Gesamtsumme: <strong>@AdditionLeftByte + @AdditionRightByte = @Solution.Sum</strong>
                    (Binär: <code>@ToBinary((int)Solution.Sum, Solution.Sum > 255 ? 9 : 8)</code>).
                    @if (Solution.Sum > 255)
                    {
                        <span> Es ist ein 9-Bit-Übertrag (2<sup>8</sup> = 256) entstanden.</span>
                    }
                </p>
            </div>
        }
    }
    else
    {
        <!-- Printable Exam Worksheet -->
        <div class="worksheet-container">
            <div class="worksheet-header">
                <div>
                    <span class="feature-kicker">Übungsblatt & Klausurvorbereitung</span>
                    <h3>Schriftliche Binäraddition (8-Bit)</h3>
                </div>
                <div class="worksheet-toolbar no-print">
                    <button class="player-btn" title="Neue Zufallsaufgabe" @onclick="RandomizeInputs">
                        🎲 Neue Aufgabe
                    </button>
                    <button class="player-btn @(ShowWorksheetSolution ? "active" : "")" @onclick="() => ShowWorksheetSolution = !ShowWorksheetSolution">
                        @(ShowWorksheetSolution ? "👁️ Lösung verbergen" : "👁️ Lösung anzeigen")
                    </button>
                    <button class="player-btn primary" @onclick="PrintWorksheet">
                        🖨️ Drucken / PDF
                    </button>
                </div>
            </div>

            <p class="worksheet-instruction">
                <strong>Aufgabenstellung:</strong> Addieren Sie die beiden 8-Bit-Dualzahlen schriftlich.
                Tragen Sie die Zwischenüberträge (Carry-Bits) in die dafür vorgesehene Zeile ein und ermitteln Sie das Gesamtergebnis.
                @if (ShowWorksheetSolution)
                {
                    <span class="solution-badge">Musterlösung eingeblendet</span>
                }
            </p>

            <div class="addition-matrix">
                <table class="matrix-table">
                    <thead>
                        <tr>
                            <th class="matrix-label">Stellenwert</th>
                            <th class="matrix-cell">2⁸</th>
                            @for (var b = 7; b >= 0; b--)
                            {
                                <th class="matrix-cell">2<sup>@b</sup></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="matrix-label">Summand A</td>
                            <td class="matrix-cell">0</td>
                            @for (var b = 7; b >= 0; b--)
                            {
                                <td class="matrix-cell">@GetBit(AdditionLeftByte, b)</td>
                            }
                        </tr>
                        <tr>
                            <td class="matrix-label">+ Summand B</td>
                            <td class="matrix-cell">0</td>
                            @for (var b = 7; b >= 0; b--)
                            {
                                <td class="matrix-cell">@GetBit(AdditionRightByte, b)</td>
                            }
                        </tr>
                        <tr>
                            <td class="matrix-label">Übertrag (Ü)</td>
                            <td class="matrix-cell carry-cell">
                                @if (ShowWorksheetSolution)
                                {
                                    @((Solution.Sum > 255) ? "1" : "")
                                }
                            </td>
                            @for (var b = 7; b >= 0; b--)
                            {
                                var c = b == 0 ? 0 : CarryOutBits[b - 1];
                                <td class="matrix-cell carry-cell">@(ShowWorksheetSolution && c > 0 ? c.ToString() : "")</td>
                            }
                        </tr>
                        <tr class="result-row">
                            <td class="matrix-label">= Summe</td>
                            <td class="matrix-cell sum-cell">
                                @if (ShowWorksheetSolution)
                                {
                                    @((Solution.Sum > 255) ? "1" : "0")
                                }
                            </td>
                            @for (var b = 7; b >= 0; b--)
                            {
                                var sBit = (Solution.Sum >> b) & 1;
                                <td class="matrix-cell sum-cell">@(ShowWorksheetSolution ? sBit.ToString() : "")</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

            @if (ShowWorksheetSolution)
            {
                <div class="narrative-card">
                    <h4>Musterlösung & Ergebnisprüfung:</h4>
                    <p>
                        A = @(AdditionLeftByte)₁₀ = <strong>@ToBinary(AdditionLeftByte)₂</strong><br />
                        B = @(AdditionRightByte)₁₀ = <strong>@ToBinary(AdditionRightByte)₂</strong><br />
                        <strong>A + B = @AdditionLeftByte + @AdditionRightByte = @(Solution.Sum)₁₀</strong> &rArr; <strong>@ToBinary((int)Solution.Sum, Solution.Sum > 255 ? 9 : 8)₂</strong>
                    </p>
                </div>
            }
        </div>
    }
</article>

@code {
    private enum ViewMode { Simulator, Worksheet }

    private ViewMode ActiveView { get; set; } = ViewMode.Simulator;
    private bool ShowWorksheetSolution { get; set; } = false;

    private readonly BinaryAdditionSolver additionSolver = new();

    [Parameter]
    public int AdditionLeft { get; set; } = 13;

    [Parameter]
    public int AdditionRight { get; set; } = 29;

    private int CurrentStep { get; set; } = 0;
    private int TotalSteps => Solution.Sum > 255 ? 9 : 8;

    private byte AdditionLeftByte => ClampToByte(AdditionLeft);
    private byte AdditionRightByte => ClampToByte(AdditionRight);

    private BinaryAdditionSolution Solution =>
        (BinaryAdditionSolution)additionSolver.Solve(new BinaryAdditionParameters(AdditionLeftByte, AdditionRightByte));

    private int[] CarryOutBits
    {
        get
        {
            var carries = new int[8];
            var c = 0;
            for (var bit = 0; bit < 8; bit++)
            {
                var leftBit = (AdditionLeftByte >> bit) & 1;
                var rightBit = (AdditionRightByte >> bit) & 1;
                var partial = leftBit + rightBit + c;
                c = (partial >> 1) & 1;
                carries[bit] = c;
            }
            return carries;
        }
    }

    private int VisibleSumDec
    {
        get
        {
            if (CurrentStep == 0) return 0;
            var mask = (1 << Math.Min(CurrentStep, 8)) - 1;
            var val = (int)Solution.Sum & mask;
            if (CurrentStep > 8) val = (int)Solution.Sum;
            return val;
        }
    }

    private bool IsActiveBit(int bitIndex)
    {
        return CurrentStep > 0 && (CurrentStep - 1) == bitIndex;
    }

    private static int GetBit(byte value, int bitIndex) => (value >> bitIndex) & 1;
    private static byte ClampToByte(int value) => (byte)Math.Clamp(value, 0, 255);
    private static string ToBinary(int value, int width = 8) => Convert.ToString(value, 2).PadLeft(width, '0');

    private void HandleLeftChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            AdditionLeft = val;
            CurrentStep = 0;
        }
    }

    private void HandleRightChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            AdditionRight = val;
            CurrentStep = 0;
        }
    }

    private void RandomizeInputs()
    {
        AdditionLeft = Random.Shared.Next(5, 180);
        AdditionRight = Random.Shared.Next(5, 120);
        CurrentStep = 0;
    }

    private void NextStep()
    {
        if (CurrentStep < TotalSteps) CurrentStep++;
    }

    private void PreviousStep()
    {
        if (CurrentStep > 0) CurrentStep--;
    }

    private void ResetPlayer()
    {
        CurrentStep = 0;
    }

    private void CompleteSolution()
    {
        CurrentStep = TotalSteps;
    }

    private async Task PrintWorksheet()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }
}
