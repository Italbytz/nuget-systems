@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="moore-container @(IsEmbed ? "is-embedded" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-mode" : "simulator-mode")">
    @if (!IsEmbed)
    {
        <header class="component-header">
            <div class="header-titles">
                <span class="kicker">Grundlagen der Informatik &bull; Technische Informatik</span>
                <h2>Endliche Moore-Zustandsautomaten</h2>
                <p class="subtitle">Zustandsgraphen, synchrone Schaltwerkssynthese &amp; D-Flip-Flop-Steuerung</p>
            </div>
            <div class="view-switcher no-print">
                <button class="btn-toggle @(ActiveView == ViewMode.StepByStep ? "active" : "")" @onclick="() => SetView(ViewMode.StepByStep)">
                    ▶️ Interaktiver Simulator
                </button>
                <button class="btn-toggle @(ActiveView == ViewMode.Worksheet ? "active" : "")" @onclick="() => SetView(ViewMode.Worksheet)">
                    📄 Klausur-Übungsblatt
                </button>
            </div>
        </header>
    }

    @if (ActiveView == ViewMode.StepByStep)
    {
        <!-- CONTROLS & STATUS BAR -->
        <div class="card toolbar-card no-print">
            <div class="toolbar-section">
                <span class="tool-label">Eingangssignal (Zählrichtung):</span>
                <div class="input-toggle-group">
                    <button class="btn-input @(InputSignal == 0 ? "active-backward" : "")" @onclick="() => SetInput(0)">
                        e = 0 (Rückwärts / Halt bei 0)
                    </button>
                    <button class="btn-input @(InputSignal == 1 ? "active-forward" : "")" @onclick="() => SetInput(1)">
                        e = 1 (Vorwärts / Halt bei 2)
                    </button>
                </div>
            </div>

            <div class="toolbar-section clock-controls">
                <button class="btn-clock" @onclick="StepClock" title="Takt-Impuls auslösen">
                    ⏱️ Takt (Clock)
                </button>
                <button class="btn-autoplay @(IsAutoPlaying ? "active-playing" : "")" @onclick="ToggleAutoPlay">
                    @(IsAutoPlaying ? "⏸️ Pause" : "▶️ Auto-Takt")
                </button>
                <button class="btn-reset" @onclick="ResetToS0" title="Auf Anfangszustand S0 zurücksetzen">
                    ↺ Reset (S₀)
                </button>
            </div>

            <div class="toolbar-section state-summary-pill">
                <span class="pill-label">Zustand:</span>
                <strong class="pill-val">S@(CurrentState)</strong>
                <span class="pill-code">(z₀z₁ = @(Z0)@(Z1))</span>
                <span class="pill-sep">&bull;</span>
                <span class="pill-label">Ausgang:</span>
                <strong class="pill-val">@(OutputVal)</strong>
                <span class="pill-code">(a₀a₁ = @(A0)@(A1))</span>
            </div>
        </div>

        <!-- SIMULATOR TABS -->
        <div class="tab-nav no-print">
            <button class="tab-btn @(ActiveTab == SimTab.CircuitAndGraph ? "active" : "")" @onclick="() => ActiveTab = SimTab.CircuitAndGraph">
                🔄 Zustandsgraph &amp; D-Flip-Flop-Schaltwerk
            </button>
            <button class="tab-btn @(ActiveTab == SimTab.TruthTables ? "active" : "")" @onclick="() => ActiveTab = SimTab.TruthTables">
                📋 Wahrheitstafeln (Synthese)
            </button>
            <button class="tab-btn @(ActiveTab == SimTab.KVMaps ? "active" : "")" @onclick="() => ActiveTab = SimTab.KVMaps">
                🗺️ KV-Diagramme &amp; Schaltfunktionen
            </button>
        </div>

        @if (ActiveTab == SimTab.CircuitAndGraph)
        {
            <div class="sim-grid">
                <!-- LEFT: STATE DIAGRAM -->
                <div class="card sim-card">
                    <div class="card-header">
                        <h3>Zustandsübergangsgraph</h3>
                        <span class="badge badge-accent">3 Zustände (S₀, S₁, S₂)</span>
                    </div>
                    <div class="graph-canvas-wrap">
                        <svg viewBox="0 0 460 300" class="state-graph-svg">
                            <!-- Definitions: Arrow Markers -->
                            <defs>
                                <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                    <path d="M 0 1 L 8 5 L 0 9 z" fill="@(IsEmbed ? "#94a3b8" : "#475569")" />
                                </marker>
                                <marker id="arrow-active" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                    <path d="M 0 1 L 8 5 L 0 9 z" fill="#0284c7" />
                                </marker>
                            </defs>

                            <!-- Self Loop S0: e=0 -->
                            <path d="M 75 125 C 20 80, 20 220, 75 175" fill="none"
                                  stroke="@(CurrentState == 0 && InputSignal == 0 ? "#0284c7" : (IsEmbed ? "#334155" : "#cbd5e1"))"
                                  stroke-width="@(CurrentState == 0 && InputSignal == 0 ? "3" : "2")"
                                  marker-end="@(CurrentState == 0 && InputSignal == 0 ? "url(#arrow-active)" : "url(#arrow)")" />
                            <text x="18" y="154" fill="@(CurrentState == 0 && InputSignal == 0 ? "#38bdf8" : (IsEmbed ? "#94a3b8" : "#475569"))" font-size="12" font-weight="bold">e = 0</text>

                            <!-- Forward Edge S0 -> S1: e=1 -->
                            <path d="M 125 130 C 160 105, 200 105, 235 130" fill="none"
                                  stroke="@(CurrentState == 0 && InputSignal == 1 ? "#0284c7" : (IsEmbed ? "#334155" : "#cbd5e1"))"
                                  stroke-width="@(CurrentState == 0 && InputSignal == 1 ? "3" : "2")"
                                  marker-end="@(CurrentState == 0 && InputSignal == 1 ? "url(#arrow-active)" : "url(#arrow)")" />
                            <text x="180" y="105" text-anchor="middle" fill="@(CurrentState == 0 && InputSignal == 1 ? "#38bdf8" : (IsEmbed ? "#94a3b8" : "#475569"))" font-size="12" font-weight="bold">e = 1</text>

                            <!-- Backward Edge S1 -> S0: e=0 -->
                            <path d="M 235 170 C 200 195, 160 195, 125 170" fill="none"
                                  stroke="@(CurrentState == 1 && InputSignal == 0 ? "#0284c7" : (IsEmbed ? "#334155" : "#cbd5e1"))"
                                  stroke-width="@(CurrentState == 1 && InputSignal == 0 ? "3" : "2")"
                                  marker-end="@(CurrentState == 1 && InputSignal == 0 ? "url(#arrow-active)" : "url(#arrow)")" />
                            <text x="180" y="205" text-anchor="middle" fill="@(CurrentState == 1 && InputSignal == 0 ? "#38bdf8" : (IsEmbed ? "#94a3b8" : "#475569"))" font-size="12" font-weight="bold">e = 0</text>

                            <!-- Forward Edge S1 -> S2: e=1 -->
                            <path d="M 285 130 C 320 105, 360 105, 395 130" fill="none"
                                  stroke="@(CurrentState == 1 && InputSignal == 1 ? "#0284c7" : (IsEmbed ? "#334155" : "#cbd5e1"))"
                                  stroke-width="@(CurrentState == 1 && InputSignal == 1 ? "3" : "2")"
                                  marker-end="@(CurrentState == 1 && InputSignal == 1 ? "url(#arrow-active)" : "url(#arrow)")" />
                            <text x="340" y="105" text-anchor="middle" fill="@(CurrentState == 1 && InputSignal == 1 ? "#38bdf8" : (IsEmbed ? "#94a3b8" : "#475569"))" font-size="12" font-weight="bold">e = 1</text>

                            <!-- Backward Edge S2 -> S1: e=0 -->
                            <path d="M 395 170 C 360 195, 320 195, 285 170" fill="none"
                                  stroke="@(CurrentState == 2 && InputSignal == 0 ? "#0284c7" : (IsEmbed ? "#334155" : "#cbd5e1"))"
                                  stroke-width="@(CurrentState == 2 && InputSignal == 0 ? "3" : "2")"
                                  marker-end="@(CurrentState == 2 && InputSignal == 0 ? "url(#arrow-active)" : "url(#arrow)")" />
                            <text x="340" y="205" text-anchor="middle" fill="@(CurrentState == 2 && InputSignal == 0 ? "#38bdf8" : (IsEmbed ? "#94a3b8" : "#475569"))" font-size="12" font-weight="bold">e = 0</text>

                            <!-- Self Loop S2: e=1 -->
                            <path d="M 385 125 C 440 80, 440 220, 385 175" fill="none"
                                  stroke="@(CurrentState == 2 && InputSignal == 1 ? "#0284c7" : (IsEmbed ? "#334155" : "#cbd5e1"))"
                                  stroke-width="@(CurrentState == 2 && InputSignal == 1 ? "3" : "2")"
                                  marker-end="@(CurrentState == 2 && InputSignal == 1 ? "url(#arrow-active)" : "url(#arrow)")" />
                            <text x="442" y="154" fill="@(CurrentState == 2 && InputSignal == 1 ? "#38bdf8" : (IsEmbed ? "#94a3b8" : "#475569"))" font-size="12" font-weight="bold">e = 1</text>

                            <!-- State Nodes -->
                            <!-- Node S0 -->
                            <g class="state-node-g @(CurrentState == 0 ? "is-active-node" : "")" @onclick="() => SetState(0)" style="cursor: pointer;">
                                <circle cx="100" cy="150" r="30" class="node-circle node-s0" />
                                <text x="100" y="145" text-anchor="middle" class="node-text-name">S₀</text>
                                <line x1="80" y1="151" x2="120" y2="151" class="node-divider" />
                                <text x="100" y="165" text-anchor="middle" class="node-text-sub">00 / 0</text>
                            </g>

                            <!-- Node S1 -->
                            <g class="state-node-g @(CurrentState == 1 ? "is-active-node" : "")" @onclick="() => SetState(1)" style="cursor: pointer;">
                                <circle cx="260" cy="150" r="30" class="node-circle node-s1" />
                                <text x="260" y="145" text-anchor="middle" class="node-text-name">S₁</text>
                                <line x1="240" y1="151" x2="280" y2="151" class="node-divider" />
                                <text x="260" y="165" text-anchor="middle" class="node-text-sub">01 / 1</text>
                            </g>

                            <!-- Node S2 -->
                            <g class="state-node-g @(CurrentState == 2 ? "is-active-node" : "")" @onclick="() => SetState(2)" style="cursor: pointer;">
                                <circle cx="360" cy="150" r="30" class="node-circle node-s2" />
                                <text x="360" y="145" text-anchor="middle" class="node-text-name">S₂</text>
                                <line x1="340" y1="151" x2="380" y2="151" class="node-divider" />
                                <text x="360" y="165" text-anchor="middle" class="node-text-sub">10 / 2</text>
                            </g>

                            <!-- Legend / Node Format Note -->
                            <text x="230" y="275" text-anchor="middle" class="graph-legend-text">Knotenaufbau: Name / Zustandskodierung z₀z₁ / Zahlenausgabe</text>
                        </svg>
                    </div>
                </div>

                <!-- RIGHT: SYNCHRONOUS CIRCUIT DIAGRAM -->
                <div class="card sim-card">
                    <div class="card-header">
                        <h3>Synchrones Schaltwerk (Schaltbild)</h3>
                        <span class="badge">2 D-Flip-Flops &amp; Logikgatter</span>
                    </div>
                    <div class="circuit-canvas-wrap">
                        <svg viewBox="0 0 520 300" class="circuit-svg">
                            <!-- FLIP FLOP 0 (Bit z0) -->
                            <g class="flip-flop-group">
                                <rect x="310" y="50" width="70" height="90" rx="4" class="ff-box @(Z0 == 1 ? "ff-active" : "")" />
                                <text x="345" y="72" text-anchor="middle" class="ff-title">FF 0</text>
                                <text x="320" y="95" class="ff-pin">D</text>
                                <text x="370" y="95" text-anchor="end" class="ff-pin">Q</text>
                                <text x="320" y="125" class="ff-pin">&gt;</text>
                                <text x="345" y="130" text-anchor="middle" class="ff-sub">z₀ = @Z0</text>
                            </g>

                            <!-- FLIP FLOP 1 (Bit z1) -->
                            <g class="flip-flop-group">
                                <rect x="310" y="170" width="70" height="90" rx="4" class="ff-box @(Z1 == 1 ? "ff-active" : "")" />
                                <text x="345" y="192" text-anchor="middle" class="ff-title">FF 1</text>
                                <text x="320" y="215" class="ff-pin">D</text>
                                <text x="370" y="215" text-anchor="end" class="ff-pin">Q</text>
                                <text x="320" y="245" class="ff-pin">&gt;</text>
                                <text x="345" y="250" text-anchor="middle" class="ff-sub">z₁ = @Z1</text>
                            </g>

                            <!-- INPUT SIGNAL 'e' -->
                            <g class="input-line-group">
                                <rect x="15" y="130" width="45" height="30" rx="4" class="wire-box @(InputSignal == 1 ? "box-high" : "box-low")" />
                                <text x="37" y="150" text-anchor="middle" class="wire-box-text">e = @InputSignal</text>
                                <line x1="60" y1="145" x2="100" y2="145" class="wire @(InputSignal == 1 ? "wire-high" : "wire-low")" />
                            </g>

                            <!-- CLOCK INPUT -->
                            <g class="clock-line-group">
                                <rect x="230" y="270" width="55" height="24" rx="3" class="clk-box" />
                                <text x="257" y="286" text-anchor="middle" class="clk-text">⏱️ CLK</text>
                                <path d="M 285 282 L 300 282 L 300 125 L 310 125 M 300 245 L 310 245" fill="none" class="wire-clk" />
                            </g>

                            <!-- COMBINATIONAL LOGIC FOR D0 and D1 -->
                            <!-- D0 Logic Block -->
                            <rect x="100" y="60" width="130" height="70" rx="4" class="logic-box" />
                            <text x="165" y="80" text-anchor="middle" class="logic-title">Steuerlogik D₀</text>
                            <text x="165" y="100" text-anchor="middle" class="logic-eq">(e &and; z₀) &or; (e &and; z₁)</text>
                            <text x="165" y="118" text-anchor="middle" class="logic-val">D₀ = @D0Next</text>

                            <!-- Line from D0 block to FF0 D input -->
                            <line x1="230" y1="95" x2="310" y2="95" class="wire @(D0Next == 1 ? "wire-high" : "wire-low")" />

                            <!-- D1 Logic Block -->
                            <rect x="100" y="180" width="130" height="70" rx="4" class="logic-box" />
                            <text x="165" y="200" text-anchor="middle" class="logic-title">Steuerlogik D₁</text>
                            <text x="165" y="218" text-anchor="middle" class="logic-eq">(e &and; &not;z₀ &and; &not;z₁) &or; (&not;e &and; z₀)</text>
                            <text x="165" y="238" text-anchor="middle" class="logic-val">D₁ = @D1Next</text>

                            <!-- Line from D1 block to FF1 D input -->
                            <line x1="230" y1="215" x2="310" y2="215" class="wire @(D1Next == 1 ? "wire-high" : "wire-low")" />

                            <!-- OUTPUTS -->
                            <!-- a0 Output -->
                            <line x1="380" y1="95" x2="430" y2="95" class="wire @(A0 == 1 ? "wire-high" : "wire-low")" />
                            <circle cx="450" cy="95" r="14" class="out-lamp @(A0 == 1 ? "lamp-on" : "lamp-off")" />
                            <text x="450" y="99" text-anchor="middle" class="lamp-label">a₀</text>
                            <text x="475" y="99" class="lamp-sub">= @A0</text>

                            <!-- a1 Output -->
                            <line x1="380" y1="215" x2="430" y2="215" class="wire @(A1 == 1 ? "wire-high" : "wire-low")" />
                            <circle cx="450" cy="215" r="14" class="out-lamp @(A1 == 1 ? "lamp-on" : "lamp-off")" />
                            <text x="450" y="219" text-anchor="middle" class="lamp-label">a₁</text>
                            <text x="475" y="219" class="lamp-sub">= @A1</text>
                        </svg>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == SimTab.TruthTables)
        {
            <!-- TRUTH TABLES FOR SYNTHESIS -->
            <div class="card truth-tables-card">
                <div class="card-header">
                    <h3>Synthese-Wahrheitstafeln (Kodierung mit z₀, z₁)</h3>
                    <span class="badge">Zustände: S₀=00, S₁=01, S₂=10, Don't Care=11</span>
                </div>

                <div class="tables-split-layout">
                    <!-- TRANSITION TABLE -->
                    <div class="table-column">
                        <h4>Übergangsfunktion (Folgezustand z₀ⁿᵉˣᵗ, z₁ⁿᵉˣᵗ)</h4>
                        <table class="exam-style-table">
                            <thead>
                                <tr>
                                    <th colspan="2">Alter Zustand</th>
                                    <th>Eingang</th>
                                    <th colspan="2">Neuer Zustand</th>
                                    <th>Bedeutung</th>
                                </tr>
                                <tr>
                                    <th>z₀</th>
                                    <th>z₁</th>
                                    <th>e</th>
                                    <th>z₀ⁿᵉˣᵗ</th>
                                    <th>z₁ⁿᵉˣᵗ</th>
                                    <th>Übergang</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="@(CurrentState == 0 && InputSignal == 0 ? "active-row" : "")">
                                    <td>0</td><td>0</td><td>0</td><td><strong>0</strong></td><td><strong>0</strong></td><td>S₀ &rarr; S₀ (Halt)</td>
                                </tr>
                                <tr class="@(CurrentState == 0 && InputSignal == 1 ? "active-row" : "")">
                                    <td>0</td><td>0</td><td>1</td><td><strong>0</strong></td><td><strong>1</strong></td><td>S₀ &rarr; S₁ (Vorwärts)</td>
                                </tr>
                                <tr class="@(CurrentState == 1 && InputSignal == 0 ? "active-row" : "")">
                                    <td>0</td><td>1</td><td>0</td><td><strong>0</strong></td><td><strong>0</strong></td><td>S₁ &rarr; S₀ (Rückwärts)</td>
                                </tr>
                                <tr class="@(CurrentState == 1 && InputSignal == 1 ? "active-row" : "")">
                                    <td>0</td><td>1</td><td>1</td><td><strong>1</strong></td><td><strong>0</strong></td><td>S₁ &rarr; S₂ (Vorwärts)</td>
                                </tr>
                                <tr class="@(CurrentState == 2 && InputSignal == 0 ? "active-row" : "")">
                                    <td>1</td><td>0</td><td>0</td><td><strong>0</strong></td><td><strong>1</strong></td><td>S₂ &rarr; S₁ (Rückwärts)</td>
                                </tr>
                                <tr class="@(CurrentState == 2 && InputSignal == 1 ? "active-row" : "")">
                                    <td>1</td><td>0</td><td>1</td><td><strong>1</strong></td><td><strong>0</strong></td><td>S₂ &rarr; S₂ (Halt)</td>
                                </tr>
                                <tr class="dc-row">
                                    <td>1</td><td>1</td><td>0</td><td class="dc-val">-</td><td class="dc-val">-</td><td>Don't Care (nicht erreichbar)</td>
                                </tr>
                                <tr class="dc-row">
                                    <td>1</td><td>1</td><td>1</td><td class="dc-val">-</td><td class="dc-val">-</td><td>Don't Care (nicht erreichbar)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- OUTPUT TABLE -->
                    <div class="table-column">
                        <h4>Ausgabefunktion (Ausgänge a₀, a₁)</h4>
                        <table class="exam-style-table">
                            <thead>
                                <tr>
                                    <th colspan="2">Zustand</th>
                                    <th colspan="2">Ausgang</th>
                                    <th>Zahlenwert</th>
                                </tr>
                                <tr>
                                    <th>z₀</th>
                                    <th>z₁</th>
                                    <th>a₀</th>
                                    <th>a₁</th>
                                    <th>Dezimal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="@(CurrentState == 0 ? "active-row" : "")">
                                    <td>0</td><td>0</td><td><strong>0</strong></td><td><strong>0</strong></td><td>0</td>
                                </tr>
                                <tr class="@(CurrentState == 1 ? "active-row" : "")">
                                    <td>0</td><td>1</td><td><strong>0</strong></td><td><strong>1</strong></td><td>1</td>
                                </tr>
                                <tr class="@(CurrentState == 2 ? "active-row" : "")">
                                    <td>1</td><td>0</td><td><strong>1</strong></td><td><strong>0</strong></td><td>2</td>
                                </tr>
                                <tr class="dc-row">
                                    <td>1</td><td>1</td><td class="dc-val">-</td><td class="dc-val">-</td><td>-</td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="synthesis-note">
                            <strong>Didaktischer Hinweis:</strong><br />
                            Bei 3 Zuständen bleiben 2<sup>2</sup> &minus; 3 = 1 Zustandskombination (<em>z</em><sub>0</sub><em>z</em><sub>1</sub> = 11<sub>2</sub>) ungenutzt.
                            In den KV-Diagrammen werden diese Stellen als <em>Don't Cares (&minus;)</em> eingetragen und zur optimalen Blockbildung mit 1 oder 0 belegt.
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (ActiveTab == SimTab.KVMaps)
        {
            <!-- KV MAPS MINIMIZATION -->
            <div class="card kv-maps-card">
                <div class="card-header">
                    <h3>Minimierung der Steuer- und Ausgangsfunktionen via KV-Diagramme</h3>
                    <span class="badge badge-accent">3 Eingangsvariablen (e &times; z₀z₁)</span>
                </div>

                <div class="kv-grid-4col">
                    <!-- KV MAP z0_next -->
                    <div class="kv-box">
                        <div class="kv-title">D₀ = z₀ⁿᵉˣᵗ</div>
                        <table class="sim-kv-mini">
                            <thead>
                                <tr>
                                    <th rowspan="2">e</th>
                                    <th colspan="4">z₀z₁</th>
                                </tr>
                                <tr>
                                    <th>00</th><th>01</th><th>11</th><th>10</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>0</th>
                                    <td>0</td><td>0</td><td class="dc-cell">-</td><td>0</td>
                                </tr>
                                <tr>
                                    <th>1</th>
                                    <td>0</td><td class="minterm-cell">1</td><td class="dc-cell dc-chosen">-</td><td class="minterm-cell">1</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="kv-formula">
                            D₀ = <strong>(e &and; z₀) &or; (e &and; z₁)</strong>
                        </div>
                    </div>

                    <!-- KV MAP z1_next -->
                    <div class="kv-box">
                        <div class="kv-title">D₁ = z₁ⁿᵉˣᵗ</div>
                        <table class="sim-kv-mini">
                            <thead>
                                <tr>
                                    <th rowspan="2">e</th>
                                    <th colspan="4">z₀z₁</th>
                                </tr>
                                <tr>
                                    <th>00</th><th>01</th><th>11</th><th>10</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>0</th>
                                    <td>0</td><td>0</td><td class="dc-cell dc-chosen">-</td><td class="minterm-cell">1</td>
                                </tr>
                                <tr>
                                    <th>1</th>
                                    <td class="minterm-cell">1</td><td>0</td><td class="dc-cell">-</td><td>0</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="kv-formula">
                            D₁ = <strong>(e &and; &not;z₀ &and; &not;z₁) &or; (&not;e &and; z₀)</strong>
                        </div>
                    </div>

