    {
        CircuitAndGraph,
        TruthTables,
        KVMaps
    }

    private ViewMode ActiveView = ViewMode.StepByStep;
    private SimTab ActiveTab = SimTab.CircuitAndGraph;
    private bool ShowSolution = false;
    private bool IsEmbed = false;

    // Moore State Machine Simulation State
    // States: 0 = S0 (00), 1 = S1 (01), 2 = S2 (10)
    private int CurrentState = 0;
    private int InputSignal = 1; // 0 = Backward / Stop at 0, 1 = Forward / Stop at 2

    // Flip Flop outputs: z0, z1
    private int Z0 => (CurrentState >> 1) & 1;
    private int Z1 => CurrentState & 1;

    // Next Flip Flop inputs: D0 = z0^next, D1 = z1^next
    // From equations:
    // z0_next = (e & z0) | (e & z1)
    // z1_next = (e & !z0 & !z1) | (!e & z0)
    private int D0Next
    {
        get
        {
            bool term1 = (InputSignal == 1) && (Z0 == 1);
            bool term2 = (InputSignal == 1) && (Z1 == 1);
            return (term1 || term2) ? 1 : 0;
        }
    }

    private int D1Next
    {
        get
        {
            bool term1 = (InputSignal == 1) && (Z0 == 0) && (Z1 == 0);
            bool term2 = (InputSignal == 0) && (Z0 == 1);
            return (term1 || term2) ? 1 : 0;
        }
    }

    // Outputs: a0 = z0, a1 = z1
    private int A0 => Z0;
    private int A1 => Z1;
    private int OutputVal => CurrentState;

    // Autoplay timer
    private bool IsAutoPlaying = false;
    private System.Threading.Timer? AutoPlayTimer;

    protected override void OnInitialized()
    {
        ReadQueryParameters();
    }

    protected override void OnParametersSet()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (!string.IsNullOrEmpty(query))
            {
                if (query.Contains("view=worksheet", StringComparison.OrdinalIgnoreCase))
                {
                    ActiveView = ViewMode.Worksheet;
                }
                if (query.Contains("solution=true", StringComparison.OrdinalIgnoreCase))
                {
                    ShowSolution = true;
                }
                if (query.Contains("embed=true", StringComparison.OrdinalIgnoreCase) || query.Contains("embedded=true", StringComparison.OrdinalIgnoreCase))
                {
                    IsEmbed = true;
                }
            }
        }
        catch
        {
            // Ignore URI parsing issues during prerender
        }
    }

    private void SetView(ViewMode view)
    {
        ActiveView = view;
        StopAutoPlay();
    }

    private void SetInput(int val)
    {
        InputSignal = val;
    }

    private void SetState(int state)
    {
        CurrentState = Math.Clamp(state, 0, 2);
    }

    private void ResetToS0()
    {
        CurrentState = 0;
        InputSignal = 1;
    }

    private void StepClock()
    {
        // Transition based on current state and input
        if (CurrentState == 0)
        {
            CurrentState = (InputSignal == 1) ? 1 : 0;
        }
        else if (CurrentState == 1)
        {
            CurrentState = (InputSignal == 1) ? 2 : 0;
        }
        else if (CurrentState == 2)
        {
            CurrentState = (InputSignal == 1) ? 2 : 1;
        }
        InvokeAsync(StateHasChanged);
    }

    private void ToggleAutoPlay()
    {
        if (IsAutoPlaying)
        {
            StopAutoPlay();
        }
        else
        {
            IsAutoPlaying = true;
            AutoPlayTimer = new System.Threading.Timer(_ =>
            {
                StepClock();
            }, null, 0, 1200);
        }
    }

    private void StopAutoPlay()
    {
        IsAutoPlaying = false;
        AutoPlayTimer?.Dispose();
        AutoPlayTimer = null;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    public void Dispose()
    {
        StopAutoPlay();
    }
}
