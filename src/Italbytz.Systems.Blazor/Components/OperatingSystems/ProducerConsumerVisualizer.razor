@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<article class="pc-container @(IsEmbed ? "embed-mode" : "")">

    @if (!IsEmbed)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Interprozesskommunikation</p>
            <h2>Erzeuger-Verbraucher-Problem (Producer-Consumer)</h2>
            <p class="feature-intro">
                Zwei nebenläufige Prozesse teilen sich einen begrenzten FIFO-Puffer. Erforschen Sie den Unterschied zwischen 
                <strong>ungeschütztem Zugriff</strong> (Race Conditions, Lost Updates), Synchronisation über <strong>C#-<code>lock</code> / Monitor</strong> 
                sowie Betriebssystem-<strong>Mutex</strong> mit Signalisierung über <code>AutoResetEvent</code> (Sleep/Wakeup).
            </p>
        </div>
    }

    <!-- Toolbar / Mode Switcher -->
    <div class="controls-panel no-print">
        <div class="toolbar-grid">
            <div class="sync-mode-group">
                <span class="preset-label">Synchronisation:</span>
                <button class="sync-btn @(CurrentMode == SyncMode.Bare ? "active-bare" : "")" 
                        @onclick="() => SetMode(SyncMode.Bare)">
                    🔴 Ungeschützt (Bare)
                </button>
                <button class="sync-btn @(CurrentMode == SyncMode.Lock ? "active-lock" : "")" 
                        @onclick="() => SetMode(SyncMode.Lock)">
                    🟢 C# lock (Monitor)
                </button>
                <button class="sync-btn @(CurrentMode == SyncMode.Mutex ? "active-mutex" : "")" 
                        @onclick="() => SetMode(SyncMode.Mutex)">
                    🔵 OS-Mutex
                </button>
            </div>

            <div class="speed-control">
                <span class="preset-label">Tempo:</span>
                <select class="speed-select" @bind="PlaySpeedMs">
                    <option value="1800">Normal (1.8s)</option>
                    <option value="1000">Schnell (1.0s)</option>
                    <option value="2800">Gemächlich (2.8s)</option>
                </select>
            </div>

            <div class="action-btn-group">
                <button class="ctrl-btn" @onclick="ResetSimulation" title="Simulation zurücksetzen">
                    🔄 Reset
                </button>
                @if (IsPlaying)
                {
                    <button class="ctrl-btn ctrl-pause" @onclick="PausePlay" title="Simulation pausieren">
                        ⏸️ Pause
                    </button>
                }
                else
                {
                    <button class="ctrl-btn ctrl-play" @onclick="StartPlay" title="Simulation abspielen">
                        ▶️ Play
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Alert Banners -->
    @if (IsRaceConditionDetected)
    {
        <div class="alert-banner alert-race">
            <span class="alert-icon">⚠️</span>
            <div class="alert-content">
                <strong class="alert-title">RACE CONDITION AUFGETRETEN!</strong>
                <span class="alert-desc">
                    Beide Threads greifen zeitgleich ungeschützt auf die Zählvariable <code>_count</code> zu. 
                    Aktualisierungen gehen verloren (Lost Update) oder Grenzwerte werden verletzt!
                </span>
            </div>
        </div>
    }
    else if (IsBufferFull && ProducerState == ThreadState.WaitingForSpace)
    {
        <div class="alert-banner alert-full">
            <span class="alert-icon">⏳</span>
            <div class="alert-content">
                <strong class="alert-title">PUFFER VOLL (Kapazität @Capacity erreicht)!</strong>
                <span class="alert-desc">
                    @if (CurrentMode == SyncMode.Bare)
                    {
                        <span>Produzent befindet sich im <strong>aktiven Warten (Busy Waiting)</strong> und verbraucht CPU-Zyklen.</span>
                    }
                    else
                    {
                        <span>Produzent schläft passiv (<code>Consumption.WaitOne()</code>), bis der Verbraucher Platz schafft.</span>
                    }
                </span>
            </div>
        </div>
    }
    else if (IsBufferEmpty && ConsumerState == ThreadState.WaitingForItems)
    {
        <div class="alert-banner alert-empty">
            <span class="alert-icon">⏳</span>
            <div class="alert-content">
                <strong class="alert-title">PUFFER LEER (0 Items)!</strong>
                <span class="alert-desc">
                    @if (CurrentMode == SyncMode.Bare)
                    {
                        <span>Verbraucher befindet sich im <strong>aktiven Warten (Busy Waiting)</strong>.</span>
                    }
                    else
                    {
                        <span>Verbraucher schläft passiv (<code>Production.WaitOne()</code>), bis neue Daten eintreffen.</span>
                    }
                </span>
            </div>
        </div>
    }

    <!-- Main Dual Layout: Visualizer Left, Code Right -->
    <div class="pc-layout-grid">

        <!-- Left: Interactive Simulation Panel -->
        <div class="sim-panel">
            
            <!-- Threads Grid -->
            <div class="threads-grid">
                
                <!-- Producer Card -->
                <div class="thread-card producer-card @(ProducerState == ThreadState.InCriticalSection ? "card-critical" : "") @(ProducerState == ThreadState.WaitingForSpace ? "card-blocked" : "")">
                    <div class="thread-header">
                        <span class="thread-icon">🏭</span>
                        <div class="thread-info">
                            <strong class="thread-name">Produzent (Thread 1)</strong>
                            <span class="thread-status-badge status-@ProducerState.ToString().ToLowerInvariant()">
                                @GetThreadStateLabel(ProducerState)
                            </span>
                        </div>
                    </div>
                    <div class="thread-action-box">
                        <span class="action-label">Aktuelle Aktion:</span>
                        <p class="action-text mono">@ProducerActionText</p>
                    </div>
                    <div class="thread-manual-bar no-print">
                        <button class="manual-btn producer-btn" @onclick="StepProducer" disabled="@IsPlaying">
                            👉 Produzent: 1 Schritt
                        </button>
                    </div>
                </div>

                <!-- Sync Object Status -->
                <div class="sync-card">
                    <div class="sync-card-header">
                        <span class="sync-icon">🔒</span>
                        <strong class="sync-title">Synchronisation</strong>
                    </div>
                    <div class="sync-details">
                        @if (CurrentMode == SyncMode.Bare)
                        {
                            <div class="sync-status status-danger">
                                <strong>Keine Sperre</strong>
                                <span>Ungeschützter paralleler Speicherzugriff</span>
                            </div>
                        }
                        else
                        {
                            <div class="sync-item">
                                <span class="sync-label">@(CurrentMode == SyncMode.Lock ? "Locker (lock)" : "Mutex (OS)"):</span>
                                <span class="sync-val @(IsLockHeld ? "val-locked" : "val-free")">
                                    @(IsLockHeld ? $"Gesperrt von {LockOwner}" : "Frei")
                                </span>
                            </div>
                            <div class="sync-item">
                                <span class="sync-label">Event Production:</span>
                                <span class="sync-val @(IsProductionEventSignaled ? "val-signaled" : "val-reset")">
                                    @(IsProductionEventSignaled ? "Signaled (Aufgeweckt)" : "Reset")
                                </span>
                            </div>
                            <div class="sync-item">
                                <span class="sync-label">Event Consumption:</span>
                                <span class="sync-val @(IsConsumptionEventSignaled ? "val-signaled" : "val-reset")">
                                    @(IsConsumptionEventSignaled ? "Signaled (Aufgeweckt)" : "Reset")
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Consumer Card -->
                <div class="thread-card consumer-card @(ConsumerState == ThreadState.InCriticalSection ? "card-critical" : "") @(ConsumerState == ThreadState.WaitingForItems ? "card-blocked" : "")">
                    <div class="thread-header">
                        <span class="thread-icon">🛒</span>
                        <div class="thread-info">
                            <strong class="thread-name">Verbraucher (Thread 2)</strong>
                            <span class="thread-status-badge status-@ConsumerState.ToString().ToLowerInvariant()">
                                @GetThreadStateLabel(ConsumerState)
                            </span>
                        </div>
                    </div>
                    <div class="thread-action-box">
                        <span class="action-label">Aktuelle Aktion:</span>
                        <p class="action-text mono">@ConsumerActionText</p>
                    </div>
                    <div class="thread-manual-bar no-print">
                        <button class="manual-btn consumer-btn" @onclick="StepConsumer" disabled="@IsPlaying">
                            👉 Verbraucher: 1 Schritt
                        </button>
                    </div>
                </div>

            </div>

            <!-- Buffer Visualization -->
            <div class="buffer-section">
                <div class="buffer-header">
                    <div class="buffer-title-wrap">
                        <span class="buffer-icon">📦</span>
                        <strong>Gemeinsamer Puffer (FIFO)</strong>
                    </div>
                    <div class="buffer-counter mono">
                        Füllstand: <strong class="counter-val @(Count > Capacity ? "counter-overflow" : "")">@Count</strong> / @Capacity
                    </div>
                </div>

                <div class="buffer-slots-grid">
                    @for (int i = 0; i < Capacity; i++)
                    {
                        int slotIdx = i;
                        bool isFilled = slotIdx < BufferSlots.Count;
                        var item = isFilled ? BufferSlots[slotIdx] : null;
                        <div class="buffer-slot @(isFilled ? "slot-filled" : "slot-empty")">
                            <span class="slot-index mono">#@slotIdx</span>
                            @if (item != null)
                            {
                                <span class="slot-content mono" title="Item @item.Id erzeugt in Schritt @item.Step">
                                    @item.Id
                                </span>
                            }
                            else
                            {
                                <span class="slot-free mono">&minus;</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Console Log Stream -->
            <div class="console-box">
                <div class="console-header">
                    <span class="console-title">💻 Konsolenausgabe (Console.WriteLine)</span>
                    <span class="step-badge mono">Schritt: @StepCounter</span>
                </div>
                <div class="console-body mono" @ref="ConsoleLogRef">
                    @if (LogEntries.Count == 0)
                    {
                        <div class="log-empty">Simulation gestartet. Klicken Sie auf „1 Schritt“ oder „Play“.</div>
                    }
                    else
                    {
                        @foreach (var log in LogEntries)
                        {
                            <div class="log-line @(log.Contains("Producing") ? "log-prod" : (log.Contains("Consuming") ? "log-cons" : "log-warn"))">
                                @log
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        <!-- Right: C# Source Code Panel -->
        <div class="code-panel">
            <div class="code-header">
                <div class="code-title-wrap">
                    <span class="code-icon">📄</span>
                    <strong>C# Quellcode</strong>
                    <span class="code-variant-pill">
                        @(CurrentMode switch {
                            SyncMode.Bare => "ProducerConsumerBare.cs",
                            SyncMode.Lock => "ProducerConsumerLock.cs",
                            SyncMode.Mutex => "ProducerConsumerMutex.cs",
                            _ => ""
                        })
                    </span>
                </div>
                <div class="code-actions no-print">
                    <button class="copy-btn" @onclick="CopyCodeToClipboard" title="Code in Zwischenablage kopieren">
                        @(IsCopied ? "✓ Kopiert!" : "📋 Kopieren")
                    </button>
                    <a href="https://github.com/RobinNunkesser/work/tree/main/artifacts/packages/dotnet/nuget-systems/samples/console/OperatingSystems/ProducerConsumer/" 
                       target="_blank" rel="noopener noreferrer" class="repo-link" title="Im Repository ansehen">
                        🔗 GitHub
                    </a>
                </div>
            </div>

            <div class="code-container">
                @if (CurrentMode == SyncMode.Bare)
                {
                    <pre class="code-listing mono"><code><span class="kw">namespace</span> <span class="tp">ProducerConsumerBare</span>;

<span class="kw">internal static class</span> <span class="tp">Program</span>
{
    <span class="kw">private const int</span> Steps = <span class="num">1000</span>;
    <span class="kw">private const int</span> Capacity = <span class="num">100</span>;
    <span class="kw">private static int</span> _count = <span class="num">50</span>;
    <span class="kw">private static int</span> _step;

    <span class="com">// Produzent ohne wechselseitigen Ausschluss</span>
    <span class="kw">private static void</span> <span class="fn">Producer</span>()
    {
        <span class="kw">while</span> (_step &lt; Steps)
        {
            <span class="com">// Busy Waiting (100% CPU-Last)</span>
            <span class="kw">if</span> (_count &gt;= Capacity) <span class="kw">continue</span>;

            <span class="highlight-danger"><span class="com">// KRITISCHER ABSCHNITT: Ungeschütztes Inkrementieren</span>
            Console.WriteLine(<span class="str">$"Step {++_step}: Producing one item, {++_count} items in buffer."</span>);
            Console.Out.Flush();</span>
        }
    }

    <span class="com">// Verbraucher ohne wechselseitigen Ausschluss</span>
    <span class="kw">private static void</span> <span class="fn">Consumer</span>()
    {
        <span class="kw">while</span> (_step &lt; Steps)
        {
            <span class="com">// Busy Waiting (100% CPU-Last)</span>
            <span class="kw">if</span> (_count &lt;= <span class="num">0</span>) <span class="kw">continue</span>;

            <span class="highlight-danger"><span class="com">// KRITISCHER ABSCHNITT: Ungeschütztes Dekrementieren</span>
            Console.WriteLine(<span class="str">$"Step {++_step}: Consuming one item, {--_count} items in buffer."</span>);
            Console.Out.Flush();</span>
        }
    }

    <span class="kw">public static void</span> <span class="fn">Main</span>()
    {
        <span class="kw">var</span> producer = <span class="kw">new</span> Thread(Producer);
        <span class="kw">var</span> consumer = <span class="kw">new</span> Thread(Consumer);
        producer.Start();
        consumer.Start();
    }
}</code></pre>
                }
                else if (CurrentMode == SyncMode.Lock)
                {
                    <pre class="code-listing mono"><code><span class="kw">namespace</span> <span class="tp">ProducerConsumerLock</span>;

<span class="kw">internal static class</span> <span class="tp">Program</span>
{
    <span class="kw">private const int</span> Steps = <span class="num">1000</span>;
    <span class="kw">private const int</span> Capacity = <span class="num">100</span>;
    <span class="kw">private static int</span> _count = <span class="num">50</span>;
    <span class="kw">private static int</span> _step;

    <span class="com">// Synchronisationsobjekte</span>
    <span class="kw">private static readonly object</span> Locker = <span class="kw">new object</span>();
    <span class="kw">private static readonly</span> AutoResetEvent Production = <span class="kw">new</span> AutoResetEvent(<span class="kw">false</span>);
    <span class="kw">private static readonly</span> AutoResetEvent Consumption = <span class="kw">new</span> AutoResetEvent(<span class="kw">false</span>);

    <span class="kw">private static void</span> <span class="fn">Producer</span>()
    {
        <span class="kw">while</span> (_step &lt; Steps - <span class="num">1</span>)
        {
            <span class="highlight-success"><span class="kw">lock</span> (Locker)
            {
                <span class="kw">if</span> (_count &lt; Capacity)
                {
                    Console.WriteLine(<span class="str">$"Step {++_step}: Producing one item, {++_count} items in buffer."</span>);
                    Console.Out.Flush();
                    Production.Set(); <span class="com">// Weckt wartenden Verbraucher auf</span>
                }
            }</span>

            <span class="com">// Passives Schlafen bei vollem Puffer (kein Busy Waiting!)</span>
            <span class="kw">if</span> (_count == Capacity) Consumption.WaitOne();
        }
    }

    <span class="kw">private static void</span> <span class="fn">Consumer</span>()
    {
        <span class="kw">while</span> (_step &lt; Steps - <span class="num">1</span>)
        {
            <span class="highlight-success"><span class="kw">lock</span> (Locker)
            {
                <span class="kw">if</span> (_count &gt; <span class="num">0</span>)
                {
                    Console.WriteLine(<span class="str">$"Step {++_step}: Consuming one item, {--_count} items in buffer."</span>);
                    Console.Out.Flush();
                    Consumption.Set(); <span class="com">// Weckt wartenden Produzenten auf</span>
                }
            }</span>

            <span class="com">// Passives Schlafen bei leerem Puffer</span>
            <span class="kw">if</span> (_count == <span class="num">0</span>) Production.WaitOne();
        }
    }

    <span class="kw">public static void</span> <span class="fn">Main</span>()
    {
        <span class="kw">var</span> producer = <span class="kw">new</span> Thread(Producer);
