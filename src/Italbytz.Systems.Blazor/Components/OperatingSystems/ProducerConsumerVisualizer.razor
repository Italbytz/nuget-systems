            </div>

            <!-- Terminal Run Hint -->
            <div class="run-hint-box no-print">
                <span class="hint-title">🚀 Lokal ausführen:</span>
                <code class="hint-cmd mono">dotnet run --project samples/console/OperatingSystems/ProducerConsumer/@(CurrentMode switch {
                    SyncMode.Bare => "ProducerConsumerBare",
                    SyncMode.Lock => "ProducerConsumerLock",
                    SyncMode.Mutex => "ProducerConsumerMutex",
                    _ => ""
                })</code>
            </div>
        </div>

    </div>

</article>

@code {
    [Parameter] public bool IsEmbed { get; set; }

    public enum SyncMode { Bare, Lock, Mutex }
    public enum ThreadState { Ready, InCriticalSection, WaitingForSpace, WaitingForItems }

    public record BufferItem(string Id, int Step);

    private SyncMode CurrentMode { get; set; } = SyncMode.Bare;
    private int Capacity { get; set; } = 8;
    private int Count { get; set; } = 4;
    private int StepCounter { get; set; } = 0;

    private List<BufferItem> BufferSlots { get; set; } = new();
    private List<string> LogEntries { get; set; } = new();

    private ThreadState ProducerState { get; set; } = ThreadState.Ready;
    private ThreadState ConsumerState { get; set; } = ThreadState.Ready;

    private string ProducerActionText { get; set; } = "Bereit zum Produzieren";
    private string ConsumerActionText { get; set; } = "Bereit zum Konsumieren";

    private bool IsLockHeld { get; set; } = false;
    private string LockOwner { get; set; } = "";

    private bool IsProductionEventSignaled { get; set; } = false;
    private bool IsConsumptionEventSignaled { get; set; } = false;

    private bool IsRaceConditionDetected { get; set; } = false;
    private bool IsBufferFull => Count >= Capacity;
    private bool IsBufferEmpty => Count <= 0;

    private bool IsPlaying { get; set; } = false;
    private int PlaySpeedMs { get; set; } = 1800;
    private CancellationTokenSource? _playCts;

    private ElementReference ConsoleLogRef;
    private bool IsCopied { get; set; } = false;

    protected override void OnInitialized()
    {
        ParseUrlParameters();
        ResetSimulation();
    }

    private void ParseUrlParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (!string.IsNullOrEmpty(query))
            {
                if (query.Contains("embed=true", StringComparison.OrdinalIgnoreCase) || query.Contains("embedded=true", StringComparison.OrdinalIgnoreCase))
                {
                    IsEmbed = true;
                }

                if (query.Contains("mode=lock", StringComparison.OrdinalIgnoreCase))
                {
                    CurrentMode = SyncMode.Lock;
                }
                else if (query.Contains("mode=mutex", StringComparison.OrdinalIgnoreCase))
                {
                    CurrentMode = SyncMode.Mutex;
                }
                else if (query.Contains("mode=bare", StringComparison.OrdinalIgnoreCase))
                {
                    CurrentMode = SyncMode.Bare;
                }
            }
        }
        catch { }
    }

    private void SetMode(SyncMode mode)
    {
        StopPlay();
        CurrentMode = mode;
        ResetSimulation();
    }

    private void ResetSimulation()
    {
        StopPlay();
        StepCounter = 0;
        Count = 4;
        BufferSlots.Clear();
        for (int i = 1; i <= Count; i++)
        {
            BufferSlots.Add(new BufferItem($"D{i}", 0));
        }

        LogEntries.Clear();
        LogEntries.Add($"Initialzustand: Pufferkapazität={Capacity}, Startfüllstand={Count}");

        ProducerState = ThreadState.Ready;
        ConsumerState = ThreadState.Ready;
        ProducerActionText = "Bereit (wartet auf Takt)";
        ConsumerActionText = "Bereit (wartet auf Takt)";

        IsLockHeld = false;
        LockOwner = "";
        IsProductionEventSignaled = false;
        IsConsumptionEventSignaled = false;
        IsRaceConditionDetected = false;
        IsCopied = false;
    }

    private void StepProducer()
    {
        if (CurrentMode == SyncMode.Bare)
        {
            ExecuteProducerBare();
        }
        else if (CurrentMode == SyncMode.Lock)
        {
            ExecuteProducerLock();
        }
        else
        {
            ExecuteProducerMutex();
        }
    }

    private void StepConsumer()
    {
        if (CurrentMode == SyncMode.Bare)
        {
            ExecuteConsumerBare();
        }
        else if (CurrentMode == SyncMode.Lock)
        {
            ExecuteConsumerLock();
        }
        else
        {
            ExecuteConsumerMutex();
        }
    }

    private void ExecuteProducerBare()
    {
        // Check for Race Condition if consumer is simultaneously active
        if (ConsumerState == ThreadState.InCriticalSection)
        {
            IsRaceConditionDetected = true;
        }

        ProducerState = ThreadState.InCriticalSection;

        if (Count >= Capacity)
        {
            ProducerState = ThreadState.WaitingForSpace;
            ProducerActionText = "Busy Waiting: Puffer voll (count >= Capacity). continue;";
            LogEntries.Add($"[Produzent] Puffer voll ({Count}/{Capacity}) -> Busy Waiting!");
            return;
        }

        StepCounter++;
        Count++;
        var newItem = new BufferItem($"P{StepCounter}", StepCounter);
        BufferSlots.Add(newItem);

        ProducerActionText = $"Item {newItem.Id} produziert! _count={Count}";
        LogEntries.Add($"Step {StepCounter}: Producing one item, {Count} items in buffer.");

        ProducerState = ThreadState.Ready;
    }

    private void ExecuteConsumerBare()
    {
        if (ProducerState == ThreadState.InCriticalSection)
        {
            IsRaceConditionDetected = true;
        }

        ConsumerState = ThreadState.InCriticalSection;

        if (Count <= 0)
        {
            ConsumerState = ThreadState.WaitingForItems;
            ConsumerActionText = "Busy Waiting: Puffer leer (count <= 0). continue;";
            LogEntries.Add($"[Verbraucher] Puffer leer ({Count}/{Capacity}) -> Busy Waiting!");
            return;
        }

        StepCounter++;
        Count--;
        var item = BufferSlots.Count > 0 ? BufferSlots[0] : new BufferItem("??", StepCounter);
        if (BufferSlots.Count > 0) BufferSlots.RemoveAt(0);

        ConsumerActionText = $"Item {item.Id} verbraucht! _count={Count}";
        LogEntries.Add($"Step {StepCounter}: Consuming one item, {Count} items in buffer.");

        ConsumerState = ThreadState.Ready;
    }

    private void ExecuteProducerLock()
    {
        if (ProducerState == ThreadState.WaitingForSpace)
        {
            if (Count < Capacity)
            {
                ProducerState = ThreadState.Ready;
                ProducerActionText = "Aufgeweckt (Consumption.Set() empfangen)!";
            }
            else
            {
                ProducerActionText = "Schläft: Consumption.WaitOne(); wartet auf Platz";
                return;
            }
        }

        // Acquire lock
        IsLockHeld = true;
        LockOwner = "Produzent";
        ProducerState = ThreadState.InCriticalSection;

        if (Count < Capacity)
        {
            StepCounter++;
            Count++;
            var newItem = new BufferItem($"P{StepCounter}", StepCounter);
            BufferSlots.Add(newItem);

            ProducerActionText = $"lock(Locker) erworben -> {newItem.Id} erzeugt. Production.Set()!";
            LogEntries.Add($"Step {StepCounter}: Producing one item, {Count} items in buffer.");

            IsProductionEventSignaled = true;
            if (ConsumerState == ThreadState.WaitingForItems)
            {
                ConsumerState = ThreadState.Ready;
                ConsumerActionText = "Signal empfangen -> Bereit";
            }
        }

        // Release lock
        IsLockHeld = false;
        LockOwner = "";
        ProducerState = ThreadState.Ready;

        if (Count == Capacity)
        {
            ProducerState = ThreadState.WaitingForSpace;
            ProducerActionText = "Puffer voll: Consumption.WaitOne() -> Thread schläft";
        }
    }

    private void ExecuteConsumerLock()
    {
        if (ConsumerState == ThreadState.WaitingForItems)
        {
            if (Count > 0)
            {
                ConsumerState = ThreadState.Ready;
                ConsumerActionText = "Aufgeweckt (Production.Set() empfangen)!";
            }
