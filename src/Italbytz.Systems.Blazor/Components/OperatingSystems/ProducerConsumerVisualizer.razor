    private async void StartPlay()
    {
        if (IsPlaying) return;
        IsPlaying = true;
        _playCts = new CancellationTokenSource();
        var token = _playCts.Token;

        var random = new Random();
        try
        {
            while (!token.IsCancellationRequested && StepCounter < 30)
            {
                await Task.Delay(PlaySpeedMs, token);
                if (token.IsCancellationRequested) break;

                // Alternate or randomly pick thread action
                bool runProducer = random.Next(2) == 0;
                if (runProducer)
                {
                    StepProducer();
                }
                else
                {
                    StepConsumer();
                }

                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            IsPlaying = false;
            StateHasChanged();
        }
    }

    private void PausePlay()
    {
        StopPlay();
    }

    private void StopPlay()
    {
        if (_playCts != null)
        {
            _playCts.Cancel();
            _playCts.Dispose();
            _playCts = null;
        }
        IsPlaying = false;
    }

