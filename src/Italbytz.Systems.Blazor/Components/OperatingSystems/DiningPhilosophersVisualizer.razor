    {
        PhilosopherState.Think => "💭",
        PhilosopherState.WaitFirstFork or PhilosopherState.WaitSecondFork => "⏳",
        PhilosopherState.Eat => "🍝",
        PhilosopherState.Deadlocked => "⛔",
        _ => "👤"
    };

    private string GetStateShortLabel(PhilosopherState state) => state switch
