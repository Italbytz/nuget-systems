        PhilosopherState.Think => "Denkt",
        PhilosopherState.WaitFirstFork => "Wartet (1)",
        PhilosopherState.WaitSecondFork => "Wartet (2)",
        PhilosopherState.Eat => "Isst",
        PhilosopherState.Deadlocked => "Blockiert",
        _ => ""
    };

    private string GetStateDescription(PhilosopherState state) => state switch
