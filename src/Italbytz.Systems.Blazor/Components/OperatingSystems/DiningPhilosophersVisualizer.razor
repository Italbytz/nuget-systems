        3 => "#059669",
        4 => "#dc2626",
        _ => "#64748b"
    };

    private string GetStrategyTitle() => CurrentStrategy switch
    {
        StrategyMode.Bare => "Symmetrisch (Bare / Naiv)",
        StrategyMode.Asymmetric => "Asymmetrisch (Linkshänder P5)",
        StrategyMode.Arbitrator => "Arbitrator (Kellner / Semaphore max. 4)",
        _ => ""
    };

    private async Task CopyCode()
    {
        var code = CurrentStrategy switch
        {
            StrategyMode.Bare => @"// 1. Denken
Think();
// 2. Erste Gabel nehmen (Immer links: Forks[id])
while (Forks[id] != 0) Wait();
Forks[id] = id;
// 3. Zweite Gabel nehmen (Immer rechts: Forks[(id + 1) % 5])
while (Forks[(id + 1) % 5] != 0) Wait();
Forks[(id + 1) % 5] = -id;
// 4. Essen mit beiden Gabeln
Eat();
// 5. Beide Gabeln zurücklegen
Forks[id] = 0;
Forks[(id + 1) % 5] = 0;",
            StrategyMode.Asymmetric => @"// Asymmetrische Strategie (Linkshänder Dijkstra)
int firstFork = id; int secondFork = (id + 1) % 5;
if (id == 4) // Philosoph 5 greift umgekehrt!
    (firstFork, secondFork) = (secondFork, firstFork);
while (Forks[firstFork] != 0) Wait();
Forks[firstFork] = id;
while (Forks[secondFork] != 0) Wait();
Forks[secondFork] = id;
Eat();
Forks[firstFork] = 0; Forks[secondFork] = 0;",
            _ => @"// Arbitrator (Kellner / Semaphore max. 4 Philosophen)
static SemaphoreSlim waiter = new SemaphoreSlim(4, 4);
waiter.Wait(); // Nur max 4 dürfen gleichzeitig an den Tisch
while (Forks[id] != 0) Wait(); Forks[id] = id;
while (Forks[(id+1)%5] != 0) Wait(); Forks[(id+1)%5] = id;
Eat();
Forks[id] = 0; Forks[(id+1)%5] = 0;
waiter.Release(); // Platz für wartende Philosophen freigeben"
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            IsCopied = true;
            StateHasChanged();
            await Task.Delay(2000);
            IsCopied = false;
            StateHasChanged();
        }
        catch { }
    }

    public void Dispose()
    {
        StopPlay();
    }
}
