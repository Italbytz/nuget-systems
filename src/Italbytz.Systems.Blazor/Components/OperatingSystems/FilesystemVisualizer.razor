                    </div>
                </div>
            </div>

            <!-- Task 2: File Allocation Table (FAT) -->
            <div class="sheet-task">
                <div class="task-head">
                    <span class="task-badge badge-fat">Aufgabe 2</span>
                    <h3>File Allocation Table (FAT) Dateisystem</h3>
