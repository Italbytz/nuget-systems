@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@inject NavigationManager NavigationManager

<article class="fs-container @(IsEmbed ? "embed-mode" : "")">

    @if (!IsEmbed)
    {
        <header class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Dateisysteme</p>
            <h2>Dateisysteme: UNIX Inodes &amp; File Allocation Table (FAT)</h2>
            <p class="feature-intro">
                Erkunden Sie interaktiv die Blockhierarchie und Zeigerstrukturen klassischer Betriebssystem-Dateisysteme.
                Berechnen Sie maximale Dateigrößen nach der UNIX-System-V-/Ext4-Inode-Formel, lokalisieren Sie Byte-Offsets Schritt für Schritt
                über direkte und indirekte Adressierungsstufen und vergleichen Sie das Konzept mit der verketteten Allokation in FAT.
            </p>
        </header>

        <!-- Main Tab Switcher -->
        <nav class="view-switch no-print" aria-label="Ansichtsumschalter">
            <button class="view-btn @(ActiveTab == TabMode.Inode ? "active" : "")"
                    @onclick="() => SetTab(TabMode.Inode)">
                🗂️ UNIX Inodes (ext4 / System V)
            </button>
            <button class="view-btn @(ActiveTab == TabMode.Fat ? "active" : "")"
                    @onclick="() => SetTab(TabMode.Fat)">
                📋 FAT (File Allocation Table)
            </button>
            <button class="view-btn @(ActiveTab == TabMode.Worksheet ? "active" : "")"
                    @onclick="() => SetTab(TabMode.Worksheet)">
                🖨️ Klausur-Übungsblatt (BS 03)
            </button>
        </nav>
    }

    <!-- ========================================================================= -->
    <!-- TAB 1: UNIX INODES (ext4 / System V)                                      -->
    <!-- ========================================================================= -->
    @if (ActiveTab == TabMode.Inode)
    {
        <!-- Configuration Controls -->
        <section class="config-panel no-print">
            <div class="config-group">
                <span class="config-label">Vordefiniertes Systemprofil:</span>
                <div class="pill-group">
                    <button class="pill-btn @(IsSysVPreset ? "active" : "")" @onclick="ApplySysVPreset">
                        UNIX System V (1 KB / 4 B / 10 Dir)
                    </button>
                    <button class="pill-btn @(IsExt4Preset ? "active" : "")" @onclick="ApplyExt4Preset">
                        Linux Ext4 (4 KB / 4 B / 12 Dir)
                    </button>
                    <button class="pill-btn @(IsEnterprisePreset ? "active" : "")" @onclick="ApplyEnterprisePreset">
                        64-Bit Enterprise (8 KB / 8 B / 12 Dir)
                    </button>
                </div>
            </div>

            <div class="config-grid">
                <div class="param-box">
                    <label for="block-size-select">Blockgröße ($B$):</label>
                    <select id="block-size-select" class="form-select" @bind="BlockSize" @bind:after="Recalculate">
                        <option value="512">512 Byte</option>
                        <option value="1024">1 KB (1.024 Byte)</option>
                        <option value="2048">2 KB (2.048 Byte)</option>
                        <option value="4096">4 KB (4.096 Byte)</option>
                        <option value="8192">8 KB (8.192 Byte)</option>
                    </select>
                </div>

                <div class="param-box">
                    <label for="pointer-size-select">Zeigergröße ($P$):</label>
                    <select id="pointer-size-select" class="form-select" @bind="PointerSize" @bind:after="Recalculate">
                        <option value="4">4 Byte (32-Bit Adressierung)</option>
                        <option value="8">8 Byte (64-Bit Adressierung)</option>
                    </select>
                </div>

                <div class="param-box">
                    <label for="direct-ptr-select">Direkte Zeiger ($D$):</label>
                    <select id="direct-ptr-select" class="form-select" @bind="DirectPointersCount" @bind:after="Recalculate">
                        <option value="10">10 direkte Zeiger (System V)</option>
                        <option value="12">12 direkte Zeiger (Linux ext2/3/4)</option>
                    </select>
                </div>

                <div class="param-box highlight-box">
                    <span class="param-title">Zeiger pro Indexblock ($N$):</span>
                    <span class="param-value mono">$N = \frac{B}{P} = \frac{@FormatBytes(BlockSize)}{@PointerSize\text{ B}} = \mathbf{@PointersPerBlock}$</span>
                </div>
            </div>
        </section>

        <!-- Capacity Stage Cards -->
        <section class="stages-grid" aria-label="Kapazitätsberechnung je Zeigerstufe">
            <!-- Direct Blocks -->
            <div class="stage-card @(ActiveLevel == InodeLevel.Direct ? "highlight-stage direct-highlight" : "")">
                <div class="stage-header">
                    <span class="stage-badge direct-badge">Stufe 1</span>
                    <h4>Direkte Adressierung</h4>
                </div>
                <div class="stage-body">
                    <p class="stage-formula mono">@DirectPointersCount \times B = @DirectPointersCount \times @FormatBytes(BlockSize)</p>
                    <p class="stage-capacity mono"><strong>@FormatBytes(DirectBytes)</strong></p>
                    <p class="stage-range">Blöcke: <code>0 ... @(DirectPointersCount - 1)</code></p>
                    <div class="stage-io">
                        <span class="io-badge">1 I/O-Zugriff</span>
                        <span class="io-desc">Direkt im Inode eingetragen</span>
                    </div>
                </div>
            </div>

            <!-- Single Indirect -->
            <div class="stage-card @(ActiveLevel == InodeLevel.SingleIndirect ? "highlight-stage single-highlight" : "")">
                <div class="stage-header">
                    <span class="stage-badge single-badge">Stufe 2</span>
                    <h4>Einfach indirekt</h4>
                </div>
                <div class="stage-body">
                    <p class="stage-formula mono">1 \times N \times B = @PointersPerBlock \times @FormatBytes(BlockSize)</p>
                    <p class="stage-capacity mono"><strong>@FormatBytes(SingleIndirectBytes)</strong></p>
                    <p class="stage-range">Blöcke: <code>@DirectPointersCount ... @(DirectPointersCount + PointersPerBlock - 1)</code></p>
                    <div class="stage-io">
                        <span class="io-badge">2 I/O-Zugriffe</span>
                        <span class="io-desc">1 Zeigerblock + 1 Datenblock</span>
                    </div>
                </div>
            </div>

            <!-- Double Indirect -->
            <div class="stage-card @(ActiveLevel == InodeLevel.DoubleIndirect ? "highlight-stage double-highlight" : "")">
                <div class="stage-header">
                    <span class="stage-badge double-badge">Stufe 3</span>
                    <h4>Zweifach indirekt</h4>
                </div>
                <div class="stage-body">
                    <p class="stage-formula mono">1 \times N^2 \times B = @PointersPerBlock^2 \times @FormatBytes(BlockSize)</p>
                    <p class="stage-capacity mono"><strong>@FormatBytes(DoubleIndirectBytes)</strong></p>
                    <p class="stage-range">Blöcke: <code>@(DirectPointersCount + PointersPerBlock) ... @FormatNumber(DoubleIndirectEndBlock)</code></p>
                    <div class="stage-io">
                        <span class="io-badge">3 I/O-Zugriffe</span>
                        <span class="io-desc">2 Zeigerblöcke + 1 Datenblock</span>
                    </div>
                </div>
            </div>

            <!-- Triple Indirect -->
            <div class="stage-card @(ActiveLevel == InodeLevel.TripleIndirect ? "highlight-stage triple-highlight" : "")">
                <div class="stage-header">
                    <span class="stage-badge triple-badge">Stufe 4</span>
                    <h4>Dreifach indirekt</h4>
                </div>
                <div class="stage-body">
                    <p class="stage-formula mono">1 \times N^3 \times B = @PointersPerBlock^3 \times @FormatBytes(BlockSize)</p>
                    <p class="stage-capacity mono"><strong>@FormatBytes(TripleIndirectBytes)</strong></p>
                    <p class="stage-range">Blöcke: <code>@FormatNumber(DoubleIndirectEndBlock + 1) ... @FormatNumber(TripleIndirectEndBlock)</code></p>
                    <div class="stage-io">
                        <span class="io-badge">4 I/O-Zugriffe</span>
                        <span class="io-desc">3 Zeigerblöcke + 1 Datenblock</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Summary Total Banner -->
        <div class="total-summary-card">
            <div class="total-info">
                <span class="total-label">Theoretische maximale Dateigröße ($S_{\text{max}}$):</span>
                <span class="total-value mono">@FormatBytes(MaxFileSizeBytes)</span>
            </div>
            <div class="total-formula mono">
                $S_{\text{max}} = @FormatBytes(DirectBytes) \text{ (Dir)} + @FormatBytes(SingleIndirectBytes) \text{ (1-fach)} + @FormatBytes(DoubleIndirectBytes) \text{ (2-fach)} + @FormatBytes(TripleIndirectBytes) \text{ (3-fach)}$
            </div>
        </div>

        <!-- Interactive Byte-Offset / Block Resolver -->
        <section class="resolver-card">
            <div class="resolver-header">
                <h3>🔍 Interaktiver Byte-Offset- &amp; Block-Resolver (Klausur-Rechentrainer)</h3>
                <p>
                    Geben Sie eine beliebige Dateigröße oder ein Byte-Offset ein, um den genauen Speicherblock und den Weg
                    über die Zeigerhierarchie Schritt für Schritt nachzuvollziehen.
                </p>
            </div>

            <div class="resolver-controls">
                <div class="input-with-presets">
                    <div class="input-field">
                        <label for="offset-input">Gesuchtes Byte-Offset (in Bytes):</label>
                        <div class="input-row">
                            <input id="offset-input" type="number" min="0" class="form-control"
                                   @bind="QueryOffset" @bind:after="ResolveOffset" />
                            <span class="unit-tag">Bytes (@FormatBytes(QueryOffset))</span>
                        </div>
                    </div>
                    <div class="quick-presets">
                        <span class="preset-label">Schnellwahl:</span>
                        <button class="preset-btn" @onclick="() => SetQueryOffset(35000)">35 KB</button>
                        <button class="preset-btn" @onclick="() => SetQueryOffset(2500000)">2,5 MB</button>
                        <button class="preset-btn" @onclick="() => SetQueryOffset(50000000)">50 MB</button>
                        <button class="preset-btn" @onclick="() => SetQueryOffset(1500000000)">1,5 GB</button>
                        <button class="preset-btn" @onclick="() => SetQueryOffset(100000000000)">100 GB</button>
                    </div>
                </div>
            </div>

            <!-- Resolution Steps Panel -->
            @if (Resolution != null)
            {
                <div class="resolution-result @Resolution.CssClass">
                    <div class="resolution-banner">
                        <span class="res-icon">@Resolution.Icon</span>
                        <div class="res-summary">
                            <h4>Offset @FormatNumber(QueryOffset) Byte liegt in: <strong>@Resolution.LevelName</strong></h4>
                            <p>Logische Blocknummer: <code>Block #@FormatNumber(Resolution.BlockNumber)</code> &bull; Offset im Block: <code>@Resolution.OffsetInBlock Byte</code></p>
                        </div>
                        <div class="res-io-tag">
                            <span>@Resolution.IOCount I/O-Zugriff(e)</span>
                        </div>
                    </div>

                    <div class="resolution-steps">
                        <h5>Rechenschritte im Detail (Klausurrechenweg):</h5>
                        <ol class="steps-list">
                            <li>
                                <strong>Logischer Blockindex:</strong>
                                <span class="mono">\text{Blocknummer} = \lfloor \frac{\text{Offset}}{B} \rfloor = \lfloor \frac{@FormatNumber(QueryOffset)}{@BlockSize} \rfloor = \mathbf{@FormatNumber(Resolution.BlockNumber)}</span>
                            </li>
                            <li>
                                <strong>Offset im Zielblock:</strong>
                                <span class="mono">\text{Offset im Block} = \text{Offset} \pmod B = @FormatNumber(QueryOffset) \pmod{@BlockSize} = \mathbf{@Resolution.OffsetInBlock\text{ Byte}}</span>
                            </li>
                            <li>
                                <strong>Adressierungsstufe &amp; Relativer Index:</strong>
                                <div class="step-explanation">@Resolution.StepExplanation</div>
                            </li>
                            <li>
                                <strong>Pfad über Zeigerblöcke:</strong>
                                <div class="pointer-path mono">@Resolution.PointerPath</div>
                            </li>
                            <li>
                                <strong>Benötigte Festplattenoperationen:</strong>
                                <div class="step-io-details">
                                    <em>@Resolution.IODescription</em>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            }
        </section>

        <!-- Visual Inode Tree Architecture Diagram -->
        <section class="diagram-section">
            <div class="diagram-header">
                <h3>🏛️ Grafische Inode-Zeigerarchitektur</h3>
                <p>Die Inode enthält direkte Datenzeiger und hierarchisch verzweigte Indexblöcke:</p>
            </div>

            <div class="tree-canvas">
                <!-- Inode Box -->
                <div class="inode-box">
                    <div class="inode-header">
                        <span class="inode-title">UNIX Inode (z. B. #1428)</span>
                        <span class="inode-badge">128 / 256 Bytes</span>
                    </div>
                    <div class="inode-fields">
                        <div class="meta-field"><span>Typ &amp; Rechte:</span><code>-rw-r--r--</code></div>
                        <div class="meta-field"><span>Dateigröße:</span><code>@FormatBytes(QueryOffset)</code></div>
                        <div class="meta-field"><span>UID / GID:</span><code>1000 / 1000</code></div>
                        <div class="meta-field"><span>Link-Zähler:</span><code>1</code></div>
                    </div>
                    <div class="inode-pointers">
                        <div class="ptr-row direct-row @(ActiveLevel == InodeLevel.Direct ? "active-ptr" : "")">
                            <span class="ptr-name">Direkte Zeiger [0..@(DirectPointersCount - 1)]</span>
                            <span class="ptr-arrow">&rarr;</span>
                            <span class="ptr-target">Datenblöcke #0 .. #@(DirectPointersCount - 1)</span>
                        </div>
                        <div class="ptr-row single-row @(ActiveLevel == InodeLevel.SingleIndirect ? "active-ptr" : "")">
                            <span class="ptr-name">Einfach Indirekt [1 Zeiger]</span>
                            <span class="ptr-arrow">&rarr;</span>
                            <span class="ptr-target">Zeigerblock &rarr; @PointersPerBlock Datenblöcke</span>
                        </div>
                        <div class="ptr-row double-row @(ActiveLevel == InodeLevel.DoubleIndirect ? "active-ptr" : "")">
                            <span class="ptr-name">Zweifach Indirekt [1 Zeiger]</span>
                            <span class="ptr-arrow">&rarr;</span>
                            <span class="ptr-target">Zeigerblock &rarr; @PointersPerBlock Zeigerblöcke &rarr; @FormatNumber(PointersPerBlock * PointersPerBlock) Datenblöcke</span>
                        </div>
                        <div class="ptr-row triple-row @(ActiveLevel == InodeLevel.TripleIndirect ? "active-ptr" : "")">
                            <span class="ptr-name">Dreifach Indirekt [1 Zeiger]</span>
                            <span class="ptr-arrow">&rarr;</span>
                            <span class="ptr-target">Zeigerblock &rarr; 3 Stufen Indirektion</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: FAT (File Allocation Table)                                        -->
    <!-- ========================================================================= -->
    @if (ActiveTab == TabMode.Fat)
    {
        <section class="fat-section">
            <div class="fat-intro-card">
                <h3>📋 File Allocation Table (FAT12 / FAT16 / FAT32)</h3>
                <p>
                    Im Gegensatz zum Inode-Konzept mit Baum-Indirektion nutzt FAT eine <strong>eindimensionale Verkettungsliste</strong>
                    im Dateisystemkopf. Jeder Eintrag in der FAT entspricht genau einem Cluster (Datenblock) auf der Festplatte
                    und speichert die Nummer des Nachfolge-Clusters oder das Dateiende-Zeichen (<code>EOF</code>).
                </p>
            </div>

            <!-- FAT Control & Preset -->
            <div class="fat-controls no-print">
                <div class="fat-param-group">
                    <span class="fat-label">Clustergröße:</span>
                    <button class="pill-btn @(FatClusterSize == 2048 ? "active" : "")" @onclick="() => SetFatClusterSize(2048)">2 KB</button>
                    <button class="pill-btn @(FatClusterSize == 4096 ? "active" : "")" @onclick="() => SetFatClusterSize(4096)">4 KB</button>
                </div>
                <div class="fat-file-info">
                    <span class="file-tag">Beispieldatei: <strong>vorlesung.pdf</strong></span>
                    <span class="file-size-tag">Größe: <strong>@FormatBytes(FatChain.Count * FatClusterSize)</strong> (@FatChain.Count Cluster)</span>
                    <span class="file-start-tag">Start-Cluster im Verzeichnis: <strong>#@FatChain.FirstOrDefault()</strong></span>
                </div>
            </div>

            <!-- Directory Entry Box -->
            <div class="directory-entry-card">
                <h4>Verzeichniseintrag (Directory Entry):</h4>
                <div class="dir-table-wrap">
                    <table class="dir-table">
                        <thead>
                            <tr>
                                <th>Dateiname</th>
                                <th>Erweiterung</th>
                                <th>Attribute</th>
                                <th>Start-Cluster</th>
                                <th>Dateigröße</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="bold">vorlesung</td>
                                <td>pdf</td>
                                <td>Archiv (0x20)</td>
                                <td class="bold text-green mono">#@FatChain.FirstOrDefault()</td>
                                <td class="mono">@FormatNumber(FatChain.Count * FatClusterSize) Bytes</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="dir-note">
                    💡 <em>Der Verzeichniseintrag kennt nur den allerersten Datencluster. Alle weiteren Cluster müssen
                    durch lineares Durchwandern der FAT-Tabelle ermittelt werden.</em>
                </p>
            </div>

            <!-- Visual Cluster Chain -->
            <div class="chain-display">
                <h4>Aktive Cluster-Kette (Verkettung in der FAT):</h4>
                <div class="chain-items">
                    @for (int i = 0; i < FatChain.Count; i++)
                    {
                        var cluster = FatChain[i];
                        var isLast = i == FatChain.Count - 1;
                        <div class="cluster-node @(SelectedCluster == cluster ? "selected-node" : "")"
                             @onclick="() => SelectFatCluster(cluster)">
                            <span class="node-num">Cluster #@cluster</span>
                            <span class="node-bytes">Bytes @FormatNumber(i * FatClusterSize) &ndash; @FormatNumber((i + 1) * FatClusterSize - 1)</span>
                            <span class="node-next mono">@(isLast ? "EOF (0xFFF8)" : $"&rarr; #{FatChain[i + 1]}")</span>
                        </div>
                        @if (!isLast)
                        {
                            <span class="chain-arrow">&rarr;</span>
                        }
                    }
                </div>
            </div>

            <!-- Interactive FAT Array Table -->
            <div class="fat-table-card">
                <div class="fat-table-header">
                    <h4>Ausschnitt der File Allocation Table (Array):</h4>
                    <span class="fat-legend">
                        <span class="legend-box cluster-in-use"></span> Datei-Cluster
                        <span class="legend-box cluster-free"></span> Freier Cluster
                        <span class="legend-box cluster-reserved"></span> Reserviert
                    </span>
                </div>

                <div class="fat-grid">
                    @for (int c = 0; c < 16; c++)
                    {
                        var clusterId = c;
                        var isInChain = FatChain.Contains(clusterId);
                        var isEof = clusterId == FatChain.LastOrDefault();
                        var nextInChain = isInChain && !isEof ? FatChain[FatChain.IndexOf(clusterId) + 1] : (int?)null;

                        <div class="fat-cell @(c < 2 ? "cell-reserved" : isInChain ? "cell-active" : "cell-free") @(SelectedCluster == c ? "cell-selected" : "")"
                             @onclick="() => SelectFatCluster(clusterId)">
                            <div class="cell-idx">Cluster #@c</div>
                            <div class="cell-val mono">
                                @if (c == 0)
                                {
                                    <span>0xFFFFFFF8 (Media)</span>
                                }
                                else if (c == 1)
                                {
                                    <span>0xFFFFFFFF (Dirty)</span>
                                }
                                else if (isEof)
                                {
                                    <span class="val-eof">EOF</span>
                                }
                                else if (nextInChain.HasValue)
                                {
                                    <span class="val-next">&rarr; #@nextInChain.Value</span>
                                }
                                else
                                {
                                    <span class="val-free">FREE (0)</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Architectural Comparison Card -->
            <div class="comparison-card">
                <h4>Architektur-Vergleich: UNIX Inodes vs. File Allocation Table (FAT)</h4>
                <div class="compare-grid">
                    <div class="compare-col">
                        <h5>🗂️ UNIX Inodes (ext4 / System V)</h5>
                        <ul>
                            <li><strong>Direkte Adressierung:</strong> Für kleine Dateien genügt 1 I/O-Zugriff direkt aus der Inode.</li>
                            <li><strong>Mehrstufige Indirektion:</strong> Riesige Dateien skaliere über $O(\log N)$ Zeigerbäume.</li>
                            <li><strong>Dateiende / Sparse Files:</strong> Nicht zugewiesene Blöcke belegen keinen Speicherplatz (Löcher).</li>
                            <li><strong>Zugriffszeit:</strong> Schneller wahlfreier Zugriff (Random Access) auf beliebiges Byte-Offset ohne sequentielles Suchen.</li>
                        </ul>
                    </div>
                    <div class="compare-col">
                        <h5>📋 File Allocation Table (FAT)</h5>
                        <ul>
                            <li><strong>Verkettete Liste:</strong> Alle Cluster-Zuweisungen liegen zentral in einer einzigen Tabelle (FAT).</li>
                            <li><strong>Fragmentierung:</strong> Dateien können quer über das Speichermedium verstreut sein.</li>
                            <li><strong>Zugriffszeit:</strong> Schlechter wahlfreier Zugriff; um das Ende einer großen Datei zu lesen, muss die Kette von Cluster zu Cluster abgelaufen werden.</li>
                            <li><strong>Redundanz:</strong> FAT1 und FAT2 liegen doppelt vor, um Tabellenkorruption abzufedern.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- ========================================================================= -->
    <!-- TAB 3: KLAUSUR-ARBEITSBLATT (BS 03)                                       -->
    <!-- ========================================================================= -->
    @if (ActiveTab == TabMode.Worksheet)
    {
        <section class="worksheet-view">
            <div class="sheet-header">
                <div class="sheet-title-row">
                    <span class="sheet-lecture">Betriebssysteme</span>
                    <span class="sheet-name">Globalübung Dateisysteme (BS 03)</span>
                </div>
            </div>

            <div class="sheet-task">
                <h3>Aufgabe 1: UNIX System V</h3>
                <p>Der grundsätzliche Aufbau eines Dateisystems geht in unixoiden Systemen weiterhin auf UNIX System V zurück:</p>

                <div class="sheet-diagram-mock">
                    <div class="disk-layout">
                        <div class="disk-block boot-block">Boot-Block (0)</div>
                        <div class="disk-block super-block">Super-Block (1)</div>
                        <div class="disk-block inode-blocks">Inode-Liste (2 .. isize)</div>
                        <div class="disk-block data-blocks">Datenblöcke (Dateien, Verzeichnisse, Indexblöcke)</div>
                    </div>
                </div>

                <p>Der Zugriff auf Dateien wird über Verzeichnisse organisiert. Bis auf kleinere Erweiterungen ist auch diese noch wie bei UNIX System V:</p>

                <div class="dir-mock">
                    <div class="dir-entry-box">
                        <span class="d-inode">Inode-Nummer</span>
                        <span class="d-name">Dateiname (max. 14 Zeichen)</span>
                    </div>
                </div>

                <!-- Subtask a -->
                <div class="subtask-block">
                    <h4>a) Geben Sie an, wie Sie herausfinden können, wo auf der Festplatte die Datenblöcke einer Datei gespeichert sind.</h4>
                    <div class="answer-box">
                        <button class="solution-toggle-btn no-print" @onclick="() => ToggleSolution(1)">
                            @(ShowSolution1 ? "👁️ Musterlösung ausblenden" : "💡 Interaktive Musterlösung einblenden")
                        </button>
                        @if (ShowSolution1)
                        {
                            <div class="solution-content">
                                <p><strong>Lösungsschritte aus der Vorlesung:</strong></p>
                                <ol>
                                    <li>Im Verzeichnis steht der Dateiname zusammen mit seiner <strong>Inode-Nummer</strong> (kann z. B. im Terminal mit <code>ls -i &lt;datei&gt;</code> ermittelt werden).</li>
                                    <li>Aus dem <strong>Super-Block</strong> liest das Betriebssystem aus, ab welchem Blocksektor auf dem Datenträger die Inode-Tabelle beginnt.</li>
                                    <li>Aus der <strong>Inode-Tabelle</strong> wird die konkrete Inode der Datei geladen.</li>
                                    <li>In der Inode befinden sich die <strong>Listen von direkten und indirekten Blocknummern</strong>. Diese Blocknummern verweisen direkt bzw. über Indexblöcke auf die physischen Datenblöcke auf der Festplatte.</li>
                                </ol>
                            </div>
                        }
                    </div>
                </div>

                <!-- Subtask b -->
                <div class="subtask-block">
                    <h4>b) Gibt es Besonderheiten bei großen Dateien?</h4>
                    <div class="answer-box">
                        <button class="solution-toggle-btn no-print" @onclick="() => ToggleSolution(2)">
                            @(ShowSolution2 ? "👁️ Musterlösung ausblenden" : "💡 Interaktive Musterlösung einblenden")
                        </button>
                        @if (ShowSolution2)
                        {
                            <div class="solution-content">
                                <p><strong>Lösungsschritte aus der Vorlesung:</strong></p>
                                <ul>
                                    <li>Bei großen Dateien reichen die ersten 10 bzw. 12 direkten Datenzeiger in der Inode nicht aus.</li>
                                    <li>Daher verwendet das Dateisystem <strong>mehrstufige Indirektionszeiger</strong>:
                                        <ul>
                                            <li><strong>Einfach indirekter Zeiger:</strong> Verweist auf einen Block, der ausschließlich Zeiger auf Datenblöcke enthält.</li>
                                            <li><strong>Zweifach indirekter Zeiger:</strong> Verweist auf einen Block von Zeigerblöcken (zwei Indirektionsebenen).</li>
                                            <li><strong>Dreifach indirekter Zeiger:</strong> Drei Indirektionsebenen für Dateien im Terabyte-Bereich.</li>
                                        </ul>
                                    </li>
                                    <li><em>Konsequenz:</em> Der Zugriff auf Datenblöcke großer Dateien benötigt mehrere aufeinanderfolgende Festplatten-Lesezugriffe (I/Os).</li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

</article>

@code {
    [Parameter]
    public bool IsEmbed { get; set; } = false;

    public enum TabMode { Inode, Fat, Worksheet }
    public enum InodeLevel { Direct, SingleIndirect, DoubleIndirect, TripleIndirect, Overflow }

    private TabMode ActiveTab = TabMode.Inode;
    private InodeLevel ActiveLevel = InodeLevel.Direct;

    // Inode parameters
    private long BlockSize = 4096;
    private int PointerSize = 4;
    private int DirectPointersCount = 12;

    private long PointersPerBlock => BlockSize / PointerSize;
    private long DirectBytes => DirectPointersCount * BlockSize;
    private long SingleIndirectBytes => PointersPerBlock * BlockSize;
    private long DoubleIndirectBytes => PointersPerBlock * PointersPerBlock * BlockSize;
    private long TripleIndirectBytes => PointersPerBlock * PointersPerBlock * PointersPerBlock * BlockSize;
    private long MaxFileSizeBytes => DirectBytes + SingleIndirectBytes + DoubleIndirectBytes + TripleIndirectBytes;

    private long DoubleIndirectEndBlock => DirectPointersCount + PointersPerBlock + (PointersPerBlock * PointersPerBlock) - 1;
    private long TripleIndirectEndBlock => DoubleIndirectEndBlock + (PointersPerBlock * PointersPerBlock * PointersPerBlock);

    private bool IsSysVPreset => BlockSize == 1024 && PointerSize == 4 && DirectPointersCount == 10;
    private bool IsExt4Preset => BlockSize == 4096 && PointerSize == 4 && DirectPointersCount == 12;
    private bool IsEnterprisePreset => BlockSize == 8192 && PointerSize == 8 && DirectPointersCount == 12;

    // Offset Resolver
    private long QueryOffset = 4500000;
    private OffsetResolution? Resolution;

    // FAT state
    private int FatClusterSize = 4096;
    private List<int> FatChain = new() { 4, 7, 9, 12, 15 };
    private int? SelectedCluster = 4;

    // Worksheet solutions
    private bool ShowSolution1 = false;
    private bool ShowSolution2 = false;

    protected override void OnInitialized()
    {
        ReadQueryParameters();
        Recalculate();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (string.IsNullOrEmpty(query)) return;

            var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var pair in pairs)
            {
                var parts = pair.Split('=', 2);
                var key = parts[0].ToLowerInvariant();
                var val = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";

                if (key == "embed" && bool.TryParse(val, out var embedBool))
                {
                    IsEmbed = embedBool;
                }
                else if (key == "tab")
                {
                    if (val == "fat") ActiveTab = TabMode.Fat;
                    else if (val == "worksheet") ActiveTab = TabMode.Worksheet;
                    else if (val == "inode") ActiveTab = TabMode.Inode;
                }
                else if (key == "offset" && long.TryParse(val, out var off))
                {
                    QueryOffset = off;
                }
                else if (key == "blocksize" && long.TryParse(val, out var bs))
                {
                    BlockSize = bs;
                }
            }
        }
        catch
        {
            // fallback gracefully
        }
    }

    private void SetTab(TabMode tab)
    {
        ActiveTab = tab;
    }

    private void ApplySysVPreset()
    {
        BlockSize = 1024;
        PointerSize = 4;
        DirectPointersCount = 10;
        Recalculate();
    }

    private void ApplyExt4Preset()
    {
        BlockSize = 4096;
        PointerSize = 4;
        DirectPointersCount = 12;
        Recalculate();
    }

    private void ApplyEnterprisePreset()
    {
        BlockSize = 8192;
        PointerSize = 8;
        DirectPointersCount = 12;
        Recalculate();
    }

    private void Recalculate()
    {
        ResolveOffset();
    }

    private void SetQueryOffset(long offset)
    {
        QueryOffset = offset;
        ResolveOffset();
    }

    private void ResolveOffset()
    {
        if (QueryOffset < 0) QueryOffset = 0;

        var blockNum = QueryOffset / BlockSize;
        var offsetInBlock = QueryOffset % BlockSize;
        var N = PointersPerBlock;

        if (blockNum < DirectPointersCount)
        {
            ActiveLevel = InodeLevel.Direct;
            Resolution = new OffsetResolution(
                blockNum, offsetInBlock, 1, "Direkter Zeiger", "direct-res", "🟢",
                $"Block #{blockNum} liegt im Bereich der direkten Zeiger [0 .. {DirectPointersCount - 1}]. Es wird direkt der {blockNum}. Zeiger der Inode verwendet.",
                $"Inode.direct_ptr[{blockNum}] \u2192 Datenblock #{blockNum}",
                "1 I/O: Der Datenblock wird direkt über die bereits im Speicher geladene Inode gelesen."
            );
        }
        else if (blockNum < DirectPointersCount + N)
        {
            ActiveLevel = InodeLevel.SingleIndirect;
            var relIndex = blockNum - DirectPointersCount;
            Resolution = new OffsetResolution(
                blockNum, offsetInBlock, 2, "Einfach indirekter Zeiger", "single-res", "🔵",
                $"Block #{blockNum} liegt im einfach indirekten Bereich [Index {DirectPointersCount} .. {DirectPointersCount + N - 1}]. Relativer Index im Indexblock: {blockNum} - {DirectPointersCount} = {relIndex}.",
                $"Inode.single_indirect \u2192 Zeigerblock[Eintrag #{relIndex}] \u2192 Datenblock #{blockNum}",
                "2 I/Os: 1. Indexblock von der Platte laden, 2. Ziel-Datenblock laden."
            );
        }
        else if (blockNum < DirectPointersCount + N + (N * N))
        {
            ActiveLevel = InodeLevel.DoubleIndirect;
            var rel = blockNum - DirectPointersCount - N;
            var idx1 = rel / N;
            var idx2 = rel % N;
            Resolution = new OffsetResolution(
                blockNum, offsetInBlock, 3, "Zweifach indirekter Zeiger", "double-res", "🟣",
                $"Block #{blockNum} benötigt zweistufige Indirektion. Relativer Block: {rel}. Index Ebene 1: \u230a{rel} / {N}\u230b = {idx1}; Index Ebene 2: {rel} mod {N} = {idx2}.",
                $"Inode.double_indirect \u2192 Zeigerblock_1[#{idx1}] \u2192 Zeigerblock_2[#{idx2}] \u2192 Datenblock #{blockNum}",
                "3 I/Os: 1. Ersten Indexblock laden, 2. Zweiten Indexblock laden, 3. Datenblock laden."
            );
        }
        else if (blockNum < DirectPointersCount + N + (N * N) + (N * N * N))
        {
            ActiveLevel = InodeLevel.TripleIndirect;
            var rel = blockNum - DirectPointersCount - N - (N * N);
            var N2 = N * N;
            var idx1 = rel / N2;
            var rem = rel % N2;
            var idx2 = rem / N;
            var idx3 = rem % N;
            Resolution = new OffsetResolution(
                blockNum, offsetInBlock, 4, "Dreifach indirekter Zeiger", "triple-res", "🟠",
                $"Block #{blockNum} benötigt dreistufige Indirektion. Index Ebene 1: {idx1}; Ebene 2: {idx2}; Ebene 3: {idx3}.",
                $"Inode.triple_indirect \u2192 Block_1[#{idx1}] \u2192 Block_2[#{idx2}] \u2192 Block_3[#{idx3}] \u2192 Datenblock #{blockNum}",
                "4 I/Os: 1. Indexblock 1 laden, 2. Indexblock 2 laden, 3. Indexblock 3 laden, 4. Datenblock laden."
            );
        }
        else
        {
            ActiveLevel = InodeLevel.Overflow;
            Resolution = new OffsetResolution(
                blockNum, offsetInBlock, 0, "Bereichsüberschreitung", "overflow-res", "⚠️",
                $"Das angefragte Byte-Offset überschreitet die maximale Dateigröße des Dateisystems ({FormatBytes(MaxFileSizeBytes)}).",
                "Nicht adressierbar",
                "Fehler: File too large (EFBIG)."
            );
        }
    }

    private void SetFatClusterSize(int size)
    {
        FatClusterSize = size;
    }

    private void SelectFatCluster(int clusterId)
    {
        SelectedCluster = clusterId;
    }

    private void ToggleSolution(int num)
    {
        if (num == 1) ShowSolution1 = !ShowSolution1;
        if (num == 2) ShowSolution2 = !ShowSolution2;
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB ({bytes:N0} Byte)";
        if (bytes < 1024L * 1024L * 1024L) return $"{(bytes / (1024.0 * 1024.0)):F2} MB";
        if (bytes < 1024L * 1024L * 1024L * 1024L) return $"{(bytes / (1024.0 * 1024.0 * 1024.0)):F2} GB";
        return $"{(bytes / (1024.0 * 1024.0 * 1024.0 * 1024.0)):F2} TB";
    }

    private static string FormatNumber(long val) => val.ToString("N0");

    private record OffsetResolution(
        long BlockNumber,
        long OffsetInBlock,
        int IOCount,
        string LevelName,
        string CssClass,
        string Icon,
        string StepExplanation,
        string PointerPath,
        string IODescription
    );
}
