                        </tr>
                        <tr>
                            <td><strong>Zugriffsart</strong></td>
                            <td>Schneller wahlfreier Zugriff (Random Access) über Zeigerbaum</td>
                            <td>Sequentielles Ablaufen der FAT-Kette nötig (langsamer bei großem Offset)</td>
                        </tr>
                        <tr>
                            <td><strong>Ausfallsicherheit</strong></td>
                            <td>Journaling / Superblock-Backups</td>
                            <td>Mehrere identische Kopien der FAT (FAT 1 &amp; FAT 2)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    }

