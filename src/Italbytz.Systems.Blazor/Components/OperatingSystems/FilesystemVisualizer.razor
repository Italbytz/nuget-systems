                </div>

                <!-- Subtask 2a -->
                <div class="subtask-card">
                    <h4>a) Geben Sie an, wie Sie herausfinden können, wo auf der Festplatte die Datenblöcke einer Datei gespeichert sind.</h4>
                    <textarea class="exam-textarea" rows="3" placeholder="Ihre Antwort hier formulieren..."></textarea>
                    <div class="sol-wrap">
                        <button class="sol-toggle-btn" @onclick="() => ToggleSolution(3)">
                            @(ShowSolutionFat1 ? "Musterlösung verbergen" : "💡 Offizielle Musterlösung anzeigen")
