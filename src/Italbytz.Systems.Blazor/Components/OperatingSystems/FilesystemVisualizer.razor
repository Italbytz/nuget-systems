                    </div>
                </div>

                <!-- Subtask 2c -->
                <div class="subtask-card">
                    <h4>c) Warum gibt es mehr als eine File Allocation Table?</h4>
                    <textarea class="exam-textarea" rows="2" placeholder="Ihre Antwort hier formulieren..."></textarea>
                    <div class="sol-wrap">
                        <button class="sol-toggle-btn" @onclick="() => ToggleSolution(5)">
