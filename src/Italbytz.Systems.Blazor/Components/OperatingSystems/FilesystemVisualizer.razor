@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@inject NavigationManager NavigationManager

<article class="fs-container @(IsEmbed ? "embed-mode" : "")">

    @if (!IsEmbed)
    {
        <header class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Dateisysteme</p>
            <h2>Dateisysteme: UNIX Inodes &amp; File Allocation Table (FAT)</h2>
            <p class="feature-intro">
                Interaktiver Simulator abgestimmt auf die Übungs- und Klausuraufgaben: Verfolgen Sie Schritt für Schritt,
                wie Dateien auf der Festplatte lokalisiert werden, wie kleine vs. große Dateien organisiert sind
                und warum FAT redundante Tabellenkopien vorhält.
            </p>
        </header>

        <!-- Main Tab Switcher -->
        <nav class="view-switch no-print" aria-label="Ansichtsumschalter">
            <button class="view-btn @(ActiveTab == TabMode.Inode ? "active" : "")"
                    @onclick="() => SetTab(TabMode.Inode)">
                🗂️ 1. UNIX Inodes (ext4 / System V)
            </button>
            <button class="view-btn @(ActiveTab == TabMode.Fat ? "active" : "")"
                    @onclick="() => SetTab(TabMode.Fat)">
                📋 2. FAT (File Allocation Table)
            </button>
            <button class="view-btn exam-tab-btn @(ActiveTab == TabMode.Worksheet ? "active" : "")"
                    @onclick="() => SetTab(TabMode.Worksheet)">
                🎯 3. Klausur- &amp; Übungsaufgaben (Klausurfokus)
            </button>
        </nav>
    }

    <!-- ========================================================================= -->
    <!-- TAB 1: UNIX INODES (ext4 / System V)                                      -->
    <!-- ========================================================================= -->
    @if (ActiveTab == TabMode.Inode)
    {
        <!-- Focus Question 1: How to find data blocks -->
        <section class="exam-focus-card">
            <div class="exam-focus-header">
                <span class="focus-badge badge-unix">Klausurfrage 1</span>
                <h3>Wo auf der Festplatte liegen die Datenblöcke einer Datei?</h3>
            </div>
            <p class="focus-desc">
                In unixoiden Systemen (UNIX System V, Linux ext2/3/4) erfolgt der Zugriff hierarchisch in 4 Schritten:
            </p>

            <!-- 4-Step Interactive Pipeline -->
            <div class="pipeline-grid">
                <div class="pipeline-step @(ActiveUnixStep == 1 ? "active-step" : "")" @onclick="() => SetUnixStep(1)">
                    <div class="step-num">Schritt 1</div>
                    <div class="step-title">Verzeichniseintrag</div>
                    <div class="step-meta">Dateiname &rarr; Inode-Nr</div>
                    <div class="step-badge-text">Terminal: <code>ls -i</code></div>
                </div>
                <div class="pipeline-step @(ActiveUnixStep == 2 ? "active-step" : "")" @onclick="() => SetUnixStep(2)">
                    <div class="step-num">Schritt 2</div>
                    <div class="step-title">Super-Block</div>
                    <div class="step-meta">Start der Inode-Tabelle</div>
                    <div class="step-badge-text">Metadaten der Partition</div>
                </div>
                <div class="pipeline-step @(ActiveUnixStep == 3 ? "active-step" : "")" @onclick="() => SetUnixStep(3)">
                    <div class="step-num">Schritt 3</div>
                    <div class="step-title">Inode im Inode-Bereich</div>
                    <div class="step-meta">Metadaten &amp; Blockzeiger</div>
                    <div class="step-badge-text">10–12 Direkt + Indirekt</div>
                </div>
                <div class="pipeline-step @(ActiveUnixStep == 4 ? "active-step" : "")" @onclick="() => SetUnixStep(4)">
                    <div class="step-num">Schritt 4</div>
                    <div class="step-title">Physische Datenblöcke</div>
                    <div class="step-meta">Nutzdaten auf der Disk</div>
                    <div class="step-badge-text">Direkt oder via Indexblock</div>
                </div>
            </div>

            <!-- Step Detail Box -->
            <div class="step-detail-box">
                @if (ActiveUnixStep == 1)
                {
                    <div class="step-detail-content">
                        <strong>1. Verzeichniseintrag:</strong>
                        Verzeichnisse sind spezielle Dateien, die Dateinamen auf Inode-Nummern abbilden.
                        Beispiel: Ein Eintrag verknüpft <code>"bericht.pdf"</code> mit Inode <strong>#1428</strong>.
                    </div>
                }
                else if (ActiveUnixStep == 2)
                {
                    <div class="step-detail-content">
                        <strong>2. Super-Block:</strong>
                        Der Super-Block liegt am Anfang der Partition und speichert u.&nbsp;a. die Blockgröße, die Gesamtzahl der Inodes
                        und die Information, ab welchem Blocksektor die Inode-Tabelle auf der Festplatte gespeichert ist.
                    </div>
                }
                else if (ActiveUnixStep == 3)
                {
                    <div class="step-detail-content">
                        <strong>3. Inode-Bereich:</strong>
                        Das Betriebssystem liest Inode <strong>#1428</strong> aus der Inode-Tabelle. Die Inode enthält Dateigröße, Zugriffsrechte
                        und die Liste von Zeigern auf die Datenblöcke (Cluster) der Datei.
                    </div>
                }
                else
                {
                    <div class="step-detail-content">
                        <strong>4. Datenblöcke:</strong>
                        Über die in der Inode eingetragenen Blocknummern greift der Festplattentreiber direkt auf die Sektoren der Datei im Datenbereich zu.
                    </div>
                }
            </div>

            <!-- Partition Disk Strip -->
            <div class="disk-strip-container">
                <div class="disk-strip-title">Aufbau der Partition auf dem Datenträger (UNIX System V):</div>
                <div class="disk-strip">
                    <div class="disk-segment seg-boot @(ActiveUnixStep == 0 ? "highlight-seg" : "")">
                        <span class="seg-name">Boot-Block</span>
                        <span class="seg-sub">Block 0</span>
                    </div>
                    <div class="disk-segment seg-super @(ActiveUnixStep == 2 ? "highlight-seg" : "")">
                        <span class="seg-name">Super-Block</span>
                        <span class="seg-sub">Block 1</span>
                    </div>
                    <div class="disk-segment seg-inode @(ActiveUnixStep == 1 || ActiveUnixStep == 3 ? "highlight-seg" : "")">
                        <span class="seg-name">Inode-Tabelle</span>
                        <span class="seg-sub">Inodes 1 .. N</span>
                    </div>
                    <div class="disk-segment seg-data @(ActiveUnixStep == 4 ? "highlight-seg" : "")">
                        <span class="seg-name">Datenbereich (Datenblöcke)</span>
                        <span class="seg-sub">Dateiinhalte &amp; Indexblöcke</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Focus Question 2: Large files vs. Small files -->
        <section class="exam-focus-card">
            <div class="exam-focus-header">
                <span class="focus-badge badge-unix">Klausurfrage 2</span>
                <h3>Gibt es Besonderheiten bei großen Dateien?</h3>
            </div>
            <p class="focus-desc">
                <strong>Ja!</strong> Bei großen Dateien reichen die ersten 10 bzw. 12 direkten Zeiger der Inode nicht aus.
                Das Betriebssystem verwendet dann eine hierarchische <strong>Baumstruktur aus Indexblöcken</strong>:
            </p>

            <!-- File Size Scenario Switcher -->
            <div class="scenario-buttons">
                <button class="scenario-btn @(SelectedFileSizePreset == "small" ? "active" : "")"
                        @onclick='() => SelectFileSizePreset("small")'>
                    🟢 Kleine Datei (&le; 12 Blöcke / 48 KB)
                </button>
                <button class="scenario-btn @(SelectedFileSizePreset == "medium" ? "active" : "")"
                        @onclick='() => SelectFileSizePreset("medium")'>
                    🔵 Mittelgroße Datei (Einfach indirekt / bis 4 MB)
                </button>
                <button class="scenario-btn @(SelectedFileSizePreset == "large" ? "active" : "")"
                        @onclick='() => SelectFileSizePreset("large")'>
                    🟣 Große Datei (Zweifach indirekt / bis 4 GB)
                </button>
                <button class="scenario-btn @(SelectedFileSizePreset == "huge" ? "active" : "")"
                        @onclick='() => SelectFileSizePreset("huge")'>
                    🟠 Sehr große Datei (Dreifach indirekt / bis 4 TB)
                </button>
            </div>

            <!-- Scenario Explanation & Graphic -->
            <div class="scenario-display">
                @if (SelectedFileSizePreset == "small")
                {
                    <div class="scenario-banner direct-banner">
                        <div class="scenario-badge">Stufe 1: Direkte Zeiger</div>
                        <h4>Nur direkte Adressierung (1 I/O-Zugriff)</h4>
                        <p>
                            Dateien mit maximal @DirectPointersCount Blöcken (&le; @FormatBytes(DirectBytes)) belegen ausschließlich die
                            <strong>direkten Zeiger</strong> in der Inode. Der Datenblock wird sofort mit <strong>1 Plattenzugriff</strong> gelesen.
                        </p>
                    </div>
                }
                else if (SelectedFileSizePreset == "medium")
                {
                    <div class="scenario-banner single-banner">
                        <div class="scenario-badge">Stufe 2: Einfach indirekt</div>
                        <h4>Auslagerung in einen Zeigerblock (2 I/O-Zugriffe)</h4>
                        <p>
                            Reichen die direkten Zeiger nicht aus, verweist der <strong>einfach indirekte Zeiger</strong> auf einen zusätzlichen Block,
                            der selbst ausschließlich Adressen weiterer Datenblöcke enthält. Zugriff: <strong>2 I/Os</strong> (1&times; Zeigerblock + 1&times; Datenblock).
                        </p>
                    </div>
                }
                else if (SelectedFileSizePreset == "large")
                {
                    <div class="scenario-banner double-banner">
                        <div class="scenario-badge">Stufe 3: Zweifach indirekt</div>
                        <h4>Zweistufiger Zeigerbaum (3 I/O-Zugriffe)</h4>
                        <p>
                            Der <strong>zweifach indirekte Zeiger</strong> verweist auf einen Block von Zeigerblöcken.
                            Zugriff benötigt <strong>3 I/Os</strong> (2&times; Zeigerblock + 1&times; Datenblock).
                        </p>
                    </div>
                }
                else
                {
                    <div class="scenario-banner triple-banner">
                        <div class="scenario-badge">Stufe 4: Dreifach indirekt</div>
                        <h4>Dreistufiger Zeigerbaum (4 I/O-Zugriffe)</h4>
                        <p>
                            Drei Indirektionsebenen für gigantische Dateien im Terabyte-Bereich.
                            Zugriff benötigt <strong>4 I/Os</strong> (3&times; Zeigerblock + 1&times; Datenblock).
                        </p>
                    </div>
                }

                <!-- Inode Visual Tree Representation -->
                <div class="inode-visual-box">
                    <div class="inode-card-header">
                        <span class="inode-tag">UNIX Inode #1428</span>
                        <span class="inode-sub">Dateigröße: <strong>@FormatBytes(QueryOffset)</strong></span>
                    </div>
                    <div class="ptr-list">
                        <div class="ptr-item @(ActiveLevel == InodeLevel.Direct ? "ptr-active direct-active" : "")">
                            <span class="ptr-label">Direkte Zeiger [0..@(DirectPointersCount - 1)]</span>
                            <span class="ptr-conn">&rarr;</span>
                            <span class="ptr-dest">Direkt auf Datenblöcke 0 .. @(DirectPointersCount - 1) (1 I/O)</span>
                        </div>
                        <div class="ptr-item @(ActiveLevel == InodeLevel.SingleIndirect ? "ptr-active single-active" : "")">
                            <span class="ptr-label">Einfach indirekt [1 Zeiger]</span>
                            <span class="ptr-conn">&rarr;</span>
                            <span class="ptr-dest">1 Indexblock mit @PointersPerBlock Datenblock-Zeigern (2 I/Os)</span>
                        </div>
                        <div class="ptr-item @(ActiveLevel == InodeLevel.DoubleIndirect ? "ptr-active double-active" : "")">
                            <span class="ptr-label">Zweifach indirekt [1 Zeiger]</span>
                            <span class="ptr-conn">&rarr;</span>
                            <span class="ptr-dest">1 Indexblock &rarr; @PointersPerBlock Indexblöcke &rarr; Datenblöcke (3 I/Os)</span>
                        </div>
                        <div class="ptr-item @(ActiveLevel == InodeLevel.TripleIndirect ? "ptr-active triple-active" : "")">
                            <span class="ptr-label">Dreifach indirekt [1 Zeiger]</span>
                            <span class="ptr-conn">&rarr;</span>
                            <span class="ptr-dest">3 Stufen Indirektion für Terabyte-Dateien (4 I/Os)</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Optional Deep Dive Collapsible Section -->
        <section class="collapsible-section">
            <div class="collapsible-header" @onclick="ToggleAdvancedCalculator">
                <span class="collapsible-icon">@(ShowAdvancedCalculator ? "▼" : "▶")</span>
                <h4>📐 Vertiefung (optional): Kapazitätsformel &amp; Byte-Offset-Rechner</h4>
                <span class="collapsible-hint">Kein Klausurstoff, für Hintergrundwissen</span>
            </div>

            @if (ShowAdvancedCalculator)
            {
                <div class="collapsible-body">
                    <div class="exam-note-box">
                        <strong>💡 Hinweis für die Klausur:</strong> In der Klausur wird kein Ausrechnen von 3-fach indirekten
                        Modulo-Offsets verlangt. Das Verständnis der vier Zeigerstufen und der Adressierungslogik (Fragen 1 &amp; 2) reicht vollständig aus!
                    </div>

                    <div class="advanced-grid">
                        <div class="adv-col">
                            <label>Blockgröße ($B$):</label>
                            <select class="form-select" @bind="BlockSize" @bind:after="Recalculate">
                                <option value="1024">1 KB (1.024 B)</option>
                                <option value="2048">2 KB (2.048 B)</option>
                                <option value="4096">4 KB (4.096 B)</option>
                                <option value="8192">8 KB (8.192 B)</option>
                            </select>
                        </div>
                        <div class="adv-col">
                            <label>Zeigergröße ($P$):</label>
                            <select class="form-select" @bind="PointerSize" @bind:after="Recalculate">
                                <option value="4">4 Byte (32-Bit)</option>
                                <option value="8">8 Byte (64-Bit)</option>
                            </select>
                        </div>
                        <div class="adv-col">
                            <label>Direkte Zeiger ($D$):</label>
                            <select class="form-select" @bind="DirectPointersCount" @bind:after="Recalculate">
                                <option value="10">10 (System V)</option>
                                <option value="12">12 (Linux ext)</option>
                            </select>
                        </div>
                    </div>

                    <div class="formula-banner">
                        <div class="formula-line mono">
                            $S_{\text{max}} = D \cdot B + N \cdot B + N^2 \cdot B + N^3 \cdot B = \mathbf{@FormatBytes(MaxFileSizeBytes)}$
                        </div>
                        <div class="formula-sub mono">
                            (mit $N = \frac{B}{P} = \frac{@FormatBytes(BlockSize)}{@PointerSize\text{ B}} = @PointersPerBlock$ Zeiger pro Indexblock)
                        </div>
                    </div>

                    <div class="offset-search-box">
                        <label for="adv-offset">Byte-Offset testen:</label>
                        <div class="offset-input-row">
                            <input id="adv-offset" type="number" min="0" class="form-control"
                                   @bind="QueryOffset" @bind:after="ResolveOffset" />
                            <span class="unit-tag">@FormatBytes(QueryOffset)</span>
                            <span class="res-tag @Resolution?.CssClass">Stufe: @Resolution?.LevelName (@Resolution?.IOCount I/Os)</span>
                        </div>
                    </div>
                </div>
            }
        </section>
    }

    <!-- ========================================================================= -->
    <!-- TAB 2: FAT (File Allocation Table)                                        -->
    <!-- ========================================================================= -->
    @if (ActiveTab == TabMode.Fat)
    {
        <!-- Focus Question 1: How to find data blocks in FAT -->
        <section class="exam-focus-card">
            <div class="exam-focus-header">
                <span class="focus-badge badge-fat">Klausurfrage 1</span>
                <h3>Wo auf der Festplatte liegen die Datenblöcke einer Datei (in FAT)?</h3>
            </div>
            <p class="focus-desc">
                Im Gegensatz zu UNIX Inodes nutzt FAT eine <strong>zentrale verkettete Liste</strong>:
            </p>

            <!-- 3-Step Interactive Pipeline for FAT -->
            <div class="pipeline-grid fat-pipeline">
                <div class="pipeline-step @(ActiveFatStep == 1 ? "active-step" : "")" @onclick="() => SetFatStep(1)">
                    <div class="step-num">Schritt 1</div>
                    <div class="step-title">Verzeichniseintrag</div>
                    <div class="step-meta">Dateiname &amp; Start-Cluster</div>
                    <div class="step-badge-text">z. B. Start = #@FatChain.FirstOrDefault()</div>
                </div>
                <div class="pipeline-step @(ActiveFatStep == 2 ? "active-step" : "")" @onclick="() => SetFatStep(2)">
                    <div class="step-num">Schritt 2</div>
                    <div class="step-title">File Allocation Table</div>
                    <div class="step-meta">Verkettete Liste ablaufen</div>
                    <div class="step-badge-text">Clusterkette bis EOF</div>
                </div>
                <div class="pipeline-step @(ActiveFatStep == 3 ? "active-step" : "")" @onclick="() => SetFatStep(3)">
                    <div class="step-num">Schritt 3</div>
                    <div class="step-title">Datencluster</div>
                    <div class="step-meta">Nutzdaten auf der Disk</div>
                    <div class="step-badge-text">Cluster 1:1 im Datenbereich</div>
                </div>
            </div>

            <!-- Step Detail Box -->
            <div class="step-detail-box">
                @if (ActiveFatStep == 1)
                {
                    <div class="step-detail-content">
                        <strong>1. Verzeichniseintrag:</strong>
                        Im Verzeichnis (Stammverzeichnis oder Unterordner) steht der Dateiname zusammen mit dem <strong>Start-Cluster</strong> (z. B. <code>#4</code>).
                        Der Verzeichniseintrag kennt <em>nur diesen einen</em> Cluster!
                    </div>
                }
                else if (ActiveFatStep == 2)
                {
                    <div class="step-detail-content">
                        <strong>2. File Allocation Table:</strong>
                        Ausgehend von Cluster <code>#4</code> schlägt das Betriebssystem in der FAT nach:
                        Index <code>#4</code> enthält <code>#7</code> &rarr; Index <code>#7</code> enthält <code>#9</code> &rarr;
                        Index <code>#9</code> enthält <code>#12</code> &rarr; Index <code>#12</code> enthält <code>EOF</code> (Dateiende).
                    </div>
                }
                else
                {
                    <div class="step-detail-content">
                        <strong>3. Datencluster im Datenbereich:</strong>
                        Die Kette aus der FAT (Cluster 4, 7, 9, 12) wird nun sequentiell im Datenbereich ausgelesen.
                    </div>
                }
            </div>

            <!-- FAT Partition Disk Strip -->
            <div class="disk-strip-container">
                <div class="disk-strip-title">Gesamtaufbau der FAT-Partition auf dem Datenträger:</div>
                <div class="disk-strip">
                    <div class="disk-segment seg-boot @(ActiveFatStep == 0 ? "highlight-seg" : "")">
                        <span class="seg-name">Bootsektor</span>
                        <span class="seg-sub">Reservierte Sektoren</span>
                    </div>
                    <div class="disk-segment seg-fat @(ActiveFatStep == 2 && !IsFat1Corrupted ? "highlight-seg" : "")">
                        <span class="seg-name">FAT 1</span>
                        <span class="seg-sub">Primäre Tabelle</span>
                    </div>
                    <div class="disk-segment seg-fat2 @(ActiveFatStep == 2 && IsFat1Corrupted ? "highlight-seg" : "")">
                        <span class="seg-name">FAT 2</span>
                        <span class="seg-sub">Redundante Kopie</span>
                    </div>
                    <div class="disk-segment seg-root @(ActiveFatStep == 1 ? "highlight-seg" : "")">
                        <span class="seg-name">Stammverzeichnis</span>
                        <span class="seg-sub">Directory Entries</span>
                    </div>
                    <div class="disk-segment seg-data @(ActiveFatStep == 3 ? "highlight-seg" : "")">
                        <span class="seg-name">Datenbereich (Cluster)</span>
                        <span class="seg-sub">Cluster 2 .. N</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Focus Question 2: Large files in FAT -->
        <section class="exam-focus-card">
            <div class="exam-focus-header">
                <span class="focus-badge badge-fat">Klausurfrage 2</span>
                <h3>Gibt es Besonderheiten bei großen Dateien?</h3>
            </div>
            <div class="exam-answer-callout">
                <div class="callout-icon">💡</div>
                <div class="callout-body">
                    <h4>Musterantwort aus der Klausur:</h4>
                    <p class="callout-text">
                        <strong>Nein!</strong> Bei FAT werden große und kleine Dateien gleich behandelt.
                        Die Kette der Cluster in der File Allocation Table wird einfach fortgesetzt, bis die Datei endet (<code>EOF</code>).
                    </p>
                    <span class="callout-sub">Im Gegensatz zu UNIX Inodes existieren keine Indirektionsstufen.</span>
                </div>
            </div>

            <!-- Interactive FAT Chain Visualization -->
            <div class="chain-box">
                <div class="chain-box-header">
                    <span class="chain-title">Cluster-Kette für Beispieldatei <code>vorlesung.pdf</code> (@FormatBytes(FatChain.Count * FatClusterSize)):</span>
                    <div class="chain-size-toggle">
                        <button class="pill-btn @(FatChain.Count <= 3 ? "active" : "")" @onclick="SetShortFatChain">Kleine Datei (2 Cluster)</button>
                        <button class="pill-btn @(FatChain.Count > 3 ? "active" : "")" @onclick="SetLongFatChain">Größere Datei (5 Cluster)</button>
                    </div>
                </div>
                <div class="chain-flow">
                    <div class="chain-node start-node">
                        <span class="node-tag">Verzeichnis</span>
                        <span class="node-val">Start = #@FatChain.FirstOrDefault()</span>
                    </div>
                    <span class="flow-arrow">&rarr;</span>
                    @for (int i = 0; i < FatChain.Count; i++)
                    {
                        var cluster = FatChain[i];
                        var isLast = i == FatChain.Count - 1;
                        <div class="chain-node cluster-node @(SelectedCluster == cluster ? "selected" : "")"
                             @onclick="() => SelectFatCluster(cluster)">
                            <span class="node-tag">Cluster #@cluster</span>
                            <span class="node-val mono">@(isLast ? "EOF (0xFFFF)" : $"&rarr; #{FatChain[i + 1]}")</span>
                        </div>
                        @if (!isLast)
                        {
                            <span class="flow-arrow">&rarr;</span>
                        }
                    }
                </div>
            </div>
        </section>

        <!-- Focus Question 3: Why multiple FATs -->
        <section class="exam-focus-card">
            <div class="exam-focus-header">
                <span class="focus-badge badge-fat">Klausurfrage 3</span>
                <h3>Warum gibt es mehr als eine File Allocation Table?</h3>
            </div>
            <div class="fat-redundancy-demo">
                <div class="redundancy-text">
                    <p>
                        <strong>Redundanz &amp; Ausfallsicherheit:</strong> Die FAT ist die zentrale Lebensader des Dateisystems.
                        Kommt es zu einem fehlerhaften Sektor in der primären Tabelle (FAT 1), kann der Schaden anhand der
                        Kopie (FAT 2&hellip;n) behoben oder von dort weitergelesen werden.
                    </p>
                    <button class="fail-sim-btn @(IsFat1Corrupted ? "repaired" : "corrupted")" @onclick="ToggleFat1Corruption">
                        @(IsFat1Corrupted ? "🔄 FAT 1 über Kopie (FAT 2) reparieren" : "⚠️ Lesefehler in FAT 1 simulieren")
                    </button>
                </div>

                <div class="fat-tables-pair">
                    <div class="fat-table-col @(IsFat1Corrupted ? "table-damaged" : "table-ok")">
                        <div class="col-head">
                            <span>FAT 1 (Primär)</span>
                            <span class="status-badge">@(IsFat1Corrupted ? "❌ Beschädigt" : "✓ Aktiv")</span>
                        </div>
                        <div class="col-body mono">
                            @if (IsFat1Corrupted)
                            {
                                <div class="error-msg">Lesefehler: Sektor unlesbar!</div>
                            }
                            else
                            {
                                <div>[#4 &rarr; 7] [#7 &rarr; 9] [#9 &rarr; 12] [#12 &rarr; EOF]</div>
                            }
                        </div>
                    </div>

                    <div class="fat-table-col @(IsFat1Corrupted ? "table-rescuer" : "table-standby")">
                        <div class="col-head">
                            <span>FAT 2 (Kopie)</span>
                            <span class="status-badge">@(IsFat1Corrupted ? "🛡️ Eingesprungen (Rettung)" : "✓ Standby")</span>
                        </div>
                        <div class="col-body mono">
                            <div>[#4 &rarr; 7] [#7 &rarr; 9] [#9 &rarr; 12] [#12 &rarr; EOF]</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Direct Comparison Summary -->
        <section class="comparison-card">
            <h4>Direkter Vergleich: UNIX Inodes vs. FAT (Klausur-Merktabelle)</h4>
            <div class="comp-table-wrap">
                <table class="comp-table">
                    <thead>
                        <tr>
                            <th>Kriterium</th>
                            <th>UNIX Inodes (ext4 / System V)</th>
                            <th>File Allocation Table (FAT)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Auffinden der Datenblöcke</strong></td>
                            <td>Verzeichnis &rarr; Inode &rarr; Liste direkter/indirekter Blockzeiger</td>
                            <td>Verzeichnis &rarr; Start-Cluster &rarr; Kette in FAT bis EOF</td>
                        </tr>
                        <tr>
                            <td><strong>Große Dateien</strong></td>
                            <td>Mehrstufige Indirektion (Einfach, Zweifach, Dreifach indirekte Zeiger)</td>
