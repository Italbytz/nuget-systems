                        {
                            <div class="official-solution-box">
                                <div class="sol-title">Musterlösung aus dem Vorlesungs-PDF:</div>
                                <p>
                                    „In Verzeichnissen sind die Start-Cluster einer Datei festgehalten. In der File Allocation Table
                                    sind ausgehend von diesem Cluster alle anderen Clusternummern als verkettete Liste auslesbar.“
                                </p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Subtask 2b -->
                <div class="subtask-card">
                    <h4>b) Gibt es Besonderheiten bei großen Dateien?</h4>
                    <textarea class="exam-textarea" rows="2" placeholder="Ihre Antwort hier formulieren..."></textarea>
                    <div class="sol-wrap">
                        <button class="sol-toggle-btn" @onclick="() => ToggleSolution(4)">
                            @(ShowSolutionFat2 ? "Musterlösung verbergen" : "💡 Offizielle Musterlösung anzeigen")
                        </button>
                        @if (ShowSolutionFat2)
                        {
                            <div class="official-solution-box">
                                <div class="sol-title">Musterlösung aus dem Vorlesungs-PDF:</div>
                                <p>
                                    „Nein, bei FAT werden große und kleine Dateien gleich behandelt.“
