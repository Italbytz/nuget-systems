@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="ostypes-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Grundlagen &amp; Klassifikation</p>
            <h2>Arten von Betriebssystemen (Zielsystem-Kategorien)</h2>
            <p class="feature-intro">
                Betriebssysteme sind spezialisiert auf die physikalischen und organisatorischen Anforderungen 
                ihrer Ziel-Endgeräte. Erkunden Sie die 5 wesentlichen Kategorien nach Tanenbaum/Baun:
                von hochparallelen <strong>Großrechnern</strong> und mandantenfähigen <strong>Servern</strong> 
                über <strong>PCs</strong> und energieeffiziente <strong>Mobile Computer</strong> 
                bis hin zu <strong>eingebetteten Echtzeitsystemen</strong> mit harten Zeitschranken.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver System-Explorer &amp; Benchmark-Simulator
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht 1:1)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- System Category Selector Tabs -->
        <div class="controls-panel no-print">
            <div class="category-selector">
                <span class="selector-label">Zielsystem-Kategorie wählen:</span>
                <div class="category-tabs">
                    @foreach (var sys in SystemCategories)
                    {
                        <button class="sys-tab-btn @(SelectedSysId == sys.Id ? "active" : "")"
                                style="border-color: @(SelectedSysId == sys.Id ? sys.ColorHex : "#334155");"
                                @onclick="() => SelectCategory(sys.Id)">
                            <span class="tab-icon">@sys.Icon</span>
                            <span class="tab-title">@sys.Name</span>
                            <span class="goal-preview-tag">@sys.ShortGoal</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Main Category Banner -->
        <div class="sys-banner" style="border-left-color: @CurrentSys.ColorHex;">
            <div class="banner-icon-box" style="color: @CurrentSys.ColorHex;">@CurrentSys.Icon</div>
            <div class="banner-content">
                <div class="banner-title-line">
                    <h3 class="banner-title">@CurrentSys.Name</h3>
                    <span class="exam-goal-badge">Klausur-Kernziel: @CurrentSys.PrimaryGoal</span>
                    <span class="hardware-badge">Hardware: @CurrentSys.HardwareClass</span>
                </div>
                <p class="banner-desc">@CurrentSys.Description</p>
                <div class="banner-examples-line">
                    <strong>Bekannte Betriebssysteme:</strong>
                    <span class="os-pill-list">@CurrentSys.TypicalOS</span>
                </div>
            </div>
        </div>

        <!-- Interactive Architecture & Workload Simulator Stage -->
        <div class="architecture-stage">

            <!-- Left: System Architecture & Workload Injector -->
            <div class="stage-card workload-card">
                <div class="card-header">
                    <span class="card-title">Architektur-Fokus &amp; Workload-Simulation</span>
                    <span class="card-tag" style="background: @CurrentSys.ColorHex; color: #fff;">@CurrentSys.SchedulingFocus</span>
                </div>

                <div class="workload-body">
                    <div class="focus-summary-box">
                        <span class="focus-label">Optimierungsziel des OS-Kernels:</span>
                        <div class="focus-val">@CurrentSys.KernelOptimization</div>
                    </div>

                    <div class="live-metrics-grid">
                        <div class="metric-box">
                            <span class="metric-name">@CurrentSys.Metric1Name</span>
                            <div class="metric-bar-outer">
                                <div class="metric-bar-inner" style="width: @CurrentSys.Metric1Value%; background: @CurrentSys.ColorHex;"></div>
                            </div>
                            <span class="metric-val">@CurrentSys.Metric1Label</span>
                        </div>

                        <div class="metric-box">
                            <span class="metric-name">@CurrentSys.Metric2Name</span>
                            <div class="metric-bar-outer">
                                <div class="metric-bar-inner" style="width: @CurrentSys.Metric2Value%; background: @CurrentSys.ColorHex;"></div>
                            </div>
                            <span class="metric-val">@CurrentSys.Metric2Label</span>
                        </div>

                        <div class="metric-box">
                            <span class="metric-name">@CurrentSys.Metric3Name</span>
                            <div class="metric-bar-outer">
                                <div class="metric-bar-inner" style="width: @CurrentSys.Metric3Value%; background: @CurrentSys.ColorHex;"></div>
                            </div>
                            <span class="metric-val">@CurrentSys.Metric3Label</span>
                        </div>
                    </div>

                    <!-- Workload Stress Simulation Button -->
                    <div class="workload-stress-box">
                        <span class="stress-label">Typisches Lastszenario simulieren:</span>
                        <div class="stress-desc">@CurrentSys.ScenarioDescription</div>
                        <button class="stress-trigger-btn" style="background: @CurrentSys.ColorHex;" @onclick="TriggerStressTest">
                            ⚡ Lastprofil anlegen &amp; Systemreaktion testen
                        </button>
                        @if (IsStressActive)
                        {
                            <div class="stress-result-banner">
                                <span class="stress-icon">✅</span>
                                <span class="stress-txt">@CurrentSys.StressResultText</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Architectural Components & Trade-offs -->
            <div class="stage-card trade-offs-card">
                <div class="card-header">
                    <span class="card-title">Design-Trade-offs &amp; Kerneltreiber</span>
                    <span class="card-sub">Typische Kompromisse</span>
                </div>

                <div class="trade-offs-body">
                    <div class="trade-item pro-item">
                        <span class="trade-icon">🎯</span>
                        <div class="trade-txt">
                            <strong>Höchste Priorität:</strong>
                            <span>@CurrentSys.HighestPriority</span>
                        </div>
                    </div>

                    <div class="trade-item con-item">
                        <span class="trade-icon">⚖️</span>
                        <div class="trade-txt">
                            <strong>Bewusst akzeptierter Kompromiss:</strong>
                            <span>@CurrentSys.Compromise</span>
                        </div>
                    </div>

                    <div class="trade-item tech-item">
                        <span class="trade-icon">⚙️</span>
                        <div class="trade-txt">
                            <strong>Zentrale Kernel-Mechanismen:</strong>
                            <span>@CurrentSys.KeyKernelMechanisms</span>
                        </div>
                    </div>

                    <div class="trade-item exam-item">
                        <span class="trade-icon">💡</span>
                        <div class="trade-txt">
                            <strong>Klausur-Merksatz:</strong>
                            <span>@CurrentSys.ExamTakeaway</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- System Taxonomy & Comparison Matrix -->
        <div class="panel-card taxonomy-card">
            <div class="panel-header">
                <span class="panel-title">📊 Große Vergleichsmatrix aller 5 Rechensystemarten (Tanenbaum/Baun)</span>
                <button class="toggle-btn" @onclick="ToggleTaxonomy">
                    @(ShowTaxonomy ? "▲ Tabelle einklappen" : "▼ Tabelle ausklappen")
                </button>
            </div>

            @if (ShowTaxonomy)
            {
                <div class="table-responsive">
                    <table class="ostypes-table">
                        <thead>
                            <tr>
                                <th>Kategorie</th>
                                <th>Wichtiges Ziel (Klausurlösung)</th>
                                <th>Nutzeranzahl</th>
                                <th>Hardware-Dimension</th>
                                <th>Scheduling-Schwerpunkt</th>
                                <th>Echtzeitfähigkeit</th>
                                <th>Typische OS-Beispiele</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sys in SystemCategories)
                            {
                                <tr class="@(SelectedSysId == sys.Id ? "row-selected" : "")" @onclick="() => SelectCategory(sys.Id)">
                                    <td>
                                        <span class="table-cat-name">@sys.Icon <strong>@sys.Name</strong></span>
                                    </td>
                                    <td>
                                        <span class="goal-highlight">@sys.PrimaryGoal</span>
                                    </td>
                                    <td>@sys.UserCount</td>
                                    <td>@sys.HardwareClass</td>
                                    <td>@sys.SchedulingFocus</td>
                                    <td>
                                        <span class="@(sys.IsRealtime ? "tag-rt-yes" : "tag-rt-no")">
                                            @(sys.IsRealtime ? "Ja (Hart/Weich)" : "Nein (Best-Effort)")
                                        </span>
                                    </td>
                                    <td><code class="mono-code">@sys.TypicalOS</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Exam Trainer / Self-Check matching BSGrundlagenRechensystemartenBaun.tex -->
        <div class="panel-card exam-card">
            <div class="panel-header">
                <div class="exam-title-wrap">
                    <span class="panel-title">📝 Klausur-Trainer: 1:1 Zuordnungscheck (5 Punkte)</span>
                    <span class="exam-source">Vorlage: BSGrundlagenRechensystemartenBaun.tex</span>
                </div>
                <button class="action-btn primary" @onclick="ToggleQuizSolution">
                    @(ShowQuizSolution ? "👁️ Musterlösung verbergen" : "💡 Musterlösung aufdecken & prüfen")
                </button>
            </div>

            <div class="exam-body">
                <p class="exam-prompt">
                    <em>„Betriebssysteme lassen sich nach Art der Endgeräte für die sie gemacht sind in Systeme für 
                    Großrechner, Server, Personal Computer, Mobile Computer und Eingebettete Systeme kategorisieren. 
                    Nennen Sie zu jeder Kategorie ein wichtiges Ziel.“</em>
                </p>

                <div class="quiz-match-grid">
                    @foreach (var item in QuizItems)
                    {
                        <div class="quiz-row @(ShowQuizSolution ? "row-solved" : "")">
                            <div class="quiz-cat">
                                <span class="cat-icon">@item.Icon</span>
                                <strong>@item.CategoryName</strong>
                            </div>
                            <div class="quiz-arrow">&rarr;</div>
                            <div class="quiz-answer-slot">
                                @if (ShowQuizSolution)
                                {
                                    <span class="quiz-sol-text bold text-green">@item.OfficialGoal</span>
                                    <span class="quiz-sol-hint">(@item.DetailExplanation)</span>
                                }
                                else
                                {
                                    <span class="quiz-placeholder">Klicken Sie auf „Musterlösung aufdecken“, um den exakten Prüfungstext zu vergleichen.</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- WORKSHEET VIEW (1:1 EXAM REPLICA MATCHING BSGrundlagenRechensystemarten) -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">
            
            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-group">
                    <span class="exam-sub">Grundlagen der Informatik</span>
                    <h1 class="exam-main-title">O S Types @(ShowSolution ? "- Lösung" : "")</h1>
                    <span class="exam-task-label">Aufgabe 1 (Arten von Betriebssystemen)</span>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Fields -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 5 P.</div>
                </div>
            </div>

            <!-- Task Prompt matching BSGrundlagenRechensystemartenBaun.tex -->
            <div class="task-prompt-box">
                <p class="task-text">
                    Betriebssysteme lassen sich nach Art der Endgeräte für die sie gemacht sind in Systeme für 
                    Großrechner, Server, Personal Computer, Mobile Computer und Eingebettete Systeme kategorisieren. 
                    Nennen Sie zu jeder Kategorie ein wichtiges Ziel.
                </p>
            </div>

            <!-- Answer Section matching LaTeX \TextField or \begin{wBox} -->
            @if (!ShowSolution)
            {
                <div class="ws-answer-lines">
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                </div>
            }
            else
            {
                <div class="ws-solution-box">
                    <div class="sol-bullet-list">
                        <div class="sol-item">
                            &bull; <strong>Großrechner:</strong> Viele Prozesse gleichzeitig bearbeiten
                        </div>
                        <div class="sol-item">
                            &bull; <strong>Server:</strong> Viele Nutzer gleichzeitig bedienen
                        </div>
                        <div class="sol-item">
                            &bull; <strong>PC:</strong> Arbeit und Unterhaltung vor allem für einen Benutzer
                        </div>
                        <div class="sol-item">
                            &bull; <strong>Mobile Computer:</strong> Hohe Reaktivität
                        </div>
                        <div class="sol-item">
                            &bull; <strong>Eingebettete Systeme:</strong> Einhalten von Zeitschranken
                        </div>
                    </div>
                </div>
            }

            <!-- Footer for Worksheet -->
            <div class="worksheet-footer">
                <span>Intelligent Systems Design &bull; Hochschule Hamm-Lippstadt &bull; Betriebssysteme</span>
            </div>

        </div>
    }

</article>

@code {
    public enum ViewMode { Simulator, Worksheet }

    [Parameter] public bool IsEmbed { get; set; }

    private ViewMode ActiveView { get; set; } = ViewMode.Simulator;
    private bool ShowSolution { get; set; } = false;
    private bool ShowTaxonomy { get; set; } = true;
    private bool ShowQuizSolution { get; set; } = false;
    private bool IsStressActive { get; set; } = false;

    private string SelectedSysId { get; set; } = "mainframe";

    public record SystemCategory(
        string Id,
        string Name,
        string Icon,
        string ColorHex,
        string ShortGoal,
        string PrimaryGoal,
        string HardwareClass,
        string UserCount,
        string Description,
        string TypicalOS,
        string SchedulingFocus,
        string KernelOptimization,
        string HighestPriority,
        string Compromise,
        string KeyKernelMechanisms,
        string ExamTakeaway,
        bool IsRealtime,
        string Metric1Name, int Metric1Value, string Metric1Label,
        string Metric2Name, int Metric2Value, string Metric2Label,
        string Metric3Name, int Metric3Value, string Metric3Label,
        string ScenarioDescription,
        string StressResultText
    );

    private List<SystemCategory> SystemCategories { get; set; } = new();

    private SystemCategory CurrentSys => SystemCategories.FirstOrDefault(s => s.Id == SelectedSysId) ?? SystemCategories[0];

    public record QuizMatchItem(
        string Id,
        string CategoryName,
        string Icon,
        string OfficialGoal,
        string DetailExplanation
    );

    private List<QuizMatchItem> QuizItems { get; set; } = new()
    {
        new("mainframe", "Großrechner", "🏛️", "Viele Prozesse gleichzeitig bearbeiten", "Fokus auf massiven I/O-Durchsatz, Batch-Jobs und Parallelausführung"),
        new("server", "Server", "🏢", "Viele Nutzer gleichzeitig bedienen", "Bereitstellung von Netzwerk-Diensten (Web, DB, Druck, Datei) für hunderte Clients"),
        new("pc", "Personal Computer (PC)", "💻", "Arbeit und Unterhaltung vor allem für einen Benutzer", "Fokus auf interaktive Benutzeroberflächen (GUI), Responsivität und Multimedia"),
        new("mobile", "Mobile Computer", "📱", "Hohe Reaktivität", "Schnelle Touch-Reaktion, Sensor-Handling, Telefonie/Kamera bei striktem Energiesparen"),
        new("embedded", "Eingebettete Systeme", "🤖", "Einhalten von Zeitschranken", "Harte oder weiche Deadlines bei minimalem RAM/Flash ohne GUI")
    };

    protected override void OnInitialized()
    {
        InitializeCategories();
        ReadQueryParameters();
        SelectCategory("mainframe");
    }

    protected override void OnParametersSet()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (!string.IsNullOrEmpty(query))
            {
                if (query.Contains("view=worksheet", StringComparison.OrdinalIgnoreCase))
                {
                    ActiveView = ViewMode.Worksheet;
                }
                if (query.Contains("solution=true", StringComparison.OrdinalIgnoreCase))
                {
                    ShowSolution = true;
                }
                if (query.Contains("embed=true", StringComparison.OrdinalIgnoreCase) || query.Contains("embedded=true", StringComparison.OrdinalIgnoreCase))
                {
                    IsEmbed = true;
                    ShowTaxonomy = false;
                }
            }
        }
        catch { }
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private void ToggleTaxonomy()
    {
        ShowTaxonomy = !ShowTaxonomy;
    }

    private void ToggleQuizSolution()
    {
        ShowQuizSolution = !ShowQuizSolution;
    }

    private void SelectCategory(string id)
    {
        SelectedSysId = id;
        IsStressActive = false;
    }

    private void TriggerStressTest()
    {
        IsStressActive = true;
    }

    private async Task TriggerPrint()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch { }
    }

    private void InitializeCategories()
    {
        SystemCategories = new List<SystemCategory>
        {
            // 1. Großrechner
            new SystemCategory(
                "mainframe", "Großrechner (Mainframe)", "🏛️", "#0284c7", "Viele Prozesse gleichzeitig",
                "Viele Prozesse gleichzeitig bearbeiten", "Mainframe-Schränke (z.B. IBM z16 / LinuxONE)", "Tausende getrennte Prozesse",
                "Großrechner zeichnen sich durch gigantischen I/O-Durchsatz und extreme Zuverlässigkeit (RAS) aus. Tausende Batch-Jobs und Datenbank-Transaktionen laufen parallel.",
                "z/OS, OS/360, Linux on Z", "Durchsatz- & Batch-Scheduling (Workload Manager)",
                "Massives I/O-Offloading auf Channel-Controller, Hardware-Partitionierung (LPARs)",
                "Durchsatz (Prozesse pro Sekunde) und Ausfallsicherheit", "Interaktive Latenz für Einzelnutzer irrelevant",
                "Asynchrone I/O-Kanäle, LPAR-Controller, Hardware-Multiplexing",
                "Großrechner müssen vor allem VIELE PROZESSE GLEICHZEITIG bearbeiten (I/O-intensiv).",
                false,
                "I/O-Durchsatz", 98, "Sehr hoch (GB/s Channels)",
                "Prozess-Parallelität", 95, "Bis zu 100.000 Tasks",
                "Hardware-Isolation", 100, "LPAR Hardware-Boundaries",
                "10.000 parallele Bankbuchungen eintreffen...",
                "Alle 10.000 Transaktionen wurden unterbrechungsfrei über Hardware-Kanäle abgearbeitet. Durchsatz: 100%."
            ),

            // 2. Server
            new SystemCategory(
                "server", "Server-Betriebssysteme", "🏢", "#10b981", "Viele Nutzer gleichzeitig",
                "Viele Nutzer gleichzeitig bedienen", "Rack-/Blade-Server, Cloud-Instanzen (AWS/Azure)", "Hunderte bis Millionen Nutzer",
                "Server-Betriebssysteme stellen zentrale Dienste (Web, Datenbanken, File/Print, Authentifizierung) bereit. Kernanforderung ist die parallele Bedienung vieler Clients ohne Blockade.",
                "Linux (Debian/RHEL), Windows Server, FreeBSD", "Fair-Share / CFS (Completely Fair Scheduler)",
                "Netzwerk-Stack-Skalierbarkeit (epoll/kqueue), Multithreading, Mandanten-Trennung",
                "Gleichzeitige Verbindungen, Verfügbarkeit (Uptime) und Datensicherheit", "Kein lokaler GUI-Overhead (oft Headless)",
                "epoll/io_uring, TCP SYN-Cookies, Virtual Memory Paging, Zugriffsrechte (ACLs)",
                "Server müssen vor allem VIELE NUTZER GLEICHZEITIG bedienen (Dienstbereitstellung).",
                false,
                "Netzwerk-Konkurrenz", 92, "100.000 aktive TCP-Sockets",
                "Multi-Tenant Sicherheit", 90, "Kernel-Namespaces & ACLs",
                "Verfügbarkeit (SLA)", 99, "99.999% High Availability",
                "Peak-Traffic: 50.000 gleichzeitige HTTP/REST-Anfragen...",
                "epoll hat alle 50.000 Verbindungen non-blocking angenommen. CPU-Last optimal auf Cores balanciert."
            ),

            // 3. PC
            new SystemCategory(
                "pc", "Personal Computer (PC)", "💻", "#8b5cf6", "Ein Benutzer (Arbeit/Spiele)",
                "Arbeit und Unterhaltung vor allem für einen Benutzer", "Desktop-PCs, Notebooks, Workstations", "Vor allem 1 aktiver Benutzer",
                "PC-Betriebssysteme sind primär auf interaktive Benutzerführung, reaktionsschnelle grafische Oberflächen (GUI), Office-Arbeit und Multimedia/Gaming optimiert.",
                "Microsoft Windows 11, macOS, Desktop Linux (Ubuntu/Fedora)", "Interaktivitäts-Priorisierung (Foreground Boosting)",
                "Vordergrund-Anwendung erhält CPU- & GPU-Priorität; dynamisches Treibermodell für Peripherie",
                "Gefühlte Reaktionsschnelligkeit (kein GUI-Lag) und Plug-and-Play-Kompatibilität", "Hintergrund-Durchsatz wird für flüssige UI gedrosselt",
                "Desktop-Compositor, Direct3D/Metal GPU-Pipeline, Preemptive Multitasking",
                "Personal Computer dienen der ARBEIT UND UNTERHALTUNG VOR ALLEM FÜR EINEN BENUTZER.",
                false,
                "GUI-Responsivität", 96, "60/120 Hz flüssig",
                "Peripherie-Support", 95, "USB, Bluetooth, Displays",
                "Multimedia/3D-Leistung", 90, "GPU Direct Rendering",
                "Videorendering im Hintergrund + 4K-Videowiedergabe im Vordergrund...",
                "Foreground-Boosting hält das Video ruckelfrei (120 FPS), während der Render-Job gedrosselt im Hintergrund läuft."
            ),

            // 4. Mobile
            new SystemCategory(
                "mobile", "Mobile Computer", "📱", "#f59e0b", "Hohe Reaktivität & Energie",
                "Hohe Reaktivität", "Smartphones, Tablets, Smartwatches", "1 Benutzer (Touch/Mobil)",
                "Mobile Betriebssysteme müssen extrem reaktiv auf Toucheingaben, Kamera und Sensoren reagieren, während sie gleichzeitig strikt auf minimale Leistungsaufnahme (Akkulaufzeit) achten.",
                "Android, iOS, iPadOS", "UI-Thread Affinity & Aggressives Energy-Aware-Scheduling",
                "Aggressives Einfrieren (Freeze/Suspend) inaktiver Apps, Big.LITTLE CPU-Core-Steuerung",
                "Sofortige Touch-Rückmeldung (< 16 ms) und maximale Akkulaufzeit", "Hintergrundprozesse werden stark reglementiert und getötet",
                "Doze-Mode, Low-Memory Killer (LMK), Sandboxing, Wake-Locks",
                "Mobile Computer erfordern vor allem HOHE REAKTIVITÄT bei strengem Energiesparen.",
                false,
                "Touch-Reaktivität", 98, "< 16 ms Latenz",
                "Energieeffizienz", 96, "Tiefschlaf bei Display-Aus",
