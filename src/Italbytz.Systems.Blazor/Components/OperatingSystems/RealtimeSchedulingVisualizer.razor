@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@using Italbytz.OperatingSystems
@using Italbytz.OperatingSystems.Abstractions
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="rt-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Prozessverwaltung (Process Management)</p>
            <h2>Echtzeit-Scheduling (Rate Monotonic &amp; Earliest Deadline First)</h2>
            <p class="feature-intro">
                Interaktiver Vergleich von statischer Priorisierung nach Periode (RMS, Rate-Monotonic) 
                und dynamischer Priorisierung nach absoluter Frist (EDF, Earliest Deadline First) 
                über einen 32-Zeitslot-Planungshorizont.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Simulator &amp; Gantt-Diagramm
            </button>
            
            <a class="view-btn pdf-link-btn" href="pdf/RTScheduling_10.pdf" target="_blank" download="RTScheduling_10.pdf" title="10 Echtzeit-Scheduling-Szenarien als druckreifes LaTeX-PDF herunterladen">
            🎯 Freiwilliges Klausurtraining (PDF)
        </a>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Controls Panel -->
        <div class="controls-panel no-print">
            <div class="config-grid">
                <label class="control-label">
                    <span>Szenario / Parametersatz:</span>
                    <select class="form-input select" @bind="SelectedPresetKey" @bind:after="OnPresetChanged">
                        <option value="Exam1">Beispiel 1: A=(1,8), B=(3,10), C=(3,6)</option>
                        <option value="Exam2">Beispiel 2: A=(4,15), B=(4,15), C=(4,9)</option>
                        <option value="Lecture">Beispiel 3: A=(1,4), B=(2,6), C=(3,8)</option>
                    </select>
                </label>

                <div class="policy-toggle">
                    <span class="policy-label">Aktive Ansicht:</span>
                    <div class="toggle-group">
                        <button class="toggle-btn @(ActivePolicy == "Both" ? "active" : "")" @onclick='() => ActivePolicy = "Both"'>RMS &amp; EDF Vergleich</button>
                        <button class="toggle-btn @(ActivePolicy == "RMS" ? "active" : "")" @onclick='() => ActivePolicy = "RMS"'>Nur RMS</button>
                        <button class="toggle-btn @(ActivePolicy == "EDF" ? "active" : "")" @onclick='() => ActivePolicy = "EDF"'>Nur EDF</button>
                    </div>
                </div>
            </div>

            <!-- Task Parameters Table -->
            <div class="params-strip">
                <span class="params-title">Periodische Prozesse:</span>
                <div class="task-param-chips">
                    <div class="param-chip chip-a">
                        <strong>Prozess A:</strong> Rechenzeit <em>C</em><sub>A</sub> = @TaskA_C, Periode <em>T</em><sub>A</sub> = @TaskA_T
                    </div>
                    <div class="param-chip chip-b">
                        <strong>Prozess B:</strong> Rechenzeit <em>C</em><sub>B</sub> = @TaskB_C, Periode <em>T</em><sub>B</sub> = @TaskB_T
                    </div>
                    <div class="param-chip chip-c">
                        <strong>Prozess C:</strong> Rechenzeit <em>C</em><sub>C</sub> = @TaskC_C, Periode <em>T</em><sub>C</sub> = @TaskC_T
                    </div>
                </div>
                <button class="preset-btn random" @onclick="GenerateRandomTaskSet">🎲 Zufallsszenario</button>
            </div>
        </div>

        @if (RmsSolution != null && EdfSolution != null)
        {
            var activeSteps = ActivePolicy == "EDF" ? EdfSolution.Steps : RmsSolution.Steps;
            var maxSteps = Math.Min(32, activeSteps.Count);
            var currentStepText = CurrentSlotIndex < activeSteps.Count ? activeSteps[CurrentSlotIndex] : "";

            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge badge-slot">Zeitslot t = @CurrentSlotIndex</div>
                    <div class="narrator-title">
                        RMS: <strong>@(GetTaskName(RmsSolution.Processes[CurrentSlotIndex]))</strong> | 
                        EDF: <strong>@(GetTaskName(EdfSolution.Processes[CurrentSlotIndex]))</strong>
                    </div>
                </div>
                <p class="narrator-text">
                    @if (ActivePolicy == "Both")
                    {
                        <span><strong>RMS-Entscheidung:</strong> @(CurrentSlotIndex < RmsSolution.Steps.Count ? RmsSolution.Steps[CurrentSlotIndex] : "") &bull; <strong>EDF-Entscheidung:</strong> @(CurrentSlotIndex < EdfSolution.Steps.Count ? EdfSolution.Steps[CurrentSlotIndex] : "")</span>
                    }
                    else if (ActivePolicy == "RMS")
                    {
                        <span>@(CurrentSlotIndex < RmsSolution.Steps.Count ? RmsSolution.Steps[CurrentSlotIndex] : "")</span>
                    }
                    else
                    {
                        <span>@(CurrentSlotIndex < EdfSolution.Steps.Count ? EdfSolution.Steps[CurrentSlotIndex] : "")</span>
                    }
                </p>
                <div class="utilization-strip">
                    <span>Gesamtauslastung: <strong class="mono blue">@TotalUtilization.ToString("P1")</strong></span>
                    <span>RMS (statisch): <strong class="@(IsRmsFeasible ? "emerald" : "red")">@(IsRmsFeasible ? "✓ Zulässig (im 32-Slot-Trace)" : "⚠️ Fristverletzung im Trace")</strong></span>
                    <span>EDF (dynamisch): <strong class="@(IsEdfFeasible ? "emerald" : "red")">@(IsEdfFeasible ? "✓ Zulässig (U ≤ 100%)" : (TotalUtilization > 1.0 ? "✗ Überlastet (U > 100%)" : "⚠️ Fristverletzung im Trace"))</strong></span>
                </div>
            </div>

            <!-- Main Display: Gantt Timelines -->
            <div class="gantt-display-card">
                <div class="gantt-header">
                    <h3>Scheduling-Ablaufdiagramme (Zeithorizont <em>t</em> = 0 &hellip; 31)</h3>
                    <div class="gantt-legend">
                        <span class="leg-item"><span class="leg-box leg-a"></span> Prozess A</span>
                        <span class="leg-item"><span class="leg-box leg-b"></span> Prozess B</span>
                        <span class="leg-item"><span class="leg-box leg-c"></span> Prozess C</span>
                        <span class="leg-item"><span class="leg-box leg-idle"></span> Leerlauf (Idle)</span>
                    </div>
                </div>

                <!-- Ready Requests Baseline Grid -->
                <div class="timeline-section">
                    <div class="timeline-title">Rechenbereitschaft der periodischen Prozesse:</div>
                    <div class="gantt-grid">
                        <div class="row-label label-a">Prozess A</div>
                        <div class="slots-row">
                            @for (int t = 0; t < 32; t++)
                            {
                                bool isReady = (t % TaskA_T < TaskA_C);
                                <div class="slot-cell @(isReady ? "slot-a" : "slot-empty") @(t == CurrentSlotIndex ? "slot-current" : "")">
                                    @(isReady ? "A" : "")
                                </div>
                            }
                        </div>

                        <div class="row-label label-b">Prozess B</div>
                        <div class="slots-row">
                            @for (int t = 0; t < 32; t++)
                            {
                                bool isReady = (t % TaskB_T < TaskB_C);
                                <div class="slot-cell @(isReady ? "slot-b" : "slot-empty") @(t == CurrentSlotIndex ? "slot-current" : "")">
                                    @(isReady ? "B" : "")
                                </div>
                            }
                        </div>

                        <div class="row-label label-c">Prozess C</div>
                        <div class="slots-row">
                            @for (int t = 0; t < 32; t++)
                            {
                                bool isReady = (t % TaskC_T < TaskC_C);
                                <div class="slot-cell @(isReady ? "slot-c" : "slot-empty") @(t == CurrentSlotIndex ? "slot-current" : "")">
                                    @(isReady ? "C" : "")
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- RMS Schedule Grid -->
                @if (ActivePolicy == "Both" || ActivePolicy == "RMS")
                {
                    <div class="timeline-section section-rms">
                        <div class="timeline-title">
                            <span class="policy-badge badge-rms">RMS</span>
                            <strong>Rate-Monotonic Schedule (Feste Prioritäten: $T_A=@TaskA_T, T_B=@TaskB_T, T_C=@TaskC_T$)</strong>
                        </div>
                        <div class="gantt-grid">
                            <div class="row-label label-rms">RMS CPU</div>
                            <div class="slots-row">
                                @for (int t = 0; t < 32; t++)
                                {
                                    int proc = RmsSolution.Processes[t];
                                    bool isPastOrCurrent = (t <= CurrentSlotIndex);
                                    string slotClass = GetProcSlotClass(proc);
                                    if (t == CurrentSlotIndex) slotClass += " slot-current";
                                    if (!isPastOrCurrent) slotClass += " slot-future";

                                    <div class="slot-cell @slotClass" @onclick="() => CurrentSlotIndex = t">
                                        @(isPastOrCurrent ? GetTaskAbbr(proc) : "")
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- EDF Schedule Grid -->
                @if (ActivePolicy == "Both" || ActivePolicy == "EDF")
                {
                    <div class="timeline-section section-edf">
                        <div class="timeline-title">
                            <span class="policy-badge badge-edf">EDF</span>
                            <strong>Earliest Deadline First (Dynamische Prioritäten nach absoluter Deadline)</strong>
                        </div>
                        <div class="gantt-grid">
                            <div class="row-label label-edf">EDF CPU</div>
                            <div class="slots-row">
                                @for (int t = 0; t < 32; t++)
                                {
                                    int proc = EdfSolution.Processes[t];
                                    bool isPastOrCurrent = (t <= CurrentSlotIndex);
                                    string slotClass = GetProcSlotClass(proc);
                                    if (t == CurrentSlotIndex) slotClass += " slot-current";
                                    if (!isPastOrCurrent) slotClass += " slot-future";

                                    <div class="slot-cell @slotClass" @onclick="() => CurrentSlotIndex = t">
                                        @(isPastOrCurrent ? GetTaskAbbr(proc) : "")
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Timeline Slot Indices -->
                <div class="time-ticks-row">
                    <div class="row-label label-ticks">Zeit <em>t</em></div>
                    <div class="slots-row ticks">
                        @for (int t = 0; t < 32; t++)
                        {
                            <div class="tick-cell @(t == CurrentSlotIndex ? "tick-current" : "")">
                                @t
                            </div>
                        }
                    </div>
                </div>

            </div>

            <StepPlayerHud CurrentStepIndex="@CurrentSlotIndex"
                           TotalSteps="32"
                           ProgressLabel="@($"{CurrentSlotIndex} / 31")"
                           CanGoPrevious="@(CurrentSlotIndex > 0)"
                           CanGoNext="@(CurrentSlotIndex < 31)"
                           IsEmbed="@IsEmbed"
                           OnStart="GoToStart"
                           OnPrevious="PreviousStep"
                           OnNext="NextStep"
                           OnEnd="GoToEnd"
                           OnRandom="GenerateRandomTaskSet" />
        }
    }

    <!-- ========================================================================= -->
    <!-- WORKSHEET VIEW (1:1 EXAM REPLICA)                                         -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">

            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-block">
                    <span class="exam-sub">Betriebssysteme &bull; Echtzeitsysteme</span>
                    <h1 class="exam-main-title">Übungs- und Klausuraufgabe: Echtzeit-Scheduling (RMS &amp; EDF)</h1>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Seite drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Fields -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 12 P.</div>
                </div>
            </div>

            <!-- Intro Text matching BSSchedulingEchtzeitText -->
            <div class="task-prompt-box">
                <p class="task-text">
                    Periodische Echtzeitprozesse müssen ihre Berechnungen jeweils vor Ablauf ihrer Deadline abschließen.
                    Bei <strong>Rate-Monotonic Scheduling (RMS)</strong> werden feste Prioritäten nach der kürzesten Periode vergeben.
                    Bei <strong>Earliest Deadline First (EDF)</strong> erhält der Prozess mit der aktuell am nächsten liegenden absoluten Frist dynamisch den Vorrang.
                </p>
            </div>

            <!-- Teilaufgabe 1 -->
            <div class="task-section">
                <div class="task-sub-title">
                    <span>Teilaufgabe 1 (6 Punkte)</span>
                </div>
                <p class="task-text">
                    Prozesse A, B und C melden sich gemäß folgender Abbildung rechenbereit. 
                    Markieren Sie in den Zeilen <strong>RMS A, B, C</strong> und <strong>EDF A, B, C</strong>, wie die Prozesse auf der CPU geschedulet werden.
                </p>

                <!-- Task Parameter Strip -->
                <div class="ws-task-specs">
                    <span><strong>Prozess A:</strong> <em>C</em><sub>A</sub> = @TaskA_C, <em>T</em><sub>A</sub> = @TaskA_T</span>
                    <span><strong>Prozess B:</strong> <em>C</em><sub>B</sub> = @TaskB_C, <em>T</em><sub>B</sub> = @TaskB_T</span>
                    <span><strong>Prozess C:</strong> <em>C</em><sub>C</sub> = @TaskC_C, <em>T</em><sub>C</sub> = @TaskC_T</span>
                </div>

                <!-- 1:1 Exam Table Grid matching LaTeX hshlexercise template -->
                <div class="ws-exam-matrix">
                    <table class="ws-matrix-table">
                        <thead>
                            <tr>
                                <th class="hdr-label">Prozess</th>
                                @for (int t = 0; t < 32; t++)
                                {
                                    <th class="hdr-tick">@t</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Ready A -->
                            <tr class="row-ready row-ready-a">
                                <td class="lbl-cell lbl-a">A (Bereit)</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isReady = (t % TaskA_T < TaskA_C);
                                    <td class="cell-ready @(isReady ? "fill-a" : "")"></td>
                                }
                            </tr>
                            <!-- Ready B -->
                            <tr class="row-ready row-ready-b">
                                <td class="lbl-cell lbl-b">B (Bereit)</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isReady = (t % TaskB_T < TaskB_C);
                                    <td class="cell-ready @(isReady ? "fill-b" : "")"></td>
                                }
                            </tr>
                            <!-- Ready C -->
                            <tr class="row-ready row-ready-c">
                                <td class="lbl-cell lbl-c">C (Bereit)</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isReady = (t % TaskC_T < TaskC_C);
                                    <td class="cell-ready @(isReady ? "fill-c" : "")"></td>
                                }
                            </tr>

                            <!-- Separator -->
                            <tr class="sep-row"><td colspan="33"></td></tr>

                            <!-- RMS A -->
                            <tr class="row-sched">
                                <td class="lbl-cell">RMS A</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isExec = ShowSolution && RmsSolution != null && RmsSolution.Processes[t] == 0;
                                    <td class="cell-box @(isExec ? "exec-a" : "")">
                                        @(isExec ? "✕" : "")
                                    </td>
                                }
                            </tr>
                            <!-- RMS B -->
                            <tr class="row-sched">
                                <td class="lbl-cell">RMS B</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isExec = ShowSolution && RmsSolution != null && RmsSolution.Processes[t] == 1;
                                    <td class="cell-box @(isExec ? "exec-b" : "")">
                                        @(isExec ? "✕" : "")
                                    </td>
                                }
                            </tr>
                            <!-- RMS C -->
                            <tr class="row-sched">
                                <td class="lbl-cell">RMS C</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isExec = ShowSolution && RmsSolution != null && RmsSolution.Processes[t] == 2;
                                    <td class="cell-box @(isExec ? "exec-c" : "")">
                                        @(isExec ? "✕" : "")
                                    </td>
                                }
                            </tr>

                            <!-- Separator -->
                            <tr class="sep-row"><td colspan="33"></td></tr>

                            <!-- EDF A -->
                            <tr class="row-sched">
                                <td class="lbl-cell">EDF A</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isExec = ShowSolution && EdfSolution != null && EdfSolution.Processes[t] == 0;
                                    <td class="cell-box @(isExec ? "exec-a" : "")">
                                        @(isExec ? "✕" : "")
                                    </td>
                                }
                            </tr>
                            <!-- EDF B -->
                            <tr class="row-sched">
                                <td class="lbl-cell">EDF B</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isExec = ShowSolution && EdfSolution != null && EdfSolution.Processes[t] == 1;
                                    <td class="cell-box @(isExec ? "exec-b" : "")">
                                        @(isExec ? "✕" : "")
                                    </td>
                                }
                            </tr>
                            <!-- EDF C -->
                            <tr class="row-sched">
                                <td class="lbl-cell">EDF C</td>
                                @for (int t = 0; t < 32; t++)
                                {
                                    bool isExec = ShowSolution && EdfSolution != null && EdfSolution.Processes[t] == 2;
                                    <td class="cell-box @(isExec ? "exec-c" : "")">
                                        @(isExec ? "✕" : "")
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Teilaufgabe 2 (Begründung / Auslastung) -->
            <div class="task-section">
                <div class="task-sub-title">
                    <span>Teilaufgabe 2 (6 Punkte)</span>
                </div>
                <p class="task-text">
                    Berechnen Sie die Gesamtauslastung <em>U</em> = &sum; <em>C</em><sub><em>i</em></sub> / <em>T</em><sub><em>i</em></sub> und beurteilen Sie anhand des Ablaufplans, ob RMS und EDF zulässige Ablaufpläne liefern.
                </p>

                @if (ShowSolution)
                {
                    <div class="ws-solution-box">
                        <p class="sol-text">
                            <strong>Auslastungsberechnung:</strong>
                            <div class="mono bold text-center" style="margin: 0.5rem 0;">
                                <em>U</em> = @TaskA_C / @TaskA_T + @TaskB_C / @TaskB_T + @TaskC_C / @TaskC_T = @TotalUtilization.ToString("0.###") &bull; (@TotalUtilization.ToString("P1"))
                            </div>
                        </p>
                        <p class="sol-text">
                            <strong>RMS-Beurteilung:</strong> Da RMS feste Prioritäten nach der kürzesten Periode vergibt, @(IsRmsFeasible ? "werden im 32-Slot-Ablaufplan alle Fristen eingehalten (zulässig)." : "kommt es im Ablaufplan zu einer Fristverletzung (nicht zulässig).")
                        </p>
                        <p class="sol-text">
                            <strong>EDF-Beurteilung:</strong> Für EDF gilt die notwendige und hinreichende Bedingung <em>U</em> &le; 100%. Da <em>U</em> @(TotalUtilization <= 1.0 ? "≤" : ">") 1,0, ist der Ablaufplan nach EDF @(IsEdfFeasible ? "garantiert ohne Deadline-Verletzungen einhaltbar." : "überlastet und nicht einhaltbar.")
                        </p>
                    </div>
                }
                else
                {
                    <div class="ws-textfield-lines">
                        <div class="text-line"></div>
                        <div class="text-line"></div>
                        <div class="text-line"></div>
                        <div class="text-line"></div>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="exam-footer">
                <div class="exam-footer-note">
                    Hinweis: Tragen Sie in jedes Zeitintervall [<em>t</em>, <em>t</em>+1) genau ein Kreuz X für den ausgeführten Prozess ein.
                </div>
            </div>

        </div>
    }

</article>

@code {
    public enum ViewMode { Simulator, Worksheet }

    [Parameter] public string? View { get; set; }
    [Parameter] public bool? Solution { get; set; }
    [Parameter] public bool? Embed { get; set; }

    private ViewMode ActiveView = ViewMode.Simulator;
    private bool ShowSolution = false;
    private bool IsEmbed = false;

    private string SelectedPresetKey = "Exam1";
    private string ActivePolicy = "Both";

    private int TaskA_C = 1;
    private int TaskA_T = 8;

    private int TaskB_C = 3;
    private int TaskB_T = 10;

    private int TaskC_C = 3;
    private int TaskC_T = 6;

    private IRealtimeSchedulingSolution? RmsSolution;
    private IRealtimeSchedulingSolution? EdfSolution;
    private int CurrentSlotIndex = 0;

    private double TotalUtilization => ((double)TaskA_C / TaskA_T) + ((double)TaskB_C / TaskB_T) + ((double)TaskC_C / TaskC_T);
    private bool IsRmsFeasible => CheckDeadlinesMet(RmsSolution);
    private bool IsEdfFeasible => TotalUtilization <= 1.0 && CheckDeadlinesMet(EdfSolution);

    private bool CheckDeadlinesMet(IRealtimeSchedulingSolution? solution)
    {
        if (solution == null) return false;
        var tasks = new (int C, int T, int Id)[]
        {
            (TaskA_C, TaskA_T, 0),
            (TaskB_C, TaskB_T, 1),
            (TaskC_C, TaskC_T, 2)
        };

        foreach (var task in tasks)
        {
            if (task.T <= 0 || task.C <= 0) continue;
            int periodStart = 0;
            while (periodStart + task.T <= 32)
            {
                int count = 0;
                for (int t = periodStart; t < periodStart + task.T; t++)
                {
                    if (solution.Processes[t] == task.Id) count++;
                }
                if (count < task.C) return false;
                periodStart += task.T;
            }
        }
        return true;
    }

    private string? _lastQueryString;

    protected override void OnInitialized()
    {
        LoadPreset(SelectedPresetKey);
        ReadQueryParameters();
    }

    protected override void OnParametersSet()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (string.IsNullOrEmpty(query) || query == _lastQueryString) return;
            _lastQueryString = query;

            var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            bool customTasksSpecified = false;

            foreach (var pair in pairs)
            {
                var parts = pair.Split('=', 2);
                var key = parts[0].ToLowerInvariant();
                var val = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";

                if ((key == "embed" || key == "embedded") && bool.TryParse(val, out var embedBool))
                {
                    IsEmbed = embedBool;
                }
                else if (key == "view")
                {
                    ActiveView = val.Equals("worksheet", StringComparison.OrdinalIgnoreCase)
                        ? ViewMode.Worksheet
                        : ViewMode.Simulator;
                }
                else if (key == "solution" && bool.TryParse(val, out var solBool))
                {
                    ShowSolution = solBool;
                }
                else if (key == "policy")
                {
                    if (val.Equals("rms", StringComparison.OrdinalIgnoreCase))
                    {
                        ActivePolicy = "RMS";
                    }
                    else if (val.Equals("edf", StringComparison.OrdinalIgnoreCase))
                    {
                        ActivePolicy = "EDF";
                    }
                    else if (val.Equals("both", StringComparison.OrdinalIgnoreCase))
                    {
                        ActivePolicy = "Both";
                    }
                }
                else if (key == "preset" || key == "p")
                {
                    var normalized = val.Trim().ToLowerInvariant();
                    if (normalized == "1" || normalized == "exam1" || normalized == "beispiel1" || normalized == "beispiel_1" || normalized == "ex1")
                    {
                        LoadPreset("Exam1");
                    }
                    else if (normalized == "2" || normalized == "exam2" || normalized == "beispiel2" || normalized == "beispiel_2" || normalized == "ex2")
                    {
                        LoadPreset("Exam2");
                    }
                    else if (normalized == "3" || normalized == "lecture" || normalized == "vorlesung" || normalized == "beispiel3" || normalized == "beispiel_3" || normalized == "ex3")
                    {
                        LoadPreset("Lecture");
                    }
                }
                else if (key == "a" && TryParseTask(val, out var ca, out var ta))
                {
                    TaskA_C = ca;
                    TaskA_T = ta;
                    customTasksSpecified = true;
                }
                else if (key == "b" && TryParseTask(val, out var cb, out var tb))
                {
                    TaskB_C = cb;
                    TaskB_T = tb;
                    customTasksSpecified = true;
                }
                else if (key == "c" && TryParseTask(val, out var cc, out var tc))
                {
                    TaskC_C = cc;
                    TaskC_T = tc;
                    customTasksSpecified = true;
                }
                else if (key == "ca" && int.TryParse(val, out var parsedCa) && parsedCa > 0)
                {
                    TaskA_C = parsedCa;
                    customTasksSpecified = true;
                }
                else if (key == "ta" && int.TryParse(val, out var parsedTa) && parsedTa > 0)
                {
                    TaskA_T = parsedTa;
                    customTasksSpecified = true;
                }
                else if (key == "cb" && int.TryParse(val, out var parsedCb) && parsedCb > 0)
                {
                    TaskB_C = parsedCb;
                    customTasksSpecified = true;
                }
                else if (key == "tb" && int.TryParse(val, out var parsedTb) && parsedTb > 0)
                {
                    TaskB_T = parsedTb;
                    customTasksSpecified = true;
                }
                else if (key == "cc" && int.TryParse(val, out var parsedCc) && parsedCc > 0)
                {
                    TaskC_C = parsedCc;
                    customTasksSpecified = true;
                }
                else if (key == "tc" && int.TryParse(val, out var parsedTc) && parsedTc > 0)
                {
                    TaskC_T = parsedTc;
                    customTasksSpecified = true;
                }
                else if ((key == "slot" || key == "step" || key == "t") && int.TryParse(val, out var slot))
                {
                    CurrentSlotIndex = Math.Clamp(slot, 0, 31);
                }
            }

            if (customTasksSpecified)
            {
                Recalculate();
            }
        }
        catch { }
    }

    private static bool TryParseTask(string val, out int c, out int t)
    {
        c = 0;
        t = 0;
        var parts = val.Split(new[] { ',', ';', ':', '/' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && int.TryParse(parts[0].Trim(), out c) && int.TryParse(parts[1].Trim(), out t) && c > 0 && t > 0)
        {
            return true;
        }
        return false;
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void OnPresetChanged()
    {
        LoadPreset(SelectedPresetKey);
    }

    private void LoadPreset(string key)
    {
        SelectedPresetKey = key;
        switch (key)
        {
            case "Exam1":
                TaskA_C = 1; TaskA_T = 8;
                TaskB_C = 3; TaskB_T = 10;
                TaskC_C = 3; TaskC_T = 6;
                break;
            case "Exam2":
                TaskA_C = 4; TaskA_T = 15;
                TaskB_C = 4; TaskB_T = 15;
                TaskC_C = 4; TaskC_T = 9;
                break;
            case "Lecture":
                TaskA_C = 1; TaskA_T = 4;
                TaskB_C = 2; TaskB_T = 6;
                TaskC_C = 3; TaskC_T = 8;
                break;
        }
        Recalculate();
    }

    private void Recalculate()
    {
        var parameters = new RealtimeSchedulingParameters(new (int, int)[]
        {
            (TaskA_C, TaskA_T),
            (TaskB_C, TaskB_T),
            (TaskC_C, TaskC_T)
        });

        var rmsSolver = new RMSSolver();
        var edfSolver = new EDFSolver();

        RmsSolution = rmsSolver.Solve(parameters);
        EdfSolution = edfSolver.Solve(parameters);

        if (CurrentSlotIndex >= 32) CurrentSlotIndex = 0;
    }

    private void GenerateRandomTaskSet()
    {
        var rand = new Random();
        TaskA_C = rand.Next(1, 3);
        TaskA_T = rand.Next(4, 9);

        TaskB_C = rand.Next(1, 4);
        TaskB_T = rand.Next(6, 12);

        TaskC_C = rand.Next(1, 4);
        TaskC_T = rand.Next(6, 14);

        Recalculate();
        CurrentSlotIndex = 0;
    }

    private void GoToStart() => CurrentSlotIndex = 0;
    private void PreviousStep() { if (CurrentSlotIndex > 0) CurrentSlotIndex--; }
    private void NextStep() { if (CurrentSlotIndex < 31) CurrentSlotIndex++; }
    private void GoToEnd() => CurrentSlotIndex = 31;

    private void OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            CurrentSlotIndex = Math.Clamp(val, 0, 31);
        }
    }

    private string GetTaskName(int procIdx)
    {
        return procIdx switch
        {
            0 => "Prozess A",
            1 => "Prozess B",
            2 => "Prozess C",
            _ => "Leerlauf (Idle)"
        };
    }

    private string GetTaskAbbr(int procIdx)
    {
        return procIdx switch
        {
            0 => "A",
            1 => "B",
            2 => "C",
            _ => "-"
        };
    }

    private string GetProcSlotClass(int procIdx)
    {
        return procIdx switch
        {
            0 => "slot-a",
            1 => "slot-b",
            2 => "slot-c",
            _ => "slot-idle"
        };
    }
}
