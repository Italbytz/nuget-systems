@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@using Italbytz.OperatingSystems
@using Italbytz.OperatingSystems.Abstractions
@using Italbytz.OperatingSystems.Resources.Buddy
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="buddy-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">
    
    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Speicherverwaltung</p>
            <h2>Buddy-System (Speicherallokation, Split &amp; Coalescing)</h2>
            <p class="feature-intro">
                Schritt-für-Schritt-Ablaufverfolgung der binären Speicheraufteilung in 2er-Potenzen (1024 KB Gesamtspeicher, 32 Kacheln à 32 KB), 
                Berechnung des internen Verschnitts und Verschmelzung (Merging) von Partner-Blöcken (Buddies) bei der Freigabe.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Simulator (Step-Trace)
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Controls Panel -->
        <div class="controls-panel no-print">
            <div class="config-grid">
                <label class="control-label">
                    <span>Anforderungen in KB für Prozesse A–E:</span>
                    <input type="text" class="form-input" @bind="BuddyRequestsInput" @bind:after="OnConfigurationChanged" placeholder="z. B. 120, 64, 200, 32, 90" />
                </label>

                <label class="control-label">
                    <span>Freigabe-Reihenfolge:</span>
                    <input type="text" class="form-input" @bind="BuddyReleaseOrderInput" @bind:after="OnConfigurationChanged" placeholder="z. B. B, D, A, E, C" />
                </label>
            </div>

            <!-- Presets Bar -->
            <div class="preset-bar">
                <span class="preset-label">Beispiele:</span>
                <button class="preset-btn" title="120, 64, 200, 32, 90 | B, D, A, E, C" @onclick="() => LoadPreset(Preset1Requests, Preset1Release)">Beispiel 1</button>
                <button class="preset-btn" title="171, 7, 394, 41, 9 | C, E, D, B, A" @onclick="() => LoadPreset(Preset2Requests, Preset2Release)">Beispiel 2</button>
                <button class="preset-btn" title="80, 240, 60, 110, 45 | A, C, B, E, D" @onclick="() => LoadPreset(Preset3Requests, Preset3Release)">Beispiel 3</button>
                <button class="preset-btn random" @onclick="GenerateRandomSet">🎲 Zufall</button>
            </div>
        </div>

        @if (TryGetParsedBuddy(out var buddyData, out var parseError))
        {
            var maxSteps = buddyData!.Snapshots.Count; // 10 steps (0..9) + initial (step 0 = initial, 1..10 = ops)
            var currentSnapshot = CurrentStepIndex == 0 
                ? Enumerable.Repeat("free", 32).ToArray() 
                : buddyData.Snapshots[CurrentStepIndex - 1];

            <!-- Player Toolbar -->
            <div class="player-toolbar no-print">
                <div class="player-controls">
                    <button class="player-btn" title="Start" disabled="@(CurrentStepIndex == 0)" @onclick="GoToStart">⏮ Start</button>
                    <button class="player-btn" title="Zurück" disabled="@(CurrentStepIndex == 0)" @onclick="PreviousStep">◀ Zurück</button>
                    <button class="player-btn primary" title="Nächster Schritt" disabled="@(CurrentStepIndex >= maxSteps)" @onclick="NextStep">▶ Weiter</button>
                    <button class="player-btn" title="Ende" disabled="@(CurrentStepIndex >= maxSteps)" @onclick="GoToEnd">⏭ Ende</button>
                    <button class="player-btn reset" title="Zurücksetzen" @onclick="GoToStart">🔄 Reset</button>
                </div>

                <div class="player-progress">
                    <span class="step-indicator">
                        <strong>Schritt @CurrentStepIndex / @maxSteps</strong>
                    </span>
                    <input type="range" min="0" max="@maxSteps" value="@CurrentStepIndex" @oninput="OnSliderChanged" class="step-slider" />
                </div>
            </div>

            <!-- Unified Buddy Matrix Card -->
            <div class="matrix-card">
                <div class="matrix-card-header">
                    <div class="step-summary-bar">
                        @if (CurrentStepIndex == 0)
                        {
                            <span class="step-badge badge-init">🏁 Initial</span>
                            <span class="summary-text">1024 KB freier Hauptspeicher (32 Kacheln à 32 KB)</span>
                        }
                        else
                        {
                            var op = buddyData.StepDetails[CurrentStepIndex - 1];
                            var isAlloc = op.OperationType == "Allocate";
                            <span class="step-badge @(isAlloc ? "badge-alloc" : "badge-free")">
                                @(isAlloc ? "📥 Allokation" : "📤 Freigabe") @op.ProcessName
                            </span>
                            <span class="summary-text">@GetCompactStepSummary(CurrentStepIndex, buddyData)</span>
                        }
                    </div>

                    <div class="matrix-legend">
                        <span class="legend-chip p-a">A (@buddyData.Requests[0] KB)</span>
                        <span class="legend-chip p-b">B (@buddyData.Requests[1] KB)</span>
                        <span class="legend-chip p-c">C (@buddyData.Requests[2] KB)</span>
                        <span class="legend-chip p-d">D (@buddyData.Requests[3] KB)</span>
                        <span class="legend-chip p-e">E (@buddyData.Requests[4] KB)</span>
                        <span class="legend-chip free-legend-pill">Ziffern 1, 2, 3… = Freiblöcke (Start &amp; Ende)</span>
                    </div>
                </div>

                <!-- 32-Column Matrix Table -->
                <div class="matrix-table-wrapper">
                    <table class="buddy-matrix-table">
                        <thead>
                            <tr class="scale-row">
                                <th class="col-op scale-hdr">Adressbereich</th>
                                <th colspan="8" class="scale-th">0 – 256 KB</th>
                                <th colspan="8" class="scale-th">256 – 512 KB</th>
                                <th colspan="8" class="scale-th">512 – 768 KB</th>
                                <th colspan="8" class="scale-th">768 – 1024 KB</th>
                            </tr>
                            <tr class="header-row">
                                <th class="col-op">Operation</th>
                                @for (int c = 0; c < 32; c++)
                                {
                                    var is4th = (c + 1) % 4 == 0 && c < 31;
                                    var is8th = (c + 1) % 8 == 0 && c < 31;
                                    <th class="col-kachel @(is8th ? "grid-bound-major" : is4th ? "grid-bound-minor" : "")" 
                                        title="Kachel @c: [@(c * 32) KB – @((c + 1) * 32) KB]">@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Step 0: Initial -->
                            <tr class="matrix-row @(CurrentStepIndex == 0 ? "matrix-row-active" : "")">
                                <td class="op-cell">
                                    <span class="proc-indicator init-tag">Initial</span>
                                    <span class="op-sub">1024 KB</span>
                                    @if (CurrentStepIndex == 0)
                                    {
                                        <span class="active-arrow">◀</span>
                                    }
                                </td>
                                @for (int c = 0; c < 32; c++)
                                {
                                    var isStart = c == 0;
                                    var isEnd = c == 31;
                                    var is8thBound = (c + 1) % 8 == 0 && c < 31;
                                    var is4thBound = (c + 1) % 4 == 0 && c < 31;
                                    <td class="kaestchen kaestchen-free free-color-0 @(isStart ? "block-start" : "") @(isEnd ? "block-end" : "") @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")"
                                        title="Freier Block 1: Kacheln [0..31] [0 KB – 1024 KB] (1024 KB)">
                                        <div class="kaestchen-inner">
                                            @if (isStart || isEnd)
                                            {
                                                <span class="free-num-badge">1</span>
                                            }
                                            else
                                            {
                                                <span class="free-connector"></span>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>

                            @for (int s = 0; s < buddyData.Snapshots.Count; s++)
                            {
                                var stepNum = s + 1;
                                var isRowActive = CurrentStepIndex == stepNum;
                                var isFuture = stepNum > CurrentStepIndex;
                                var op = buddyData.StepDetails[s];
                                var rowSnap = buddyData.Snapshots[s];
                                var blocks = GetBuddyBlocks(rowSnap);

                                <tr class="matrix-row @(isRowActive ? "matrix-row-active" : "") @(isFuture ? "matrix-row-future" : "")">
                                    <td class="op-cell">
                                        <span class="proc-indicator @GetSlotColorClass(op.ProcessName)">@op.Title</span>
                                        @if (isRowActive)
                                        {
                                            <span class="active-arrow">◀</span>
                                        }
                                    </td>
                                    @if (isFuture)
                                    {
                                        @for (int c = 0; c < 32; c++)
                                        {
                                            var is8thBound = (c + 1) % 8 == 0 && c < 31;
                                            var is4thBound = (c + 1) % 4 == 0 && c < 31;
                                            <td class="kaestchen kaestchen-future @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")">
                                                <span class="future-dot">·</span>
                                            </td>
                                        }
                                    }
                                    else
                                    {
                                        @for (int c = 0; c < 32; c++)
                                        {
                                            var block = blocks.FirstOrDefault(b => c >= b.StartSlot && c <= b.EndSlot);
                                            if (block != null)
                                            {
                                                var isAlloc = block.IsAllocated;
                                                var isStart = c == block.StartSlot;
                                                var isEnd = c == block.EndSlot;
                                                var isAffected = isRowActive && op.AffectedSlots.Contains(c);
                                                var is8thBound = (c + 1) % 8 == 0 && c < 31;
                                                var is4thBound = (c + 1) % 4 == 0 && c < 31;

                                                if (isAlloc)
                                                {
                                                    <td class="kaestchen kaestchen-alloc @GetSlotColorClass(block.ProcessName) @(isStart ? "block-start" : "") @(isEnd ? "block-end" : "") @(isAffected ? "affected-slot" : "") @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")"
                                                        title="Prozess @block.ProcessName: Kacheln [@block.StartSlot..@block.EndSlot] [@block.StartKb KB – @block.EndKb KB] (@(block.SizeKb) KB)">
                                                        <div class="kaestchen-inner">
                                                            <span class="slot-letter">@block.ProcessName</span>
                                                        </div>
                                                    </td>
                                                }
                                                else
                                                {
                                                    var colorIdx = (block.BlockNumber - 1) % 6;
                                                    <td class="kaestchen kaestchen-free free-color-@colorIdx @(isStart ? "block-start" : "") @(isEnd ? "block-end" : "") @(isAffected ? "affected-slot" : "") @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")"
                                                        title="Freier Block @block.BlockNumber: Kacheln [@block.StartSlot..@block.EndSlot] [@block.StartKb KB – @block.EndKb KB] (@(block.SizeKb) KB)">
                                                        <div class="kaestchen-inner">
                                                            @if (isStart || isEnd)
                                                            {
                                                                <span class="free-num-badge">@block.BlockNumber</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="free-connector"></span>
                                                            }
                                                        </div>
                                                    </td>
                                                }
                                            }
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @{
                    var currentBlocks = GetBuddyBlocks(currentSnapshot);
                }
                <!-- Active Blocks Detail (Anfangspunkt, Endpunkt, Kacheln & Größe) -->
                <div class="active-allocation-panel no-print">
                    <div class="allocation-title-row">
                        <span class="alloc-title">📍 Aktuelle Speicherbelegung (Start- &amp; Endpunkte):</span>
                        <span class="alloc-help">Kacheln 0–31 à 32 KB | 0 KB – 1024 KB</span>
                    </div>
                    <div class="block-chips-list">
                        @foreach (var b in currentBlocks)
                        {
                            if (b.IsAllocated)
                            {
                                <div class="alloc-chip chip-alloc @GetSlotColorClass(b.ProcessName)"
                                     title="Prozess @b.ProcessName: Kacheln [@b.StartSlot..@b.EndSlot] [@b.StartKb–@b.EndKb KB]">
                                    <span class="chip-proc">@b.ProcessName</span>
                                    <span class="chip-range">Kacheln @b.StartSlot–@b.EndSlot</span>
                                    <span class="chip-kb">[@b.StartKb–@b.EndKb KB]</span>
                                    <span class="chip-len">(@(b.SizeKb) KB)</span>
                                </div>
                            }
                            else
                            {
                                var colorIdx = (b.BlockNumber - 1) % 6;
                                <div class="alloc-chip chip-free free-color-@colorIdx"
                                     title="Freier Block @b.BlockNumber: Kacheln [@b.StartSlot..@b.EndSlot] [@b.StartKb–@b.EndKb KB]">
                                    <span class="chip-free-badge">@b.BlockNumber</span>
                                    <span class="chip-range">Kacheln @b.StartSlot–@b.EndSlot</span>
                                    <span class="chip-kb">[@b.StartKb–@b.EndKb KB]</span>
                                    <span class="chip-len">(@(b.SizeKb) KB frei)</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Step Metrics Bar -->
                <div class="metrics-grid four-up">
                    <div class="metric-card">
                        <span class="metric-label">Belegter Speicher</span>
                        <strong class="metric-val">@((currentSnapshot.Count(s => s != "free") * 32)) KB</strong>
                        <span class="metric-sub">@currentSnapshot.Count(s => s != "free") von 32 Kacheln belegt</span>
                    </div>

                    <div class="metric-card">
                        <span class="metric-label">Freier Speicher</span>
                        <strong class="metric-val text-success">@((currentSnapshot.Count(s => s == "free") * 32)) KB</strong>
                        <span class="metric-sub">in @(currentBlocks.Count(b => !b.IsAllocated)) Freiblöcken</span>
                    </div>

                    <div class="metric-card">
                        <span class="metric-label">Aktive Prozesse</span>
                        <strong class="metric-val text-brand">@currentSnapshot.Where(s => s != "free").Distinct().Count()</strong>
                        <span class="metric-sub">im Hauptspeicher</span>
                    </div>

                    <div class="metric-card">
                        <span class="metric-label">Freigabereihenfolge</span>
                        <strong class="metric-val text-amber">@string.Join(" → ", buddyData.ReleaseOrder)</strong>
                        <span class="metric-sub">Schritte 6 bis 10</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="validation-box">
                <p class="validation-copy">⚠️ @parseError</p>
            </div>
        }
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- WORKSHEET VIEW (1:1 EXAM PRINTABLE WORKSPACE)                            -->
        <!-- ========================================================================= -->
        <div class="worksheet-view">
            <div class="worksheet-toolbar no-print">
                <button class="ws-btn solution-toggle @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                    @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung anzeigen")
                </button>
                <button class="ws-btn print-btn" @onclick="PrintWorksheet">
                    🖨️ Arbeitsblatt drucken
                </button>
            </div>

            <div class="worksheet-paper">
                <div class="ws-header">
                    <div class="ws-title-group">
                        <span class="ws-kicker">Übungsaufgabe zur Speicherverwaltung</span>
                        <h3 class="ws-title">Buddy-System (Speicherzuweisung)</h3>
                    </div>
                    <div class="ws-meta-box">
                        <div><strong>Vorlesung:</strong> Betriebssysteme</div>
                        <div><strong>Thema:</strong> Speicherzuweisung &amp; Partner-Verfahren</div>
                    </div>
                </div>

                <div class="ws-instructions">
                    <p>
                        Gegeben sei ein Hauptspeicher mit einer Gesamtgröße von <strong>1024 KB</strong>. 
                        Die kleinste verwaltbare Kachelgröße beträgt <strong>32 KB</strong> (insgesamt 32 Kacheln).
                    </p>
                    <p>
                        Tragen Sie für die folgenden Anforderungen der Prozesse <strong>A bis E</strong> sowie die anschließenden 
                        Freigaben die jeweilige Belegung in das Raster ein. Ein Feld entspricht dabei 32 KB.
                    </p>
                    <p>
                        Tragen Sie in die Felder <strong>A, B, C, D oder E</strong> ein, wenn der Speicher einem der Prozesse zugeordnet ist. 
                        <strong>Visualisieren Sie zudem die einzelnen Freiblöcke:</strong> Tragen Sie in das <em>erste</em> und <em>letzte</em> Feld jedes zusammenhängenden Freiblocks die Ziffer des Blocks ein (z.&nbsp;B. <strong>1, 2, 3&hellip;</strong>) und kennzeichnen Sie die Blockgrenzen. Unterschiedliche Freiblöcke müssen durch unterschiedliche Ziffern und deutliche Blockgrenzen markiert werden.
                    </p>
                </div>

                @if (TryGetParsedBuddy(out var wsBuddy, out _))
                {
                    <!-- Process Spec Table -->
                    <div class="ws-proc-specs">
                        <table class="ws-spec-table">
                            <thead>
                                <tr>
                                    <th>Prozess</th>
                                    <th>A</th>
                                    <th>B</th>
                                    <th>C</th>
                                    <th>D</th>
                                    <th>E</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Anforderung (KB)</strong></td>
                                    <td>@wsBuddy!.Requests[0]</td>
                                    <td>@wsBuddy.Requests[1]</td>
                                    <td>@wsBuddy.Requests[2]</td>
                                    <td>@wsBuddy.Requests[3]</td>
                                    <td>@wsBuddy.Requests[4]</td>
                                </tr>
                                <tr>
                                    <td><strong>Allokierte 2er-Potenz</strong></td>
                                    <td>@(GetBlockSize(wsBuddy.Requests[0])) KB</td>
                                    <td>@(GetBlockSize(wsBuddy.Requests[1])) KB</td>
                                    <td>@(GetBlockSize(wsBuddy.Requests[2])) KB</td>
                                    <td>@(GetBlockSize(wsBuddy.Requests[3])) KB</td>
                                    <td>@(GetBlockSize(wsBuddy.Requests[4])) KB</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="ws-release-note">
                            <strong>Reihenfolge der Freigabe:</strong> @string.Join(" → ", wsBuddy.ReleaseOrder)
                        </p>
                    </div>

                    <!-- 32-Column Exam Grid Table -->
                    <div class="ws-matrix-wrapper">
                        <table class="ws-matrix-table">
                            <thead>
                                <tr>
                                    <th class="ws-col-hdr">Operation</th>
                                    @for (int c = 0; c < 32; c++)
                                    {
                                        var is4th = (c + 1) % 4 == 0 && c < 31;
                                        var is8th = (c + 1) % 8 == 0 && c < 31;
                                        <th class="@(is8th ? "grid-bound-major" : is4th ? "grid-bound-minor" : "")">@c</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Initial Row -->
                                <tr>
                                    <td class="ws-row-label">Initial</td>
                                    @for (int c = 0; c < 32; c++)
                                    {
                                        var isStart = c == 0;
                                        var isEnd = c == 31;
                                        var is8thBound = (c + 1) % 8 == 0 && c < 31;
                                        var is4thBound = (c + 1) % 4 == 0 && c < 31;
                                        <td class="ws-slot-cell @(ShowSolution ? "ws-free-block free-color-0" : "") @(isStart ? "block-start" : "") @(isEnd ? "block-end" : "") @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")">
                                            @if (ShowSolution)
                                            {
                                                if (isStart || isEnd)
                                                {
                                                    <span class="free-num-badge">1</span>
                                                }
                                                else
                                                {
                                                    <span class="free-connector"></span>
                                                }
                                            }
                                        </td>
                                    }
                                </tr>

                                <!-- 5 Allocation Rows -->
                                @for (int i = 0; i < 5; i++)
                                {
                                    var op = wsBuddy.StepDetails[i];
                                    var snap = wsBuddy.Snapshots[i];
                                    var blocks = GetBuddyBlocks(snap);

                                    <tr>
                                        <td class="ws-row-label">@op.ProcessName (@wsBuddy.Requests[i])</td>
                                        @for (int c = 0; c < 32; c++)
                                        {
                                            var block = blocks.FirstOrDefault(b => c >= b.StartSlot && c <= b.EndSlot);
                                            var isAlloc = block != null && block.IsAllocated;
                                            var isStart = block != null && c == block.StartSlot;
                                            var isEnd = block != null && c == block.EndSlot;
                                            var is8thBound = (c + 1) % 8 == 0 && c < 31;
                                            var is4thBound = (c + 1) % 4 == 0 && c < 31;
                                            var colorIdx = block != null && !isAlloc ? (block.BlockNumber - 1) % 6 : 0;

                                            <td class="ws-slot-cell @(ShowSolution && isAlloc ? $"ws-filled {GetSlotColorClass(block!.ProcessName)}" : "") @(ShowSolution && !isAlloc ? $"ws-free-block free-color-{colorIdx}" : "") @(ShowSolution && isStart ? "block-start" : "") @(ShowSolution && isEnd ? "block-end" : "") @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")"
                                                title="@(ShowSolution && block != null ? (block.IsAllocated ? $"Prozess {block.ProcessName} [Kacheln {block.StartSlot}..{block.EndSlot}] ({block.SizeKb} KB)" : $"Freier Block {block.BlockNumber} [Kacheln {block.StartSlot}..{block.EndSlot}] ({block.SizeKb} KB)") : $"Kachel {c}")">
                                                @if (ShowSolution && block != null)
                                                {
                                                    if (isAlloc)
                                                    {
                                                        <span class="slot-letter">@block.ProcessName</span>
                                                    }
                                                    else if (isStart || isEnd)
                                                    {
                                                        <span class="free-num-badge">@block.BlockNumber</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="free-connector"></span>
                                                    }
                                                }
                                            </td>
                                        }
                                    </tr>
                                }

                                <!-- 5 Release Rows -->
                                @for (int i = 5; i < 10; i++)
                                {
                                    var op = wsBuddy.StepDetails[i];
                                    var snap = wsBuddy.Snapshots[i];
                                    var blocks = GetBuddyBlocks(snap);

                                    <tr>
                                        <td class="ws-row-label">Free @op.ProcessName</td>
                                        @for (int c = 0; c < 32; c++)
                                        {
                                            var block = blocks.FirstOrDefault(b => c >= b.StartSlot && c <= b.EndSlot);
                                            var isAlloc = block != null && block.IsAllocated;
                                            var isStart = block != null && c == block.StartSlot;
                                            var isEnd = block != null && c == block.EndSlot;
                                            var is8thBound = (c + 1) % 8 == 0 && c < 31;
                                            var is4thBound = (c + 1) % 4 == 0 && c < 31;
                                            var colorIdx = block != null && !isAlloc ? (block.BlockNumber - 1) % 6 : 0;

                                            <td class="ws-slot-cell @(ShowSolution && isAlloc ? $"ws-filled {GetSlotColorClass(block!.ProcessName)}" : "") @(ShowSolution && !isAlloc ? $"ws-free-block free-color-{colorIdx}" : "") @(ShowSolution && isStart ? "block-start" : "") @(ShowSolution && isEnd ? "block-end" : "") @(is8thBound ? "grid-bound-major" : is4thBound ? "grid-bound-minor" : "")"
                                                title="@(ShowSolution && block != null ? (block.IsAllocated ? $"Prozess {block.ProcessName} [Kacheln {block.StartSlot}..{block.EndSlot}] ({block.SizeKb} KB)" : $"Freier Block {block.BlockNumber} [Kacheln {block.StartSlot}..{block.EndSlot}] ({block.SizeKb} KB)") : $"Kachel {c}")">
                                                @if (ShowSolution && block != null)
                                                {
                                                    if (isAlloc)
                                                    {
                                                        <span class="slot-letter">@block.ProcessName</span>
                                                    }
                                                    else if (isStart || isEnd)
                                                    {
                                                        <span class="free-num-badge">@block.BlockNumber</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="free-connector"></span>
                                                    }
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (ShowSolution)
                    {
                        <div class="ws-solution-box no-print">
                            <h4>Hinweise zur Musterlösung:</h4>
                            <p>
                                Die Buchstaben <strong>A–E</strong> bezeichnen die Kacheln der allokierten Blöcke. 
                                Die Ziffern <strong>1, 2, 3&hellip;</strong> nummerieren die jeweiligen <strong>zusammenhängenden freien Partnerblöcke</strong> pro Zeile. 
                                Die verstärkten vertikalen Linien markieren die Blockgrenzen im Buddy-System.
                            </p>
                        </div>
                    }
                }
            </div>
        </div>
    }

</article>

@code {
    public enum ViewMode
    {
        Simulator,
        Worksheet
    }

    private static readonly string[] ProcessNames = ["A", "B", "C", "D", "E"];

    [Parameter]
    public string BuddyRequestsInput { get; set; } = "120, 64, 200, 32, 90";

    [Parameter]
    public string BuddyReleaseOrderInput { get; set; } = "B, D, A, E, C";

    [Parameter]
    public bool IsEmbed { get; set; } = false;

    private ViewMode ActiveView { get; set; } = ViewMode.Simulator;
    private bool ShowSolution { get; set; } = false;
    private int CurrentStepIndex { get; set; } = 0;

    // Presets
    private const string Preset1Requests = "120, 64, 200, 32, 90";
    private const string Preset1Release = "B, D, A, E, C";

    private const string Preset2Requests = "171, 7, 394, 41, 9";
    private const string Preset2Release = "C, E, D, B, A";

    private const string Preset3Requests = "80, 240, 60, 110, 45";
    private const string Preset3Release = "A, C, B, E, D";

    public sealed record BuddyStepInfo(
        int StepNumber,
        string ProcessName,
        string OperationType,
        string Title,
        string DescriptionHeader,
        int RequestedSize,
        int BlockSize,
        List<int> AffectedSlots
    );

    public sealed record ParsedBuddyData(
        int[] Requests,
        string[] ReleaseOrder,
        List<string[]> Snapshots,
        List<BuddyStepInfo> StepDetails
    );

    protected override void OnInitialized()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (string.IsNullOrEmpty(query)) return;

            var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var pair in pairs)
            {
                var parts = pair.Split('=', 2);
                var key = parts[0].ToLowerInvariant();
                var val = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";

                if (key == "embed" && bool.TryParse(val, out var embedBool))
                {
                    IsEmbed = embedBool;
                }
                else if (key == "view")
                {
                    ActiveView = val.Equals("worksheet", StringComparison.OrdinalIgnoreCase) 
                        ? ViewMode.Worksheet 
                        : ViewMode.Simulator;
                }
                else if (key == "solution" && bool.TryParse(val, out var solBool))
                {
                    ShowSolution = solBool;
                }
                else if (key == "requests" && !string.IsNullOrWhiteSpace(val))
                {
                    BuddyRequestsInput = val;
                }
                else if (key == "release" && !string.IsNullOrWhiteSpace(val))
                {
                    BuddyReleaseOrderInput = val;
                }
            }
        }
        catch { }
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private async Task PrintWorksheet()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void OnConfigurationChanged()
    {
        CurrentStepIndex = 0;
    }

    private void LoadPreset(string requests, string release)
    {
        BuddyRequestsInput = requests;
        BuddyReleaseOrderInput = release;
        CurrentStepIndex = 0;
    }

    private void GenerateRandomSet()
    {
        var rnd = new Random();
        var requests = new int[5];
        for (int i = 0; i < 5; i++)
        {
            requests[i] = rnd.Next(5, 450);
        }

        var shuffledRelease = ProcessNames.OrderBy(_ => rnd.Next()).ToArray();

        BuddyRequestsInput = string.Join(", ", requests);
        BuddyReleaseOrderInput = string.Join(", ", shuffledRelease);
        CurrentStepIndex = 0;
    }

    private void GoToStart()
    {
        CurrentStepIndex = 0;
    }

    private void PreviousStep()
    {
        if (CurrentStepIndex > 0) CurrentStepIndex--;
    }

    private void NextStep()
    {
        if (TryGetParsedBuddy(out var buddyData, out _))
        {
            if (CurrentStepIndex < buddyData!.Snapshots.Count)
            {
                CurrentStepIndex++;
            }
        }
    }

    private void GoToEnd()
    {
        if (TryGetParsedBuddy(out var buddyData, out _))
        {
            CurrentStepIndex = buddyData!.Snapshots.Count;
        }
    }

    private void OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var step))
        {
            CurrentStepIndex = step;
        }
    }

    private static int GetBlockSize(int requestSize)
    {
        if (requestSize <= 0) return 0;
        int power = (int)Math.Ceiling(Math.Log2(requestSize));
        return (int)Math.Pow(2, Math.Max(5, power)); // at least 32 KB chunk
    }

    private bool TryGetParsedBuddy(out ParsedBuddyData? data, out string errorMessage)
    {
        try
        {
            var requests = BuddyRequestsInput
                .Split(new[] { ',', ';', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(t => int.TryParse(t, out var val) ? val : throw new InvalidOperationException($"Ungültige Zahl '{t}' in den Anforderungen."))
                .ToArray();

            if (requests.Length != 5)
            {
                throw new InvalidOperationException("Bitte geben Sie genau 5 Speicheranforderungen für die Prozesse A bis E an.");
            }

            if (requests.Any(r => r < 1 || r > 512))
            {
                throw new InvalidOperationException("Anforderungen müssen zwischen 1 KB und 512 KB liegen.");
            }

            var release = BuddyReleaseOrderInput
                .Split(new[] { ',', ';', ' ', '\t', '>', '-' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(item => item.ToUpperInvariant())
                .ToArray();

            if (release.Length != 5 || release.Distinct().Count() != 5 || release.Except(ProcessNames).Any())
            {
                throw new InvalidOperationException("Freigabereihenfolge muss die Prozesse A, B, C, D, E jeweils genau einmal enthalten.");
            }

            var parameters = new BuddyParameters
            {
                Processes = ProcessNames.ToArray(),
                Requests = requests,
                FreeOrder = release
            };

            var solution = (BuddySolution)new BuddySolver().Solve(parameters);
            var mappedSnapshots = solution.History
                .Select(snap => snap.Select(MapBuddySlot).ToArray())
                .ToList();

            // Construct step info details
            var stepDetails = new List<BuddyStepInfo>();
            for (int s = 0; s < mappedSnapshots.Count; s++)
            {
                var stepNum = s + 1;
                string pName;
                string opType;
                int reqSize = 0;
                int blkSize = 0;

                if (s < 5)
                {
                    pName = ProcessNames[s];
                    opType = "Allocate";
                    reqSize = requests[s];
                    blkSize = GetBlockSize(reqSize);
                }
                else
                {
                    pName = release[s - 5];
                    opType = "Release";
                    var pIdx = Array.IndexOf(ProcessNames, pName);
                    reqSize = pIdx >= 0 ? requests[pIdx] : 0;
                    blkSize = GetBlockSize(reqSize);
                }

                var currentSnap = mappedSnapshots[s];
                var prevSnap = s == 0 ? Enumerable.Repeat("free", 32).ToArray() : mappedSnapshots[s - 1];

                var affected = new List<int>();
                for (int c = 0; c < 32; c++)
                {
                    if (currentSnap[c] != prevSnap[c])
                    {
                        affected.Add(c);
                    }
                }

                var title = opType == "Allocate" ? $"{pName} ({reqSize} KB)" : $"Free {pName}";
                var descHeader = opType == "Allocate"
                    ? $"Anforderung von Prozess {pName}: {reqSize} KB (Allokiert: {blkSize} KB)"
                    : $"Freigabe von Prozess {pName} ({reqSize} KB, {blkSize} KB Block)";

                stepDetails.Add(new BuddyStepInfo(stepNum, pName, opType, title, descHeader, reqSize, blkSize, affected));
            }

            data = new ParsedBuddyData(requests, release, mappedSnapshots, stepDetails);
            errorMessage = string.Empty;
            return true;
        }
        catch (Exception ex)
        {
            data = null;
            errorMessage = ex.Message;
            return false;
        }
    }

    private static string MapBuddySlot(int slot) =>
        slot switch
        {
            -1 => "free",
            >= 0 and < 5 => ProcessNames[slot],
            _ => "?"
        };

    private string GetSlotColorClass(string slot)
    {
        if (string.IsNullOrWhiteSpace(slot)) return "p-default";
        if (slot.Contains('A')) return "p-a";
        if (slot.Contains('B')) return "p-b";
        if (slot.Contains('C')) return "p-c";
        if (slot.Contains('D')) return "p-d";
        if (slot.Contains('E')) return "p-e";
        return "p-default";
    }

    private static string GetCompactStepSummary(int stepIndex, ParsedBuddyData data)
    {
        if (stepIndex == 0) return "1024 KB freier Hauptspeicher (32 Kacheln à 32 KB)";

        var op = data.StepDetails[stepIndex - 1];
        var startSlot = op.AffectedSlots.Count > 0 ? op.AffectedSlots.Min() : 0;
        var endSlot = op.AffectedSlots.Count > 0 ? op.AffectedSlots.Max() : 0;
        var startKb = startSlot * 32;
        var endKb = (endSlot + 1) * 32;

        if (op.OperationType == "Allocate")
        {
            var frag = op.BlockSize - op.RequestedSize;
            return $"Allokiert in Kacheln {startSlot}–{endSlot} [{startKb}–{endKb} KB] ({op.BlockSize} KB Block für {op.RequestedSize} KB Anforderung, Verschnitt: {frag} KB)";
        }
        else
        {
            return $"Kacheln {startSlot}–{endSlot} [{startKb}–{endKb} KB] ({op.BlockSize} KB) freigegeben & Buddies verschmolzen";
        }
    }

    public record BuddyBlock(bool IsAllocated, string ProcessName, int StartSlot, int SlotCount, int BlockNumber)
    {
        public int SizeKb => SlotCount * 32;
        public int EndSlot => StartSlot + SlotCount - 1;
        public int StartKb => StartSlot * 32;
        public int EndKb => (EndSlot + 1) * 32;
    }

    private static List<BuddyBlock> GetBuddyBlocks(string[] snapshot)
    {
        var rawBlocks = new List<(bool isAlloc, string name, int start, int count)>();
        DecomposeBuddyTree(snapshot, 0, 32, rawBlocks);

        var result = new List<BuddyBlock>();
        int freeBlockCounter = 1;
        foreach (var b in rawBlocks)
        {
            if (b.isAlloc)
            {
                result.Add(new BuddyBlock(true, b.name, b.start, b.count, 0));
            }
            else
            {
                result.Add(new BuddyBlock(false, "free", b.start, b.count, freeBlockCounter++));
            }
        }
        return result;
    }

    private static void DecomposeBuddyTree(string[] snapshot, int startSlot, int slotCount, List<(bool isAlloc, string name, int start, int count)> result)
    {
        bool allFree = true;
        for (int i = startSlot; i < startSlot + slotCount; i++)
        {
            if (snapshot[i] != "free")
            {
                allFree = false;
                break;
            }
        }

        if (allFree)
        {
            result.Add((false, "free", startSlot, slotCount));
            return;
        }

        var firstProc = snapshot[startSlot];
        bool allSameProc = firstProc != "free";
        if (allSameProc)
        {
            for (int i = startSlot + 1; i < startSlot + slotCount; i++)
            {
                if (snapshot[i] != firstProc)
                {
                    allSameProc = false;
                    break;
                }
            }
        }

        if (allSameProc)
        {
            result.Add((true, firstProc, startSlot, slotCount));
            return;
        }

        int half = slotCount / 2;
        DecomposeBuddyTree(snapshot, startSlot, half, result);
        DecomposeBuddyTree(snapshot, startSlot + half, half, result);
    }
}
