@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@using Italbytz.OperatingSystems
@using Italbytz.OperatingSystems.Abstractions
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="scheduling-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">
    
    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Prozess- &amp; Thread-Verwaltung</p>
            <h2>CPU-Scheduling-Strategien (Gantt-Chart &amp; Verweilzeit-Simulator)</h2>
            <p class="feature-intro">
                Schritt-für-Schritt-Ablaufverfolgung, visuelles Gantt-Diagramm und Berechnung der mittleren Verweilzeit 
                (T̄<sub>tr</sub>) für <strong>SJF</strong>, <strong>Prioritätsscheduling</strong>, <strong>FCFS</strong> und <strong>Round Robin</strong>.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Simulator (Gantt-Trace)
            </button>
            
            <a class="view-btn pdf-link-btn" href="pdf/Scheduling_10.pdf" target="_blank" download="Scheduling_10.pdf" title="10 Übungsaufgaben als druckreifes LaTeX-PDF herunterladen">
            🎯 Freiwilliges Klausurtraining (PDF)
        </a>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Controls Panel -->
        <div class="controls-panel no-print">
            <div class="config-grid">
                <label class="control-label">
                    <span>Strategie:</span>
                    <select class="form-select" @bind="SelectedSchedulingPolicy" @bind:after="OnConfigurationChanged">
                        <option value="SJF">Shortest Job First (SJF)</option>
                        <option value="Priority">Prioritätsscheduling</option>
                        <option value="FCFS">First-Come First-Served (FCFS)</option>
                        <option value="RoundRobin">Round Robin (Prozessor-Sharing)</option>
                        <option value="CompareAll">📊 Alle 4 Strategien vergleichen</option>
                    </select>
                </label>

                <label class="control-label">
                    <span>Bedienzeiten (t<sub>burst</sub>):</span>
                    <input type="text" class="form-input" @bind="SchedulingValuesInput" @bind:after="OnConfigurationChanged" placeholder="z. B. 6, 2, 8, 3, 5" />
                </label>

                <label class="control-label span-two">
                    <span>Prioritäten:</span>
                    <input type="text" class="form-input" @bind="SchedulingPrioritiesInput" @bind:after="OnConfigurationChanged" placeholder="sehr hoch, hoch, mittel, niedrig, sehr niedrig" />
                </label>
            </div>

            @if (SelectedSchedulingPolicy == "RoundRobin")
            {
                <div class="rr-controls-bar">
                    <div class="rr-mode-switch">
                        <span class="rr-mode-label">Modus:</span>
                        <button type="button" class="rr-btn @(RoundRobinMode == RoundRobinSubMode.TimeSlices ? "active" : "")"
                                @onclick="() => SetRoundRobinMode(RoundRobinSubMode.TimeSlices)">
                            🔄 Zeitscheiben (Gantt-Trace mit <em>q</em>)
                        </button>
                        <button type="button" class="rr-btn @(RoundRobinMode == RoundRobinSubMode.ProcessorSharing ? "active" : "")"
                                @onclick="() => SetRoundRobinMode(RoundRobinSubMode.ProcessorSharing)">
                            📊 Prozessor-Sharing (Phasenmodell <em>q</em> &rarr; 0)
                        </button>
                    </div>

                    @if (RoundRobinMode == RoundRobinSubMode.TimeSlices)
                    {
                        <div class="rr-quantum-group">
                            <label class="quantum-label">
                                <span>Zeitscheibe <em>q</em>:</span>
                                <input type="number" min="1" max="20" class="form-input quantum-input" @bind="Quantum" @bind:after="OnConfigurationChanged" />
                            </label>
                            <div class="quantum-quick-btns">
                                <button type="button" class="q-btn @(Quantum == 1 ? "active" : "")" @onclick="() => SetQuantum(1)">q=1</button>
                                <button type="button" class="q-btn @(Quantum == 2 ? "active" : "")" @onclick="() => SetQuantum(2)">q=2</button>
                                <button type="button" class="q-btn @(Quantum == 3 ? "active" : "")" @onclick="() => SetQuantum(3)">q=3</button>
                                <button type="button" class="q-btn @(Quantum == 4 ? "active" : "")" @onclick="() => SetQuantum(4)">q=4</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Presets Bar -->
            <div class="preset-bar">
                <span class="preset-label">Beispiele:</span>
                <button class="preset-btn" @onclick="() => LoadPreset(Preset1Values, Preset1Priorities)">Beispiel 1 (6, 2, 8, 3, 5)</button>
                <button class="preset-btn" @onclick="() => LoadPreset(Preset2Values, Preset2Priorities)">Beispiel 2 (4, 9, 2, 7, 3)</button>
                <button class="preset-btn" @onclick="() => LoadPreset(Preset3Values, Preset3Priorities)">Aufsteigend (2, 4, 6, 8, 10)</button>
                <button class="preset-btn random" @onclick="GenerateRandomSet">🎲 Zufallsprozesse</button>
            </div>
        </div>

        @if (TryGetParsedScheduling(out var procList, out var parseError))
        {
            var sjfScore = new ShortestJobFirstSolver().Solve(new SchedulingParameters(procList.Select(p => p.Duration).ToArray(), procList.Select(p => p.Priority).ToArray())).Time;
            var prioScore = new PrioritySchedulingSolver().Solve(new SchedulingParameters(procList.Select(p => p.Duration).ToArray(), procList.Select(p => p.Priority).ToArray())).Time;
            var fcfsScore = new FCFSSolver().Solve(new SchedulingParameters(procList.Select(p => p.Duration).ToArray(), procList.Select(p => p.Priority).ToArray())).Time;
            var rrScore = new RoundRobinSolver().Solve(new SchedulingParameters(procList.Select(p => p.Duration).ToArray(), procList.Select(p => p.Priority).ToArray())).Time;

            var (rrSlices, rrProcResults, rrSliceTurnaround, rrSliceWaiting) = CalculateRoundRobin(procList, Math.Max(1, Quantum));
            var (psPhases, psPhaseResults, psScore) = CalculateProcessorSharing(procList);

            var activeSchedule = SelectedSchedulingPolicy switch
            {
                "RoundRobin" when RoundRobinMode == RoundRobinSubMode.ProcessorSharing => psPhases,
                "RoundRobin" => rrSlices,
                _ => GetScheduleForPolicy(SelectedSchedulingPolicy, procList)
            };

            var totalExecutionTime = procList.Sum(p => p.Duration);
            var maxSteps = activeSchedule.Count;

            <!-- Narrator Card -->
            <div class="narrator-card">
                <div class="narrator-header">
                    <div class="step-badge @(CurrentStepIndex == 0 ? "badge-init" : "badge-active")">
                        @if (CurrentStepIndex == 0)
                        {
                            <span>🏁 Initialisierung</span>
                        }
                        else
                        {
                            var item = activeSchedule[CurrentStepIndex - 1];
                            <span>▶ Schritt @CurrentStepIndex: @item.ProcessName</span>
                        }
                    </div>
                    <div class="narrator-title">
                        @if (CurrentStepIndex == 0)
                        {
                            <span>Bereit-Warteschlange enthält @procList.Count Prozesse: @string.Join(", ", procList.Select(p => $"{p.Name} (t={p.Duration}, {p.Priority})"))</span>
                        }
                        else
                        {
                            var item = activeSchedule[CurrentStepIndex - 1];
                            <span>Ausführung von <strong>@item.ProcessName</strong> [Zeit: @item.StartTime → @item.EndTime]</span>
                        }
                    </div>
                </div>

                <div class="narrator-body">
                    <p class="narrator-text">
                        @GetSchedulingNarratorText(CurrentStepIndex, activeSchedule, procList.Count, SelectedSchedulingPolicy, psPhaseResults)
                    </p>
                </div>
            </div>

            <!-- Gantt Chart Container -->
            <div class="gantt-card">
                <div class="gantt-header">
                    <h4 class="gantt-title">
                        Gantt-Diagramm (CPU-Ausführungsreihenfolge)
                        @if (SelectedSchedulingPolicy == "RoundRobin")
                        {
                            <span class="text-amber">
                                @(RoundRobinMode == RoundRobinSubMode.TimeSlices ? $"(Round Robin mit Zeitscheibe q={Quantum})" : "(Prozessor-Sharing Phasenmodell q → 0)")
                            </span>
                        }
                    </h4>
                    <span class="gantt-total-time">Gesamtlaufzeit: <strong>@totalExecutionTime Zeiteinheiten</strong></span>
                </div>

                <!-- Gantt Bar Visualization -->
                <div class="gantt-timeline-wrapper">
                    <div class="gantt-bar-container">
                        @for (int i = 0; i < activeSchedule.Count; i++)
                        {
                            var item = activeSchedule[i];
                            var stepNum = i + 1;
                            var isExecuted = stepNum <= CurrentStepIndex;
                            var isCurrentlyActive = stepNum == CurrentStepIndex;
                            var widthPercent = totalExecutionTime > 0 ? (double)item.Duration / totalExecutionTime * 100.0 : 0.0;
                            var colorClass = GetProcessColorClass(item.ProcessIndex);

                            <div class="gantt-block @colorClass @(isExecuted ? "executed" : "pending") @(isCurrentlyActive ? "active-gantt-block" : "")"
                                 style="width: @widthPercent.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;"
                                 title="@($"{item.ProcessName}: t={item.StartTime} → {item.EndTime} (Dauer: {item.Duration})")">
                                <span class="gantt-pname">@item.ProcessName</span>
                                <span class="gantt-duration">t=@item.Duration</span>
                            </div>
                        }
                    </div>

                    <!-- Time Ticks -->
                    <div class="gantt-ticks">
                        <span class="gantt-tick tick-start">0</span>
                        @for (int i = 0; i < activeSchedule.Count; i++)
                        {
                            var item = activeSchedule[i];
                            if (ShouldShowTick(i, activeSchedule))
                            {
                                var leftPercent = totalExecutionTime > 0 ? (double)item.EndTime / totalExecutionTime * 100.0 : 0.0;
                                <span class="gantt-tick" style="left: @leftPercent.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;">
                                    @item.EndTime
                                </span>
                            }
                        }
                    </div>
                </div>

                <!-- Process Details Table -->
                <div class="process-table-wrapper">
                    @if (SelectedSchedulingPolicy == "RoundRobin" && RoundRobinMode == RoundRobinSubMode.TimeSlices)
                    {
                        <table class="scheduling-data-table">
                            <thead>
                                <tr>
                                    <th>Prozess</th>
                                    <th>Bedienzeit (t<sub>i</sub>)</th>
                                    <th>Priorität</th>
                                    <th>Erste Zuteilung</th>
                                    <th>Endzeit (C<sub>i</sub>)</th>
                                    <th>Wartezeit (T<sub>w</sub>)</th>
                                    <th>Verweilzeit (T<sub>tr</sub>)</th>
                                    <th>Zeitscheiben</th>
                                    <th>Status (Schritt @CurrentStepIndex)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in rrProcResults)
                                {
                                    var isFinishedNow = CurrentStepIndex > 0 && activeSchedule[CurrentStepIndex - 1].EndTime >= res.CompletionTime;
                                    var isCurrentlyRunning = CurrentStepIndex > 0 && activeSchedule[CurrentStepIndex - 1].ProcessIndex == res.OriginalIndex;

                                    <tr class="@(isCurrentlyRunning ? "row-active" : "")">
                                        <td>
                                            <span class="proc-badge @GetProcessColorClass(res.OriginalIndex)">@res.Name</span>
                                        </td>
                                        <td>@res.Duration</td>
                                        <td>@res.Priority</td>
                                        <td>@(res.FirstStartTime >= 0 ? res.FirstStartTime.ToString() : "-")</td>
                                        <td><strong>@res.CompletionTime</strong></td>
                                        <td>@res.WaitingTime</td>
                                        <td><strong>@res.TurnaroundTime</strong></td>
                                        <td>@res.SliceCount &times; q</td>
                                        <td>
                                            @if (isFinishedNow)
                                            {
                                                <span class="completed-badge">✓ Fertiggestellt (t=@res.CompletionTime)</span>
                                            }
                                            else
                                            {
                                                <span class="pending-badge">⏳ Wartend / Aktiv</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-summary-row">
                                    <td colspan="4"><strong>Durchschnitt (n = @procList.Count)</strong></td>
                                    <td>-</td>
                                    <td><strong>T̄<sub>w</sub> = @rrSliceWaiting.ToString("F2")</strong></td>
                                    <td><strong class="text-amber">T̄<sub>tr</sub> = @rrSliceTurnaround.ToString("F2")</strong></td>
                                    <td colspan="2"><span class="metric-sub">Klausurformel (q &rarr; 0): @rrScore.ToString("F2")</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else if (SelectedSchedulingPolicy == "RoundRobin" && RoundRobinMode == RoundRobinSubMode.ProcessorSharing)
                    {
                        <table class="scheduling-data-table">
                            <thead>
                                <tr>
                                    <th>Phase</th>
                                    <th>Terminierender Prozess</th>
                                    <th>Bedienzeit (t<sub>i</sub>)</th>
                                    <th>Intervall (&Delta;t)</th>
                                    <th>Aktive Prozesse (k)</th>
                                    <th>Phasen-Laufzeit (k &middot; &Delta;t)</th>
                                    <th>Fertigstellung (C<sub>i</sub>)</th>
                                    <th>Verweilzeit-Beitrag (&Delta;T̄)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < psPhaseResults.Count; i++)
                                {
                                    var item = psPhaseResults[i];
                                    var stepNum = i + 1;
                                    var isExecuted = stepNum <= CurrentStepIndex;
                                    var isCurrentlyActive = stepNum == CurrentStepIndex;

                                    <tr class="@(isCurrentlyActive ? "row-active" : "") @(!isExecuted ? "row-pending" : "")">
                                        <td><strong>Phase #@item.PhaseIndex</strong></td>
                                        <td>
                                            <span class="proc-badge @GetProcessColorClass(item.ProcessIndex)">@item.ProcessName</span>
                                        </td>
                                        <td>@item.Duration</td>
                                        <td>&Delta;t = @item.Delta</td>
                                        <td>k = @item.ActiveProcesses</td>
                                        <td>@item.WallDuration</td>
                                        <td><strong>t = @item.CompletionTime</strong></td>
                                        <td>
                                            <code>@item.ActiveProcesses&sup2; / @procList.Count &times; @item.Delta = @item.Contribution.ToString("F2")</code>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-summary-row">
                                    <td colspan="6"><strong>Gesamt-Verweilzeit T̄<sub>RR</sub> (Klausurformel)</strong></td>
                                    <td>-</td>
                                    <td><strong class="text-amber">@rrScore.ToString("F2") Zeiteinheiten</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <table class="scheduling-data-table">
                            <thead>
                                <tr>
                                    <th>Rang</th>
                                    <th>Prozess</th>
                                    <th>Bedienzeit (t<sub>i</sub>)</th>
                                    <th>Priorität</th>
                                    <th>Startzeit</th>
                                    <th>Endzeit (C<sub>i</sub>)</th>
                                    <th>Verweilzeit-Beitrag (ΔT̄)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < activeSchedule.Count; i++)
                                {
                                    var item = activeSchedule[i];
                                    var stepNum = i + 1;
                                    var isExecuted = stepNum <= CurrentStepIndex;
                                    var isCurrentlyActive = stepNum == CurrentStepIndex;
                                    var remaining = procList.Count - i;
                                    var contribution = (double)remaining * item.Duration / procList.Count;

                                    <tr class="@(isCurrentlyActive ? "row-active" : "") @(!isExecuted ? "row-pending" : "")">
                                        <td><strong>#@stepNum</strong></td>
                                        <td>
                                            <span class="proc-badge @GetProcessColorClass(item.ProcessIndex)">@item.ProcessName</span>
                                        </td>
                                        <td>@item.Duration</td>
                                        <td>@item.Priority</td>
                                        <td>@item.StartTime</td>
                                        <td><strong>@item.EndTime</strong></td>
                                        <td>
                                            <code>@remaining / @procList.Count &times; @item.Duration = @contribution.ToString("F2")</code>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- Comparative Heuristics Overview Bar -->
            <div class="comparison-card">
                <h4 class="comparison-title">Vergleich aller 4 Scheduling-Verfahren</h4>
                <div class="metrics-grid four-up">
                    <div class="metric-card @(SelectedSchedulingPolicy == "SJF" ? "highlight-strategy" : "")">
                        <span class="metric-label">Shortest Job First</span>
                        <strong class="metric-val text-success">@sjfScore.ToString("F2")</strong>
                        <span class="metric-sub">⭐ Optimal (T̄<sub>min</sub>)</span>
                    </div>

                    <div class="metric-card @(SelectedSchedulingPolicy == "Priority" ? "highlight-strategy" : "")">
                        <span class="metric-label">Prioritätsscheduling</span>
                        <strong class="metric-val text-brand">@prioScore.ToString("F2")</strong>
                        <span class="metric-sub">Prioritätsordnung</span>
                    </div>

                    <div class="metric-card @(SelectedSchedulingPolicy == "FCFS" ? "highlight-strategy" : "")">
                        <span class="metric-label">First-Come First-Served</span>
                        <strong class="metric-val">@fcfsScore.ToString("F2")</strong>
                        <span class="metric-sub">Eingangsreihenfolge</span>
                    </div>

                    <div class="metric-card @(SelectedSchedulingPolicy == "RoundRobin" ? "highlight-strategy" : "")">
                        <span class="metric-label">Round Robin @(SelectedSchedulingPolicy == "RoundRobin" && RoundRobinMode == RoundRobinSubMode.TimeSlices ? $"(q={Quantum})" : "(q → 0)")</span>
                        <strong class="metric-val text-amber">@(SelectedSchedulingPolicy == "RoundRobin" && RoundRobinMode == RoundRobinSubMode.TimeSlices ? rrSliceTurnaround.ToString("F2") : rrScore.ToString("F2"))</strong>
                        <span class="metric-sub">@(SelectedSchedulingPolicy == "RoundRobin" && RoundRobinMode == RoundRobinSubMode.TimeSlices ? $"Zeitscheibe q={Quantum} (q→0: {rrScore:F2})" : "Prozessor-Sharing")</span>
                    </div>
                </div>
            </div>

            <StepPlayerHud CurrentStepIndex="@CurrentStepIndex"
                           TotalSteps="@(maxSteps + 1)"
                           ProgressLabel="@($"{CurrentStepIndex} / {maxSteps}")"
                           CanGoPrevious="@(CurrentStepIndex > 0)"
                           CanGoNext="@(CurrentStepIndex < maxSteps)"
                           IsEmbed="@IsEmbed"
                           OnStart="GoToStart"
                           OnPrevious="PreviousStep"
                           OnNext="NextStep"
                           OnEnd="GoToEnd"
                           OnRandom="GenerateRandomSet" />
        }
        else
        {
            <div class="validation-box">
                <p class="validation-copy">⚠️ @parseError</p>
            </div>
        }
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- WORKSHEET VIEW (1:1 EXAM PRINTABLE WORKSPACE)                            -->
        <!-- ========================================================================= -->
        <div class="worksheet-view">
            <div class="worksheet-toolbar no-print">
                <button class="ws-btn solution-toggle @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                    @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung anzeigen")
                </button>
                <button class="ws-btn print-btn" @onclick="PrintWorksheet">
                    🖨️ Arbeitsblatt drucken
                </button>
            </div>

            <div class="worksheet-paper">
                <div class="ws-header">
                    <div class="ws-title-group">
                        <span class="ws-kicker">Übungsaufgabe zur Prozessverwaltung</span>
                        <h3 class="ws-title">CPU-Scheduling von Prozessen</h3>
                    </div>
                    <div class="ws-meta-box">
                        <div><strong>Vorlesung:</strong> Betriebssysteme</div>
                        <div><strong>Thema:</strong> Mittlere Verweilzeit T̄<sub>tr</sub></div>
                    </div>
                </div>

                <div class="ws-instructions">
                    <p>
                        Gegeben sind folgende Prozesse, die zum Zeitpunkt t = 0 im System eintreffen. 
                        Berechnen Sie für die Teilaufgaben jeweils die <strong>mittlere Verweilzeit</strong> (T̄<sub>tr</sub>) der Prozesse:
                    </p>
                </div>

                @if (TryGetParsedScheduling(out var wsProcList, out var wsError))
                {
                    var sjfScore = new ShortestJobFirstSolver().Solve(new SchedulingParameters(wsProcList.Select(p => p.Duration).ToArray(), wsProcList.Select(p => p.Priority).ToArray())).Time;
                    var prioScore = new PrioritySchedulingSolver().Solve(new SchedulingParameters(wsProcList.Select(p => p.Duration).ToArray(), wsProcList.Select(p => p.Priority).ToArray())).Time;
                    var fcfsScore = new FCFSSolver().Solve(new SchedulingParameters(wsProcList.Select(p => p.Duration).ToArray(), wsProcList.Select(p => p.Priority).ToArray())).Time;
                    var rrScore = new RoundRobinSolver().Solve(new SchedulingParameters(wsProcList.Select(p => p.Duration).ToArray(), wsProcList.Select(p => p.Priority).ToArray())).Time;

                    <!-- Process Definition Table -->
                    <div class="ws-table-wrapper">
                        <table class="ws-table">
                            <thead>
                                <tr class="ws-thead-row">
                                    <th class="ws-corner-th">Eigenschaft</th>
                                    @for (int p = 0; p < wsProcList.Count; p++)
                                    {
                                        <th>P@(p + 1)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ws-row-hdr">Erwartete Zeit (t<sub>burst</sub>)</td>
                                    @foreach (var proc in wsProcList)
                                    {
                                        <td>@proc.Duration</td>
                                    }
                                </tr>
                                <tr>
                                    <td class="ws-row-hdr">Priorität</td>
                                    @foreach (var proc in wsProcList)
                                    {
                                        <td>@proc.Priority</td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Subtask a: Shortest Job First -->
                    <div class="ws-subtask-box">
                        <div class="ws-subtask-title">a) Shortest Job First (SJF)</div>
                        <p class="ws-subtask-desc">Reihenfolge nach aufsteigender Bedienzeit:</p>
                        <div class="ws-response-box @(ShowSolution ? "solved" : "")">
                            @if (ShowSolution)
                            {
                                var sjfOrder = wsProcList.OrderBy(p => p.Duration).ToList();
                                <div class="ws-sol-calc">
                                    <p><strong>Ausführungsreihenfolge:</strong> @string.Join(" → ", sjfOrder.Select(p => $"{p.Name} (t={p.Duration})"))</p>
                                    <p><strong>Berechnung:</strong> T̄<sub>SJF</sub> = 1/@wsProcList.Count &times; (@string.Join(" + ", sjfOrder.Select((p, idx) => $"{wsProcList.Count - idx} · {p.Duration}")))</p>
                                    <p><strong>Ergebnis:</strong> T̄<sub>SJF</sub> = <strong>@sjfScore.ToString("F2") Zeiteinheiten</strong></p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Subtask b: Priority Scheduling -->
                    <div class="ws-subtask-box">
                        <div class="ws-subtask-title">b) Prioritätsscheduling (ohne Verdrängung)</div>
                        <p class="ws-subtask-desc">Reihenfolge nach Prioritätsstufen (sehr hoch &gt; hoch &gt; mittel &gt; niedrig &gt; sehr niedrig):</p>
                        <div class="ws-response-box @(ShowSolution ? "solved" : "")">
                            @if (ShowSolution)
                            {
                                var prioOrder = GetScheduleForPolicy("Priority", wsProcList);
                                <div class="ws-sol-calc">
                                    <p><strong>Ausführungsreihenfolge:</strong> @string.Join(" → ", prioOrder.Select(p => $"{p.ProcessName} (p={p.Priority}, t={p.Duration})"))</p>
                                    <p><strong>Berechnung:</strong> T̄<sub>Prio</sub> = 1/@wsProcList.Count &times; (@string.Join(" + ", prioOrder.Select((p, idx) => $"{wsProcList.Count - idx} · {p.Duration}")))</p>
                                    <p><strong>Ergebnis:</strong> T̄<sub>Prio</sub> = <strong>@prioScore.ToString("F2") Zeiteinheiten</strong></p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Subtask c: First-Come First-Served -->
                    <div class="ws-subtask-box">
                        <div class="ws-subtask-title">c) First-Come First-Served (FCFS)</div>
                        <p class="ws-subtask-desc">Reihenfolge nach Ankunfts- / Eingangsreihenfolge:</p>
                        <div class="ws-response-box @(ShowSolution ? "solved" : "")">
                            @if (ShowSolution)
                            {
                                <div class="ws-sol-calc">
                                    <p><strong>Ausführungsreihenfolge:</strong> @string.Join(" → ", wsProcList.Select(p => $"{p.Name} (t={p.Duration})"))</p>
                                    <p><strong>Berechnung:</strong> T̄<sub>FCFS</sub> = 1/@wsProcList.Count &times; (@string.Join(" + ", wsProcList.Select((p, idx) => $"{wsProcList.Count - idx} · {p.Duration}")))</p>
                                    <p><strong>Ergebnis:</strong> T̄<sub>FCFS</sub> = <strong>@fcfsScore.ToString("F2") Zeiteinheiten</strong></p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Subtask d: Round Robin -->
                    <div class="ws-subtask-box">
                        <div class="ws-subtask-title">d) Round Robin (Prozessor-Sharing für Zeitschlitz q → 0)</div>
                        <p class="ws-subtask-desc">Gleichmäßige Zuteilung der CPU auf alle aktiven Prozesse:</p>
                        <div class="ws-response-box @(ShowSolution ? "solved" : "")">
                            @if (ShowSolution)
                            {
                                var sortedDurations = wsProcList.Select(p => p.Duration).OrderBy(d => d).ToArray();
                                var wsRR = CalculateRoundRobin(wsProcList, 1);
                                <div class="ws-sol-calc">
                                    <p><strong>Phasen (nach sortierten Dauern):</strong> @string.Join(" ≤ ", sortedDurations)</p>
                                    <p><strong>Berechnung (Klausurformel q &rarr; 0):</strong> T̄<sub>RR</sub> = &sum;<sub>i=1..n</sub> (n - i + 1)&sup2; / n &times; &Delta;t<sub>i</sub> = <strong>@rrScore.ToString("F2") Zeiteinheiten</strong></p>
                                    <p><strong>Vergleich mit diskreten Zeitscheiben (q = 1):</strong> T̄<sub>RR(q=1)</sub> = <strong>@wsRR.AverageTurnaround.ToString("F2") Zeiteinheiten</strong> (Wartezeit T̄<sub>w</sub> = @wsRR.AverageWaiting.ToString("F2"))</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

</article>

@code {
    public enum ViewMode
    {
        Simulator,
        Worksheet
    }

    public enum RoundRobinSubMode
    {
        TimeSlices,
        ProcessorSharing
    }

    public sealed record ProcessItem(string Name, int Duration, string Priority, int OriginalIndex);
    public sealed record ScheduleBlock(
        string ProcessName, 
        int ProcessIndex, 
        int Duration, 
        string Priority, 
        int StartTime, 
        int EndTime, 
        int RemainingDuration = 0, 
        bool IsCompletion = false
    );

    public sealed record ProcessResult(
        string Name,
        int OriginalIndex,
        int Duration,
        string Priority,
        int FirstStartTime,
        int CompletionTime,
        int WaitingTime,
        int TurnaroundTime,
        int SliceCount
    );

    public sealed record PhaseResult(
        int PhaseIndex,
        string ProcessName,
        int ProcessIndex,
        int Duration,
        int Delta,
        int ActiveProcesses,
        int WallDuration,
        int CompletionTime,
        double Contribution
    );

    [Parameter]
    public string SelectedSchedulingPolicy { get; set; } = "SJF";

    [Parameter]
    public string SchedulingValuesInput { get; set; } = "6, 2, 8, 3, 5";

    [Parameter]
    public string SchedulingPrioritiesInput { get; set; } = "mittel, sehr hoch, niedrig, hoch, sehr niedrig";

    [Parameter]
    public bool IsEmbed { get; set; } = false;

    [Parameter]
    public int Quantum { get; set; } = 1;

    public RoundRobinSubMode RoundRobinMode { get; set; } = RoundRobinSubMode.TimeSlices;

    [SupplyParameterFromQuery(Name = "q")] public int? QueryQuantum { get; set; }
    [SupplyParameterFromQuery(Name = "quantum")] public int? QueryQuantumLong { get; set; }
    [SupplyParameterFromQuery(Name = "rrmode")] public string? QueryRrMode { get; set; }

    private ViewMode ActiveView { get; set; } = ViewMode.Simulator;
    private bool ShowSolution { get; set; } = false;
    private int CurrentStepIndex { get; set; } = 0;

    // Presets
    private const string Preset1Values = "6, 2, 8, 3, 5";
    private const string Preset1Priorities = "mittel, sehr hoch, niedrig, hoch, sehr niedrig";

    private const string Preset2Values = "4, 9, 2, 7, 3";
    private const string Preset2Priorities = "hoch, niedrig, sehr hoch, sehr niedrig, mittel";

    private const string Preset3Values = "2, 4, 6, 8, 10";
    private const string Preset3Priorities = "mittel, hoch, sehr hoch, niedrig, sehr niedrig";

    protected override void OnInitialized()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (string.IsNullOrEmpty(query)) return;

            var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var pair in pairs)
            {
                var parts = pair.Split('=', 2);
                var key = parts[0].ToLowerInvariant();
                var val = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";

                if (key == "embed" && bool.TryParse(val, out var embedBool))
                {
                    IsEmbed = embedBool;
                }
                else if (key == "view")
                {
                    ActiveView = val.Equals("worksheet", StringComparison.OrdinalIgnoreCase) 
                        ? ViewMode.Worksheet 
                        : ViewMode.Simulator;
                }
                else if (key == "solution" && bool.TryParse(val, out var solBool))
                {
                    ShowSolution = solBool;
                }
                else if (key == "policy" && !string.IsNullOrWhiteSpace(val))
                {
                    SelectedSchedulingPolicy = val;
                }
                else if (key == "values" && !string.IsNullOrWhiteSpace(val))
                {
                    SchedulingValuesInput = val;
                }
                else if (key == "priorities" && !string.IsNullOrWhiteSpace(val))
                {
                    SchedulingPrioritiesInput = val;
                }
                else if (key == "q" || key == "quantum")
                {
                    if (int.TryParse(val, out var qParsed) && qParsed > 0)
                    {
                        Quantum = qParsed;
                    }
                }
                else if (key == "rrmode" || key == "rr_mode" || key == "mode")
                {
                    if (val.Equals("phases", StringComparison.OrdinalIgnoreCase) || val.Equals("sharing", StringComparison.OrdinalIgnoreCase))
                    {
                        RoundRobinMode = RoundRobinSubMode.ProcessorSharing;
                    }
                    else
                    {
                        RoundRobinMode = RoundRobinSubMode.TimeSlices;
                    }
                }
            }

            var effQuantum = QueryQuantum ?? QueryQuantumLong;
            if (effQuantum.HasValue && effQuantum.Value > 0)
            {
                Quantum = effQuantum.Value;
            }
            if (!string.IsNullOrEmpty(QueryRrMode))
            {
                if (QueryRrMode.Equals("phases", StringComparison.OrdinalIgnoreCase) || QueryRrMode.Equals("sharing", StringComparison.OrdinalIgnoreCase))
                {
                    RoundRobinMode = RoundRobinSubMode.ProcessorSharing;
                }
                else
                {
                    RoundRobinMode = RoundRobinSubMode.TimeSlices;
                }
            }
        }
        catch { }
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private void SetRoundRobinMode(RoundRobinSubMode mode)
    {
        RoundRobinMode = mode;
        CurrentStepIndex = 0;
    }

    private void SetQuantum(int q)
    {
        Quantum = q;
        CurrentStepIndex = 0;
    }

    private async Task PrintWorksheet()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void OnConfigurationChanged()
    {
        CurrentStepIndex = 0;
    }

    private void LoadPreset(string values, string priorities)
    {
        SchedulingValuesInput = values;
        SchedulingPrioritiesInput = priorities;
        CurrentStepIndex = 0;
    }

    private void GenerateRandomSet()
    {
        var rnd = new Random();
        var count = 5;
        var durations = new int[count];
        for (int i = 0; i < count; i++)
        {
            durations[i] = rnd.Next(1, 11);
        }

        var pList = new[] { "sehr hoch", "hoch", "mittel", "niedrig", "sehr niedrig" };
        var shuffledPrio = pList.OrderBy(_ => rnd.Next()).ToArray();

        SchedulingValuesInput = string.Join(", ", durations);
        SchedulingPrioritiesInput = string.Join(", ", shuffledPrio);
        CurrentStepIndex = 0;
    }

    private void GoToStart()
    {
        CurrentStepIndex = 0;
    }

    private void PreviousStep()
    {
        if (CurrentStepIndex > 0) CurrentStepIndex--;
    }

    private void NextStep()
    {
        if (TryGetParsedScheduling(out var procList, out _))
        {
            var schedule = GetScheduleForPolicy(SelectedSchedulingPolicy, procList);
            if (CurrentStepIndex < schedule.Count)
            {
                CurrentStepIndex++;
            }
        }
    }

    private void GoToEnd()
    {
        if (TryGetParsedScheduling(out var procList, out _))
        {
            var schedule = GetScheduleForPolicy(SelectedSchedulingPolicy, procList);
            CurrentStepIndex = schedule.Count;
        }
    }

    private void OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var step))
        {
            CurrentStepIndex = step;
        }
    }

    private bool ShouldShowTick(int index, List<ScheduleBlock> schedule)
    {
        if (schedule.Count <= 12) return true;
        var item = schedule[index];
        if (index == schedule.Count - 1) return true;
        if (item.IsCompletion) return true;
        return false;
    }

    private bool TryGetParsedScheduling(out List<ProcessItem> processes, out string errorMessage)
    {
        try
        {
            var durations = SchedulingValuesInput
                .Split(new[] { ',', ';', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(t => int.TryParse(t, out var val) ? val : throw new InvalidOperationException($"Ungültige Zahl '{t}' in den Bedienzeiten."))
                .ToArray();

            var priorities = SchedulingPrioritiesInput
                .Split(new[] { ',', ';', '\t' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(p => p.Trim())
                .ToArray();

            if (durations.Length == 0)
            {
                throw new InvalidOperationException("Bitte geben Sie mindestens eine Prozessdauer an.");
            }

            if (priorities.Length != durations.Length)
            {
                var defaultPrios = new[] { "sehr hoch", "hoch", "mittel", "niedrig", "sehr niedrig" };
                priorities = Enumerable.Range(0, durations.Length)
                    .Select(i => i < priorities.Length ? priorities[i] : (i < defaultPrios.Length ? defaultPrios[i] : "mittel"))
                    .ToArray();
            }

            processes = durations
                .Select((d, idx) => new ProcessItem($"P{idx + 1}", d, priorities[idx], idx))
                .ToList();

            errorMessage = string.Empty;
            return true;
        }
        catch (Exception ex)
        {
            processes = new List<ProcessItem>();
            errorMessage = ex.Message;
            return false;
        }
    }

    private (List<ScheduleBlock> Slices, List<ProcessResult> ProcessResults, double AverageTurnaround, double AverageWaiting) 
        CalculateRoundRobin(List<ProcessItem> processes, int quantum)
    {
        var slices = new List<ScheduleBlock>();
        var queue = new Queue<(ProcessItem Proc, int Rem)>();
        foreach (var p in processes)
        {
            queue.Enqueue((p, p.Duration));
        }

        var currentTime = 0;
        var resultsMap = new Dictionary<int, ProcessResult>();
        var sliceCountMap = processes.ToDictionary(p => p.OriginalIndex, _ => 0);
        var firstStartMap = processes.ToDictionary(p => p.OriginalIndex, _ => -1);

        while (queue.Count > 0)
        {
            var (proc, rem) = queue.Dequeue();
            if (firstStartMap[proc.OriginalIndex] < 0)
            {
                firstStartMap[proc.OriginalIndex] = currentTime;
            }

            var runDuration = Math.Min(quantum, rem);
            var start = currentTime;
            var end = currentTime + runDuration;
            currentTime = end;
            sliceCountMap[proc.OriginalIndex]++;

            var nextRem = rem - runDuration;
            var isComp = nextRem == 0;
            slices.Add(new ScheduleBlock(proc.Name, proc.OriginalIndex, runDuration, proc.Priority, start, end, nextRem, isComp));

            if (isComp)
            {
                var completion = end;
                var turnaround = completion;
                var waiting = turnaround - proc.Duration;
                resultsMap[proc.OriginalIndex] = new ProcessResult(
                    proc.Name,
                    proc.OriginalIndex,
                    proc.Duration,
                    proc.Priority,
                    firstStartMap[proc.OriginalIndex],
                    completion,
                    waiting,
                    turnaround,
                    sliceCountMap[proc.OriginalIndex]
                );
            }
            else
            {
                queue.Enqueue((proc, nextRem));
            }
        }

        var processResults = processes.Select(p => resultsMap[p.OriginalIndex]).ToList();
        var avgTurnaround = processResults.Count > 0 ? processResults.Average(r => r.TurnaroundTime) : 0.0;
        var avgWaiting = processResults.Count > 0 ? processResults.Average(r => r.WaitingTime) : 0.0;

        return (slices, processResults, avgTurnaround, avgWaiting);
    }

    private (List<ScheduleBlock> Phases, List<PhaseResult> PhaseResults, double AverageTurnaround)
        CalculateProcessorSharing(List<ProcessItem> processes)
    {
        var sorted = processes.OrderBy(p => p.Duration).ToList();
        var phases = new List<ScheduleBlock>();
        var phaseResults = new List<PhaseResult>();
        var totalProcesses = processes.Count;
        var remainingProcesses = totalProcesses;
        var sharedTime = 0;
        var currentTime = 0;
        var totalScore = 0.0;

        for (int i = 0; i < sorted.Count; i++)
        {
            var proc = sorted[i];
            var delta = proc.Duration - sharedTime;
            var wallDuration = remainingProcesses * delta;
            var start = currentTime;
            var end = currentTime + wallDuration;
            currentTime = end;
            sharedTime = proc.Duration;

            var contribution = totalProcesses > 0 
                ? (double)remainingProcesses * delta * remainingProcesses / totalProcesses 
                : 0.0;
            totalScore += contribution;

            phases.Add(new ScheduleBlock(
                proc.Name,
                proc.OriginalIndex,
                wallDuration,
                proc.Priority,
                start,
                end,
                0,
                true
            ));

            phaseResults.Add(new PhaseResult(
                i + 1,
                proc.Name,
                proc.OriginalIndex,
                proc.Duration,
                delta,
                remainingProcesses,
                wallDuration,
                end,
                contribution
            ));

            remainingProcesses--;
        }

        return (phases, phaseResults, totalScore);
    }

    private List<ScheduleBlock> GetScheduleForPolicy(string policy, List<ProcessItem> processes)
    {
        if (policy == "RoundRobin")
        {
            if (RoundRobinMode == RoundRobinSubMode.ProcessorSharing)
            {
                return CalculateProcessorSharing(processes).Phases;
            }
            return CalculateRoundRobin(processes, Math.Max(1, Quantum)).Slices;
        }

        var result = new List<ScheduleBlock>();
        var currentTime = 0;

        List<ProcessItem> ordered = policy switch
        {
            "SJF" => processes.OrderBy(p => p.Duration).ToList(),
            "Priority" => OrderByPriority(processes),
            _ => processes.ToList() // FCFS
        };

        for (int i = 0; i < ordered.Count; i++)
        {
            var p = ordered[i];
            var start = currentTime;
            var end = currentTime + p.Duration;
            result.Add(new ScheduleBlock(p.Name, p.OriginalIndex, p.Duration, p.Priority, start, end, 0, true));
            currentTime = end;
        }

        return result;
    }

    private List<ProcessItem> OrderByPriority(List<ProcessItem> processes)
    {
        var priorityLadder = new[] { "sehr hoch", "hoch", "mittel", "niedrig", "sehr niedrig" };
        var ordered = new List<ProcessItem>();

        foreach (var pLevel in priorityLadder)
        {
            var match = processes.FirstOrDefault(p => string.Equals(p.Priority, pLevel, StringComparison.OrdinalIgnoreCase));
            if (match != null && !ordered.Contains(match))
            {
                ordered.Add(match);
            }
        }

        foreach (var p in processes)
        {
            if (!ordered.Contains(p)) ordered.Add(p);
        }

        return ordered;
    }

    private string GetProcessColorClass(int procIndex)
    {
        var colors = new[] { "p-blue", "p-green", "p-amber", "p-purple", "p-rose", "p-cyan", "p-emerald", "p-indigo" };
        return colors[procIndex % colors.Length];
    }

    private string GetSchedulingNarratorText(int stepIndex, List<ScheduleBlock> schedule, int totalProcesses, string policy, List<PhaseResult>? phaseResults = null)
    {
        if (stepIndex == 0)
        {
            return policy switch
            {
                "SJF" => $"Alle {totalProcesses} Prozesse stehen zur Zeit t=0 in der Bereit-Warteschlange. Shortest Job First wählt als Nächstes den Prozess mit der kürzesten Bedienzeit.",
                "Priority" => $"Alle {totalProcesses} Prozesse stehen zur Zeit t=0 in der Bereit-Warteschlange. Prioritätsscheduling wählt stets den Prozess mit der höchsten Prioritätsstufe.",
                "RoundRobin" when RoundRobinMode == RoundRobinSubMode.ProcessorSharing => $"Alle {totalProcesses} Prozesse teilen sich die CPU gleichmäßig im Prozessor-Sharing (q → 0). Prozesse mit kürzerer Bedienzeit terminieren früher.",
                "RoundRobin" => $"Alle {totalProcesses} Prozesse stehen zur Zeit t=0 in der Bereit-Warteschlange. Round Robin teilt die CPU reihum in Zeitscheiben von q={Quantum} Zeiteinheit(en) zu.",
                _ => $"Alle {totalProcesses} Prozesse stehen zur Zeit t=0 in der Bereit-Warteschlange. FCFS arbeitet die Prozesse streng in der Eingangsreihenfolge ab."
            };
        }

        var item = schedule[stepIndex - 1];

        if (policy == "RoundRobin")
        {
            if (RoundRobinMode == RoundRobinSubMode.ProcessorSharing && phaseResults != null && stepIndex - 1 < phaseResults.Count)
            {
                var pRes = phaseResults[stepIndex - 1];
                return $"Phase {pRes.PhaseIndex}: Von t={item.StartTime} bis t={item.EndTime} (Laufzeit: {pRes.WallDuration}) teilten sich {pRes.ActiveProcesses} Prozesse gleichmäßig die CPU (Δt = {pRes.Delta}). Bei t={item.EndTime} terminiert {pRes.ProcessName}. Beitrag zur mittleren Verweilzeit: {pRes.ActiveProcesses}²/{totalProcesses} × {pRes.Delta} = {pRes.Contribution:F2}.";
            }
            else
            {
                if (item.IsCompletion)
                {
                    return $"Schritt {stepIndex}: {item.ProcessName} erhält die letzte Zeitscheibe von t={item.StartTime} bis t={item.EndTime} (Dauer: {item.Duration}). 🎉 {item.ProcessName} ist damit vollständig fertiggestellt (Fertigstellung C={item.EndTime}, Verweilzeit T_tr={item.EndTime})!";
                }
                else
                {
                    return $"Schritt {stepIndex}: {item.ProcessName} erhält die CPU für {item.Duration} Zeiteinheit(en) von t={item.StartTime} bis t={item.EndTime}. Restbedienzeit: {item.RemainingDuration}. Da {item.ProcessName} noch nicht fertig ist, wird er am Ende der Bereit-Warteschlange eingereiht.";
                }
            }
        }

        var remaining = totalProcesses - (stepIndex - 1);
        var contribution = (double)remaining * item.Duration / totalProcesses;

        return policy switch
        {
            "SJF" => $"Schritt {stepIndex}: {item.ProcessName} besitzt mit t={item.Duration} die kürzeste verbleibende Bedienzeit. Seine Abarbeitung von t={item.StartTime} bis t={item.EndTime} hält noch {remaining} Prozesse im System auf. Verweilzeit-Beitrag: {remaining}/{totalProcesses} \u00d7 {item.Duration} = {contribution:F2}.",
            "Priority" => $"Schritt {stepIndex}: {item.ProcessName} hat die höchste Priorität ('{item.Priority}') unter den noch wartenden Prozessen. Ausführung von t={item.StartTime} bis t={item.EndTime}. Verweilzeit-Beitrag: {remaining}/{totalProcesses} \u00d7 {item.Duration} = {contribution:F2}.",
            _ => $"Schritt {stepIndex}: {item.ProcessName} steht an Position {stepIndex} der Eingangswarteschlange (FCFS). Ausführung von t={item.StartTime} bis t={item.EndTime}. Verweilzeit-Beitrag: {remaining}/{totalProcesses} \u00d7 {item.Duration} = {contribution:F2}."
        };
    }
}
