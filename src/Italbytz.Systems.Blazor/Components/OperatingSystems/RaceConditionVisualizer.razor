    private void ResetSimulation()
    {
        StopAutoPlay();
        CurrentStepIndex = 0;
        SharedVariableValue = (SelectedPreset == "Bank") ? 100 : 0;
        LastWriter = 0;
        LockHolder = 0;
        Thread1LocalVar = 0;
        Thread2LocalVar = 0;
        HasCollisionOccurred = false;
        CollisionMessage = "";
        CurrentStepExplanation = "Bereit. Klicken Sie auf „Nächster Schritt“ oder „Auto-Play“.";
        ConsoleLines.Clear();
    }

    private void StepForward()
    {
        if (CurrentStepIndex < ActiveSchedule.Count)
        {
            CurrentStepIndex++;
            ApplyStep(CurrentStepIndex - 1);
        }
        else
        {
            StopAutoPlay();
        }
    }

    private void StepBack()
    {
        if (CurrentStepIndex > 0)
        {
            CurrentStepIndex--;
            ReplayUpToStep(CurrentStepIndex);
        }
    }

    private void GoToStart()
    {
        ResetSimulation();
    }

    private void ReplayUpToStep(int targetStep)
    {
        SharedVariableValue = (SelectedPreset == "Bank") ? 100 : 0;
        LastWriter = 0;
        LockHolder = 0;
        Thread1LocalVar = 0;
        Thread2LocalVar = 0;
        HasCollisionOccurred = false;
        CollisionMessage = "";
        ConsoleLines.Clear();

        if (targetStep == 0)
        {
            CurrentStepExplanation = "Initialzustand geladen.";
            return;
        }

        for (int i = 0; i < targetStep; i++)
        {
            ApplyStep(i);
        }
    }

    private void ApplyStep(int stepIndex)
    {
        var step = ActiveSchedule[stepIndex];
        SharedVariableValue = step.SharedValAfter;
        LastWriter = (step.ActionType == "write") ? step.ThreadId : LastWriter;
        LockHolder = step.LockHolderAfter;
        Thread1LocalVar = step.LocalValT1;
        Thread2LocalVar = step.LocalValT2;
        CurrentStepExplanation = step.Explanation;

        if (step.TriggersCollision)
        {
            HasCollisionOccurred = true;
            CollisionMessage = (SelectedPreset == "Exam")
                ? "Thread 1 liest unerwartet die von Thread 2 gesetzte ID (Wert 2 statt 1)!"
                : (SelectedPreset == "Bank")
                    ? "Lost Update! Einzahlung von 50 € überschreibt die Abhebung von 30 €. 30 € sind verloren gegangen!"
                    : "Lost Update! Beide Threads haben 0 gelesen und 1 geschrieben. Ein Inkrement ist verloren!";
        }

        if (!string.IsNullOrEmpty(step.ConsoleOutput))
        {
            ConsoleLines.Add(new ConsoleLine
            {
                StepNum = stepIndex + 1,
                ThreadId = step.ThreadId,
                Message = step.ConsoleOutput,
                IsError = step.IsConsoleError
            });
        }
    }

    private int GetThreadProgress(int threadId)
    {
        int count = 0;
        for (int i = 0; i < CurrentStepIndex; i++)
        {
            if (ActiveSchedule[i].ThreadId == threadId) count++;
        }
        return count;
    }

    private string GetThreadStatusText(int threadId)
    {
        if (CurrentStepIndex == 0) return "Bereit";
        if (CurrentStepIndex >= ActiveSchedule.Count) return "Beendet";

        var cur = ActiveSchedule[CurrentStepIndex - 1];
        if (cur.ThreadId == threadId)
        {
            if (cur.ActionType == "sleep") return "Schlafend (Sleep)";
            if (cur.ActionType == "lock" && LockHolder == threadId) return "Im Lock";
            return "Rechnend";
        }
        else
        {
            // The other thread
            if (IsProtected && LockHolder != 0 && LockHolder != threadId)
            {
                return "Blockiert (Wartet auf Lock)";
            }
            return "Wartend / Bereit";
        }
    }

    private string GetThreadStatusClass(int threadId)
    {
        var text = GetThreadStatusText(threadId);
        if (text.Contains("Blockiert")) return "status-blocked";
        if (text.Contains("Schlafend")) return "status-sleep";
        if (text.Contains("Rechnend") || text.Contains("Im Lock")) return "status-active";
        if (text.Contains("Beendet")) return "status-done";
        return "status-ready";
    }

    private void ToggleAutoPlay()
    {
        if (IsPlaying) StopAutoPlay();
        else StartAutoPlay();
    }

    private void StartAutoPlay()
    {
        StopAutoPlay();
        if (CurrentStepIndex >= ActiveSchedule.Count)
        {
            ResetSimulation();
        }

        IsPlaying = true;
        _playCts = new CancellationTokenSource();
        _ = PlayLoopAsync(_playCts.Token);
    }

    private void StopAutoPlay()
    {
        IsPlaying = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private async Task PlayLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && CurrentStepIndex < ActiveSchedule.Count)
            {
                await Task.Delay(PlaySpeedMs, token);
                if (token.IsCancellationRequested) break;

                StepForward();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            IsPlaying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        StopAutoPlay();
    }
}
