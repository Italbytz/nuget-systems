                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.BusyWaiting, Status1After = ProcessStatus.BusyWaiting,
                ConsoleOutput = ".1 (wartet...)"
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 2, ActionType = "check",
                Explanation = "VERKLEMMUNG: Beide Threads warten endlos aufeinander! Dies beweist, warum Petersons _turn unverzichtbar ist.",
                Interested0After = true, Interested1After = true, TurnAfter = -1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.BusyWaiting, Status1After = ProcessStatus.BusyWaiting,
