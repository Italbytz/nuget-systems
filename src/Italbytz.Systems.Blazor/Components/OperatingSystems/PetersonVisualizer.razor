    private void ApplySimulationState()
    {
        if (CurrentStepIndex == 0)
        {
            Interested[0] = false;
            Interested[1] = false;
            Turn = -1;
            MyselfVal = -1;
            InCriticalRegion[0] = false;
            InCriticalRegion[1] = false;
            ThreadStatus[0] = ProcessStatus.Ready;
            ThreadStatus[1] = ProcessStatus.Ready;
            CurrentStepExplanation = "Bereit. Klicken Sie auf „Nächster Schritt“ oder „Auto-Play“.";
            ConsoleLines.Clear();
            return;
        }

        var step = ActiveSchedule[CurrentStepIndex - 1];
        Interested[0] = step.Interested0After;
        Interested[1] = step.Interested1After;
        Turn = step.TurnAfter;
        MyselfVal = step.MyselfAfter;
        InCriticalRegion[0] = step.InCs0After;
        InCriticalRegion[1] = step.InCs1After;
        ThreadStatus[0] = step.Status0After;
        ThreadStatus[1] = step.Status1After;
        CurrentStepExplanation = step.Explanation;

        // Rebuild console output up to CurrentStepIndex
        ConsoleLines.Clear();
        for (int i = 0; i < CurrentStepIndex; i++)
        {
            var s = ActiveSchedule[i];
            if (!string.IsNullOrEmpty(s.ConsoleOutput))
            {
                ConsoleLines.Add(new ConsoleLine
                {
                    StepNum = i + 1,
                    ThreadId = s.ThreadId,
                    Message = s.ConsoleOutput
                });
            }
        }
    }

    public void StepForward()
    {
        if (CurrentStepIndex < ActiveSchedule.Count)
        {
            CurrentStepIndex++;
            ApplySimulationState();
        }
        else
        {
            StopAutoPlay();
        }
    }

    public void StepBack()
    {
        StopAutoPlay();
        if (CurrentStepIndex > 0)
        {
            CurrentStepIndex--;
            ApplySimulationState();
        }
    }

    public void GoToStart()
    {
        StopAutoPlay();
        CurrentStepIndex = 0;
        ApplySimulationState();
    }

    public void ResetSimulation()
    {
        LoadPreset(SelectedPreset);
    }

    public void ToggleAutoPlay()
    {
        if (IsPlaying)
        {
            StopAutoPlay();
        }
        else
        {
            StartAutoPlay();
        }
    }

    private void StartAutoPlay()
    {
        if (CurrentStepIndex >= ActiveSchedule.Count)
        {
            CurrentStepIndex = 0;
            ApplySimulationState();
        }

        IsPlaying = true;
        _playCts = new CancellationTokenSource();
        var token = _playCts.Token;

        _ = Task.Run(async () =>
        {
            while (IsPlaying && !token.IsCancellationRequested)
            {
                await Task.Delay(PlaySpeedMs, token);
                if (token.IsCancellationRequested) break;

                await InvokeAsync(() =>
                {
                    if (CurrentStepIndex < ActiveSchedule.Count)
                    {
                        StepForward();
                    }
                    else
                    {
                        StopAutoPlay();
                    }
                    StateHasChanged();
                });
            }
        }, token);
    }

    private void StopAutoPlay()
    {
        IsPlaying = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private int GetThreadProgress(int threadId)
    {
        int maxIndex = -1;
        for (int i = 0; i < CurrentStepIndex; i++)
        {
            if (ActiveSchedule[i].ThreadId == threadId)
            {
                if (ActiveSchedule[i].InstructionIndex > maxIndex)
                {
                    maxIndex = ActiveSchedule[i].InstructionIndex;
                }
            }
        }
        return maxIndex;
    }

    private bool ShouldWait(int process)
    {
        int other = 1 - process;
        if (SelectedPreset == "DeadlockDemo")
        {
            return Interested[other];
        }
        return (Interested[other] && Turn == other);
    }

    private string GetThreadStatusText(int threadId)
    {
        return ThreadStatus[threadId] switch
        {
            ProcessStatus.Ready => "Bereit",
            ProcessStatus.InEntryProtocol => "Eintrittsprotokoll",
            ProcessStatus.BusyWaiting => "Aktives Warten ⏳",
            ProcessStatus.InCriticalSection => "Im kritischen Abschnitt 🔒",
            ProcessStatus.Exited => "Beendet ✅",
            _ => "Bereit"
        };
    }

    private string GetThreadStatusClass(int threadId)
    {
        return ThreadStatus[threadId] switch
        {
            ProcessStatus.Ready => "status-ready",
            ProcessStatus.InEntryProtocol => "status-entry",
            ProcessStatus.BusyWaiting => "status-waiting",
            ProcessStatus.InCriticalSection => "status-cs",
            ProcessStatus.Exited => "status-done",
            _ => "status-ready"
        };
    }

    public void Dispose()
    {
        StopAutoPlay();
    }
}
