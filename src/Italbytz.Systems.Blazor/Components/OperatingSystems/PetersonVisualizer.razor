    public void LoadPreset(string preset)
    {
        StopAutoPlay();
        SelectedPreset = preset;
        CurrentStepIndex = 0;
        ConsoleLines.Clear();

        BuildCodeInstructions();
        BuildSchedule(preset);
        ApplySimulationState();
    }

    private void BuildCodeInstructions()
    {
        Thread0Instructions = new List<InstructionDef>
        {
            new() { CodeText = "Interested[0] = true;", IsCriticalSection = false },
            new() { CodeText = "_turn = 1;", IsCriticalSection = false },
            new() { CodeText = "while (Interested[1] && _turn == 1) ;", IsCriticalSection = false },
            new() { CodeText = "_myself = 0;", IsCriticalSection = true },
            new() { CodeText = "Console.WriteLine($\"Variable: {_myself}\");", IsCriticalSection = true },
            new() { CodeText = "Interested[0] = false;", IsCriticalSection = false }
        };

        Thread1Instructions = new List<InstructionDef>
        {
            new() { CodeText = "Interested[1] = true;", IsCriticalSection = false },
            new() { CodeText = "_turn = 0;", IsCriticalSection = false },
            new() { CodeText = "while (Interested[0] && _turn == 0) ;", IsCriticalSection = false },
            new() { CodeText = "_myself = 1;", IsCriticalSection = true },
            new() { CodeText = "Console.WriteLine($\"Variable: {_myself}\");", IsCriticalSection = true },
            new() { CodeText = "Interested[1] = false;", IsCriticalSection = false }
        };
    }

    private void BuildSchedule(string preset)
    {
        ActiveSchedule.Clear();

        if (preset == "Standard")
        {
            // Preset 1: Thread 0 starts first, enters CS, Thread 1 arrives and busy-waits, T0 leaves, T1 enters
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 0, ActionType = "flag",
                Explanation = "Thread 0 bekundet Eintrittsinteresse: Interested[0] = true.",
                Interested0After = true, Interested1After = false, TurnAfter = -1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready,
                ConsoleOutput = "Thread 0 wants to enter critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 1, ActionType = "turn",
                Explanation = "Thread 0 ist höflich und bietet Thread 1 den Vortritt an: _turn = 1.",
                Interested0After = true, Interested1After = false, TurnAfter = 1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 2, ActionType = "check",
                Explanation = "T0 prüft while(Interested[1] && _turn == 1). Da Interested[1] == false ist, bricht die Schleife ab ➔ T0 darf sofort eintreten!",
                Interested0After = true, Interested1After = false, TurnAfter = 1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 3, ActionType = "cs",
                Explanation = "Thread 0 betritt den kritischen Bereich und schreibt _myself = 0.",
                Interested0After = true, Interested1After = false, TurnAfter = 1, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.Ready,
                ConsoleOutput = "Thread 0 entered critical region."
            });
            // Thread 1 now wants to enter while T0 is in CS
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 0, ActionType = "flag",
                Explanation = "Thread 1 möchte nun ebenfalls eintreten: Interested[1] = true.",
                Interested0After = true, Interested1After = true, TurnAfter = 1, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.InEntryProtocol,
                ConsoleOutput = "Thread 1 wants to enter critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 1, ActionType = "turn",
                Explanation = "Thread 1 bietet Thread 0 den Vortritt an: _turn = 0.",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.InEntryProtocol
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 2, ActionType = "check",
                Explanation = "T1 prüft while(Interested[0] && _turn == 0). Da T0 noch interessiert ist und _turn==0 ist, muss T1 aktiv warten (.1)!",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.BusyWaiting,
                ConsoleOutput = ".1 (aktives Warten...)"
            });
            // T0 finishes CS and leaves
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 4, ActionType = "cs",
                Explanation = "Thread 0 liest Variable: _myself == 0 (konsistent).",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.BusyWaiting,
                ConsoleOutput = "Variable should be 0, is: 0"
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 5, ActionType = "leave",
                Explanation = "Thread 0 verlässt den kritischen Abschnitt: Interested[0] = false.",
                Interested0After = false, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.BusyWaiting
            });
            // T1 can now pass the while loop
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 2, ActionType = "check",
                Explanation = "T1 prüft erneut while(Interested[0] && _turn == 0). Da Interested[0] jetzt false ist, wird die Schleife beendet!",
                Interested0After = false, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.InEntryProtocol
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 3, ActionType = "cs",
                Explanation = "Thread 1 betritt den kritischen Abschnitt: _myself = 1.",
                Interested0After = false, Interested1After = true, TurnAfter = 0, MyselfAfter = 1,
                InCs0After = false, InCs1After = true,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.InCriticalSection,
                ConsoleOutput = "Thread 1 entered critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 4, ActionType = "cs",
                Explanation = "Thread 1 liest Variable: _myself == 1 (konsistent).",
                Interested0After = false, Interested1After = true, TurnAfter = 0, MyselfAfter = 1,
                InCs0After = false, InCs1After = true,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.InCriticalSection,
                ConsoleOutput = "Variable should be 1, is: 1"
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 5, ActionType = "leave",
                Explanation = "Thread 1 verlässt den kritischen Abschnitt: Interested[1] = false.",
                Interested0After = false, Interested1After = false, TurnAfter = 0, MyselfAfter = 1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.Exited
            });
        }
        else if (preset == "Contention")
        {
            // Preset 2: Simultaneous Contention (Race to set _turn)
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 0, ActionType = "flag",
                Explanation = "Thread 0 bekundet Interesse: Interested[0] = true.",
                Interested0After = true, Interested1After = false, TurnAfter = -1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready,
                ConsoleOutput = "Thread 0 wants to enter critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 0, ActionType = "flag",
                Explanation = "Thread 1 bekundet zeitgleich Interesse: Interested[1] = true.",
                Interested0After = true, Interested1After = true, TurnAfter = -1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.InEntryProtocol,
                ConsoleOutput = "Thread 1 wants to enter critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 1, ActionType = "turn",
                Explanation = "Thread 0 setzt zuerst _turn = 1 (gibt T1 den Vortritt).",
                Interested0After = true, Interested1After = true, TurnAfter = 1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.InEntryProtocol
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 1, ActionType = "turn",
                Explanation = "Thread 1 überschreibt kurz danach _turn = 0 (gibt T0 den Vortritt)! Da T1 zuletzt schrieb, bleibt _turn == 0.",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.InEntryProtocol
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 2, ActionType = "check",
                Explanation = "T0 prüft: Interested[1]==true, ABER _turn==0 != 1! Die Bedingung ist FALSE ➔ T0 darf eintreten!",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.InEntryProtocol
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 2, ActionType = "check",
                Explanation = "T1 prüft: Interested[0]==true UND _turn==0 == 0! Die Bedingung ist TRUE ➔ T1 muss aktiv warten (.1)!",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.BusyWaiting,
                ConsoleOutput = ".1 (aktives Warten...)"
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 3, ActionType = "cs",
                Explanation = "Thread 0 gewinnt das Rennen dank Symmetriebruch und betritt den KS: _myself = 0.",
                Interested0After = true, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.BusyWaiting,
                ConsoleOutput = "Thread 0 entered critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 5, ActionType = "leave",
                Explanation = "Thread 0 beendet KS und setzt Interested[0] = false.",
                Interested0After = false, Interested1After = true, TurnAfter = 0, MyselfAfter = 0,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.BusyWaiting
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 3, ActionType = "cs",
                Explanation = "Interested[0] ist nun false ➔ T1 verlässt die Warteschleife und betritt den KS!",
                Interested0After = false, Interested1After = true, TurnAfter = 0, MyselfAfter = 1,
                InCs0After = false, InCs1After = true,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.InCriticalSection,
                ConsoleOutput = "Thread 1 entered critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 1, InstructionIndex = 5, ActionType = "leave",
                Explanation = "Thread 1 verlässt den KS: Interested[1] = false.",
                Interested0After = false, Interested1After = false, TurnAfter = 0, MyselfAfter = 1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.Exited
            });
        }
        else if (preset == "Solo")
        {
            // Preset 3: Single process execution (No contention)
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 0, ActionType = "flag",
                Explanation = "Thread 0 setzt Interested[0] = true.",
                Interested0After = true, Interested1After = false, TurnAfter = -1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready,
                ConsoleOutput = "Thread 0 wants to enter critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 1, ActionType = "turn",
                Explanation = "Thread 0 setzt _turn = 1.",
                Interested0After = true, Interested1After = false, TurnAfter = 1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 2, ActionType = "check",
                Explanation = "Interested[1] ist false ➔ Schleife bricht sofort ab ohne Verzögerung!",
                Interested0After = true, Interested1After = false, TurnAfter = 1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.InEntryProtocol, Status1After = ProcessStatus.Ready
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 3, ActionType = "cs",
                Explanation = "Thread 0 im KS: _myself = 0.",
                Interested0After = true, Interested1After = false, TurnAfter = 1, MyselfAfter = 0,
                InCs0After = true, InCs1After = false,
                Status0After = ProcessStatus.InCriticalSection, Status1After = ProcessStatus.Ready,
                ConsoleOutput = "Thread 0 entered critical region."
            });
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 5, ActionType = "leave",
                Explanation = "Thread 0 verlässt KS: Interested[0] = false.",
                Interested0After = false, Interested1After = false, TurnAfter = 1, MyselfAfter = 0,
                InCs0After = false, InCs1After = false,
                Status0After = ProcessStatus.Exited, Status1After = ProcessStatus.Ready
            });
        }
        else if (preset == "DeadlockDemo")
        {
            // Preset 4: Anti-Pattern (Omission of turn variable -> mutual blocking)
            ActiveSchedule.Add(new ScheduleStep
            {
                ThreadId = 0, InstructionIndex = 0, ActionType = "flag",
                Explanation = "Thread 0 setzt Interested[0] = true.",
                Interested0After = true, Interested1After = false, TurnAfter = -1, MyselfAfter = -1,
                InCs0After = false, InCs1After = false,
