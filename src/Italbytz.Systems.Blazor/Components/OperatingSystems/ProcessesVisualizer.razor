    public void RefreshProcessStats()
    {
        var rnd = new Random();
        CurrentProcessInfo = CurrentProcessInfo with
        {
            WorkingSetMb = Math.Round(45.0 + rnd.NextDouble() * 12.0, 1),
            ThreadCount = 14 + rnd.Next(0, 5)
        };
    }

    public void ApplyCommandPreset(string preset)
    {
        SelectedCommandPreset = preset;
        CommandPhase = 0;
        TerminalStdout = "";
        TerminalStderr = "";

        switch (preset)
        {
            case "dotnet":
                CustomCommand = "dotnet";
                CustomArguments = "--version";
                break;
            case "uname":
                CustomCommand = "uname";
                CustomArguments = "-a";
                break;
            case "ls":
                CustomCommand = "ls";
                CustomArguments = "-la /usr";
                break;
            case "whoami":
                CustomCommand = "whoami";
                CustomArguments = "";
                break;
            case "error":
                CustomCommand = "cat";
                CustomArguments = "/etc/shadow";
                break;
        }
    }

    public async Task ExecuteCommandAsync()
    {
        if (IsRunningCommand) return;

        IsRunningCommand = true;
        TerminalStdout = "";
        TerminalStderr = "";
        CommandPhase = 1;
        StateHasChanged();

        await Task.Delay(400);
        CommandPhase = 2; // Process.Start()
        StateHasChanged();

        await Task.Delay(400);
        CommandPhase = 3; // Streams reading
        StateHasChanged();

        await Task.Delay(400);

        // Simulated Command Execution Output
        if (SelectedCommandPreset == "error" || CustomCommand == "cat" && CustomArguments.Contains("shadow"))
        {
            LastExitCode = 1;
            TerminalStderr = "cat: /etc/shadow: Permission denied";
        }
        else if (CustomCommand == "dotnet")
        {
            LastExitCode = 0;
            TerminalStdout = "10.0.101";
        }
        else if (CustomCommand == "uname")
        {
            LastExitCode = 0;
            TerminalStdout = "Darwin Kernel Version 25.6.0: Fri Jul 31 19:16:36 PDT 2026; root:xnu/RELEASE_ARM64 arm64";
        }
        else if (CustomCommand == "ls")
        {
            LastExitCode = 0;
            TerminalStdout = "drwxr-xr-x   5 root  wheel   160 Jan  1  2026 .\ndrwxr-xr-x  12 root  wheel   384 Jan  1  2026 ..\ndrwxr-xr-x 892 root  wheel 28544 Nov  8 12:00 bin\ndrwxr-xr-x  39 root  wheel  1248 Nov  8 12:00 lib\ndrwxr-xr-x 195 root  wheel  6240 Nov  8 12:00 share";
        }
        else if (CustomCommand == "whoami")
        {
            LastExitCode = 0;
            TerminalStdout = "student (uid=1000)";
        }
        else
        {
            LastExitCode = 0;
            TerminalStdout = $"[Ausgeführt: {CustomCommand} {CustomArguments} um {DateTime.Now:HH:mm:ss}]";
        }

        CommandPhase = 4; // WaitForExit()
        IsRunningCommand = false;
        StateHasChanged();
    }

    public void ResetCommandExecution()
    {
        CommandPhase = 0;
        TerminalStdout = "";
        TerminalStderr = "";
        IsRunningCommand = false;
        LastExitCode = 0;
    }

    public void Dispose()
    {
    }
}
