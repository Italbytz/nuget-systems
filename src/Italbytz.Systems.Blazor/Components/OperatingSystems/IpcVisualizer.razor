    private void ResetSimulation()
    {
        StopAutoPlay();
        CurrentStepIndex = 0;
        ConsoleLines.Clear();

        // Reset state values
        for (int i = 0; i < ShmSlots.Length; i++)
        {
            ShmSlots[i].IsWritten = false;
            ShmSlots[i].Value = "";
            ShmSlots[i].IsHighlighted = false;
        }
        FileSizeInBytes = 0;
        FileContentPreview = "";
        SemValue = 1;
        SemWaitersCount = 0;
        IsStreamingSocket = false;
        MqMessages.Clear();

        IsSenderActive = false;
        IsReceiverActive = false;
        SenderCurrentCall = "idle";
        ReceiverCurrentCall = "idle";
        SenderActionDetail = "Bereit zum Start";
        ReceiverActionDetail = "Bereit zum Start";
        ReceiverResultPreview = "Keine Daten";
        CurrentStepExplanation = "Simulation bereit. Klicken Sie auf „Nächster Schritt“ oder „Auto-Play“.";
    }

    private void GoToStart()
    {
        ResetSimulation();
    }

    private void StepForward()
    {
        if (CurrentStepIndex < ActiveSchedule.Count)
        {
            var step = ActiveSchedule[CurrentStepIndex];
            SenderCurrentCall = step.SenderCall;
            ReceiverCurrentCall = step.ReceiverCall;
            IsSenderActive = step.SenderActive;
            IsReceiverActive = step.ReceiverActive;
            SenderActionDetail = step.SenderDetail;
            ReceiverActionDetail = step.ReceiverDetail;
            ReceiverResultPreview = step.ResultPreview;
            CurrentStepExplanation = step.Explanation;

            step.Mutator?.Invoke();
            CurrentStepIndex++;
        }
        else
        {
            StopAutoPlay();
        }
    }

    private void StepBack()
    {
        if (CurrentStepIndex > 1)
        {
            int target = CurrentStepIndex - 1;
            ResetSimulation();
            for (int i = 0; i < target; i++)
            {
                StepForward();
            }
        }
        else
        {
            ResetSimulation();
        }
    }

    private void ToggleAutoPlay()
    {
        if (IsPlaying)
        {
            StopAutoPlay();
        }
        else
        {
            StartAutoPlay();
        }
    }

    private void StartAutoPlay()
    {
        if (CurrentStepIndex >= ActiveSchedule.Count)
        {
            ResetSimulation();
        }

        IsPlaying = true;
        _autoPlayCts = new CancellationTokenSource();
        _ = RunAutoPlayLoop(_autoPlayCts.Token);
    }

    private void StopAutoPlay()
    {
        IsPlaying = false;
        _autoPlayCts?.Cancel();
        _autoPlayCts = null;
    }

    private async Task RunAutoPlayLoop(CancellationToken token)
    {
        while (!token.IsCancellationRequested && CurrentStepIndex < ActiveSchedule.Count)
        {
            StepForward();
            StateHasChanged();
            try
            {
                await Task.Delay(SelectedSpeed, token);
            }
            catch (TaskCanceledException)
            {
                break;
            }
        }
        IsPlaying = false;
        StateHasChanged();
    }

    private void AddLog(string actor, string msg, bool isError = false)
    {
        ConsoleLines.Add(new TraceLogLine(ConsoleLines.Count + 1, actor.ToLower(), actor, msg, isError));
    }

    private string GetSenderStatusClass() => IsSenderActive ? "state-running" : "state-ready";
    private string GetSenderStatusText() => IsSenderActive ? "Aktiv / Rechnend" : "Bereit (Ready)";

    private string GetReceiverStatusClass()
    {
        if (SemWaitersCount > 0 && SelectedMechanismId == "sem") return "state-blocked";
        return IsReceiverActive ? "state-running" : "state-ready";
    }

    private string GetReceiverStatusText()
    {
        if (SemWaitersCount > 0 && SelectedMechanismId == "sem") return "Blockiert (Wait)";
        return IsReceiverActive ? "Aktiv / Rechnend" : "Bereit (Ready)";
    }

    public void Dispose()
    {
        StopAutoPlay();
    }
}
