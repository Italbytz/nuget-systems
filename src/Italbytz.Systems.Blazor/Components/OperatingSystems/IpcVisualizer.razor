@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<article class="ipc-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Interprozesskommunikation</p>
            <h2>IPC-Mechanismen: Shared Memory, Sockets, Semaphoren &amp; Dateien</h2>
            <p class="feature-intro">
                Interprozesskommunikation (IPC) umfasst Verfahren, mit denen Prozesse Daten austauschen oder 
                ihre Abläufe synchronisieren. Neben den klassischen Vorlesungs-Mechanismen (Signale, Pipes, 
                Message Queues, Sockets) zählen im weiteren Sinne auch <strong>Dateien</strong>, 
                <strong>Semaphoren / Mutexe</strong> und <strong>Geteilter Speicher (Shared Memory)</strong> dazu.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver IPC-Explorer &amp; Mechanismen-Vergleich
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht 1:1)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Controls & Mechanism Selector -->
        <div class="controls-panel no-print">
            <div class="mechanism-selector">
                <span class="selector-label">IPC-Mechanismus wählen:</span>
                <div class="mechanism-tabs">
                    @foreach (var mech in AvailableMechanisms)
                    {
                        <button class="mech-tab-btn @(SelectedMechanismId == mech.Id ? "active" : "") @(mech.IsExamAnswer ? "exam-highlight" : "")"
                                @onclick="() => SelectMechanism(mech.Id)">
                            <span class="tab-icon">@mech.Icon</span>
                            <span class="tab-title">@mech.Name</span>
                            @if (mech.IsExamAnswer)
                            {
                                <span class="exam-tag">★ Weiter gefasst</span>
                            }
                        </button>
                    }
                </div>
            </div>

            <div class="toolbar-grid">
                <div class="btn-group">
                    <button class="action-btn" @onclick="GoToStart" disabled="@(CurrentStepIndex == 0)" title="An den Anfang">
                        ⏮️ Anfang
                    </button>
                    <button class="action-btn" @onclick="StepBack" disabled="@(CurrentStepIndex == 0)" title="Schritt zurück">
                        ◀️ Zurück
                    </button>
                    <button class="action-btn primary" @onclick="ToggleAutoPlay">
                        @(IsPlaying ? "⏸️ Pause" : "▶️ Auto-Play")
                    </button>
                    <button class="action-btn primary" @onclick="StepForward" disabled="@(CurrentStepIndex >= ActiveSchedule.Count)" title="Nächster Schritt">
                        Nächster Schritt (@(CurrentStepIndex)/@ActiveSchedule.Count) ⏭️
                    </button>
                    <button class="action-btn" @onclick="ResetSimulation" title="Simulation zurücksetzen">
                        🔄 Reset
                    </button>
                </div>

                <div class="speed-group">
                    <label class="speed-label" for="speedSelect">Tempo:</label>
                    <select id="speedSelect" class="speed-dropdown" @bind="SelectedSpeed">
                        <option value="2500">Langsam (2.5s)</option>
                        <option value="1500">Normal (1.5s)</option>
                        <option value="800">Schnell (0.8s)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Mechanism Summary Banner -->
        <div class="mech-summary-banner" style="border-left-color: @CurrentMechanism.ColorHex;">
            <div class="banner-icon" style="color: @CurrentMechanism.ColorHex;">@CurrentMechanism.Icon</div>
            <div class="banner-text">
                <div class="banner-title-row">
                    <h3 class="banner-title">@CurrentMechanism.Name</h3>
                    <span class="cat-badge @(CurrentMechanism.IsExamAnswer ? "badge-exam" : "badge-standard")">
                        @(CurrentMechanism.IsExamAnswer ? "★ Weiterer Begriff" : "Klassischer Begriff")
                    </span>
                    <span class="speed-pill">Performance: @CurrentMechanism.PerformanceRating</span>
                </div>
                <p class="banner-desc">@CurrentMechanism.Description</p>
            </div>
        </div>

        <!-- Interactive Architecture Stage -->
        <div class="architecture-stage">

            <!-- Process A (Sender / Producer) -->
            <div class="process-card proc-sender @(IsSenderActive ? "active-actor" : "")">
                <div class="process-header">
                    <div class="proc-id">
                        <span class="proc-icon">📤</span>
                        <div>
                            <strong>Prozess A (Sender)</strong>
                            <small class="proc-pid">PID: 2048 (Sender/Erzeuger)</small>
                        </div>
                    </div>
                    <span class="state-badge @GetSenderStatusClass()">@GetSenderStatusText()</span>
                </div>

                <div class="process-body">
                    <div class="code-snippet-box mono">
                        <span class="snippet-label">Aktueller Systemaufruf / Operation:</span>
                        <div class="snippet-code">@SenderCurrentCall</div>
                    </div>

                    <div class="var-status-panel">
                        <div class="var-row">
                            <span class="var-name">Puffer-Aktion:</span>
                            <span class="var-val mono">@SenderActionDetail</span>
                        </div>
                        <div class="var-row">
                            <span class="var-name">Kopier-Aufwand:</span>
                            <span class="var-val mono">@CurrentMechanism.CopyOverheadSender</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Central Communication Medium / Channel -->
            <div class="channel-card">
                <div class="channel-header" style="border-bottom-color: @CurrentMechanism.ColorHex;">
                    <span class="channel-title">@CurrentMechanism.MediumName</span>
                    <span class="channel-location-tag">@CurrentMechanism.StorageLocation</span>
                </div>

                <div class="channel-body">
                    
                    @if (SelectedMechanismId == "shm")
                    {
                        <!-- Shared Memory Visualizer -->
                        <div class="shm-visualizer">
                            <div class="memory-map-title">Gemeinsamer physischer RAM-Block (0x7FFE_0000 - Zero Copy)</div>
                            <div class="memory-slots">
                                @for (int i = 0; i < ShmSlots.Length; i++)
                                {
                                    var slot = ShmSlots[i];
                                    <div class="mem-slot @(slot.IsWritten ? "slot-occupied" : "slot-empty") @(slot.IsHighlighted ? "slot-active" : "")">
                                        <span class="slot-idx">#@i</span>
                                        <span class="slot-val mono">@(slot.IsWritten ? slot.Value : "—")</span>
                                        <span class="slot-status">@(slot.IsWritten ? "Gültig" : "Frei")</span>
                                    </div>
                                }
                            </div>
                            <div class="shm-pointer-legend">
                                <span class="legend-item"><span class="dot shm-dot"></span> Direkter Lese-/Schreibzugriff beider Adressräume (ohne Kernel-Kopie!)</span>
                            </div>
                        </div>
                    }
                    else if (SelectedMechanismId == "file")
                    {
                        <!-- File Storage Visualizer -->
                        <div class="file-visualizer">
                            <div class="file-icon-box">📁</div>
                            <div class="file-details">
                                <div class="file-path mono">/var/tmp/shared_dataset.dat</div>
                                <div class="file-meta">Dateisystem: ext4 &bull; Inode: 488219 &bull; Größe: @FileSizeInBytes Bytes</div>
                                <div class="file-content-preview mono">
                                    @(string.IsNullOrEmpty(FileContentPreview) ? "[Datei leer oder wird erzeugt...]" : FileContentPreview)
                                </div>
                            </div>
                            <div class="file-note">
                                ℹ️ Persistente Speicherung: Daten überleben Prozess-Ende, erfordert Dateisystem-I/O &amp; Page Cache.
                            </div>
                        </div>
                    }
                    else if (SelectedMechanismId == "sem")
                    {
                        <!-- Semaphore / Mutex Visualizer -->
                        <div class="sem-visualizer">
                            <div class="sem-meter-box">
                                <div class="sem-counter-circle @(SemValue > 0 ? "sem-green" : "sem-red")">
                                    <span class="sem-counter-num">@SemValue</span>
                                    <span class="sem-counter-lbl">sem_t Zähler</span>
                                </div>
                                <div class="sem-gate-status">
                                    <strong>Status:</strong> @(SemValue > 0 ? "Tor OFFEN (Ressource frei)" : "Tor GESPERRT (Ressource belegt)")
                                </div>
                            </div>
                            <div class="sem-queue-box">
                                <span class="queue-lbl">Warteschlange blockierter Threads/Prozesse:</span>
                                <div class="queue-pills">
                                    @if (SemWaitersCount == 0)
                                    {
                                        <span class="no-waiters">Keine Prozesse blockiert</span>
                                    }
                                    else
                                    {
                                        for (int w = 0; w < SemWaitersCount; w++)
                                        {
                                            <span class="waiter-pill">PID @(2049 + w) (wartet auf sem_post)</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="sem-note">
                                ℹ️ Semaphoren übertragen selbst keine Dateninhalte, sondern koordinieren atomar Zugriffsrechte!
                            </div>
                        </div>
                    }
                    else if (SelectedMechanismId == "socket")
                    {
                        <!-- Socket Visualizer -->
                        <div class="socket-visualizer">
                            <div class="socket-endpoints">
                                <div class="socket-end">
                                    <span class="end-label">Sender Socket</span>
                                    <span class="end-addr mono">127.0.0.1:49152</span>
                                </div>
                                <div class="socket-pipe-anim">
                                    <div class="stream-pulse @(IsStreamingSocket ? "pulsing" : "")">
                                        <span>TCP-Pakete / Stream</span>
                                    </div>
                                </div>
                                <div class="socket-end">
                                    <span class="end-label">Server Socket</span>
                                    <span class="end-addr mono">127.0.0.1:8080 (LISTEN)</span>
                                </div>
                            </div>
                            <div class="socket-note">
                                ℹ️ Funktioniert lokal (UNIX Domain Socket) und über Rechnernetze (TCP/IP). Hohe Flexibilität, aber Netzwerk-Stack-Overhead.
                            </div>
                        </div>
                    }
                    else if (SelectedMechanismId == "mq")
                    {
                        <!-- Message Queue Visualizer -->
                        <div class="mq-visualizer">
                            <div class="mq-box-title">POSIX Message Queue: <code>/my_queue</code> (Kernel-Raum)</div>
                            <div class="mq-messages">
                                @if (!MqMessages.Any())
                                {
                                    <div class="mq-empty">[Keine Nachrichten in der Warteschlange]</div>
                                }
                                else
                                {
                                    @foreach (var msg in MqMessages)
                                    {
                                        <div class="mq-msg-card">
                                            <span class="msg-prio">Prio @msg.Priority</span>
                                            <span class="msg-payload mono">@msg.Payload</span>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="mq-note">
                                ℹ️ Strukturierte Botschaften mit Priorität. Empfänger kann gezielt bestimmte Nachrichtentypen abholen.
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Signals / Pipes Fallback Visualizer -->
                        <div class="signals-visualizer">
                            <div class="sig-pill">
                                <span class="sig-name">SIGUSR1 (10)</span> &bull; Asynchrone Benachrichtigung durch den Kernel
                            </div>
                            <p class="sig-text">
                                Signale übermitteln lediglich die Signalnummer und unterbrechen den Zielprozess zur Ausführung des Signal-Handlers.
                            </p>
                        </div>
                    }

                    <!-- Current Step Narrative -->
                    <div class="channel-step-info">
                        <strong>SCHRITT @CurrentStepIndex VON @ActiveSchedule.Count:</strong>
                        <span>@CurrentStepExplanation</span>
                    </div>

                </div>
            </div>

            <!-- Process B (Receiver / Consumer) -->
            <div class="process-card proc-receiver @(IsReceiverActive ? "active-actor" : "")">
                <div class="process-header">
                    <div class="proc-id">
                        <span class="proc-icon">📥</span>
                        <div>
                            <strong>Prozess B (Empfänger)</strong>
                            <small class="proc-pid">PID: 2049 (Consumer/Verbraucher)</small>
                        </div>
                    </div>
                    <span class="state-badge @GetReceiverStatusClass()">@GetReceiverStatusText()</span>
                </div>

                <div class="process-body">
                    <div class="code-snippet-box mono">
                        <span class="snippet-label">Aktueller Systemaufruf / Operation:</span>
                        <div class="snippet-code">@ReceiverCurrentCall</div>
                    </div>

                    <div class="var-status-panel">
                        <div class="var-row">
                            <span class="var-name">Puffer-Aktion:</span>
                            <span class="var-val mono">@ReceiverActionDetail</span>
                        </div>
                        <div class="var-row">
                            <span class="var-name">Empfangenes Ergebnis:</span>
                            <span class="var-val mono">@ReceiverResultPreview</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Matrix & Taxonomy Section (Comprehensive Overview) -->
        <div class="panel-card taxonomy-card">
            <div class="panel-header">
                <span class="panel-title">📊 Große IPC-Vergleichsmatrix &amp; Systemtaxonomie</span>
                <button class="toggle-ipcs-btn" @onclick="ToggleTaxonomy">
                    @(ShowTaxonomy ? "▲ Tabelle einklappen" : "▼ Tabelle ausklappen")
                </button>
            </div>

            @if (ShowTaxonomy)
            {
                <div class="taxonomy-body">
                    <div class="table-responsive">
                        <table class="ipc-table">
                            <thead>
                                <tr>
                                    <th>Mechanismus</th>
                                    <th>Kategorie</th>
                                    <th>Speicherort / Medium</th>
                                    <th>Datenformat</th>
                                    <th>Kopplung / Reichweite</th>
                                    <th>Performance</th>
                                    <th>Synchronisation</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="highlight-row">
                                    <td><strong>Geteilter Speicher (Shared Memory)</strong></td>
                                    <td><span class="tag-weiter">★ Weiterer Begriff</span></td>
                                    <td>Gemeinsamer physischer RAM (virtuell gemappt)</td>
                                    <td>Beliebige Datenstrukturen</td>
                                    <td>Lokal (gleiches System)</td>
                                    <td><span class="perf-best">Extrem schnell (Zero-Copy)</span></td>
                                    <td>Explizit nötig (Mutex/Semaphore)</td>
                                </tr>
                                <tr class="highlight-row">
                                    <td><strong>Dateien (Files)</strong></td>
                                    <td><span class="tag-weiter">★ Weiterer Begriff</span></td>
                                    <td>Dateisystem / Inodes (SSD/HDD/PageCache)</td>
                                    <td>Bytestrom / Formatierte Dateien</td>
                                    <td>Lokal / NFS</td>
                                    <td><span class="perf-mid">Mäßig (I/O-Overhead)</span></td>
                                    <td>File-Locking (<code>flock</code> / <code>fcntl</code>)</td>
                                </tr>
                                <tr class="highlight-row">
                                    <td><strong>Semaphoren / Mutexe</strong></td>
                                    <td><span class="tag-weiter">★ Weiterer Begriff</span></td>
                                    <td>Kernel / Shared Memory Futex</td>
                                    <td>Reine Signal-/Zählerwerte (keine Nutzdaten)</td>
                                    <td>Lokal (Threads &amp; Prozesse)</td>
                                    <td><span class="perf-best">Sehr schnell</span></td>
                                    <td>Dient selbst der Synchronisation</td>
                                </tr>
                                <tr>
                                    <td><strong>Pipes (anonym)</strong></td>
                                    <td><span class="tag-standard">Standard</span></td>
                                    <td>Kernel-Ringspeicher (RAM)</td>
                                    <td>Unstrukturierter Bytestrom (FIFO)</td>
                                    <td>Nur verwandte Prozesse (Parent/Child)</td>
                                    <td><span class="perf-fast">Schnell (2x Kopieren)</span></td>
                                    <td>Implizit blockierend (read/write)</td>
                                </tr>
                                <tr>
                                    <td><strong>Named Pipes (FIFOs)</strong></td>
                                    <td><span class="tag-standard">Standard</span></td>
                                    <td>Kernel-Puffer mit Dateisystem-Knoten</td>
                                    <td>Unstrukturierter Bytestrom (FIFO)</td>
                                    <td>Beliebige lokale Prozesse</td>
                                    <td><span class="perf-fast">Schnell</span></td>
                                    <td>Implizit blockierend</td>
                                </tr>
                                <tr>
                                    <td><strong>Message Queues</strong></td>
                                    <td><span class="tag-standard">Standard</span></td>
                                    <td>Kernel-Warteschlange</td>
                                    <td>Strukturierte Nachrichten + Typ/Priorität</td>
                                    <td>Beliebige lokale Prozesse</td>
                                    <td><span class="perf-fast">Schnell</span></td>
                                    <td>Blockierend oder nicht-blockierend</td>
                                </tr>
                                <tr>
                                    <td><strong>Sockets</strong></td>
                                    <td><span class="tag-standard">Standard</span></td>
                                    <td>Netzwerk-Stack / UNIX Domain Socket</td>
                                    <td>Bytestrom (TCP) oder Datagramme (UDP)</td>
                                    <td>Lokal oder über Rechnernetze hinweg</td>
                                    <td><span class="perf-mid">Mäßig (Protokoll-Stack)</span></td>
                                    <td>Synchron oder asynchron</td>
                                </tr>
                                <tr>
                                    <td><strong>Signale</strong></td>
                                    <td><span class="tag-standard">Standard</span></td>
                                    <td>Kernel-Interrupt / Prozesstabelle</td>
                                    <td>Ganzzahlige Signal-ID (z.B. SIGKILL, SIGUSR1)</td>
                                    <td>Beliebige Prozesse mit Rechten</td>
                                    <td><span class="perf-best">Sehr schnell</span></td>
                                    <td>Asynchron (unterbricht Programmlauf)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- Exam Self-Check Card -->
        <div class="panel-card exam-quiz-card">
            <div class="panel-header">
                <span class="panel-title">📝 Klausur-Selbsttest: Aufgabe 1 (BSIPCWeitereArten.tex)</span>
                <span class="exam-badge-score">Klausurrelevanz: Hoch (5 Punkte)</span>
            </div>
            <div class="quiz-body">
                <p class="quiz-question">
                    <em>„In der Vorlesung haben wir Signale, Pipes, Named Pipes, Message Queues und Socketverbindungen 
                    als Möglichkeiten der Interprozesskommunikation kennengelernt. Wenn man den Begriff weiter fasst, 
                    fallen aber noch einige weitere Möglichkeiten darunter. Nennen Sie mindestens zwei.“</em>
                </p>

                <div class="quiz-options-grid">
                    @foreach (var opt in QuizOptions)
                    {
                        <button class="quiz-opt-btn @(opt.IsSelected ? "selected" : "") @(ShowQuizSolution ? (opt.IsCorrect ? "correct-highlight" : "incorrect-highlight") : "")"
                                @onclick="() => ToggleQuizOption(opt)">
                            <span class="opt-checkbox">@(opt.IsSelected ? "☑" : "☐")</span>
                            <span class="opt-title">@opt.Title</span>
                            @if (ShowQuizSolution)
                            {
                                <span class="opt-verdict @(opt.IsCorrect ? "verdict-correct" : "verdict-wrong")">
                                    @(opt.IsCorrect ? "✓ Richtig" : "✗ Bereits genannt / kein IPC")
                                </span>
                            }
                        </button>
                    }
                </div>

                <div class="quiz-actions">
                    <button class="action-btn primary" @onclick="ToggleQuizSolution">
                        @(ShowQuizSolution ? "👁️ Lösung verbergen" : "💡 Lösung aufdecken & prüfen")
                    </button>
                    <button class="action-btn" @onclick="ResetQuiz">
                        🔄 Zurücksetzen
                    </button>
                    @if (ShowQuizSolution)
                    {
                        <div class="quiz-feedback-text">
                            <strong>Ergebnis:</strong> Sie haben @QuizScore von @QuizOptions.Count(o => o.IsCorrect) korrekten weiteren IPC-Mechanismen markiert.
                            (Erforderlich für volle Punktzahl: mindestens 2!).
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Terminal Console Output -->
        <div class="panel-card console-card">
            <div class="panel-header">
                <span class="panel-title">🖥️ System-Trace &amp; Protokollausgabe</span>
                <span class="console-hint">Protokolliert POSIX-Aufrufe und Zustandsänderungen</span>
            </div>
            <div class="console-body mono">
                @if (!ConsoleLines.Any())
                {
                    <span class="console-empty">Simulation bereit. Klicken Sie auf „Nächster Schritt“ oder „Auto-Play“...</span>
                }
                else
                {
                    @foreach (var line in ConsoleLines)
                    {
                        <div class="console-row @(line.IsError ? "console-error" : "")">
                            <span class="console-ts">[@line.StepNum]</span>
                            <span class="console-src tag-@line.Actor">@line.ActorName:</span>
                            <span class="console-msg">@line.Message</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- WORKSHEET VIEW (1:1 EXAM REPLICA MATCHING BSIPCWeitereArten.tex)         -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">
            
            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-group">
                    <span class="exam-sub">Grundlagen der Informatik</span>
                    <h1 class="exam-main-title">I P C @(ShowSolution ? "- Lösung" : "")</h1>
                    <span class="exam-task-label">Aufgabe 1 (Arten von Interprozesskommunikation)</span>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Fields -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 5 P.</div>
                </div>
            </div>

            <!-- Task Question matching BSIPCWeitereArten.tex -->
            <div class="task-prompt-box">
                <p class="task-text">
                    In der Vorlesung haben wir Signale, Pipes, Named Pipes, Message Queues und Socketverbindungen 
                    als Möglichkeiten der Interprozesskommunikation kennengelernt. Wenn man den Begriff weiter fasst 
                    fallen aber noch einige weitere Möglichkeiten darunter. Nennen Sie mindestens zwei.
                </p>
            </div>

            <!-- Answer Section -->
            @if (!ShowSolution)
            {
                <div class="ws-answer-lines">
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                    <div class="answer-line"></div>
                </div>
            }
            else
            {
                <div class="ws-solution-box">
                    <div class="sol-hdr bold">Musterlösung:</div>
