    private void ApplySimulationState()
    {
        if (CurrentStepIndex == 0)
        {
            CurrentBuffer = new List<char>();
            ReceivedText = "";
            TotalBytesWritten = 0;
            IsWriteEndOpen = true;
            IsReadEndOpen = true;
            WriterState = ProcState.Ready;
            ReaderState = ProcState.Ready;
            WriterCurrentCall = "idle";
            ReaderCurrentCall = "idle";
            IsSigpipeTriggered = false;
            IsEofReached = false;
            CurrentStepExplanation = "Bereit. Klicken Sie auf „Nächster Schritt“ oder „Auto-Play“.";
            ConsoleLines.Clear();
            return;
        }

        var step = ActiveSchedule[CurrentStepIndex - 1];
        CurrentBuffer = new List<char>(step.BufferContent);
        ReceivedText = step.ReceivedAccumulated;
        TotalBytesWritten = step.BytesWrittenTotal;
        IsWriteEndOpen = step.WriteEndOpen;
        IsReadEndOpen = step.ReadEndOpen;
        WriterState = step.WriterState;
        ReaderState = step.ReaderState;
        WriterCurrentCall = step.WriterCall;
        ReaderCurrentCall = step.ReaderCall;
        IsSigpipeTriggered = step.Sigpipe;
        IsEofReached = step.Eof;
        CurrentStepExplanation = step.Explanation;

        // Rebuild console output up to CurrentStepIndex
        ConsoleLines.Clear();
        for (int i = 0; i < CurrentStepIndex; i++)
        {
            var s = ActiveSchedule[i];
            if (!string.IsNullOrEmpty(s.ConsoleLog))
            {
                ConsoleLines.Add(new ConsoleLine
                {
                    StepNum = i + 1,
                    Actor = s.Actor,
                    ActorName = s.ActorName,
                    Message = s.ConsoleLog,
                    IsError = s.IsError
                });
            }
        }
    }

    public void StepForward()
    {
        if (CurrentStepIndex < ActiveSchedule.Count)
        {
            CurrentStepIndex++;
            ApplySimulationState();
        }
        else
        {
            StopAutoPlay();
        }
    }

    public void StepBack()
    {
        StopAutoPlay();
        if (CurrentStepIndex > 0)
        {
            CurrentStepIndex--;
            ApplySimulationState();
        }
    }

    public void GoToStart()
    {
        StopAutoPlay();
        CurrentStepIndex = 0;
        ApplySimulationState();
    }

    public void ResetSimulation()
    {
        LoadPreset(SelectedPreset);
    }

    public void ToggleAutoPlay()
    {
        if (IsPlaying)
        {
            StopAutoPlay();
        }
        else
        {
            StartAutoPlay();
        }
    }

    private void StartAutoPlay()
    {
        if (CurrentStepIndex >= ActiveSchedule.Count)
        {
            CurrentStepIndex = 0;
            ApplySimulationState();
        }

        IsPlaying = true;
        _playCts = new CancellationTokenSource();
        var token = _playCts.Token;

        _ = Task.Run(async () =>
        {
            while (IsPlaying && !token.IsCancellationRequested)
            {
                await Task.Delay(PlaySpeedMs, token);
                if (token.IsCancellationRequested) break;

                await InvokeAsync(() =>
                {
                    if (CurrentStepIndex < ActiveSchedule.Count)
                    {
                        StepForward();
                    }
                    else
                    {
                        StopAutoPlay();
                    }
                    StateHasChanged();
                });
            }
        }, token);
    }

    private void StopAutoPlay()
    {
        IsPlaying = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private string GetWriterStatusText()
    {
        return WriterState switch
        {
            ProcState.Ready => "Bereit",
            ProcState.Running => "Schreibt (aktiv)",
            ProcState.Blocked => "Blockiert (Puffer voll)",
            ProcState.Exited => "Beendet (close)",
            _ => "Bereit"
        };
    }

    private string GetWriterStatusClass()
    {
        return WriterState switch
        {
            ProcState.Ready => "state-ready",
            ProcState.Running => "state-running",
            ProcState.Blocked => "state-blocked",
            ProcState.Exited => "state-exited",
            _ => "state-ready"
        };
    }

    private string GetReaderStatusText()
    {
        return ReaderState switch
        {
            ProcState.Ready => "Bereit",
            ProcState.Running => "Liest (aktiv)",
            ProcState.Blocked => "Blockiert (Puffer leer)",
            ProcState.Exited => "Beendet (EOF)",
            _ => "Bereit"
        };
    }

    private string GetReaderStatusClass()
    {
        return ReaderState switch
        {
            ProcState.Ready => "state-ready",
            ProcState.Running => "state-running",
            ProcState.Blocked => "state-blocked",
            ProcState.Exited => "state-exited",
            _ => "state-ready"
        };
    }

    public void Dispose()
    {
        StopAutoPlay();
    }
}
