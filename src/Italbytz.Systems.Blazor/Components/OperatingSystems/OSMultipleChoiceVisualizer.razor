@namespace Italbytz.Systems.Blazor.Components.OperatingSystems
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="osmc-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Betriebssysteme &bull; Wissensprüfung &amp; Konzepte</p>
            <h2>Multiple-Choice Fragen (Wahr / Falsch)</h2>
            <p class="feature-intro">
                Überprüfen Sie Ihr konzeptionelles Verständnis der Kernmechanismen von Betriebssystemen:
                <strong>Paging &amp; MMU</strong>, <strong>Journaling-Dateisysteme</strong>, 
                <strong>Schedulingverfahren</strong>, <strong>Kernel-Architekturen</strong> 
                sowie <strong>Prozess-Synchronisation (Mutex &amp; Semaphoren)</strong>.
                Authentische Prüfungsfragen mit offizieller Klausur-Bewertungslogik (+1 Pkt richtig, &minus;1 Pkt falsch, min. 0 Pkte).
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.ExamSim ? "active" : "")"
                    @onclick="() => SetView(ViewMode.ExamSim)">
                📝 Klausur-Simulation (9 Zufallsfragen)
            </button>
            <button class="view-btn @(ActiveView == ViewMode.StudyCatalog ? "active" : "")"
                    @onclick="() => SetView(ViewMode.StudyCatalog)">
                📚 Vollständiger Fragenkatalog &amp; Lernmodus (17 Fragen)
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht 1:1)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- VIEW 1: EXAM SIMULATION (9 Random Questions with Official Scoring)       -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.ExamSim)
    {
        <div class="panel-card exam-sim-card">
            <div class="panel-header">
                <div class="exam-title-wrap">
                    <span class="panel-title">Klausur-Simulation: 9 Fragen zu Betriebssystemen</span>
                    <span class="exam-rule-tag">Regel: +1 Punkt für richtig, &minus;1 Punkt für falsch, Gesamtergebnis &ge; 0 Punkte</span>
                </div>
                <div class="header-actions no-print">
                    <button class="action-btn secondary" @onclick="GenerateNewExamSet">
                        🔄 Neue 9 Fragen ziehen
                    </button>
                    @if (!ExamEvaluated)
                    {
                        <button class="action-btn primary" @onclick="EvaluateExam">
                            ✅ Jetzt auswerten
                        </button>
                    }
                    else
                    {
                        <button class="action-btn accent" @onclick="ResetExamAnswers">
                            ✏️ Nochmals versuchen
                        </button>
                    }
                </div>
            </div>

            <!-- Score Banner (shown when evaluated) -->
            @if (ExamEvaluated)
            {
                <div class="score-banner @(CalculatedScore >= 5 ? "score-pass" : "score-fail")">
                    <div class="score-icon">@(CalculatedScore >= 5 ? "🏆" : "⚠️")</div>
                    <div class="score-details">
                        <div class="score-main-line">
                            <strong>Ergebnis: @CalculatedScore von 9 Punkten</strong>
                            <span class="score-percent">(@((CalculatedScore * 100) / 9)%) &bull; @(CalculatedScore >= 5 ? "Bestanden" : "Nicht bestanden (mind. 5 P. empfohlen)")</span>
                        </div>
                        <div class="score-breakdown">
                            <span class="tag-correct">✅ @CountCorrect Richtig (+@CountCorrect P.)</span>
                            <span class="tag-incorrect">❌ @CountIncorrect Falsch (&minus;@CountIncorrect P.)</span>
                            <span class="tag-unanswered">⚪ @CountUnanswered Unbeantwortet (0 P.)</span>
                            <span class="tag-min-note">Min-Cap: 0 Pkt. wirksam: @(RawScore < 0 ? "Ja (Rohpunkte: " + RawScore + ")" : "Nein")</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Questions Table -->
            <div class="table-responsive">
                <table class="mc-table">
                    <thead>
                        <tr>
                            <th class="col-nr">#</th>
                            <th class="col-question">Frage / Aussage</th>
                            <th class="col-choice">Wahr</th>
                            <th class="col-choice">Falsch</th>
                            @if (ExamEvaluated)
                            {
                                <th class="col-eval">Bewertung</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < CurrentExamQuestions.Count; i++)
                        {
                            var index = i;
                            var q = CurrentExamQuestions[index];
                            var userAns = UserAnswers.ContainsKey(q.Id) ? UserAnswers[q.Id] : (bool?)null;
                            var isCorrect = userAns.HasValue && userAns.Value == q.CorrectAnswer;
                            var isWrong = userAns.HasValue && userAns.Value != q.CorrectAnswer;

                            <tr class="@(index % 2 == 0 ? "row-even" : "row-odd") @(ExamEvaluated ? (isCorrect ? "row-correct" : (isWrong ? "row-wrong" : "row-empty")) : "")">
                                <td class="col-nr bold">@(index + 1)</td>
                                <td class="col-question">
                                    <div class="q-text">@q.Text</div>
                                    @if (ExamEvaluated)
                                    {
                                        <div class="q-explanation">
                                            <strong>Erklärung:</strong> @q.Explanation
                                        </div>
                                    }
                                </td>
                                <td class="col-choice">
                                    <label class="choice-label @(userAns == true ? "selected" : "")">
                                        <input type="radio" name="sim_q_@q.Id" 
                                               checked="@(userAns == true)" 
                                               disabled="@ExamEvaluated"
                                               @onchange="() => SetUserAnswer(q.Id, true)" />
                                        <span class="choice-box"></span>
                                    </label>
                                </td>
                                <td class="col-choice">
                                    <label class="choice-label @(userAns == false ? "selected" : "")">
                                        <input type="radio" name="sim_q_@q.Id" 
                                               checked="@(userAns == false)" 
                                               disabled="@ExamEvaluated"
                                               @onchange="() => SetUserAnswer(q.Id, false)" />
                                        <span class="choice-box"></span>
                                    </label>
                                </td>
                                @if (ExamEvaluated)
                                {
                                    <td class="col-eval">
                                        @if (userAns == null)
                                        {
                                            <span class="eval-pill pill-empty">0 P. (offen)</span>
                                        }
                                        else if (isCorrect)
                                        {
                                            <span class="eval-pill pill-correct">+1 P. (Richtig)</span>
                                        }
                                        else
                                        {
                                            <span class="eval-pill pill-wrong">&minus;1 P. (Falsch)</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!ExamEvaluated)
            {
                <div class="exam-submit-bar no-print">
                    <span class="unanswered-hint">
                        @CountAnswered von @CurrentExamQuestions.Count Fragen beantwortet.
                    </span>
                    <button class="action-btn primary large" @onclick="EvaluateExam">
                        ✅ Klausur abgeben &amp; Punktzahl berechnen
                    </button>
                </div>
            }
        </div>
    }

    <!-- ========================================================================= -->
    <!-- VIEW 2: STUDY CATALOG & FLASHCARD TRAINER (All 17 Questions)             -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.StudyCatalog)
    {
        <div class="panel-card catalog-card">
            <div class="panel-header">
                <div class="exam-title-wrap">
                    <span class="panel-title">Vollständiger Fragenkatalog aller 17 Prüfungsfragen</span>
                    <span class="exam-rule-tag">Didaktisch aufbereitet mit detaillierten Begründungen</span>
                </div>
                <div class="header-actions no-print">
                    <button class="action-btn secondary" @onclick="ToggleAllExplanations">
                        @(ShowAllExplanations ? "🙈 Erklärungen einklappen" : "💡 Alle Erklärungen aufdecken")
                    </button>
                </div>
            </div>

            <!-- Category Filter Pills -->
            <div class="filter-strip no-print">
                <span class="filter-label">Themenbereich:</span>
                <button class="filter-pill @(SelectedCategory == "All" ? "active" : "")" 
                        @onclick='() => FilterCategory("All")'>
                    Alle (@AllQuestions.Count)
                </button>
                <button class="filter-pill @(SelectedCategory == "Memory" ? "active" : "")" 
                        @onclick='() => FilterCategory("Memory")'>
                    💾 Speicher &amp; Paging (4)
                </button>
                <button class="filter-pill @(SelectedCategory == "FileSystem" ? "active" : "")" 
                        @onclick='() => FilterCategory("FileSystem")'>
                    📁 Dateisysteme &amp; Journaling (5)
                </button>
                <button class="filter-pill @(SelectedCategory == "Scheduling" ? "active" : "")" 
                        @onclick='() => FilterCategory("Scheduling")'>
                    ⏱️ Schedulingverfahren (4)
                </button>
                <button class="filter-pill @(SelectedCategory == "Kernel" ? "active" : "")" 
                        @onclick='() => FilterCategory("Kernel")'>
                    ⚙️ Kernel-Architekturen (2)
                </button>
                <button class="filter-pill @(SelectedCategory == "Sync" ? "active" : "")" 
                        @onclick='() => FilterCategory("Sync")'>
                    🔒 Synchronisation (2)
                </button>
            </div>

            <!-- Catalog Questions List -->
            <div class="catalog-list">
                @foreach (var q in FilteredQuestions)
                {
                    var isExpanded = ShowAllExplanations || ExpandedQuestionIds.Contains(q.Id);
                    <div class="catalog-item @(q.CorrectAnswer ? "ans-true" : "ans-false")">
                        <div class="catalog-item-header" @onclick="() => ToggleQuestionExplanation(q.Id)">
                            <div class="item-title-group">
                                <span class="item-badge-cat">@q.CategoryLabel</span>
                                <p class="item-text">@q.Text</p>
                            </div>
                            <div class="item-answer-tag @(q.CorrectAnswer ? "tag-true" : "tag-false")">
                                @(q.CorrectAnswer ? "WAHR" : "FALSCH")
                            </div>
                            <button class="item-toggle-btn">
                                @(isExpanded ? "▲" : "▼")
                            </button>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="catalog-item-body">
                                <div class="explanation-box">
                                    <strong>Fachliche Begründung:</strong>
                                    <span>@q.Explanation</span>
                                </div>
                                @if (!string.IsNullOrEmpty(q.AlternativeText))
                                {
                                    <div class="alt-question-box">
                                        <span class="alt-label">Typische Alternativ-Frage in der Klausur:</span>
                                        <p class="alt-text">„@q.AlternativeText“ &rarr; <strong class="@(q.AlternativeAnswer ? "text-green" : "text-amber")">@(q.AlternativeAnswer ? "WAHR" : "FALSCH")</strong></p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- VIEW 3: WORKSHEET VIEW (1:1 LaTeX / XeLaTeX Replica)                     -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">
            
            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-group">
                    <span class="exam-sub">Grundlagen der Informatik</span>
                    <h1 class="exam-main-title">O S Multiple Choice @(ShowSolution ? "- Lösung" : "")</h1>
                    <span class="exam-task-label">Aufgabe 1 (Multiple Choice)</span>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Fields -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 9 P.</div>
                </div>
            </div>

            <!-- Task Prompt matching OSMultipleChoiceTask.tex -->
            <div class="task-prompt-box">
                <p class="task-text">
                    Im Folgenden finden Sie einige Multiple Choice Fragen. Jede richtig beantwortete Frage gibt einen Punkt, jede falsch beantwortete Frage gibt einen Minuspunkt. Die Gesamtaufgabe gibt allerdings mindestens Null Punkte.
                </p>
            </div>

            <!-- Alternating Striped Table matching \rowcolors[]{1}{black!10}{white} -->
            <div class="ws-table-container">
                <table class="ws-table">
                    <thead>
                        <tr>
                            <th class="ws-col-q">Frage</th>
                            <th class="ws-col-ans">wahr</th>
                            <th class="ws-col-ans">falsch</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < WorksheetQuestions.Count; i++)
                        {
                            var index = i;
                            var q = WorksheetQuestions[index];
                            <tr class="@(index % 2 == 0 ? "ws-row-even" : "ws-row-odd")">
                                <td class="ws-col-q">@q.Text</td>
                                <td class="ws-col-ans">
                                    <div class="ws-checkbox @(ShowSolution && q.CorrectAnswer ? "ws-checked" : "")">
                                        @if (ShowSolution && q.CorrectAnswer)
                                        {
                                            <span>&#10003;</span>
                                        }
                                    </div>
                                </td>
                                <td class="ws-col-ans">
                                    <div class="ws-checkbox @(ShowSolution && !q.CorrectAnswer ? "ws-checked" : "")">
                                        @if (ShowSolution && !q.CorrectAnswer)
                                        {
                                            <span>&#10003;</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer for Worksheet -->
            <div class="worksheet-footer">
                <span>Intelligent Systems Design &bull; Hochschule Hamm-Lippstadt &bull; Betriebssysteme</span>
            </div>
        </div>
    }

</article>

@code {
    [Parameter]
    public bool IsEmbed { get; set; } = false;

    public enum ViewMode
    {
        ExamSim,
        StudyCatalog,
        Worksheet
    }

    private ViewMode ActiveView { get; set; } = ViewMode.ExamSim;
    private bool ShowSolution { get; set; } = false;
    private bool ExamEvaluated { get; set; } = false;
    private bool ShowAllExplanations { get; set; } = false;
    private string SelectedCategory { get; set; } = "All";

    private HashSet<int> ExpandedQuestionIds { get; } = new();
    private Dictionary<int, bool> UserAnswers { get; } = new();

    public class QuestionModel
    {
        public int Id { get; set; }
        public string Text { get; set; } = string.Empty;
        public bool CorrectAnswer { get; set; }
        public string Category { get; set; } = string.Empty;
        public string CategoryLabel { get; set; } = string.Empty;
        public string Explanation { get; set; } = string.Empty;
        public string AlternativeText { get; set; } = string.Empty;
        public bool AlternativeAnswer { get; set; }
    }

    private List<QuestionModel> AllQuestions { get; set; } = new();
    private List<QuestionModel> CurrentExamQuestions { get; set; } = new();
    private List<QuestionModel> WorksheetQuestions { get; set; } = new();

    protected override void OnInitialized()
    {
        InitializeQuestionsCatalog();
        CheckUrlParameters();
        GenerateNewExamSet();
        InitializeWorksheetFixedQuestions();
    }

    protected override void OnParametersSet()
    {
        CheckUrlParameters();
    }

    private void CheckUrlParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query.ToLowerInvariant();

            if (query.Contains("embed=true") || query.Contains("embedded=true") || query.Contains("embed=1"))
            {
                IsEmbed = true;
            }

            if (query.Contains("view=worksheet") || query.Contains("view=sheet"))
            {
                ActiveView = ViewMode.Worksheet;
            }

            if (query.Contains("solution=true") || query.Contains("solution=1") || query.Contains("lsg=true"))
            {
                ShowSolution = true;
            }
        }
        catch
        {
            // Fallback to default
        }
    }

    private void InitializeQuestionsCatalog()
    {
        AllQuestions = new List<QuestionModel>
        {
            // 1. Paging & Memory (4 questions)
            new QuestionModel
            {
                Id = 1,
                Category = "Memory",
                CategoryLabel = "Speicher & Paging",
                Text = "Die MMU übersetzt beim Paging logische Speicheradressen mit der Seitentabelle in physische Adressen.",
                CorrectAnswer = true,
                Explanation = "Richtig. Die Memory Management Unit (MMU) ist die Hardware-Einheit, die logische Adressen der CPU anhand der Einträge der Seitentabelle in reale physische RAM-Adressen umsetzt."
            },
            new QuestionModel
            {
                Id = 2,
                Category = "Memory",
                CategoryLabel = "Speicher & Paging",
                Text = "Beim Paging haben alle Seiten die gleiche Länge.",
                CorrectAnswer = true,
                Explanation = "Richtig. Im Gegensatz zur Segmentierung mit variablen Blockgrößen ist der logische Adressraum beim Paging in Seiten (Pages) fester, stets identischer Größe (z. B. 4 KB) unterteilt."
            },
            new QuestionModel
            {
                Id = 3,
                Category = "Memory",
                CategoryLabel = "Speicher & Paging",
                Text = "Ein Nachteil kurzer Seiten beim Paging ist, dass die Seitentabelle sehr groß werden kann.",
                CorrectAnswer = true,
                Explanation = "Richtig. Kleinere Seitengrößen erfordern mehr Seiten, um denselben Adressraum abzudecken. Dadurch steigt die Zeilenanzahl und somit der Speicherbedarf der Seitentabelle drastisch an."
            },
            new QuestionModel
            {
                Id = 16,
                Category = "Memory",
                CategoryLabel = "Speicher & Paging",
                Text = "Eine Vergrößerung des Speichers kann in manchen Ersetzungsstrategien zu mehr Seitenfehlern führen.",
                CorrectAnswer = true,
                Explanation = "Richtig. Dies ist als Bélády-Anomalie bekannt. Bei Ersetzungsstrategien ohne Stack-Eigenschaft (z. B. standardmäßiges FIFO) können bei mehr physikalischen Seitenrahmen mehr Seitenfehler auftreten."
            },

            // 2. File Systems & Storage (5 questions)
            new QuestionModel
            {
                Id = 4,
                Category = "FileSystem",
                CategoryLabel = "Dateisysteme",
                Text = "Journaling-Dateisysteme grenzen die bei der Konsistenzprüfung zu überprüfenden Daten ein.",
                CorrectAnswer = true,
                Explanation = "Richtig. Nach einem Systemabsturz muss nicht das gesamte Dateisystem blockweise durchsucht werden (wie bei fsck). Es genügt die Prüfung des ringförmigen Journals auf nicht abgeschlossene Transaktionen."
            },
            new QuestionModel
            {
                Id = 5,
                Category = "FileSystem",
                CategoryLabel = "Dateisysteme",
                Text = "Bei Dateisystemen mit Journal sind Datenverluste garantiert ausgeschlossen.",
                CorrectAnswer = false,
                Explanation = "Falsch. Journaling garantiert die Integrität der Dateisystem-Struktur (Metadaten-Konsistenz). Dateiinhalte im Cache, die noch nicht geflusht wurden, können bei plötzlichem Stromausfall dennoch verloren gehen."
            },
            new QuestionModel
            {
                Id = 6,
                Category = "FileSystem",
                CategoryLabel = "Dateisysteme",
                Text = "Ein Journal im Dateisystem reduziert die Anzahl der Schreibzugriffe.",
                CorrectAnswer = false,
                Explanation = "Falsch. Ein Journal erhöht die Schreibzugriffe, da Metadaten und Transaktionsschritte zunächst in das Journal und anschließend an ihre endgültige Position geschrieben werden (doppeltes Schreiben)."
            },
            new QuestionModel
            {
                Id = 7,
                Category = "FileSystem",
                CategoryLabel = "Dateisysteme",
                Text = "Der Zugriff auf Festplatten erfolgt blockorientiert und kann wahlfrei geschehen.",
                CorrectAnswer = true,
                Explanation = "Richtig. Massenspeicher (HDD/SSD) sind Blockgeräte, die Daten in Sektoren/Blöcken (z. B. 512 B oder 4 KB) organisieren und wahlfreien Zugriff über Logical Block Addressing (LBA) erlauben."
            },
            new QuestionModel
            {
                Id = 15,
                Category = "FileSystem",
                CategoryLabel = "Dateisysteme",
                Text = "Defragmentieren ist auch bei SSDs nötig.",
                CorrectAnswer = false,
                Explanation = "Falsch. SSDs besitzen keine beweglichen Schreib-/Leseköpfe; die Zugriffszeit auf alle Speicherzellen ist annähernd identisch. Defragmentieren erzeugt nur schädliche zusätzliche Schreibzyklen (Flash-Verschleiß)."
            },

            // 3. Scheduling (4 questions)
            new QuestionModel
            {
                Id = 8,
                Category = "Scheduling",
                CategoryLabel = "Scheduling",
                Text = "Round Robin kann als faires Schedulingverfahren bezeichnet werden.",
                CorrectAnswer = true,
                Explanation = "Richtig. Alle rechenbereiten Prozesse erhalten zyklisch und gleichberechtigt feste Zeitscheiben (Time Slices). Kein Prozess wird systematisch bevorzugt oder verhungert.",
                AlternativeText = "Prioritätengesteuertes Scheduling kann als faires Schedulingverfahren bezeichnet werden.",
                AlternativeAnswer = false
            },
            new QuestionModel
            {
                Id = 9,
                Category = "Scheduling",
                CategoryLabel = "Scheduling",
                Text = "Mit Prioritätengesteuertem Scheduling lässt sich die geringste Gesamtlaufzeit für Aufgaben erreichen.",
                CorrectAnswer = false,
                Explanation = "Falsch. Prioritätengesteuertes Scheduling steuert die Dringlichkeit, optimiert aber nicht die mittlere oder gesamte Laufzeit. Niedrig priorisierte Prozesse können sogar verhungern (Starvation).",
                AlternativeText = "Mit Stapelbetrieb lässt sich die geringste Gesamtlaufzeit für Aufgaben erreichen.",
                AlternativeAnswer = true
            },
            new QuestionModel
            {
                Id = 10,
                Category = "Scheduling",
                CategoryLabel = "Scheduling",
                Text = "Shortest Job First ist ein in der Praxis eingesetztes Schedulingverfahren.",
                CorrectAnswer = false,
                Explanation = "Falsch. In allgemeinen interaktiven Systemen ist die exakte Ausführungszeit zukünftiger CPU-Bursts vorab nicht bekannt, weshalb SJF nur mit Schätzungen oder in Batchsystemen nutzbar ist."
            },
            new QuestionModel
            {
                Id = 11,
                Category = "Scheduling",
                CategoryLabel = "Scheduling",
                Text = "Shortest Job First garantiert die geringste durchschnittliche Laufzeit.",
                CorrectAnswer = true,
                Explanation = "Richtig. Wenn alle Prozesse gleichzeitig eintreffen, ist mathematisch bewiesen, dass SJF die minimale mittlere Warte- und Durchlaufzeit unter allen nicht-unterbrechenden Algorithmen liefert."
            },

            // 4. Kernel Architectures (2 questions)
            new QuestionModel
            {
                Id = 12,
                Category = "Kernel",
                CategoryLabel = "Kernel-Architektur",
                Text = "Monolithische Betriebssystemkerne sind leichter zu erweitern und zu warten.",
                CorrectAnswer = false,
                Explanation = "Falsch. Monolithen führen alle Dienste (VFS, IPC, Treiber) im privilegierten Kernel-Adressraum aus. Ein Fehler in einem Modul kann das Gesamtsystem zum Absturz bringen. Mikrokerne bieten bessere Isolation und Wartbarkeit."
            },
            new QuestionModel
            {
                Id = 13,
                Category = "Kernel",
                CategoryLabel = "Kernel-Architektur",
                Text = "Mikrokernel führen zu einem langsameren Betriebssystem.",
                CorrectAnswer = true,
                Explanation = "Richtig. Da Dateisysteme, Treiber und Netzwerkstacks als Userspace-Server laufen, erfordert jede Systeminteraktion IPC-Nachrichten und aufwendige Kontextwechsel zwischen User- und Kernelmode."
            },

            // 5. Synchronization (2 questions)
            new QuestionModel
            {
                Id = 14,
                Category = "Sync",
                CategoryLabel = "Synchronisation",
                Text = "Aktives Warten vor dem Betreten eines kritischen Abschnitts verschwendet Rechenzeit.",
                CorrectAnswer = true,
                Explanation = "Richtig. Bei Spinlocks rotiert die CPU in einer Abfrageschleife (Busy Waiting), anstatt den Thread in den Zustand Blocked zu versetzen und die Rechenzeit anderen Prozessen zur Verfügung zu stellen."
            },
            new QuestionModel
            {
                Id = 17,
                Category = "Sync",
                CategoryLabel = "Synchronisation",
                Text = "Die Funktion eines Mutex lässt sich auch mit Semaphoren erreichen.",
                CorrectAnswer = true,
                Explanation = "Richtig. Eine binäre Semaphore mit Initialwert 1 bildet exakt den wechselseitigen Ausschluss (Mutual Exclusion) ab.",
                AlternativeText = "Die Funktion einer Semaphore lässt sich auch mit einem Mutex erreichen.",
                AlternativeAnswer = false
            }
        };
    }

    private void InitializeWorksheetFixedQuestions()
    {
        // 9 representative questions matching the default XeLaTeX export
        WorksheetQuestions = new List<QuestionModel>
        {
            AllQuestions.First(q => q.Id == 12), // Monolithische Kerne...
            AllQuestions.First(q => q.Id == 16), // Bélády-Anomalie...
            AllQuestions.First(q => q.Id == 8),  // Round Robin...
            AllQuestions.First(q => q.Id == 13), // Mikrokernel...
            AllQuestions.First(q => q.Id == 14), // Aktives Warten...
            AllQuestions.First(q => q.Id == 4),  // Journaling grenzt ein...
            AllQuestions.First(q => q.Id == 7),  // Festplatten blockorientiert...
            AllQuestions.First(q => q.Id == 1),  // MMU übersetzt...
            AllQuestions.First(q => q.Id == 5)   // Datenverluste garantiert ausgeschlossen...
        };
    }

    private void GenerateNewExamSet()
    {
        var rnd = new Random();
        CurrentExamQuestions = AllQuestions.OrderBy(_ => rnd.Next()).Take(9).ToList();
        UserAnswers.Clear();
        ExamEvaluated = false;
    }

    private void SetUserAnswer(int questionId, bool answer)
    {
        if (ExamEvaluated) return;
        UserAnswers[questionId] = answer;
    }

    private void EvaluateExam()
    {
        ExamEvaluated = true;
    }

    private void ResetExamAnswers()
    {
        UserAnswers.Clear();
        ExamEvaluated = false;
    }

    private int CountCorrect => CurrentExamQuestions.Count(q => UserAnswers.ContainsKey(q.Id) && UserAnswers[q.Id] == q.CorrectAnswer);
    private int CountIncorrect => CurrentExamQuestions.Count(q => UserAnswers.ContainsKey(q.Id) && UserAnswers[q.Id] != q.CorrectAnswer);
    private int CountUnanswered => CurrentExamQuestions.Count(q => !UserAnswers.ContainsKey(q.Id));
    private int CountAnswered => UserAnswers.Count;

    private int RawScore => CountCorrect - CountIncorrect;
    private int CalculatedScore => Math.Max(0, RawScore);

    private IEnumerable<QuestionModel> FilteredQuestions
    {
        get
        {
            if (SelectedCategory == "All") return AllQuestions;
            return AllQuestions.Where(q => q.Category == SelectedCategory);
        }
    }

    private void FilterCategory(string cat)
    {
        SelectedCategory = cat;
    }

    private void ToggleQuestionExplanation(int id)
    {
        if (ExpandedQuestionIds.Contains(id))
            ExpandedQuestionIds.Remove(id);
        else
            ExpandedQuestionIds.Add(id);
    }

    private void ToggleAllExplanations()
    {
        ShowAllExplanations = !ShowAllExplanations;
        if (ShowAllExplanations)
        {
            foreach (var q in AllQuestions)
                ExpandedQuestionIds.Add(q.Id);
        }
        else
        {
            ExpandedQuestionIds.Clear();
        }
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
