    protected override void OnInitialized()
    {
        CheckUrlParameters();
    }

    protected override void OnParametersSet()
    {
        CheckUrlParameters();
    }

    private void CheckUrlParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query.ToLowerInvariant();

            if (query.Contains("embed=true") || query.Contains("embedded=true") || query.Contains("embed=1"))
            {
                IsEmbed = true;
            }

            if (query.Contains("view=worksheet") || query.Contains("view=sheet"))
            {
                ActiveView = ViewMode.Worksheet;
            }
            else if (query.Contains("view=pinout") || query.Contains("view=t568"))
            {
                ActiveView = ViewMode.Pinout;
            }
            else if (query.Contains("view=trainer"))
            {
                ActiveView = ViewMode.Trainer;
            }

            if (query.Contains("solution=true") || query.Contains("sol=true") || query.Contains("loesung=true"))
            {
                ShowSolution = true;
            }
        }
        catch
        {
            // Fallback to default state
        }
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void SetStandard(CablingStandard standard)
    {
        SelectedStandard = standard;
    }

    private void ToggleBit(int index)
    {
        Bits[index] = Bits[index] == 1 ? 0 : 1;
    }

    private void SetBits(string bitPattern)
    {
        for (int i = 0; i < Bits.Length && i < bitPattern.Length; i++)
        {
            Bits[i] = bitPattern[i] == '1' ? 1 : 0;
        }
    }

    private void OnNoiseSliderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            NoiseLevel = val;
        }
    }

    private void InjectNoiseSpike()
    {
        HasNoiseSpike = !HasNoiseSpike;
    }

    private void ResetNoise()
    {
        NoiseLevel = 0.0;
        HasNoiseSpike = false;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private void ToggleTrainerSolution()
    {
        ShowTrainerSolution = !ShowTrainerSolution;
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    // Path generation helpers for waveforms
    private string GetOriginalSignalPath(double highY, double lowY)
    {
        var sb = new System.Text.StringBuilder();
        double startX = 90;
        double currentY = Bits[0] == 1 ? highY : lowY;
        sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {startX:F1} {currentY:F1}");

        for (int i = 0; i < Bits.Length; i++)
        {
            double nextX = startX + (i + 1) * BitWidth;
            double targetY = Bits[i] == 1 ? highY : lowY;

            if (System.Math.Abs(currentY - targetY) > 0.1)
            {
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {startX + i * BitWidth:F1} {targetY:F1}");
                currentY = targetY;
            }
            sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {nextX:F1} {currentY:F1}");
        }
        return sb.ToString();
    }

    private string GetInvertedSignalPath(double highY, double lowY)
    {
        var sb = new System.Text.StringBuilder();
        double startX = 90;
        double currentY = Bits[0] == 1 ? lowY : highY; // Inverted!
        sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {startX:F1} {currentY:F1}");

        for (int i = 0; i < Bits.Length; i++)
        {
            double nextX = startX + (i + 1) * BitWidth;
            double targetY = Bits[i] == 1 ? lowY : highY;

            if (System.Math.Abs(currentY - targetY) > 0.1)
            {
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {startX + i * BitWidth:F1} {targetY:F1}");
                currentY = targetY;
            }
            sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {nextX:F1} {currentY:F1}");
        }
        return sb.ToString();
    }

    private string GetNoisySignalPath(double highY, double lowY, bool isOriginal)
    {
        var sb = new System.Text.StringBuilder();
        double startX = 90;
        int steps = 160;
        double totalWidth = Bits.Length * BitWidth;
        double stepWidth = totalWidth / steps;

        for (int s = 0; s <= steps; s++)
        {
            double currentX = startX + s * stepWidth;
            int bitIdx = (int)((currentX - startX) / BitWidth);
            if (bitIdx >= Bits.Length) bitIdx = Bits.Length - 1;

            bool bitVal = Bits[bitIdx] == 1;
            double baseY = isOriginal ? (bitVal ? highY : lowY) : (bitVal ? lowY : highY);

            // Calculate noise
            double noise = 0;
            if (NoiseLevel > 0)
            {
                // Pseudo-random deterministic noise wave
                noise = System.Math.Sin(s * 0.85) * (NoiseLevel * 10) + System.Math.Cos(s * 1.7) * (NoiseLevel * 6);
            }

            // Noise spike at bit 3 (x around 90 + 3.5 * BitWidth)
            if (HasNoiseSpike && bitIdx == 3)
            {
                double spikeCenter = startX + 3.5 * BitWidth;
                double dist = System.Math.Abs(currentX - spikeCenter);
                if (dist < 25)
                {
                    double spikeFactor = (25 - dist) / 25.0;
                    noise -= spikeFactor * 18.0; // Inverted Y-axis in SVG: -18 pixels = +3 Volts upward spike
                }
            }

            double y = baseY + noise;
            if (s == 0)
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {currentX:F1} {y:F1}");
            else
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {currentX:F1} {y:F1}");
        }

        return sb.ToString();
    }

    private string GetDifferenceSignalPath(double pos5Y, double zeroY, double neg5Y)
    {
        var sb = new System.Text.StringBuilder();
        double startX = 90;
        double currentY = Bits[0] == 1 ? pos5Y : neg5Y;
        sb.Append(System.Globalization.CultureInfo.InvariantCulture, $"M {startX:F1} {currentY:F1}");

        for (int i = 0; i < Bits.Length; i++)
        {
            double nextX = startX + (i + 1) * BitWidth;
            // Diff = S+ - S-. Bit 1: 5V - 0V = +5V (pos5Y). Bit 0: 0V - 5V = -5V (neg5Y).
            double targetY = Bits[i] == 1 ? pos5Y : neg5Y;

            if (System.Math.Abs(currentY - targetY) > 0.1)
            {
                sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {startX + i * BitWidth:F1} {targetY:F1}");
                currentY = targetY;
            }
            sb.Append(System.Globalization.CultureInfo.InvariantCulture, $" L {nextX:F1} {currentY:F1}");
        }
        return sb.ToString();
    }

    private string GetReconstructedSignalPath(double highY, double lowY)
    {
        return GetOriginalSignalPath(highY, lowY);
    }
}
