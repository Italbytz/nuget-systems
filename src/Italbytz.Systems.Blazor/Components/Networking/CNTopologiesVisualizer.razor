    private void SelectTopology(string topoId)
    {
        SelectedTopoId = topoId;
        ResetSimulation();
        LoadTopologyGraph(topoId);
    }

    private void LoadTopologyGraph(string topoId)
    {
        CurrentNodes.Clear();
        CurrentLinks.Clear();

        switch (topoId)
        {
            case "bus":
                // 5 Nodes along a horizontal bus line
                CurrentNodes.Add(new NodeModel { Id = "b1", Label = "A", Sublabel = "Knoten 1", X = 80, Y = 100 });
                CurrentNodes.Add(new NodeModel { Id = "b2", Label = "B", Sublabel = "Knoten 2", X = 160, Y = 100 });
                CurrentNodes.Add(new NodeModel { Id = "b3", Label = "C", Sublabel = "Knoten 3", X = 250, Y = 100 });
                CurrentNodes.Add(new NodeModel { Id = "b4", Label = "D", Sublabel = "Knoten 4", X = 340, Y = 100 });
                CurrentNodes.Add(new NodeModel { Id = "b5", Label = "E", Sublabel = "Knoten 5", X = 420, Y = 100 });

                // Main Bus Backbone Segments
                CurrentLinks.Add(new LinkModel { Id = "l1", X1 = 40, Y1 = 180, X2 = 160, Y2 = 180, IsCritical = true });
                CurrentLinks.Add(new LinkModel { Id = "l2", X1 = 160, Y1 = 180, X2 = 250, Y2 = 180, IsCritical = true });
                CurrentLinks.Add(new LinkModel { Id = "l3", X1 = 250, Y1 = 180, X2 = 340, Y2 = 180, IsCritical = true });
                CurrentLinks.Add(new LinkModel { Id = "l4", X1 = 340, Y1 = 180, X2 = 460, Y2 = 180, IsCritical = true });

                // Drop Cables
                CurrentLinks.Add(new LinkModel { Id = "d1", X1 = 80, Y1 = 116, X2 = 80, Y2 = 180, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "d2", X1 = 160, Y1 = 116, X2 = 160, Y2 = 180, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "d3", X1 = 250, Y1 = 116, X2 = 250, Y2 = 180, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "d4", X1 = 340, Y1 = 116, X2 = 340, Y2 = 180, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "d5", X1 = 420, Y1 = 116, X2 = 420, Y2 = 180, IsCritical = false });
                break;

            case "ring":
                // 5 Nodes in a circle
                double cx = 250, cy = 150, r = 100;
                string[] labels = { "A", "B", "C", "D", "E" };
                for (int i = 0; i < 5; i++)
                {
                    double angle = (i * 72 - 90) * Math.PI / 180.0;
                    double nx = Math.Round(cx + r * Math.Cos(angle));
                    double ny = Math.Round(cy + r * Math.Sin(angle));
                    CurrentNodes.Add(new NodeModel { Id = $"r{i + 1}", Label = labels[i], Sublabel = $"Knoten {i + 1}", X = nx, Y = ny });
                }
                for (int i = 0; i < 5; i++)
                {
                    int next = (i + 1) % 5;
                    CurrentLinks.Add(new LinkModel
                    {
                        Id = $"rl{i + 1}",
                        X1 = CurrentNodes[i].X,
                        Y1 = CurrentNodes[i].Y,
                        X2 = CurrentNodes[next].X,
                        Y2 = CurrentNodes[next].Y,
                        IsCritical = true
                    });
                }
                break;

            case "star":
                // Central Switch
                CurrentNodes.Add(new NodeModel { Id = "s_center", Label = "SW", Sublabel = "Switch (SPOF)", X = 250, Y = 150, IsCentral = true });
                // 5 Perimeter nodes
                for (int i = 0; i < 5; i++)
                {
                    double angle = (i * 72 - 90) * Math.PI / 180.0;
                    double nx = Math.Round(250 + 110 * Math.Cos(angle));
                    double ny = Math.Round(150 + 110 * Math.Sin(angle));
                    CurrentNodes.Add(new NodeModel { Id = $"s{i + 1}", Label = $"PC{i + 1}", Sublabel = $"Host {i + 1}", X = nx, Y = ny });
                    CurrentLinks.Add(new LinkModel
                    {
                        Id = $"sl{i + 1}",
                        X1 = 250,
                        Y1 = 150,
                        X2 = nx,
                        Y2 = ny,
                        IsCritical = false
                    });
                }
                break;

            case "tree":
                // Root
                CurrentNodes.Add(new NodeModel { Id = "t_root", Label = "Root", Sublabel = "Core Switch", X = 250, Y = 60, IsCentral = true });
                // Layer 1
                CurrentNodes.Add(new NodeModel { Id = "t_d1", Label = "Dist 1", Sublabel = "Verteiler 1", X = 150, Y = 150, IsCentral = true });
                CurrentNodes.Add(new NodeModel { Id = "t_d2", Label = "Dist 2", Sublabel = "Verteiler 2", X = 350, Y = 150, IsCentral = true });
                CurrentLinks.Add(new LinkModel { Id = "tl_r1", X1 = 250, Y1 = 60, X2 = 150, Y2 = 150, IsCritical = true });
                CurrentLinks.Add(new LinkModel { Id = "tl_r2", X1 = 250, Y1 = 60, X2 = 350, Y2 = 150, IsCritical = true });

                // Leaves
                CurrentNodes.Add(new NodeModel { Id = "t_l1", Label = "PC 1", Sublabel = "Host", X = 100, Y = 240 });
                CurrentNodes.Add(new NodeModel { Id = "t_l2", Label = "PC 2", Sublabel = "Host", X = 200, Y = 240 });
                CurrentNodes.Add(new NodeModel { Id = "t_l3", Label = "PC 3", Sublabel = "Host", X = 300, Y = 240 });
                CurrentNodes.Add(new NodeModel { Id = "t_l4", Label = "PC 4", Sublabel = "Host", X = 400, Y = 240 });

                CurrentLinks.Add(new LinkModel { Id = "tl_d11", X1 = 150, Y1 = 150, X2 = 100, Y2 = 240, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "tl_d12", X1 = 150, Y1 = 150, X2 = 200, Y2 = 240, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "tl_d21", X1 = 350, Y1 = 150, X2 = 300, Y2 = 240, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "tl_d22", X1 = 350, Y1 = 150, X2 = 400, Y2 = 240, IsCritical = false });
                break;

            case "fullmesh":
                // 4 Nodes with all N*(N-1)/2 = 6 links
                CurrentNodes.Add(new NodeModel { Id = "fm1", Label = "A", Sublabel = "Router 1", X = 150, Y = 80 });
                CurrentNodes.Add(new NodeModel { Id = "fm2", Label = "B", Sublabel = "Router 2", X = 350, Y = 80 });
                CurrentNodes.Add(new NodeModel { Id = "fm3", Label = "C", Sublabel = "Router 3", X = 350, Y = 220 });
                CurrentNodes.Add(new NodeModel { Id = "fm4", Label = "D", Sublabel = "Router 4", X = 150, Y = 220 });

                int fmlIdx = 1;
                for (int i = 0; i < CurrentNodes.Count; i++)
                {
                    for (int j = i + 1; j < CurrentNodes.Count; j++)
                    {
                        CurrentLinks.Add(new LinkModel
                        {
                            Id = $"fml_{fmlIdx++}",
                            X1 = CurrentNodes[i].X,
                            Y1 = CurrentNodes[i].Y,
                            X2 = CurrentNodes[j].X,
                            Y2 = CurrentNodes[j].Y,
                            IsCritical = false
                        });
                    }
                }
                break;

            case "mesh":
                // Partial mesh (Ad-hoc WLAN / Mesh)
                CurrentNodes.Add(new NodeModel { Id = "m1", Label = "A", Sublabel = "Host A", X = 120, Y = 100 });
                CurrentNodes.Add(new NodeModel { Id = "m2", Label = "B", Sublabel = "Host B", X = 250, Y = 70 });
                CurrentNodes.Add(new NodeModel { Id = "m3", Label = "C", Sublabel = "Host C", X = 380, Y = 100 });
                CurrentNodes.Add(new NodeModel { Id = "m4", Label = "D", Sublabel = "Host D", X = 330, Y = 220 });
                CurrentNodes.Add(new NodeModel { Id = "m5", Label = "E", Sublabel = "Host E", X = 170, Y = 220 });

                CurrentLinks.Add(new LinkModel { Id = "ml1", X1 = 120, Y1 = 100, X2 = 250, Y2 = 70, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "ml2", X1 = 250, Y1 = 70, X2 = 380, Y2 = 100, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "ml3", X1 = 380, Y1 = 100, X2 = 330, Y2 = 220, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "ml4", X1 = 330, Y1 = 220, X2 = 170, Y2 = 220, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "ml5", X1 = 170, Y1 = 220, X2 = 120, Y2 = 100, IsCritical = false });
                CurrentLinks.Add(new LinkModel { Id = "ml6", X1 = 120, Y1 = 100, X2 = 330, Y2 = 220, IsCritical = false }); // Cross-link
                break;

            case "cell":
                // Base Station in center
                CurrentNodes.Add(new NodeModel { Id = "c_bts", Label = "BTS", Sublabel = "Basisstation (SPOF)", X = 250, Y = 150, IsCentral = true });
                // 5 Mobile Phones
                for (int i = 0; i < 5; i++)
                {
                    double angle = (i * 72 - 90) * Math.PI / 180.0;
                    double nx = Math.Round(250 + 110 * Math.Cos(angle));
                    double ny = Math.Round(150 + 110 * Math.Sin(angle));
                    CurrentNodes.Add(new NodeModel { Id = $"phone_{i + 1}", Label = $"GSM{i + 1}", Sublabel = "Mobilgerät", X = nx, Y = ny });
                    CurrentLinks.Add(new LinkModel
                    {
                        Id = $"cell_link_{i + 1}",
                        X1 = 250,
                        Y1 = 150,
                        X2 = nx,
                        Y2 = ny,
                        IsCritical = false
                    });
                }
                break;
        }
    }

    private void ToggleLinkCut(string linkId)
    {
        if (CutLinkIds.Contains(linkId))
            CutLinkIds.Remove(linkId);
        else
            CutLinkIds.Add(linkId);
    }

    private void ToggleNodeFail(string nodeId)
    {
        if (FailedNodeIds.Contains(nodeId))
            FailedNodeIds.Remove(nodeId);
        else
            FailedNodeIds.Add(nodeId);
    }

    private void ResetSimulation()
    {
        CutLinkIds.Clear();
        FailedNodeIds.Clear();
    }

    private bool HasAnyFailure => CutLinkIds.Count > 0 || FailedNodeIds.Count > 0;

    private bool IsNetworkDown
    {
        get
        {
            if (SelectedTopoId == "bus")
            {
                // Any cut in backbone links l1-l4 causes total failure
                return CutLinkIds.Any(id => id.StartsWith("l"));
            }
            if (SelectedTopoId == "ring")
            {
                // Any link cut in a single ring halts circulation
                return CutLinkIds.Count > 0 || FailedNodeIds.Count > 0;
            }
            if (SelectedTopoId == "star")
            {
                // Failure of central switch causes total network outage
                return FailedNodeIds.Contains("s_center");
            }
            if (SelectedTopoId == "tree")
            {
                return FailedNodeIds.Contains("t_root") || CutLinkIds.Contains("tl_r1") && CutLinkIds.Contains("tl_r2");
            }
            if (SelectedTopoId == "cell")
            {
                // Failure of base station downs the cell
                return FailedNodeIds.Contains("c_bts");
            }
            return false;
        }
    }

    private string StatusHeadline
    {
        get
        {
            if (IsNetworkDown) return "🚨 TOTALER NETZWERKAUSFALL (SPOF ausgelöst!)";
            if (HasAnyFailure) return "⚠️ TEILAUSFALL / REDUNDANZ AKTIV";
            return "✅ NETZWERK VOLL FUNKTIONSFÄHIG";
        }
    }

    private string StatusDetails
    {
        get
        {
            if (IsNetworkDown)
            {
                if (SelectedTopoId == "bus") return "Die Busleitung wurde unterbrochen. Ohne beidseitige Terminierung führen Reflexionen zum Stillstand aller Knoten!";
                if (SelectedTopoId == "ring") return "Ein Link oder Knoten im Ring ist unterbrochen. Der Datenumlauf ist gestoppt!";
                if (SelectedTopoId == "star") return "Der zentrale Switch (Single Point of Failure) ist ausgefallen. Kein Knoten kann mehr kommunizieren!";
                if (SelectedTopoId == "cell") return "Die zentrale Basisstation ist ausgefallen. Alle Mobiltelefone in dieser Funkzelle haben kein Netz!";
                if (SelectedTopoId == "tree") return "Der Wurzel-Switch ist ausgefallen. Die Kommunikation zwischen den Teilbäumen ist blockiert!";
            }
            if (HasAnyFailure)
            {
                if (SelectedTopoId == "mesh" || SelectedTopoId == "fullmesh")
                    return "Ein Link oder Knoten ist defekt. Dank redundanter Pfade routet das Netz den Verkehr transparent um (Kein SPOF)!";
                if (SelectedTopoId == "star" || SelectedTopoId == "cell")
                    return "Ein einzelnes Endgerät ist getrennt. Alle anderen Teilnehmer und das Kernnetz arbeiten ungestört weiter.";
                return "Teile des Netzes sind isoliert, das Kernnetz arbeitet aber teilweise weiter.";
            }
            return "Alle Knoten und Verbindungsleitungen sind intakt. Klicken Sie auf eine Leitung oder einen Knoten, um Störungen zu provozieren.";
        }
    }

