@namespace Italbytz.Systems.Blazor.Components.Networking
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="layering-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Rechnernetze &bull; Grundlagen &amp; Protokollschichten</p>
            <h2>Schichtenmodell, Kapselung &amp; Schnittstellen (Layering)</h2>
            <p class="feature-intro">
                Protokollschichten im ISO/OSI- und TCP/IP-Referenzmodell trennen die logische Funktionalität 
                durch strikte <strong>Kapselung (Information Hiding)</strong> und definierte <strong>Dienstschnittstellen (Service Access Points, SAP)</strong>.
                Untersuchen Sie die architektonischen Konsequenzen von Änderungen interner Algorithmen 
                im Vergleich zu Änderungen der Schnittstellendefinition.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Schichten- &amp; Kapselungs-Simulator
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Trainer ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Trainer)">
                📝 Klausur-Trainer (1:1 Verständnis-Check)
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht 1:1)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- VIEW 1: INTERACTIVE LAYERING SIMULATOR                                   -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Scenario Selector Controls -->
        <div class="controls-panel no-print">
            <div class="scenario-selector-wrap">
                <span class="ctrl-label">Änderungsszenario auswählen:</span>
                <div class="scenario-btn-group">
                    <button class="scenario-btn @(ActiveScenario == Scenario.Algorithms ? "active" : "")"
                            @onclick="() => SelectScenario(Scenario.Algorithms)">
                        <span class="btn-icon">⚙️</span>
                        <div class="btn-text">
                            <strong>Szenario A: Interne Algorithmen / Techniken ändern</strong>
                            <small>Z.B. Wechsel von Stop-and-Wait zu Selective Repeat oder andere Prüfsumme</small>
                        </div>
                    </button>
                    <button class="scenario-btn @(ActiveScenario == Scenario.Interfaces ? "active" : "")"
                            @onclick="() => SelectScenario(Scenario.Interfaces)">
                        <span class="btn-icon">🔌</span>
                        <div class="btn-text">
                            <strong>Szenario B: Dienste / Schnittstellen ändern</strong>
                            <small>Z.B. Geänderte Funktionsparameter, Dienstprimitive oder Adressformate</small>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Simulation Stage: 3-Tier Layer Architecture -->
        <div class="layer-stage">

            <!-- Layer N+1 (Above) -->
            <div class="layer-card layer-above @(ActiveScenario == Scenario.Interfaces ? "impact-warning" : "impact-neutral")">
                <div class="layer-header">
                    <div class="layer-title-box">
                        <span class="layer-badge">Schicht N+1</span>
                        <span class="layer-name">Darüberliegende Schicht (Dienst-Konsument)</span>
                    </div>
                    <div class="impact-indicator @(ActiveScenario == Scenario.Interfaces ? "impact-badge-warn" : "impact-badge-ok")">
                        @(ActiveScenario == Scenario.Interfaces ? "⚠️ ÄNDERUNGSBEDARF MÖGLICH" : "✅ KEINE AUSWIRKUNGEN")
                    </div>
                </div>
                <div class="layer-body">
                    <p class="layer-desc">
                        Nutzt die von Schicht N bereitgestellten Dienste. 
                        @if (ActiveScenario == Scenario.Algorithms)
                        {
                            <span class="impact-txt text-green">
                                <strong>Vollständig transparent:</strong> Da die Schnittstelle N unverändert bleibt, 
                                bemerkt Schicht N+1 den internen Technologiewechsel nicht.
                            </span>
                        }
                        else
                        {
                            <span class="impact-txt text-amber">
                                <strong>Aufrufe müssen angepasst werden:</strong> Weil Schicht N neue oder geänderte Dienste 
                                anbietet, muss der Code in Schicht N+1 überarbeitet werden!
                            </span>
                        }
                    </p>
                </div>
            </div>

            <!-- Interface / SAP N (Upper Interface) -->
            <div class="interface-connector @(ActiveScenario == Scenario.Interfaces ? "conn-modified" : "conn-intact")">
                <div class="sap-pill">
                    <span class="sap-icon">@(ActiveScenario == Scenario.Interfaces ? "⚡" : "🔒")</span>
                    <strong>Schnittstelle N (Dienstzugangspunkt / SAP)</strong>
                    <span class="sap-sub">Dienste &amp; Primitiven für Schicht N+1 (@(ActiveScenario == Scenario.Interfaces ? "Geändert!" : "Konstant &amp; Stabil"))</span>
                </div>
                <div class="data-flow-indicator @(ActiveScenario == Scenario.Interfaces ? "flow-broken" : "flow-normal")">
                    <span class="flow-arrow">&uarr; Angebotene Dienste &uarr;</span>
                </div>
            </div>

            <!-- Layer N (Current Layer Under Modification) -->
            <div class="layer-card layer-current">
                <div class="layer-header">
                    <div class="layer-title-box">
                        <span class="layer-badge current-badge">Schicht N</span>
                        <span class="layer-name">Aktuelle Schicht (Ort der Modifikation)</span>
                    </div>
                    <span class="capsule-tag">Information Hiding Boundary</span>
                </div>
                <div class="layer-body current-body">
                    <div class="change-inspector-box">
                        <div class="inspector-title">
                            @(ActiveScenario == Scenario.Algorithms ? "🔧 Modifikation: Interner Algorithmus geändert" : "🔌 Modifikation: Externe Schnittstelle geändert")
                        </div>
                        <div class="inspector-detail">
                            @if (ActiveScenario == Scenario.Algorithms)
                            {
                                <div class="algorithm-switch-grid">
                                    <div class="algo-box">
                                        <span class="algo-label">Beispielhafter Tausch:</span>
                                        <span class="algo-val">Von <em>Stop-and-Wait ARQ</em> &rarr; zu <em>Selective Repeat ARQ</em></span>
                                    </div>
                                    <div class="algo-box">
                                        <span class="algo-label">Kapselungsgrenze:</span>
                                        <span class="algo-status text-green">Intakt (Nur interne Puffer- &amp; Timerlogik)</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="algorithm-switch-grid">
                                    <div class="algo-box">
                                        <span class="algo-label">Beispielhafte Änderung:</span>
                                        <span class="algo-val">Dienst-Primitiv <code>SendData(addr, payload)</code> &rarr; erhält neuen Parameter <code>qos_priority</code></span>
                                    </div>
                                    <div class="algo-box">
                                        <span class="algo-label">Schnittstellen-Vertrag:</span>
                                        <span class="algo-status text-amber">Signatur geändert &bull; Konsumenten betroffen</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Interface / SAP N-1 (Lower Interface) -->
            <div class="interface-connector conn-intact">
                <div class="sap-pill">
                    <span class="sap-icon">🔒</span>
                    <strong>Schnittstelle N&minus;1 (Dienstzugangspunkt / SAP)</strong>
                    <span class="sap-sub">Genutzte Dienste der Schicht N&minus;1 (Unverändert)</span>
                </div>
                <div class="data-flow-indicator flow-normal">
                    <span class="flow-arrow">&uarr; Bereitgestellte Basisdienste &uarr;</span>
                </div>
            </div>

            <!-- Layer N-1 (Below) -->
            <div class="layer-card layer-below impact-neutral">
                <div class="layer-header">
                    <div class="layer-title-box">
                        <span class="layer-badge">Schicht N&minus;1</span>
                        <span class="layer-name">Darunterliegende Schicht (Dienstanbieter)</span>
                    </div>
                    <div class="impact-indicator impact-badge-ok">
                        ✅ KEINE AUSWIRKUNGEN
                    </div>
                </div>
                <div class="layer-body">
                    <p class="layer-desc">
                        Stellt die Basisdienste für Schicht N bereit. 
                        <span class="impact-txt text-green">
                            <strong>Keine Auswirkungen:</strong> Schicht N&minus;1 ist der Anbieter, nicht der Konsument der Dienste von Schicht N. 
                            Weder ein Algorithmentausch noch eine Schnittstellenänderung nach oben beeinflussen die Arbeitsweise von Schicht N&minus;1.
                        </span>
                    </p>
                </div>
            </div>

        </div>

        <!-- Summary & Key Takeaway Banner -->
        <div class="panel-card takeaway-card">
            <div class="takeaway-header">
                <span class="takeaway-icon">💡</span>
                <span class="takeaway-title">Architektur-Prinzip des Schichtenmodells (Klausur-Merksatz)</span>
            </div>
            <div class="takeaway-body">
                <div class="takeaway-grid">
                    <div class="takeaway-col">
                        <h4>a) Interne Algorithmen / Techniken ändern:</h4>
                        <p>
                            <strong>Keine Auswirkungen</strong> auf benachbarte Schichten. 
                            Das Prinzip der <em>Kapselung (Information Hiding)</em> schirmt interne Details 
                            vollständig ab, solange die Schnittstelle konstant bleibt.
                        </p>
                    </div>
                    <div class="takeaway-col">
                        <h4>b) Dienste / Schnittstellen ändern:</h4>
                        <p>
                            <strong>Auswirkungen nur auf die darüberliegende Schicht:</strong> 
                            Dienste und Schnittstellen werden immer der Schicht <em>über</em> der aktuellen Schicht angeboten. 
                            Daher kann es dort zu Anpassungsbedarf kommen. Die darunterliegende Schicht bleibt unberührt.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- VIEW 2: EXAM TRAINER (1:1 Klausur-Check CNGrundlagenSchichtung)          -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Trainer)
    {
        <div class="panel-card trainer-card">
            <div class="panel-header">
                <div class="exam-title-wrap">
                    <span class="panel-title">Klausur-Trainer: Schichtenmodell-Verständnis (CNGrundlagenSchichtung)</span>
                    <span class="exam-rule-tag">Prüfen Sie Ihre Antworten im direkten Vergleich mit der offiziellen Musterlösung</span>
                </div>
                <button class="action-btn primary" @onclick="ToggleTrainerSolution">
                    @(ShowTrainerSolution ? "👁️ Musterlösung verbergen" : "💡 Musterlösung aufdecken & prüfen")
                </button>
            </div>

            <div class="trainer-body">
                <div class="prompt-box">
                    <p class="prompt-lead">
                        <strong>Aufgabenstellung:</strong><br />
                        <em>Nehmen Sie an, es gibt Änderungen an einer Schicht im Schichtenmodell. 
                        Welche Auswirkungen hat dies auf die darunter und darüber liegende Schicht wenn...</em>
                    </p>
                </div>

                <!-- Subtask a -->
                <div class="subtask-card @(ShowTrainerSolution ? "solved-card" : "")">
                    <div class="subtask-header">
                        <span class="subtask-label">Teilaufgabe a)</span>
                        <span class="subtask-question">Algorithmen oder Techniken innerhalb der Schicht geändert werden</span>
                    </div>
                    <div class="subtask-content">
                        @if (!ShowTrainerSolution)
                        {
                            <div class="user-input-box">
                                <label class="input-hint">Ihre Überlegung (Auf darüberliegende und darunterliegende Schicht):</label>
                                <textarea class="trainer-textarea" placeholder="Was passiert mit Schicht N+1 und Schicht N-1?" rows="3"></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="solution-reveal-box">
                                <div class="sol-title text-green">Offizielle Musterlösung:</div>
                                <div class="sol-quote">
                                    <strong>Keine Auswirkungen</strong>
                                </div>
                                <div class="sol-explanation">
                                    <strong>Fachliche Begründung:</strong> Durch Kapselung (Information Hiding) bleiben interne Implementierungsdetails verborgen. 
                                    Weder die darüber- noch die darunterliegende Schicht greift auf interne Algorithmen zu.
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Subtask b -->
                <div class="subtask-card @(ShowTrainerSolution ? "solved-card" : "")">
                    <div class="subtask-header">
                        <span class="subtask-label">Teilaufgabe b)</span>
                        <span class="subtask-question">Dienste bzw. Schnittstellen der Schicht geändert werden</span>
                    </div>
                    <div class="subtask-content">
                        @if (!ShowTrainerSolution)
                        {
                            <div class="user-input-box">
                                <label class="input-hint">Ihre Überlegung (Auf darüberliegende und darunterliegende Schicht):</label>
                                <textarea class="trainer-textarea" placeholder="Welche Schicht ist betroffen und warum?" rows="3"></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="solution-reveal-box">
                                <div class="sol-title text-green">Offizielle Musterlösung:</div>
                                <div class="sol-quote">
                                    <strong>Dienste und Schnittstellen werden immer der Schicht über der aktuellen Schicht angeboten. Daher kann es dort zu Änderungsbedarf kommen.</strong>
                                </div>
                                <div class="sol-explanation">
                                    <strong>Fachliche Begründung:</strong> Schicht N+1 ruft die Funktionen der Schnittstelle von Schicht N auf. Ändert sich diese Schnittstelle, bricht der Aufrufvertrag. Die darunterliegende Schicht N-1 ist nicht betroffen.
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- VIEW 3: WORKSHEET VIEW (1:1 EXAM REPLICA MATCHING CNGrundlagenSchichtung) -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">
            
            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-group">
                    <span class="exam-sub">Grundlagen der Informatik</span>
                    <h1 class="exam-main-title">Layering @(ShowSolution ? "- Lösung" : "")</h1>
                    <span class="exam-task-label">Aufgabe 1 (Schichtung)</span>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Strip -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 4 P.</div>
                </div>
            </div>

            <!-- Main Prompt matching CNGrundlagenSchichtung.tex -->
            <div class="task-prompt-box">
                <p class="task-text">
                    Nehmen Sie an, es gibt Änderungen an einer Schicht im Schichtenmodell. Welche Auswirkungen hat dies auf die darunter und darüber liegende Schicht wenn
                </p>
            </div>

            <!-- Subtask a -->
            <div class="ws-subtask">
                <div class="ws-subtask-title">
                    <strong>a)</strong> Algorithmen oder Techniken innerhalb der Schicht geändert werden
                </div>

                @if (!ShowSolution)
                {
                    <div class="ws-textfield">
                        <div class="ws-answer-lines">
                            <div class="answer-line"></div>
                            <div class="answer-line"></div>
                            <div class="answer-line"></div>
                            <div class="answer-line"></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ws-solution-box">
                        <p class="ws-solution-text">
                            Keine Auswirkungen
                        </p>
                    </div>
                }
            </div>

            <!-- Subtask b -->
            <div class="ws-subtask">
                <div class="ws-subtask-title">
                    <strong>b)</strong> Dienste bzw. Schnittstellen der Schicht geändert werden.
                </div>

                @if (!ShowSolution)
                {
                    <div class="ws-textfield">
                        <div class="ws-answer-lines">
                            <div class="answer-line"></div>
                            <div class="answer-line"></div>
                            <div class="answer-line"></div>
                            <div class="answer-line"></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ws-solution-box">
                        <p class="ws-solution-text">
                            Dienste und Schnittstellen werden immer der Schicht über der aktuellen Schicht angeboten. Daher kann es dort zu Änderungsbedarf kommen.
                        </p>
                    </div>
                }
            </div>

            <!-- Footer for Worksheet -->
            <div class="worksheet-footer">
                <span>Intelligent Systems Design &bull; Hochschule Hamm-Lippstadt &bull; Rechnernetze</span>
            </div>
        </div>
    }

</article>

@code {
    [Parameter]
    public bool IsEmbed { get; set; } = false;

    public enum ViewMode
    {
        Simulator,
        Trainer,
        Worksheet
    }

    public enum Scenario
    {
        Algorithms,
        Interfaces
    }

    private ViewMode ActiveView { get; set; } = ViewMode.Simulator;
    private Scenario ActiveScenario { get; set; } = Scenario.Algorithms;
    private bool ShowSolution { get; set; } = false;
    private bool ShowTrainerSolution { get; set; } = false;

    protected override void OnInitialized()
    {
        CheckUrlParameters();
    }

    protected override void OnParametersSet()
    {
        CheckUrlParameters();
    }

    private void CheckUrlParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query.ToLowerInvariant();

            if (query.Contains("embed=true") || query.Contains("embedded=true") || query.Contains("embed=1"))
            {
                IsEmbed = true;
            }

            if (query.Contains("view=worksheet") || query.Contains("view=sheet"))
            {
                ActiveView = ViewMode.Worksheet;
            }

            if (query.Contains("solution=true") || query.Contains("solution=1") || query.Contains("lsg=true"))
            {
                ShowSolution = true;
            }
        }
        catch
        {
            // Fallback
        }
    }

    private void SelectScenario(Scenario scenario)
    {
        ActiveScenario = scenario;
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
    }

    private void ToggleTrainerSolution()
    {
        ShowTrainerSolution = !ShowTrainerSolution;
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
