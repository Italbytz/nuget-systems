@namespace Italbytz.Systems.Blazor.Components.Networking
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<article class="dijkstra-container @(IsEmbed ? "embed-mode" : "") @(ActiveView == ViewMode.Worksheet ? "worksheet-container" : "")">

    @if (!IsEmbed && ActiveView != ViewMode.Worksheet)
    {
        <div class="card-heading no-print">
            <p class="feature-kicker">Rechnernetze &bull; Vermittlungsschicht (Routing)</p>
            <h2>Dijkstra-Algorithmus (Kürzeste Wege &amp; Routing-Tabellen)</h2>
            <p class="feature-intro">
                Schritt-für-Schritt-Ablaufverfolgung des Dijkstra-Kürzeste-Wege-Algorithmus auf gewichteten Netzwerkgraphen. 
                Visualisierung der Knotenzustände (Permanent/Tentativ), Kantenrelaxation, Distanzschätzungen (<em>D</em>), 
                Vorgängerknoten (<em>V</em>) und der resultierenden Routing-Tabelle.
            </p>
        </div>
    }

    <!-- View Switcher -->
    @if (!IsEmbed)
    {
        <div class="view-switch no-print">
            <button class="view-btn @(ActiveView == ViewMode.Simulator ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Simulator)">
                🚀 Interaktiver Simulator &amp; Graph-Trace
            </button>
            <button class="view-btn @(ActiveView == ViewMode.Worksheet ? "active" : "")"
                    @onclick="() => SetView(ViewMode.Worksheet)">
                🖨️ Klausur-Arbeitsblatt (Druckansicht)
            </button>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- SIMULATOR VIEW                                                            -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Simulator)
    {
        <!-- Controls Panel -->
        <div class="controls-panel no-print">
            <div class="config-grid">
                <label class="control-label">
                    <span>Startknoten (Quelle):</span>
                    <select class="form-input select" @bind="StartNode" @bind:after="OnStartNodeChanged">
                        @foreach (var n in Nodes)
                        {
                            <option value="@n.Id">Knoten @n.Id</option>
                        }
                    </select>
                </label>

                <label class="control-label">
                    <span>Topologie / Graph:</span>
                    <select class="form-input select" @bind="SelectedPresetKey" @bind:after="OnPresetChanged">
                        <option value="Standard">Vorlesungs-Graph (8 Knoten, 12 Kanten)</option>
                        <option value="Exam1">Klausur-Netz A (8 Knoten, 11 Kanten)</option>
                        <option value="Compact">Kompaktes Netz (6 Knoten, 9 Kanten)</option>
                    </select>
                </label>
            </div>

            <!-- Presets Bar -->
            <div class="preset-bar">
                <span class="preset-label">Beispiele:</span>
                <button class="preset-btn" @onclick='() => LoadPreset("Standard")'>Vorlesung (8 Knoten)</button>
                <button class="preset-btn" @onclick='() => LoadPreset("Exam1")'>Klausur-Graph 1</button>
                <button class="preset-btn" @onclick='() => LoadPreset("Compact")'>6-Knoten-Netz</button>
                <button class="preset-btn random" @onclick="GenerateRandomGraph">🎲 Zufallsgraph</button>
            </div>
        </div>

        @if (DijkstraResult != null)
        {
            var maxSteps = DijkstraResult.Steps.Count;
            var currentStep = CurrentStepIndex < maxSteps ? DijkstraResult.Steps[CurrentStepIndex] : DijkstraResult.Steps.LastOrDefault();

            <!-- Player Toolbar -->
            <div class="player-toolbar no-print">
                <div class="player-controls">
                    <button class="player-btn" title="Start" disabled="@(CurrentStepIndex == 0)" @onclick="GoToStart">⏮ Start</button>
                    <button class="player-btn" title="Zurück" disabled="@(CurrentStepIndex == 0)" @onclick="PreviousStep">◀ Zurück</button>
                    <button class="player-btn primary" title="Nächster Schritt" disabled="@(CurrentStepIndex >= maxSteps - 1)" @onclick="NextStep">▶ Weiter</button>
                    <button class="player-btn" title="Ende" disabled="@(CurrentStepIndex >= maxSteps - 1)" @onclick="GoToEnd">⏭ Ende</button>
                    <button class="player-btn reset" title="Zurücksetzen" @onclick="GoToStart">🔄 Reset</button>
                </div>

                <div class="player-progress">
                    <span class="step-indicator">
                        <strong>Schritt @(CurrentStepIndex) / @(maxSteps - 1):</strong>
                        <span>@(currentStep?.Title ?? "")</span>
                    </span>
                    <input type="range" min="0" max="@(maxSteps - 1)" value="@CurrentStepIndex" @oninput="OnSliderChanged" class="step-slider" />
                </div>
            </div>

            <!-- Narrator Card -->
            @if (currentStep != null)
            {
                <div class="narrator-card">
                    <div class="narrator-header">
                        <div class="step-badge @(CurrentStepIndex == 0 ? "badge-init" : "badge-step")">
                            @if (CurrentStepIndex == 0)
                            {
                                <span>🏁 Initialisierung</span>
                            }
                            else
                            {
                                <span>🔍 Schritt @CurrentStepIndex: Knoten @currentStep.SettledNodeId fixiert</span>
                            }
                        </div>
                        <div class="narrator-title">@currentStep.Title</div>
                    </div>
                    <p class="narrator-text">@currentStep.Explanation</p>

                    @if (currentStep.Relaxations.Count > 0)
                    {
                        <div class="relax-list">
                            @foreach (var r in currentStep.Relaxations)
                            {
                                <div class="relax-item @(r.Updated ? "updated" : "no-change")">
                                    <span class="relax-edge">Kante (@r.From &rarr; @r.To, Kosten @r.Weight):</span>
                                    @if (r.Updated)
                                    {
                                        <span class="relax-val">
                                            Distanz verkürzt: <strong>@r.OldDist &rarr; @r.NewDist</strong> (Vorgänger = @r.From) ✓
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="relax-val">
                                            Keine Verbesserung (@r.CalcDist &ge; @r.OldDist) &minus;
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Interactive Graph Canvas & Routing Table (2-Column Grid) -->
            <div class="main-display-grid">
                
                <!-- Left: SVG Graph Canvas -->
                <div class="graph-card">
                    <div class="graph-header">
                        <h3>Netzwerk-Topologie (Graph)</h3>
                        <div class="graph-legend">
                            <span class="leg-item"><span class="leg-dot settled"></span> Permanent (Fest)</span>
                            <span class="leg-item"><span class="leg-dot tentative"></span> Tentativ</span>
                            <span class="leg-item"><span class="leg-dot active"></span> Aktueller Knoten</span>
                        </div>
                    </div>

                    <div class="svg-container">
                        <svg class="graph-svg" viewBox="0 0 680 440">
                            <!-- Edges -->
                            @foreach (var edge in Edges)
                            {
                                var n1 = Nodes.First(n => n.Id == edge.From);
                                var n2 = Nodes.First(n => n.Id == edge.To);
                                bool isInShortestPathTree = IsEdgeInTree(currentStep, edge.From, edge.To);
                                bool isBeingRelaxed = currentStep?.Relaxations.Any(r => (r.From == edge.From && r.To == edge.To) || (r.From == edge.To && r.To == edge.From)) ?? false;

                                string edgeCls = "graph-edge";
                                if (isInShortestPathTree) edgeCls += " tree-edge";
                                if (isBeingRelaxed) edgeCls += " relaxing-edge";

                                <line x1="@n1.X" y1="@n1.Y" x2="@n2.X" y2="@n2.Y" class="@edgeCls" />

                                <!-- Weight Badge -->
                                var midX = (n1.X + n2.X) / 2;
                                var midY = (n1.Y + n2.Y) / 2;
                                <g transform="translate(@midX, @midY)">
                                    <circle r="12" class="weight-bg" />
                                    @((MarkupString)$"<text y=\"4\" text-anchor=\"middle\" class=\"weight-text\">{edge.Weight}</text>")
                                </g>
                            }

                            <!-- Nodes -->
                            @foreach (var node in Nodes)
                            {
                                bool isStart = (node.Id == StartNode);
                                bool isSettled = currentStep?.SettledNodes.Contains(node.Id) ?? false;
                                bool isCurrent = (currentStep?.SettledNodeId == node.Id);

                                string nodeCls = "graph-node";
                                if (isCurrent) nodeCls += " current-node";
                                else if (isSettled) nodeCls += " settled-node";
                                else nodeCls += " tentative-node";
                                if (isStart) nodeCls += " start-node";

                                var distVal = currentStep != null && currentStep.Distances.ContainsKey(node.Id) 
                                    ? (currentStep.Distances[node.Id] == double.PositiveInfinity ? "∞" : currentStep.Distances[node.Id].ToString()) 
                                    : "∞";
                                var predVal = currentStep != null && currentStep.Predecessors.ContainsKey(node.Id) && !string.IsNullOrEmpty(currentStep.Predecessors[node.Id])
                                    ? $"({currentStep.Predecessors[node.Id]})"
                                    : "";

                                <g class="node-group" @onclick="() => SelectNodeAsStart(node.Id)" title="Knoten @node.Id (Klicken zum Starten)">
                                    <circle cx="@node.X" cy="@node.Y" r="22" class="@nodeCls" />
                                    @((MarkupString)$"<text x=\"{node.X}\" y=\"{node.Y + 6}\" text-anchor=\"middle\" class=\"node-label\">{node.Id}</text>")
                                    
                                    <!-- Distance Tag above node -->
                                    <g transform="translate(@node.X, @(node.Y - 28))">
                                        <rect x="-24" y="-12" width="48" height="18" rx="4" class="dist-badge-bg @(isSettled ? "bg-settled" : "")" />
                                        @((MarkupString)$"<text y=\"1\" text-anchor=\"middle\" class=\"dist-badge-text\">D={distVal} {predVal}</text>")
                                    </g>
                                </g>
                            }
                        </svg>
                    </div>
                </div>

                <!-- Right: Dijkstra Iteration Table & Routing Table -->
                <div class="tables-panel">
                    
                    <!-- Dijkstra Step Matrix -->
                    <div class="sub-table-card">
                        <div class="sub-table-header">
                            <h4>Dijkstra-Arbeitstabelle (Distanz <em>D</em> &amp; Vorgänger <em>V</em>)</h4>
                        </div>
                        <div class="table-responsive">
                            <table class="dijkstra-matrix-table">
                                <thead>
                                    <tr>
                                        <th class="node-col">Knoten</th>
                                        @for (int s = 0; s < DijkstraResult.Steps.Count; s++)
                                        {
                                            var stepObj = DijkstraResult.Steps[s];
                                            <th class="@(s == CurrentStepIndex ? "active-step-col" : "")">
                                                <div class="step-head-idx">Schritt @s</div>
                                                <div class="step-head-node">
                                                    @(s == 0 ? "Init" : stepObj.SettledNodeId)
                                                </div>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var node in Nodes)
                                    {
                                        <tr>
                                            <td class="node-id-cell"><strong>@node.Id</strong></td>
                                            @for (int s = 0; s < DijkstraResult.Steps.Count; s++)
                                            {
                                                var stepObj = DijkstraResult.Steps[s];
                                                var d = stepObj.Distances[node.Id];
                                                var p = stepObj.Predecessors[node.Id];
                                                var dStr = double.IsPositiveInfinity(d) ? "∞" : d.ToString();
                                                var cellStr = string.IsNullOrEmpty(p) ? dStr : $"{dStr} ({p})";
                                                bool wasSettledHere = (stepObj.SettledNodeId == node.Id);
                                                bool isRevealed = (s <= CurrentStepIndex);

                                                <td class="val-cell @(s == CurrentStepIndex ? "active-step-col" : "") @(wasSettledHere ? "settled-cell" : "") @(isRevealed ? "revealed" : "future")">
                                                    @(isRevealed ? cellStr : "-")
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Final Forwarding Table -->
                    <div class="sub-table-card">
                        <div class="sub-table-header">
                            <h4>Routing-Tabelle von Startknoten @StartNode</h4>
                        </div>
                        <div class="table-responsive">
                            <table class="routing-table">
                                <thead>
                                    <tr>
                                        <th>Ziel</th>
                                        <th>Kosten (Metrik)</th>
                                        <th>Next-Hop</th>
                                        <th>Kürzester Pfad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in DijkstraResult.RoutingTable)
                                    {
                                        <tr>
                                            <td class="mono bold">@entry.Destination</td>
                                            <td class="mono blue">@entry.Cost</td>
                                            <td class="mono amber">@entry.NextHop</td>
                                            <td class="mono emerald bold">@entry.PathString</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

            </div>
        }
    }

    <!-- ========================================================================= -->
    <!-- WORKSHEET VIEW (1:1 EXAM REPLICA)                                         -->
    <!-- ========================================================================= -->
    @if (ActiveView == ViewMode.Worksheet)
    {
        <div class="worksheet-paper">

            <!-- Exam Header -->
            <div class="exam-header">
                <div class="exam-title-block">
                    <span class="exam-sub">Rechnernetze &bull; Vermittlungsschicht (Routing)</span>
                    <h1 class="exam-main-title">Übungs- und Klausuraufgabe: Kürzeste Wege (Dijkstra-Algorithmus)</h1>
                </div>
                <div class="exam-meta-box no-print">
                    <button class="toggle-sol-btn @(ShowSolution ? "active" : "")" @onclick="ToggleSolution">
                        @(ShowSolution ? "👁️ Musterlösung ausblenden" : "💡 Musterlösung einblenden")
                    </button>
                    <button class="print-btn" @onclick="TriggerPrint">
                        🖨️ Seite drucken / PDF
                    </button>
                </div>
            </div>

            <!-- Student Info Fields -->
            <div class="student-info-strip">
                <div class="info-field">
                    <span class="info-label">Name, Vorname:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field">
                    <span class="info-label">Matrikelnummer:</span>
                    <div class="info-line"></div>
                </div>
                <div class="info-field points-field">
                    <span class="info-label">Punkte:</span>
                    <div class="points-box">/ 8 P.</div>
                </div>
            </div>

            <!-- Task Description -->
            <div class="task-prompt-box">
                <div class="task-number">Aufgabe (Kürzeste Wege &amp; Routing)</div>
                <p class="task-text">
                    Bestimmen Sie für den unten abgebildeten gewichteten Graphen alle kürzesten Wege ausgehend vom 
                    <strong>Startknoten @StartNode</strong> mit dem <strong>Dijkstra-Algorithmus</strong>.
                    Dokumentieren Sie die Distanzschätzungen <em>D</em> und Vorgänger <em>V</em> in jedem Schritt der Arbeitstabelle und geben Sie die fertige Routing-Tabelle an.
                </p>
            </div>

            <!-- 2-Column Worksheet Layout: Left Graph, Right Table -->
            <div class="worksheet-grid">
                
                <!-- Left: Static Graph Image / SVG -->
                <div class="ws-graph-box">
                    <div class="ws-box-title">Gegebener Netzwerkgraph</div>
                    <svg class="ws-svg" viewBox="0 0 680 440">
                        @foreach (var edge in Edges)
                        {
                            var n1 = Nodes.First(n => n.Id == edge.From);
                            var n2 = Nodes.First(n => n.Id == edge.To);
                            <line x1="@n1.X" y1="@n1.Y" x2="@n2.X" y2="@n2.Y" stroke="#000000" stroke-width="2" />
                            var midX = (n1.X + n2.X) / 2;
                            var midY = (n1.Y + n2.Y) / 2;
                            <g transform="translate(@midX, @midY)">
                                <circle r="11" fill="#ffffff" stroke="#000000" stroke-width="1.5" />
                                @((MarkupString)$"<text y=\"4\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"11\" font-weight=\"bold\">{edge.Weight}</text>")
                            </g>
                        }
                        @foreach (var node in Nodes)
                        {
                            <g>
                                <circle cx="@node.X" cy="@node.Y" r="20" fill="@(node.Id == StartNode ? "#e0f2fe" : "#ffffff")" stroke="#000000" stroke-width="2" />
                                @((MarkupString)$"<text x=\"{node.X}\" y=\"{node.Y + 6}\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"14\" font-weight=\"bold\">{node.Id}</text>")
                            </g>
                        }
                    </svg>
                </div>

                <!-- Right: Dijkstra Table -->
                <div class="ws-table-box">
                    <div class="ws-box-title">Arbeitstabelle (D: Distanz, V: Vorgänger)</div>
                    <table class="ws-matrix">
                        <thead>
                            <tr>
                                <th class="ws-col-k">Knoten</th>
                                @for (int s = 0; s < (DijkstraResult?.Steps.Count ?? 8); s++)
                                {
                                    <th colspan="2" class="ws-col-step">Schritt @s</th>
                                }
                            </tr>
                            <tr class="ws-subhead">
                                <th></th>
                                @for (int s = 0; s < (DijkstraResult?.Steps.Count ?? 8); s++)
                                {
                                    <th class="ws-sub-dv">D</th>
                                    <th class="ws-sub-dv">V</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var node in Nodes)
                            {
                                <tr>
                                    <td class="ws-node-td"><strong>@node.Id</strong></td>
                                    @for (int s = 0; s < (DijkstraResult?.Steps.Count ?? 8); s++)
                                    {
                                        if (ShowSolution && DijkstraResult != null && s < DijkstraResult.Steps.Count)
                                        {
                                            var stepObj = DijkstraResult.Steps[s];
                                            var d = stepObj.Distances[node.Id];
                                            var p = stepObj.Predecessors[node.Id];
                                            var dStr = double.IsPositiveInfinity(d) ? "∞" : d.ToString();
                                            <td class="ws-cell-sol">@dStr</td>
                                            <td class="ws-cell-sol">@(string.IsNullOrEmpty(p) ? "-" : p)</td>
                                        }
                                        else
                                        {
                                            <td class="ws-cell-blank"></td>
                                            <td class="ws-cell-blank"></td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- Routing Table Results Area -->
            <div class="ws-routing-box">
                <div class="ws-box-title">Ermittelte Routing-Tabelle für Startknoten @StartNode:</div>
                @if (ShowSolution && DijkstraResult != null)
                {
                    <div class="ws-sol-routing-grid">
                        @foreach (var entry in DijkstraResult.RoutingTable)
                        {
                            <div class="ws-sol-route-card">
                                <span class="route-dest">Ziel: <strong>@entry.Destination</strong></span>
                                <span class="route-cost">Kosten: @entry.Cost</span>
                                <span class="route-hop">Next-Hop: @entry.NextHop</span>
                                <span class="route-path">Pfad: @entry.PathString</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ws-blank-routing-table">
                        <table class="ws-routing-tbl">
                            <thead>
                                <tr>
                                    <th>Zielknoten</th>
                                    @foreach (var n in Nodes.Where(n => n.Id != StartNode))
                                    {
                                        <th>@n.Id</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Gesamtkosten:</strong></td>
                                    @foreach (var n in Nodes.Where(n => n.Id != StartNode))
                                    {
                                        <td></td>
                                    }
                                </tr>
                                <tr>
                                    <td><strong>Next-Hop:</strong></td>
                                    @foreach (var n in Nodes.Where(n => n.Id != StartNode))
                                    {
                                        <td></td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="exam-footer">
                <div class="exam-footer-note">
                    Hinweis: Im Dijkstra-Algorithmus wird in jedem Schritt der unbesuchte Knoten mit der kleinsten Distanzschätzung <em>D</em> als permanent markiert und dessen ausgehende Kanten relaxiert.
                </div>
            </div>

        </div>
    }

</article>

@code {
    public enum ViewMode { Simulator, Worksheet }

    [Parameter] public string StartNode { get; set; } = "A";
    [Parameter] public string? View { get; set; }
    [Parameter] public bool? Solution { get; set; }
    [Parameter] public bool? Embed { get; set; }

    private ViewMode ActiveView = ViewMode.Simulator;
    private bool ShowSolution = false;
    private bool IsEmbed = false;

    private string SelectedPresetKey = "Standard";

    private List<GraphNode> Nodes = new();
    private List<GraphEdge> Edges = new();

    private DijkstraTraceResult? DijkstraResult;
    private int CurrentStepIndex = 0;

    protected override void OnInitialized()
    {
        ReadQueryParameters();
        LoadPreset(SelectedPresetKey);
    }

    protected override void OnParametersSet()
    {
        ReadQueryParameters();
    }

    private void ReadQueryParameters()
    {
        try
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = uri.Query;
            if (string.IsNullOrEmpty(query)) return;

            var pairs = query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
            foreach (var pair in pairs)
            {
                var parts = pair.Split('=', 2);
                var key = parts[0].ToLowerInvariant();
                var val = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";

                if (key == "view")
                {
                    ActiveView = val.Equals("worksheet", StringComparison.OrdinalIgnoreCase) ? ViewMode.Worksheet : ViewMode.Simulator;
                }
                else if (key == "solution" && bool.TryParse(val, out var solBool))
                {
                    ShowSolution = solBool;
                }
                else if (key == "embed" && bool.TryParse(val, out var embedBool))
                {
                    IsEmbed = embedBool;
                }
                else if (key == "start" && !string.IsNullOrEmpty(val))
                {
                    StartNode = val.ToUpperInvariant();
                }
            }
        }
        catch
        {
            // fallback
        }
    }

    private void SetView(ViewMode mode)
    {
        ActiveView = mode;
        UpdateUrl();
    }

    private void ToggleSolution()
    {
        ShowSolution = !ShowSolution;
        UpdateUrl();
    }

    private void UpdateUrl()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["view"] = ActiveView == ViewMode.Worksheet ? "worksheet" : null,
            ["solution"] = ShowSolution ? "true" : null,
            ["start"] = StartNode != "A" ? StartNode : null,
            ["embed"] = IsEmbed ? "true" : null
        });
        NavigationManager.NavigateTo(uri, replace: true);
    }

    private async Task TriggerPrint()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void OnStartNodeChanged()
    {
        Recalculate();
    }

    private void SelectNodeAsStart(string nodeId)
    {
        StartNode = nodeId;
        Recalculate();
    }

    private void OnPresetChanged()
    {
        LoadPreset(SelectedPresetKey);
    }

    private void LoadPreset(string preset)
    {
        SelectedPresetKey = preset;
        switch (preset)
        {
            case "Compact":
                // 6 Nodes (A..F)
                Nodes = new List<GraphNode>
                {
                    new("A", 100, 220),
                    new("B", 240, 100),
                    new("C", 240, 340),
                    new("D", 440, 100),
                    new("E", 440, 340),
                    new("F", 580, 220)
                };
                Edges = new List<GraphEdge>
                {
                    new("A", "B", 4),
                    new("A", "C", 2),
                    new("B", "C", 1),
                    new("B", "D", 5),
                    new("C", "E", 8),
                    new("C", "D", 8),
                    new("D", "E", 2),
                    new("D", "F", 6),
                    new("E", "F", 3)
                };
                break;

            case "Exam1":
                // 8 Nodes (A..H)
                Nodes = new List<GraphNode>
                {
                    new("A", 80, 220),
                    new("B", 200, 100),
                    new("C", 200, 340),
