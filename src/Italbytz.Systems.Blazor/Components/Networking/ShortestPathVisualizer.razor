    // =========================================================================
    // PLAYER CONTROLS
    // =========================================================================
    private void GoToStart() => CurrentStepIndex = 0;
    private void PreviousStep() => CurrentStepIndex = Math.Max(0, CurrentStepIndex - 1);
    private void NextStep() => CurrentStepIndex = Math.Min((DijkstraResult?.Steps.Count ?? 1) - 1, CurrentStepIndex + 1);
    private void GoToEnd() => CurrentStepIndex = Math.Max(0, (DijkstraResult?.Steps.Count ?? 1) - 1);
    private void OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx))
        {
            CurrentStepIndex = Math.Clamp(idx, 0, (DijkstraResult?.Steps.Count ?? 1) - 1);
        }
    }

    // =========================================================================
    // DIJKSTRA ALGORITHM ENGINE
    // =========================================================================
    private void Recalculate()
    {
        DijkstraResult = RunDijkstra(Nodes, Edges, StartNode);
        if (CurrentStepIndex >= DijkstraResult.Steps.Count)
        {
            CurrentStepIndex = Math.Max(0, DijkstraResult.Steps.Count - 1);
        }
    }

    private DijkstraTraceResult RunDijkstra(List<GraphNode> nodes, List<GraphEdge> edges, string startNodeId)
    {
        var result = new DijkstraTraceResult();
        var allNodeIds = nodes.Select(n => n.Id).ToList();

        // Distance & Predecessor maps
        var dist = new Dictionary<string, double>();
        var pred = new Dictionary<string, string>();
        var settled = new HashSet<string>();

        foreach (var id in allNodeIds)
        {
            dist[id] = double.PositiveInfinity;
            pred[id] = "";
        }
        dist[startNodeId] = 0;

        // Step 0: Initialization
        result.Steps.Add(new DijkstraStep
        {
            StepNumber = 0,
            Title = $"Initialisierung: Startknoten {startNodeId} hat Distanz 0",
            Explanation = $"Der Startknoten {startNodeId} wird mit D[{startNodeId}] = 0 initialisiert. Alle anderen Knoten erhalten die Distanz ∞ (unendlich) und keinen Vorgänger.",
            SettledNodeId = startNodeId,
            SettledNodes = new HashSet<string>(),
            Distances = new Dictionary<string, double>(dist),
            Predecessors = new Dictionary<string, string>(pred)
        });

        int stepNum = 1;
        while (settled.Count < allNodeIds.Count)
        {
            // Find unsettled node with minimum distance
            string? minNode = null;
            double minDist = double.PositiveInfinity;

            foreach (var id in allNodeIds)
            {
                if (!settled.Contains(id) && dist[id] < minDist)
                {
                    minDist = dist[id];
                    minNode = id;
                }
            }

            if (minNode == null || double.IsPositiveInfinity(minDist))
            {
                // Remaining nodes are unreachable
                break;
            }

            settled.Add(minNode);

            var step = new DijkstraStep
            {
                StepNumber = stepNum,
                SettledNodeId = minNode,
                SettledNodes = new HashSet<string>(settled),
                Title = $"Knoten {minNode} fixieren (D={minDist}) & Kanten relaxieren",
                Explanation = $"Knoten {minNode} besitzt unter allen unbesuchten Knoten die kleinste Distanz ({minDist}) und wird nun permanent fixiert. Seine ausgehenden Kanten werden überprüft."
            };

            // Relax outgoing edges from minNode
            var neighborEdges = edges.Where(e => e.From == minNode || e.To == minNode).ToList();
            foreach (var edge in neighborEdges)
            {
                string neighbor = edge.From == minNode ? edge.To : edge.From;
                if (!settled.Contains(neighbor))
                {
                    double oldDist = dist[neighbor];
                    double calcDist = dist[minNode] + edge.Weight;
                    bool updated = false;

                    if (calcDist < oldDist)
                    {
                        dist[neighbor] = calcDist;
                        pred[neighbor] = minNode;
                        updated = true;
                    }

                    step.Relaxations.Add(new EdgeRelaxationDetail
                    {
                        From = minNode,
                        To = neighbor,
                        Weight = edge.Weight,
                        OldDist = double.IsPositiveInfinity(oldDist) ? "∞" : oldDist.ToString(),
                        CalcDist = calcDist.ToString(),
                        NewDist = dist[neighbor].ToString(),
                        Updated = updated
                    });
                }
            }

            step.Distances = new Dictionary<string, double>(dist);
            step.Predecessors = new Dictionary<string, string>(pred);
            result.Steps.Add(step);
            stepNum++;
        }

        // Generate Routing Table from startNodeId
        foreach (var target in allNodeIds.Where(id => id != startNodeId))
        {
            var cost = dist[target];
            if (double.IsPositiveInfinity(cost))
            {
                result.RoutingTable.Add(new RoutingTableEntry
                {
                    Destination = target,
                    Cost = "∞",
                    NextHop = "-",
                    PathString = "Nicht erreichbar"
                });
            }
            else
            {
                // Trace back path
                var pathNodes = new List<string> { target };
                var curr = target;
                while (curr != startNodeId && !string.IsNullOrEmpty(pred[curr]))
                {
                    curr = pred[curr];
                    pathNodes.Insert(0, curr);
                }

                string nextHop = pathNodes.Count > 1 ? pathNodes[1] : target;
                result.RoutingTable.Add(new RoutingTableEntry
                {
                    Destination = target,
                    Cost = cost.ToString(),
                    NextHop = nextHop,
                    PathString = string.Join(" → ", pathNodes)
                });
            }
        }

        return result;
    }

    private bool IsEdgeInTree(DijkstraStep? step, string u, string v)
    {
        if (step == null) return false;
        // If v is predecessor of u, or u is predecessor of v AND both are settled (or u/v is in tree)
        if (step.Predecessors.TryGetValue(u, out var pU) && pU == v && step.SettledNodes.Contains(u)) return true;
        if (step.Predecessors.TryGetValue(v, out var pV) && pV == u && step.SettledNodes.Contains(v)) return true;
        return false;
    }

    // =========================================================================
    // DATA STRUCTURES
    // =========================================================================
    public record GraphNode(string Id, int X, int Y);
    public record GraphEdge(string From, string To, double Weight);

    public class DijkstraTraceResult
    {
        public List<DijkstraStep> Steps { get; set; } = new();
        public List<RoutingTableEntry> RoutingTable { get; set; } = new();
    }

    public class DijkstraStep
    {
        public int StepNumber { get; set; }
        public string Title { get; set; } = "";
        public string Explanation { get; set; } = "";
        public string SettledNodeId { get; set; } = "";
        public HashSet<string> SettledNodes { get; set; } = new();
        public Dictionary<string, double> Distances { get; set; } = new();
        public Dictionary<string, string> Predecessors { get; set; } = new();
        public List<EdgeRelaxationDetail> Relaxations { get; set; } = new();
    }

    public class EdgeRelaxationDetail
    {
        public string From { get; set; } = "";
        public string To { get; set; } = "";
        public double Weight { get; set; }
        public string OldDist { get; set; } = "";
        public string CalcDist { get; set; } = "";
        public string NewDist { get; set; } = "";
        public bool Updated { get; set; }
    }

    public class RoutingTableEntry
    {
        public string Destination { get; set; } = "";
        public string Cost { get; set; } = "";
        public string NextHop { get; set; } = "";
        public string PathString { get; set; } = "";
    }
}
