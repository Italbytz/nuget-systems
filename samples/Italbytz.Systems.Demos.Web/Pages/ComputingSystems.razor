@page "/computing-systems"
@page "/gdi"

<PageTitle>Grundlagen der Informatik – Themenübersicht nach Kapiteln</PageTitle>

<section class="hero-panel page-hero">
    <div>
        <p class="eyebrow">Themenbereich · Grundlagen der Informatik</p>
        <h1>Grundlagen der Informatik</h1>
        <p class="hero-copy">
            17 interaktive Simulatoren, gegliedert nach den Buchkapiteln und Foliensätzen der Vorlesung.
            Wählen Sie ein Kapitel oder steigen Sie direkt in die Übungen ein:
        </p>
    </div>
</section>

<div class="chapter-sections">
    <!-- Kapitel 01 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 01</span>
            <h2>Historie &amp; Mechanische Rechenhilfen</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="abacus">
                <p class="feature-kicker">01 Historie</p>
                <h3>Abakus (Soroban)</h3>
                <p>Bi-Quinär-System (Perlenrechnen) zur mechanischen Zahlendarstellung.</p>
            </a>
            <a class="feature-card route-card" href="napier-bones">
                <p class="feature-kicker">02 Historie</p>
                <h3>Napiersche Rechenstäbe</h3>
                <p>Gelosia-Multiplikation (1617) zur Zerlegung mehrstelliger Produkte.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 02 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 02</span>
            <h2>Zahlendarstellung &amp; Codes</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="binary-to-decimal">
                <p class="feature-kicker">03 Stellenwertsystem</p>
                <h3>Binär zu Dezimal</h3>
                <p>Potenzsumme (Basis 2) mit schrittweiser Bit-Auswertung.</p>
            </a>
            <a class="feature-card route-card" href="decimal-to-binary">
                <p class="feature-kicker">04 Divisionsverfahren</p>
                <h3>Dezimal zu Binär</h3>
                <p>Fortlaufende Division durch 2 mit Restwertmethode und LSB-MSB-Leserichtung.</p>
            </a>
            <a class="feature-card route-card" href="binary-arithmetic">
                <p class="feature-kicker">05 Arithmetik</p>
                <h3>Binäraddition</h3>
                <p>8-Bit-Addition mit Schritt-für-Schritt-Überträgen (Carry).</p>
            </a>
            <a class="feature-card route-card" href="twos-complement">
                <p class="feature-kicker">06 Festkomma</p>
                <h3>Zweierkomplement</h3>
                <p>Vorzeichenbehaftete Binärdarstellung, Invertierung und Subtraktion.</p>
            </a>
            <a class="feature-card route-card" href="floating-point">
                <p class="feature-kicker">07 Gleitkomma</p>
                <h3>IEEE 754 Gleitkomma</h3>
                <p>32-Bit Single Precision: Vorzeichen, Exponent mit Bias 127 und normalisierte Mantisse.</p>
            </a>
            <a class="feature-card route-card" href="ascii-memory">
                <p class="feature-kicker">08 Zeichenkodierung &amp; Speicher</p>
                <h3>ASCII &amp; Endianness</h3>
                <p>US-ASCII-Kodierung und Bytereihenfolge (Little Endian vs. Big Endian) im 32-Bit-Speicher.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 03 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 03</span>
            <h2>Boolesche Algebra &amp; Minimierung</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="normal-forms">
                <p class="feature-kicker">09 Boolesche Algebra</p>
                <h3>Kanonische Normalformen</h3>
                <p>DNF (Minterme) und KNF (Maxterme) aus Wahrheitstabellen.</p>
            </a>
            <a class="feature-card route-card" href="karnaugh-veitch">
                <p class="feature-kicker">10 Boolesche Minimierung</p>
                <h3>KV-Diagramme</h3>
                <p>2D-Gray-Code-Raster, 2^k-Blockbildung und disjunktive Minimalform (DMF).</p>
            </a>
            <a class="feature-card route-card" href="quine-mccluskey">
                <p class="feature-kicker">11 Boolesche Minimierung</p>
                <h3>Quine-McCluskey</h3>
                <p>Tabellenverfahren zur Primimplikanten-Bestimmung und Überdeckungsanalyse.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 04 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 04</span>
            <h2>Schaltnetze &amp; Programmierbare Bausteine</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="logic-circuits">
                <p class="feature-kicker">12 Logische Schaltungen</p>
                <h3>Logikgatter &amp; Schaltungen</h3>
                <p>Gatter, Halb-/Volladdierer und D-Latch interaktiv schalten.</p>
            </a>
            <a class="feature-card route-card" href="pla">
                <p class="feature-kicker">13 Programmierbare Logik</p>
                <h3>Programmierbare Bausteine (PLA)</h3>
                <p>Disjunktive Normalform, Berkeley-Espresso-Format und Leitungsmatrix.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 05 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 05</span>
            <h2>Zeitverhalten &amp; Schaltwerke</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="hazards">
                <p class="feature-kicker">14 Zeitverhalten</p>
                <h3>Funktions-Hazards &amp; Glitches</h3>
                <p>Störimpulse, Übergänge und kürzeste Wege im KV-Diagramm / Hyperwürfel.</p>
            </a>
            <a class="feature-card route-card" href="moore-machine">
                <p class="feature-kicker">15 Endliche Automaten</p>
                <h3>Moore-Zustandsautomaten</h3>
                <p>Zustandsübergangsgraph, D-Flip-Flop-Steuerung und synchrone Synthese.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 06 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 06</span>
            <h2>Rechnerstrukturen &amp; Software</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="cpu-simulator">
                <p class="feature-kicker">16 Rechnerarchitektur</p>
                <h3>CPU-Simulator</h3>
                <p>Von-Neumann-Architektur, Mikrocode und Register-Transfer.</p>
            </a>
            <a class="feature-card route-card" href="addressing">
                <p class="feature-kicker">17 Rechnerarchitektur</p>
                <h3>Adressierungsarten (MIPS)</h3>
                <p>Register-, direkte, indirekte, Basis- und PC-relative Adressierung im Befehlssatz.</p>
            </a>
            <a class="feature-card route-card" href="assembler">
                <p class="feature-kicker">18 Rechnerarchitektur</p>
                <h3>MIPS-Assembler</h3>
                <p>Befehlsausführung, Registerbank (r0..r31, lo, hi) und Trace-Tabelle in Dez, Bin und Hex.</p>
            </a>
        </div>
    </section>
</div>
