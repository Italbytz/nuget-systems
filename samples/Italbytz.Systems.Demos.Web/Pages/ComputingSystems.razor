@page "/computing-systems"

<PageTitle>Grundlagen der Informatik – Themenübersicht</PageTitle>

<section class="hero-panel page-hero">
    <div>
        <p class="eyebrow">Themenbereich</p>
        <h1>Grundlagen der Informatik</h1>
