@page "/operating-systems"
@page "/bs"
@page "/betriebssysteme"

<PageTitle>Betriebssysteme – Themenübersicht nach Kapiteln</PageTitle>

<section class="hero-panel page-hero">
    <div>
        <p class="eyebrow">Themenbereich · Betriebssysteme</p>
        <h1>Betriebssysteme</h1>
        <p class="hero-copy">
            13 interaktive Simulatoren, gegliedert nach den Kernbereichen und Foliensätzen der Vorlesung.
            Wählen Sie ein Kapitel oder steigen Sie direkt in die Übungen ein:
        </p>
    </div>
</section>

<div class="chapter-sections">
    <!-- Klausurtraining -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Klausurtraining</span>
            <h2>Multiple-Choice Selbsttest &amp; Wissensprüfung</h2>
        </div>
        <div class="card-grid card-grid-two">
            <div class="feature-card route-card">
                <a class="route-card-link" href="quiz?topic=os">
                    <p class="feature-kicker">00 Klausurtraining &bull; Wahr / Falsch</p>
                    <h3>Multiple-Choice Quiz (Betriebssysteme)</h3>
                    <p>Interaktiver Selbsttest mit Klausurbewertung (+1 Pkt. bei richtiger Antwort, &minus;1 Pkt. bei falscher Antwort, min. 0 Pkt.) über den gesamten Fragenkatalog der Vorlesung.</p>
                </a>
            </div>
        </div>
    </section>

    <!-- Kapitel 01 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 01</span>
            <h2>Speicherverwaltung (Memory Management)</h2>
        </div>
        <div class="card-grid card-grid-two">
            <div class="feature-card route-card">
                <a class="route-card-link" href="buddy-memory">
                    <p class="feature-kicker">01 Speicherverwaltung</p>
                    <h3>Buddy-System</h3>
                    <p>Binäre Block-Aufteilung (Splitting) und Verschmelzung (Merging).</p>
                </a>
                <div class="card-pdf-actions">
                    <a class="pdf-badge" href="pdf/Buddy_10.pdf" target="_blank" download="Buddy_10.pdf" title="10 freiwillige Übungsaufgaben zur Klausurvorbereitung (LaTeX-PDF)">
                        🎯 Freiwilliges Klausurtraining (PDF)
                    </a>
                </div>
            </div>
            <div class="feature-card route-card">
                <a class="route-card-link" href="page-replacement">
                    <p class="feature-kicker">02 Speicherverwaltung</p>
                    <h3>Seitenaustausch</h3>
                    <p>FIFO, LRU, Clock und Optimal (MIN) Schritt-für-Schritt simuliert.</p>
                </a>
                <div class="card-pdf-actions">
                    <a class="pdf-badge" href="pdf/PageReplacement_10.pdf" target="_blank" download="PageReplacement_10.pdf" title="10 freiwillige Übungsaufgaben zur Klausurvorbereitung (LaTeX-PDF)">
                        🎯 Freiwilliges Klausurtraining (PDF)
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Kapitel 02 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 02</span>
            <h2>Dateisysteme (File Systems)</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="filesystems">
                <p class="feature-kicker">03 Dateisysteme</p>
                <h3>UNIX Inodes &amp; FAT</h3>
                <p>Blockhierarchie, direkte &amp; indirekte Zeiger, Dateigrößen-Berechnung und FAT-Clusterverkettung.</p>
            </a>
            <a class="feature-card route-card" href="devices">
                <p class="feature-kicker">06 Ein-/Ausgabe</p>
                <h3>UNIX-Gerätedateien</h3>
                <p>„Alles ist eine Datei“: /dev/stdout, /dev/null, /dev/zero &amp; /dev/urandom im C# Stream-Zugriff.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 03 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 03</span>
            <h2>Prozesse &amp; CPU-Scheduling</h2>
        </div>
        <div class="card-grid card-grid-two">
            <div class="feature-card route-card">
                <a class="route-card-link" href="process-state">
                    <p class="feature-kicker">04 Prozessverwaltung</p>
                    <h3>Prozesszustandsmodell</h3>
                    <p>Zustandsübergänge zwischen Bereit (Ready), Rechnend (Running) und Blockiert (Blocked).</p>
                </a>
            </div>
            <div class="feature-card route-card">
                <a class="route-card-link" href="cpu-scheduling">
                    <p class="feature-kicker">05 Prozessverwaltung</p>
                    <h3>CPU-Scheduling</h3>
                    <p>FCFS, SPN, SRT, Round Robin und Feedback im interaktiven Gantt-Chart.</p>
                </a>
                <div class="card-pdf-actions">
                    <a class="pdf-badge" href="pdf/Scheduling_10.pdf" target="_blank" download="Scheduling_10.pdf" title="10 freiwillige Übungsaufgaben zur Klausurvorbereitung (LaTeX-PDF)">
                        🎯 Freiwilliges Klausurtraining (PDF)
                    </a>
                </div>
            </div>
            <div class="feature-card route-card">
                <a class="route-card-link" href="processes">
                    <p class="feature-kicker">08 Prozesse</p>
                    <h3>Prozesse in C# &amp; POSIX</h3>
                    <p>Prozessattribute (PID, Working Set, Threads), PID 1 sowie Starten von Kindprozessen mit E/A-Umleitung.</p>
                </a>
            </div>
            <div class="feature-card route-card">
                <a class="route-card-link" href="realtime-scheduling">
                    <p class="feature-kicker">06 Echtzeitsysteme</p>
                    <h3>Echtzeit-Scheduling</h3>
                    <p>Rate Monotonic (RMS) und Earliest Deadline First (EDF) mit Auslastungsberechnung.</p>
                </a>
                <div class="card-pdf-actions">
                    <a class="pdf-badge" href="pdf/RTScheduling_10.pdf" target="_blank" download="RTScheduling_10.pdf" title="10 freiwillige Übungsaufgaben zur Klausurvorbereitung (LaTeX-PDF)">
                        🎯 Freiwilliges Klausurtraining (PDF)
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Kapitel 04 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 04</span>
            <h2>Synchronisation &amp; Interprozesskommunikation</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="threads">
                <p class="feature-kicker">07 Nebenläufigkeit &amp; C#</p>
                <h3>Threads &amp; Lebenszyklus (C# &amp; POSIX)</h3>
                <p>Thread-Erzeugung, ParameterizedThreadStart, non-deterministisches Scheduling und POSIX-Gegenüberstellung.</p>
            </a>
            <a class="feature-card route-card" href="race-condition">
                <p class="feature-kicker">08 Synchronisation</p>
                <h3>Race Conditions &amp; Mutex</h3>
                <p>Interleaving, Wettlaufsituationen und wechselseitiger Ausschluss im kritischen Abschnitt.</p>
            </a>
            <a class="feature-card route-card" href="peterson">
                <p class="feature-kicker">09 Synchronisation</p>
                <h3>Petersons Algorithmus</h3>
                <p>Wechselseitiger Ausschluss, Interessens-Flags und symmetriebrechendes aktives Warten.</p>
            </a>
            <a class="feature-card route-card" href="producer-consumer">
                <p class="feature-kicker">10 Synchronisation &amp; C#</p>
                <h3>Erzeuger-Verbraucher (Producer-Consumer)</h3>
                <p>Interaktiver Puffer, Vergleich von Bare, C#-lock und OS-Mutex mit synchronisiertem C#-Quelltext.</p>
            </a>
            <a class="feature-card route-card" href="dining-philosophers">
                <p class="feature-kicker">11 Synchronisation &amp; Deadlocks</p>
                <h3>Philosophenproblem (Dining Philosophers)</h3>
                <p>Runder Tisch, 5 Gabeln, Deadlock-Erkennung, Dijkstras Linkshänder (Asymmetrie) und Kellner-Arbitrator.</p>
            </a>
            <a class="feature-card route-card" href="pipes">
                <p class="feature-kicker">12 Kommunikation</p>
                <h3>Pipes &amp; IPC-Kategorien</h3>
                <p>Puffer-Mechanismus, Lese-/Schreibzeiger und Zuordnung zu Shared Memory vs. Message Queues.</p>
            </a>
            <a class="feature-card route-card" href="ipc">
                <p class="feature-kicker">13 Kommunikation</p>
                <h3>IPC-Mechanismen &amp; Synthese</h3>
                <p>Shared Memory, Sockets, Semaphoren, Dateien und Message Queues im direkten Architekturvergleich.</p>
            </a>
        </div>
    </section>

    <!-- Kapitel 05 -->
    <section class="chapter-block">
        <div class="chapter-header">
            <span class="chapter-tag">Kapitel 05</span>
            <h2>Virtualisierung</h2>
        </div>
        <div class="card-grid card-grid-two">
            <a class="feature-card route-card" href="virtualisation">
                <p class="feature-kicker">11 Virtualisierung</p>
                <h3>Virtualisierung &amp; Architekturen</h3>
                <p>Partitionierung, Emulation, Hypervisoren (Typ 1 &amp; 2), Paravirtualisierung und Container.</p>
            </a>
        </div>
    </section>
</div>
