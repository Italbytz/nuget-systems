@page "/networking"

<PageTitle>Rechnernetze – Themenübersicht</PageTitle>

<section class="hero-panel page-hero">
    <div>
        <p class="eyebrow">Themenbereich</p>
        <h1>Rechnernetze</h1>
        <p class="hero-copy">
            Wählen Sie ein spezifisches Thema für interaktive Demonstratoren und Lösungsberechnungen:
        </p>
    </div>
</section>

<section class="section-stack">
    <div class="card-grid card-grid-two">
        <a class="feature-card route-card" href="line-coding">
            <p class="feature-kicker">11 Physikalische Schicht</p>
            <h3>Leitungscodierung</h3>
            <p>NRZ, NRZ-I, Manchester und Differenzieller Manchester-Signalverlauf.</p>
        </a>
        <a class="feature-card route-card" href="crc">
            <p class="feature-kicker">12 Sicherungsschicht</p>
            <h3>CRC-Verfahren</h3>
            <p>Zyklische Redundanzprüfung über Modulo-2-Polynomdivision.</p>
        </a>
        <a class="feature-card route-card" href="spanning-tree">
            <p class="feature-kicker">12 Sicherungsschicht</p>
            <h3>Spanning Tree Protocol</h3>
            <p>Minimaler Spannbaum (Kruskal &amp; Prim) und Schleifenvermeidung in Bridges.</p>
        </a>
        <a class="feature-card route-card" href="subnetting">
            <p class="feature-kicker">13 Vermittlungsschicht</p>
            <h3>IPv4-Subnetting</h3>
            <p>Präfixlängen (CIDR), Netzklassen, Subnetzmasken und Broadcast-Adressen.</p>
        </a>
        <a class="feature-card route-card" href="shortest-path">
            <p class="feature-kicker">13 Vermittlungsschicht</p>
            <h3>Kürzeste Wege (Dijkstra)</h3>
            <p>Dijkstra-Routing-Algorithmus, Distanz-Matrix und Routing-Tabellenberechnung.</p>
        </a>
        <a class="feature-card route-card" href="tcp">
            <p class="feature-kicker">14 Transportschicht</p>
            <h3>TCP-Protokollablauf</h3>
            <p>Seq- &amp; Ack-Nummern, 3-Wege-Handshake, Sliding Window und Fast Retransmit.</p>
        </a>
        <a class="feature-card route-card" href="layering">
            <p class="feature-kicker">15 Protokollschichten</p>
            <h3>Schichtenmodelle &amp; Kapselung</h3>
            <p>Auswirkungen von Schichten- und Schnittstellenänderungen nach ISO/OSI und TCP/IP.</p>
        </a>
        <a class="feature-card route-card" href="cn-topologies">
            <p class="feature-kicker">16 Netzstrukturen</p>
            <h3>Netzwerktopologien</h3>
            <p>Bus, Ring, Stern, Masche, Baum &amp; Zelle: SPOF, Ausfallsicherheit und Praxisvergleich.</p>
        </a>
        <a class="feature-card route-card" href="twisted-pair">
            <p class="feature-kicker">17 Bitübertragungsschicht</p>
            <h3>Twisted-Pair-Verkabelung</h3>
            <p>Differenzsignalübertragung, Gleichtakt-Störunterdrückung &amp; T568A/T568B RJ45-Pinbelegung.</p>
        </a>
        <a class="feature-card route-card" href="dns">
            <p class="feature-kicker">18 Anwendungsschicht</p>
            <h3>Domain Name System (DNS)</h3>
            <p>Hierarchische Namensauflösung (Root, TLD, Auth), UDP-Einsatz &amp; Idempotenz bei Paketverlust.</p>
        </a>
    </div>
</section>
