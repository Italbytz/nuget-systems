@code {
    public enum LectureTab
    {
        GdI,
        Net,
        BS,
        All
    }

    private bool collapseNavMenu = true;
    private LectureTab SelectedTab = LectureTab.GdI;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void SelectTab(LectureTab tab)
    {
        SelectedTab = tab;
    }

    protected override void OnInitialized()
    {
        AutoDetectTabFromUri(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Wenn der Nutzer nicht gerade manuell auf einen anderen Tab geklickt hat,
        // erkennen wir die passende Vorlesung automatisch aus der Route
        AutoDetectTabFromUri(e.Location);
        StateHasChanged();
    }

    private void AutoDetectTabFromUri(string uriString)
    {
        try
        {
            var uri = new Uri(uriString);
            var path = uri.AbsolutePath.Trim('/').ToLowerInvariant();

            // Wenn auf der Startseite: Standardmäßig GdI oder All lassen
            if (string.IsNullOrEmpty(path))
            {
                return;
            }

            // GdI Routen
            if (path == "computing-systems" || path == "gdi" ||
                path == "abacus" || path == "napier-bones" ||
                path == "binary-to-decimal" || path == "decimal-to-binary" ||
                path == "binary-arithmetic" || path == "binary-addition" || path == "addition" ||
                path == "twos-complement" || path == "floating-point" ||
                path == "ascii-memory" || path == "ascii-endianness" || path == "endianness" ||
                path == "normal-forms" || path == "boolean-normal-forms" ||
                path == "karnaugh-veitch" || path == "kv" ||
                path == "quine-mccluskey" || path == "qmc" ||
                path == "logic-circuits" || path == "logic-simulator" || path == "circuits" ||
                path == "pla" || path == "espresso" ||
                path == "hazards" || path == "glitches" ||
                path == "moore-machine" || path == "moore" ||
                path == "cpu-simulator" || path == "cpu" ||
                path == "addressing" || path == "mips-addressing" ||
                path == "assembler" || path == "mips-assembler")
            {
                SelectedTab = LectureTab.GdI;
                return;
            }

            // Rechnernetze Routen
            if (path == "networking" || path == "cn" || path == "rechnernetze" ||
                path == "line-coding" || path == "bitencodings" || path == "bitencoding" || path == "leitungscodierung" ||
                path == "crc" ||
                path == "spanning-tree" || path == "stp" ||
                path == "subnetting" || path == "ipv4-subnetting" ||
                path == "shortest-path" || path == "shortestpath" || path == "dijkstra" || path == "kuerzeste-wege" ||
                path == "tcp" || path == "tcp-seq-ack" || path == "tcpseqack" ||
                path == "layering" || path == "schichten" ||
                path == "cn-topologies" || path == "topologien" ||
                path == "twisted-pair" || path == "verkabelung" ||
                path == "dns" ||
                path == "http" ||
                path == "mail" || path == "email" ||
                path == "telnet" ||
                path == "server-identification" || path == "identifikation" ||
                path == "walsh-code" || path == "walsh" || path == "cdma")
            {
                SelectedTab = LectureTab.Net;
                return;
            }

            // Betriebssysteme Routen
            if (path == "operating-systems" || path == "bs" || path == "betriebssysteme" ||
                path == "buddy-memory" || path == "buddymemory" ||
                path == "page-replacement" || path == "pagereplacement" ||
                path == "cpu-scheduling" || path == "cpuscheduling" ||
                path == "realtime-scheduling" || path == "realtimescheduling" ||
                path == "process-state" || path == "processstate" || path == "prozesszustand" || path == "prozessmodell" ||
                path == "race-condition" || path == "racecondition" ||
                path == "peterson" || path == "peterson-algorithm" ||
                path == "pipes" || path == "pipe" ||
                path == "ipc" || path == "interprozesskommunikation" ||
                path == "virtualisation" || path == "virtualisierung" ||
                path == "filesystem" || path == "filesystems" || path == "dateisysteme" || path == "inode" || path == "inodes" || path == "fat")
            {
                SelectedTab = LectureTab.BS;
                return;
            }
        }
        catch
        {
            // ignore URI parsing errors
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
