                title="Betriebssysteme (11 Simulatoren)">
            <span class="pill-dot dot-bs"></span>
            <span>BS</span>
        </button>
        <button type="button" 
                class="switcher-pill switcher-pill-all @(SelectedTab == LectureTab.All ? "active pill-all" : "")" 
                @onclick="() => SelectTab(LectureTab.All)"
                title="Alle 43 Aufgaben anzeigen">
