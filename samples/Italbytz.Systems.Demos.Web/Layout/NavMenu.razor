<!-- Vorlesungs-Umschalter (Segmented Controls) -->
<div class="lecture-switcher-wrap">
    <div class="lecture-switcher" role="tablist" aria-label="Vorlesungsauswahl">
        <button type="button" 
                class="switcher-pill @(SelectedTab == LectureTab.GdI ? "active pill-gdi" : "")" 
                @onclick="() => SelectTab(LectureTab.GdI)"
                title="Grundlagen der Informatik (17 Simulatoren)">
            <span class="pill-dot dot-gdi"></span>
            <span>GdI</span>
        </button>
        <button type="button" 
                class="switcher-pill @(SelectedTab == LectureTab.Net ? "active pill-net" : "")" 
                @onclick="() => SelectTab(LectureTab.Net)"
                title="Rechnernetze (15 Simulatoren)">
            <span class="pill-dot dot-net"></span>
            <span>Netze</span>
        </button>
        <button type="button" 
                class="switcher-pill @(SelectedTab == LectureTab.BS ? "active pill-bs" : "")" 
